+# --- (f) a broken target.toml -----------------------------------------------------------
+
+GOOD = TARGET_TOML.format(
+    id="broken-1", display_name="Broken", shell="bash", os_id="broken", version_id="1"
+)
+
+
+@pytest.mark.parametrize(
+    "text, problem",
+    [
+        (None, "missing"),
+        ("id = \n", "not valid TOML"),
+        (
+            GOOD.replace('display_name = "Broken"\n', ""),
+            "missing required field 'display_name'",
+        ),
+        (
+            GOOD.replace('VERSION_ID = "1"\n', ""),
+            "missing required field 'match.VERSION_ID'",
+        ),
+        (
+            GOOD.replace('version = "0.2.13"\n', ""),
+            "missing required field 'sudo.version'",
+        ),
+        (
+            GOOD.replace('package_owner_query = ["dpkg", "-S"]\n', ""),
+            "missing required field 'package_owner_query'",
+        ),
+        (GOOD.replace('id = "broken-1"', 'id = "other-1"'), "differs from its folder name"),
+        (GOOD.replace('shell = "bash"', 'shell = "zsh"'), "shell 'zsh' is not supported"),
+    ],
+    ids=[
+        "no-file", "bad-toml", "no-display-name", "no-version-id", "no-sudo-version",
+        "no-package-owner-query", "id-differs", "shell-not-bash",
+    ],
+)
+@pytest.mark.parametrize("how", ["flag", "auto"])
+def test_broken_target_toml_is_refused(
+    monkeypatch, tmp_path, capsys, text, problem, how
+):
+    root = tmp_path / "targets"
+    folder = root / "broken-1"
+    folder.mkdir(parents=True)
+    path = folder / "target.toml"
+    if text is not None:
+        path.write_text(text, encoding="utf-8")
+    argv = ["--target", "broken-1"] if how == "flag" else []
+    release = 'ID=broken\nVERSION_ID="1"\n'
+    status, _, selection = start(monkeypatch, tmp_path, argv, release, root)
+    assert status != 0
+    assert selection is None
+    err = capsys.readouterr().err
+    assert f"{path}: " in err
+    assert problem in err
