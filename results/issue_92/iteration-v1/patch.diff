+# --- (g) the real targets/ubuntu-26.04 --------------------------------------------------
+
+ALLOWLIST_WORDS = set(
+    """
+    ls tree stat file realpath readlink basename dirname pwd cd pushd popd dirs cat head
+    tail wc nl od strings md5sum sha256sum cmp diff grep egrep fgrep sort uniq cut tr
+    column base64 xxd jq echo printf du df free uptime id whoami groups uname lsblk lscpu
+    lsusb lspci ps nproc hostname date env printenv type which history man less more
+    systemctl journalctl ss apt apt-cache dpkg dpkg-query nvidia-smi rocminfo vulkaninfo
+    """.split()
+)
+NEVER_ON_ALLOWLIST = (
+    "command", "ip", "git", "awk", "sed", "find", "xargs", "watch", "timeout",
+)
+ENTRY_FIELDS = {"flags", "options", "subcommands", "max_operands", "stdin"}
+
+
+@pytest.fixture
+def allowlist():
+    """The real allowlist's entries, by command word, via the production loader."""
+    from nl_shell import targets
+
+    data = targets.load_allowlist(targets.load("ubuntu-26.04"))
+    return data["commands"]
+
+
+def allowed(entry):
+    return (
+        set(entry.get("flags", []))
+        | set(entry.get("options", []))
+        | set(entry.get("subcommands", []))
+    )
+
+
+def test_real_target_loads_and_matches():
+    from nl_shell import targets
+
+    assert targets.ROOT == REAL_TARGETS
+    target = targets.load("ubuntu-26.04")
+    assert target.id == "ubuntu-26.04"
+    assert target.path == REAL_TARGETS / "ubuntu-26.04"
+    assert target.allowlist_path == REAL_TARGETS / "ubuntu-26.04" / "allowlist.toml"
+    assert target.shell == "bash"
+    assert target.package_owner_query == ("dpkg", "-S")
+    assert (target.sudo_implementation, target.sudo_version) == ("sudo-rs", "0.2.13")
+    assert target.display_name
+    assert target.matches({"ID": "ubuntu", "VERSION_ID": "26.04"})
+    assert not target.matches({"ID": "ubuntu", "VERSION_ID": "26.10"})
+    assert targets.available() == ["ubuntu-26.04"]
+
