+def test_real_allowlist_restrictions(allowlist):
+    a = allowlist
+    assert "-r" not in allowed(a["xxd"])
+    assert not allowed(a["sort"]) & {"-o", "--output", "--compress-program"}
+    for word in ("grep", "egrep", "fgrep"):
+        assert "--pre" not in allowed(a[word]), word
+    assert not allowed(a["jq"]) & {"--rawfile", "--slurpfile"}
+    assert "--to-file" not in allowed(a["diff"])
+    for word in ("man", "less", "more"):
+        assert not allowed(a[word]) & {"-P", "-H", "--pager", "--html", "-k"}, word
+    journal = allowed(a["journalctl"])
+    assert not any(opt.startswith("--vacuum") for opt in journal)
+    assert not journal & {"--rotate", "--flush"}
+    for word in ("env", "printenv", "date", "hostname"):
+        assert a[word].get("max_operands") == 0, word
+    for word in ("uniq", "cut", "tr", "column", "base64", "xxd"):
+        assert "max_operands" in a[word] and a[word]["max_operands"] <= 1, word
+    assert set(a["systemctl"]["subcommands"]) == {
+        "status", "is-active", "is-enabled", "is-failed", "list-units", "list-unit-files",
+        "show", "cat",
+    }
+    assert len(a["systemctl"]["subcommands"]) == 8
+    assert sorted(a["apt"]["subcommands"]) == sorted(["list", "show", "search", "policy"])
+    assert sorted(a["apt-cache"]["subcommands"]) == sorted(
+        ["show", "search", "policy", "depends", "rdepends"]
+    )
+    for word in ("dpkg", "dpkg-query"):
+        assert allowed(a[word]) <= {"-l", "-L", "-S", "-s", "-W"}, word
+    for word in ("nvidia-smi", "rocminfo", "vulkaninfo"):
+        assert allowed(a[word]) <= {"-L", "-q", "--summary"}, word
+
