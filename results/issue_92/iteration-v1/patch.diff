index 0000000..e8c9af2
--- /dev/null
+++ b/src/nl_shell/config.py
@@ -0,0 +1,54 @@
+"""The user's ``config.toml`` (ADR-0020 §1–§2).
+
+The file lives in ``$XDG_CONFIG_HOME/nl-shell/`` (default ``~/.config/nl-shell/``). A
+missing file means "no settings". A file that is not valid TOML is refused with a message,
+never half-read. Unknown keys are ignored here, so later issues can add their own (#77).
+
+This unit only reads the user's settings. The target loader (``nl_shell.targets``) is kept
+separate on purpose: later issues extend the two in parallel.
+"""
+
+from __future__ import annotations
+
+import os
+import tomllib
+from dataclasses import dataclass
+from pathlib import Path
+
+
+class ConfigError(Exception):
+    """``config.toml`` exists but can't be used. The message names the file."""
+
+
+@dataclass(frozen=True)
+class Config:
+    path: Path
+    target: str | None = None
+
+
+def config_dir() -> Path:
+    base = os.environ.get("XDG_CONFIG_HOME") or ""
+    root = Path(base) if base else Path.home() / ".config"
+    return root / "nl-shell"
+
+
+def config_path() -> Path:
+    return config_dir() / "config.toml"
+
+
+def load(path: Path | None = None) -> Config:
+    path = config_path() if path is None else path
+    try:
+        raw = path.read_bytes()
+    except FileNotFoundError:
+        return Config(path)
+    except OSError as exc:
+        raise ConfigError(f"{path}: can't be read: {exc.strerror or exc}") from exc
+    try:
+        data = tomllib.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
+        raise ConfigError(f"{path}: not valid TOML: {exc}") from exc
+    target = data.get("target")
+    if target is not None and (not isinstance(target, str) or not target):
+        raise ConfigError(f"{path}: 'target' must be a non-empty string")
+    return Config(path, target)
