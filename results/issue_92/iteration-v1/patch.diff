diff --git a/src/nl_shell/targets.py b/src/nl_shell/targets.py
new file mode 100644
index 0000000..cdc65cb
--- /dev/null
+++ b/src/nl_shell/targets.py
@@ -0,0 +1,254 @@
+"""OS targets (ADR-0023): loading ``targets/<id>/target.toml`` and choosing the target.
+
+A target is one supported OS release. Everything OS-specific lives in its folder, so this
+module names no OS: the os-release match, the shell, the package-owner query and the sudo
+implementation all come from ``target.toml``.
+
+Choosing the target (ADR-0023 §Choosing the target): the target whose ``ID`` and
+``VERSION_ID`` equal the os-release values exactly. There is no fallback through
+``ID_LIKE`` or a nearby version. With no match, start-up is refused unless the user names
+a target; a named target that does not match is recorded as such, and the gate (#12) runs
+in degraded mode for it (spec ``policy-gate/v1`` §7.7).
+
+The allowlist is only located and parsed here; the gate (#12) gives it meaning.
+"""
+
+from __future__ import annotations
+
+import re
+import tomllib
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+# At run time the targets live in the repository's `targets/`, next to `src/`. Shipping
+# them in an installed package is #48 / #50.
+ROOT = Path(__file__).resolve().parents[2] / "targets"
+
+TARGET_FILE = "target.toml"
+ALLOWLIST_FILE = "allowlist.toml"
+SUPPORTED_SHELLS = ("bash",)
+MISMATCH_REASON = "target does not match this OS"
+
+# A target id is a folder name: os-release `ID` and `VERSION_ID` characters, no `/`.
+_ID = re.compile(r"[a-z0-9][a-z0-9._-]*")
+
+# Required string fields of target.toml, as dotted paths into the TOML document.
+_REQUIRED_STRINGS = (
+    "id",
+    "display_name",
+    "shell",
+    "match.ID",
+    "match.VERSION_ID",
+    "sudo.implementation",
+    "sudo.version",
+)
+
+
+class TargetError(Exception):
+    """A target can't be loaded or chosen. The message is meant for the user."""
+
+
+@dataclass(frozen=True)
+class Target:
+    id: str
+    display_name: str
+    os_id: str
+    os_version_id: str
+    shell: str
+    package_owner_query: tuple[str, ...]
+    sudo_implementation: str
+    sudo_version: str
+    path: Path
+    fields: Mapping[str, Any] = field(repr=False)
+
+    @property
+    def allowlist_path(self) -> Path:
+        return self.path / ALLOWLIST_FILE
+
+    def matches(self, os_release: Mapping[str, str]) -> bool:
+        return (
+            os_release.get("ID") == self.os_id
+            and os_release.get("VERSION_ID") == self.os_version_id
+        )
+
+
+@dataclass(frozen=True)
+class Selection:
+    """The active target and how it relates to the OS nl-shell runs on."""
+
+    target: Target
+    matches: bool
+    detected_id: str | None
+    detected_version_id: str | None
+
+    @property
+    def reason(self) -> str | None:
+        """Why the gate runs degraded, or None when the target matches."""
+        return None if self.matches else MISMATCH_REASON
+
+    @property
+    def detected(self) -> str:
+        return describe_os(self.detected_id, self.detected_version_id)
+
+    def warning(self) -> str | None:
+        if self.matches:
+            return None
+        return (
+            f"warning: {MISMATCH_REASON} (target {self.target.id}, detected: "
+            f"{self.detected}). Every command will need a confirm, because this "
+            "target's allowlist was never checked on this OS."
+        )
+
+    def status_lines(self) -> list[str]:
+        if self.matches:
+            match = "matches this OS"
+        else:
+            match = f"does not match this OS (detected: {self.detected})"
+        return [
+            f"target: {self.target.id} ({self.target.display_name})",
+            f"target os: {match}",
+        ]
+
+
+def describe_os(os_id: str | None, version_id: str | None) -> str:
+    return f"{os_id or 'unknown'} {version_id or 'unknown'}"
+
+
+def _lookup(data: Mapping[str, Any], dotted: str) -> Any:
+    value: Any = data
+    for part in dotted.split("."):
+        if not isinstance(value, Mapping) or part not in value:
+            return None
+        value = value[part]
+    return value
+
+
+def load(target_id: str, root: Path = ROOT) -> Target:
+    """Load and validate ``root/<target_id>/target.toml``."""
+    if not _ID.fullmatch(target_id):
+        raise TargetError(
+            f"target {target_id!r} is not a valid target id "
+            f"(available targets: {_available_text(root)})"
+        )
+    folder = root / target_id
+    if not folder.is_dir():
+        raise TargetError(
+            f"target {target_id!r} has no folder {folder} "
+            f"(available targets: {_available_text(root)})"
+        )
+    path = folder / TARGET_FILE
+    try:
+        raw = path.read_bytes()
+    except FileNotFoundError:
+        raise TargetError(f"{path}: missing") from None
+    except OSError as exc:
+        raise TargetError(f"{path}: can't be read: {exc.strerror or exc}") from exc
+    try:
+        data = tomllib.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
+        raise TargetError(f"{path}: not valid TOML: {exc}") from exc
+
+    for name in _REQUIRED_STRINGS:
+        value = _lookup(data, name)
+        if value is None:
+            raise TargetError(f"{path}: missing required field '{name}'")
+        if not isinstance(value, str) or not value:
+            raise TargetError(f"{path}: field '{name}' must be a non-empty string")
+    query = data.get("package_owner_query")
+    if query is None:
+        raise TargetError(f"{path}: missing required field 'package_owner_query'")
+    if (
+        not isinstance(query, list)
+        or not query
+        or not all(isinstance(word, str) and word for word in query)
+    ):
+        raise TargetError(
+            f"{path}: field 'package_owner_query' must be a non-empty list of strings"
+        )
+    if data["id"] != target_id:
+        raise TargetError(
+            f"{path}: id {data['id']!r} differs from its folder name {target_id!r}"
+        )
+    if data["shell"] not in SUPPORTED_SHELLS:
+        raise TargetError(
+            f"{path}: shell {data['shell']!r} is not supported "
+            f"(supported: {', '.join(SUPPORTED_SHELLS)})"
+        )
+
+    return Target(
+        id=data["id"],
+        display_name=data["display_name"],
+        os_id=data["match"]["ID"],
+        os_version_id=data["match"]["VERSION_ID"],
+        shell=data["shell"],
+        package_owner_query=tuple(query),
+        sudo_implementation=data["sudo"]["implementation"],
+        sudo_version=data["sudo"]["version"],
+        path=folder,
+        fields=data,
+    )
+
+
+def load_allowlist(target: Target) -> dict[str, Any]:
+    """Parse the target's ``allowlist.toml``. Only parses: the gate (#12) checks it."""
+    path = target.allowlist_path
+    try:
+        return tomllib.loads(path.read_text(encoding="utf-8"))
+    except OSError as exc:
+        raise TargetError(f"{path}: can't be read: {exc.strerror or exc}") from exc
+    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
+        raise TargetError(f"{path}: not valid TOML: {exc}") from exc
+
+
+def available(root: Path = ROOT) -> list[str]:
+    """The ids of the target folders under ``root``, sorted."""
+    try:
+        entries = list(root.iterdir())
+    except OSError:
+        return []
+    return sorted(
+        entry.name
+        for entry in entries
+        if entry.is_dir() and _ID.fullmatch(entry.name) and (entry / TARGET_FILE).is_file()
+    )
+
+
+def _available_text(root: Path) -> str:
+    return ", ".join(available(root)) or "none"
+
+
+def select(
+    os_release: Mapping[str, str],
+    named: str | None = None,
+    root: Path = ROOT,
+    config_file: Path | None = None,
+) -> Selection:
+    """Choose the active target, or raise TargetError when start-up must be refused.
+
+    ``named`` is the target the user named (``--target`` wins over ``config.toml``; the
+    caller resolves that). ``config_file`` is only used to tell the user where to set one.
+    """
+    detected_id = os_release.get("ID")
+    detected_version = os_release.get("VERSION_ID")
+
+    if named is not None:
+        target = load(named, root)
+        return Selection(target, target.matches(os_release), detected_id, detected_version)
+
+    if detected_id and detected_version:
+        candidate = f"{detected_id}-{detected_version}"
+        if _ID.fullmatch(candidate) and (root / candidate).is_dir():
+            target = load(candidate, root)
+            if target.matches(os_release):
+                return Selection(target, True, detected_id, detected_version)
+
+    where = f" in {config_file}" if config_file is not None else " in config.toml"
+    raise TargetError(
+        f"no target matches this OS (detected: "
+        f"{describe_os(detected_id, detected_version)}). "
+        f"Available targets: {_available_text(root)}. nl-shell does not fall back to a "
+        "similar OS or version. To use a target anyway, name it with --target <id> or "
+        f'set target = "<id>"{where}; every command will then need a confirm.'
+    )
diff --git a/targets/ubuntu-26.04/allowlist.toml b/targets/ubuntu-26.04/allowlist.toml
new file mode 100644
index 0000000..b4781f1
--- /dev/null
+++ b/targets/ubuntu-26.04/allowlist.toml
@@ -0,0 +1,393 @@
+# Read-only allowlist for the ubuntu-26.04 target: the v1 entries of spec policy-gate/v1
+# §6.4, in the entry format of §6.2. The gate (#12) is the only reader that gives this file
+# meaning; a change here changes what runs without a confirm, so every entry is reviewed
+# by a human (spec §Versioning, nl-shell-pdca INTEGRATION §4).
+#
+# Format (§6.2): one table per command word, `[commands.<word>]`, with only these keys,
+# all optional:
+#   flags        options allowed without a value
+#   options      options allowed with a value
+#   subcommands  allowed first operands
+#   max_operands the most operands allowed
+#   stdin        true if the command reads standard input when given no file operand
+# Any option or subcommand not listed makes the simple command `mutating` (§6.2).
+#
+# Translated fail-closed (§6.3): an option is listed only if it can't write a file, run
+# another program, open a network connection or change system state. Where §6.4 says
+# "flags" without naming them, only well-known display and format options are listed. A
+# missing option costs a confirm; an extra one could run code unconfirmed.
+#
+# Two §6.4 words are left off, because §6.2 can't express their restriction:
+#   command  §6.4 allows only `command -v`. `flags = ["-v"]` would allow `-v` but not
+#            require it, so `command foo` would run `foo` unconfirmed. `type` and `which`
+#            cover the lookup.
+#   ip       §6.4 forbids `add`/`del`/`set`/`flush`, but those are the second operand
+#            (`ip addr add …`) and `subcommands` only covers the first (§6.2).
+# A later §6.2 field (#12) may put them back.
+#
+# Not on the list by design (§6.4): git, awk, sed, find, xargs, watch, timeout.
+
+spec = "policy-gate/v1"
+
+# --- Files and directories: listing and paths ------------------------------------------
+
+[commands.ls]
+flags = [
+    "-a", "-A", "-l", "-h", "-1", "-d", "-F", "-R", "-r", "-t", "-S", "-X", "-i", "-n",
+    "-g", "-o", "-s", "-p", "-Q", "-U", "-v", "-x", "-C", "-m", "-L",
+    "--all", "--almost-all", "--human-readable", "--directory", "--classify",
+    "--recursive", "--reverse", "--inode", "--numeric-uid-gid", "--size",
+    "--dereference",
+]
+options = ["--color", "--sort", "--time-style", "--block-size"]
+
+# Not `-o FILE` (writes a file), not `-R`/`-H` (HTML output writes files).
+[commands.tree]
+flags = [
+    "-a", "-d", "-f", "-i", "-s", "-h", "-p", "-u", "-g", "-D", "-F", "-C", "-n",
+    "--noreport",
+]
+options = ["-L", "-I", "-P"]
+
+[commands.stat]
+flags = ["-L", "-f", "-t", "--dereference", "--file-system", "--terse"]
+options = ["-c", "--format", "--printf"]
+
+# Not `-C` (compiles a magic file), not `-z` (may run decompressors).
+[commands.file]
+flags = [
+    "-b", "-i", "-L", "-h", "--brief", "--mime", "--mime-type", "--dereference",
+    "--no-dereference",
+]
+
+[commands.realpath]
+flags = ["-e", "-m", "-s", "-q", "-z", "-L", "-P"]
+options = ["--relative-to", "--relative-base"]
+
+[commands.readlink]
+flags = ["-f", "-e", "-m", "-n", "-q", "-s", "-v", "-z"]
+
+[commands.basename]
+flags = ["-a", "-z", "--multiple"]
+options = ["-s", "--suffix"]
+
+[commands.dirname]
+flags = ["-z"]
+
+[commands.pwd]
+flags = ["-L", "-P"]
+max_operands = 0
+
+# --- Working directory: one path each (changes the cwd only) ---------------------------
+
+[commands.cd]
+flags = ["-L", "-P"]
+max_operands = 1
+
+[commands.pushd]
+flags = ["-n"]
+max_operands = 1
+
+[commands.popd]
+flags = ["-n"]
+max_operands = 1
+
+# Not `-c` (clears the directory stack).
+[commands.dirs]
+flags = ["-l", "-p", "-v"]
+max_operands = 1
+
+# --- Reading files ---------------------------------------------------------------------
+
+[commands.cat]
+flags = ["-n", "-b", "-A", "-E", "-T", "-v", "-s", "-e", "-t"]
+stdin = true
+
+[commands.head]
+flags = ["-q", "-v", "-z"]
+options = ["-n", "-c"]
+stdin = true
+
+[commands.tail]
+flags = ["-f", "-F", "-q", "-v", "-z"]
+options = ["-n", "-c"]
+stdin = true
+
+[commands.wc]
+flags = ["-l", "-w", "-c", "-m", "-L"]
+stdin = true
+
+[commands.nl]
+options = ["-b", "-n", "-w", "-s", "-v", "-i"]
+stdin = true
+
+[commands.od]
+flags = ["-c", "-x", "-b", "-d", "-o", "-v"]
+options = ["-A", "-t", "-N", "-j", "-w"]
+stdin = true
+
+[commands.strings]
+flags = ["-a"]
+options = ["-n", "-t", "-e"]
+stdin = true
+
+[commands.md5sum]
+flags = ["-b", "-t", "-c", "--check", "--quiet", "--status", "--tag", "-z"]
+stdin = true
+
+[commands.sha256sum]
+flags = ["-b", "-t", "-c", "--check", "--quiet", "--status", "--tag", "-z"]
+stdin = true
+
+[commands.cmp]
+flags = ["-b", "-l", "-s", "--silent", "--quiet", "--print-bytes", "--verbose"]
+options = ["-i", "-n"]
+stdin = true
+
+# Not `--to-file` (§6.4).
+[commands.diff]
+flags = [
+    "-u", "-c", "-q", "-s", "-r", "-N", "-i", "-w", "-b", "-B", "-y", "-a", "-t",
+    "--brief",
+]
+options = ["-U", "-C", "-W"]
+stdin = true
+
+# --- Searching and text processing -----------------------------------------------------
+
+# Not `--pre` or any option that runs a preprocessor (§6.4).
+[commands.grep]
+flags = [
+    "-i", "-v", "-n", "-c", "-l", "-L", "-r", "-R", "-w", "-x", "-o", "-h", "-H", "-s",
+    "-q", "-E", "-F", "-a",
+]
+options = ["-e", "-m", "-A", "-B", "-C", "--include", "--exclude", "--color"]
+stdin = true
+
+[commands.egrep]
+flags = [
+    "-i", "-v", "-n", "-c", "-l", "-L", "-r", "-R", "-w", "-x", "-o", "-h", "-H", "-s",
+    "-q", "-a",
+]
+options = ["-e", "-m", "-A", "-B", "-C", "--include", "--exclude", "--color"]
+stdin = true
+
+[commands.fgrep]
+flags = [
+    "-i", "-v", "-n", "-c", "-l", "-L", "-r", "-R", "-w", "-x", "-o", "-h", "-H", "-s",
+    "-q", "-a",
+]
+options = ["-e", "-m", "-A", "-B", "-C", "--include", "--exclude", "--color"]
+stdin = true
+
+# Not `-o`/`--output`, `--compress-program` (§6.4), nor `-T` (temporary directory).
+[commands.sort]
+flags = ["-n", "-r", "-u", "-f", "-b", "-d", "-h", "-M", "-V", "-g", "-s", "-c", "-z"]
+options = ["-k", "-t"]
+stdin = true
+
+# The four below and `base64`, `xxd`: at most one file operand, because a second operand
+# is an output file (§6.4).
+[commands.uniq]
+flags = ["-c", "-d", "-u", "-i", "-D"]
+options = ["-f", "-s", "-w"]
+max_operands = 1
+stdin = true
+
+[commands.cut]
+flags = ["-s", "-z", "--complement"]
+options = ["-d", "-f", "-c", "-b"]
+max_operands = 1
+stdin = true
+
+# `tr` takes sets, not files, as operands; with at most one, `tr -d SET` runs unconfirmed
+# and `tr SET1 SET2` costs a confirm.
+[commands.tr]
+flags = ["-d", "-s", "-c", "-C", "-t"]
+max_operands = 1
+stdin = true
+
+[commands.column]
+flags = ["-t", "-x"]
+options = ["-s", "-c"]
+max_operands = 1
+stdin = true
+
+[commands.base64]
+flags = ["-d", "--decode", "-i", "--ignore-garbage"]
+options = ["-w"]
+max_operands = 1
+stdin = true
+
+# Not `-r` (reverse: writes binary data) (§6.4).
+[commands.xxd]
+flags = ["-p", "-u", "-b", "-e", "-i"]
+options = ["-c", "-g", "-l", "-s"]
+max_operands = 1
+stdin = true
+
+# Not `--rawfile`/`--slurpfile` (§6.4). Not `-f`/`-L` (filter or modules from files).
+[commands.jq]
+flags = [
+    "-r", "-c", "-S", "-e", "-n", "-s", "-j", "-a", "-M", "-C", "--tab", "--raw-output",
+    "--compact-output", "--sort-keys", "--slurp", "--null-input", "--exit-status",
+]
+options = ["--indent"]
+stdin = true
+
+# Output passes the rendering filter (#71).
+[commands.echo]
+flags = ["-n", "-e", "-E"]
+
+# Not `-v VAR` (assigns a shell variable).
+[commands.printf]
+
+# --- System information ----------------------------------------------------------------
+
+[commands.du]
+flags = ["-s", "-h", "-a", "-c", "-x", "-k", "-m", "-b", "-L", "-P", "-S"]
+options = ["-d", "--max-depth", "--block-size"]
+
+[commands.df]
+flags = ["-h", "-H", "-T", "-i", "-a", "-l", "-k", "-P", "--total"]
+options = ["-t", "-x", "-B"]
+
+[commands.free]
+flags = ["-h", "-b", "-k", "-m", "-g", "-t", "-w", "-l", "--si"]
+
+[commands.uptime]
+flags = ["-p", "-s"]
+max_operands = 0
+
+[commands.id]
+flags = ["-u", "-g", "-G", "-n", "-r", "-z"]
+
+[commands.whoami]
+max_operands = 0
+
+[commands.groups]
+
+[commands.uname]
+flags = ["-a", "-s", "-n", "-r", "-v", "-m", "-p", "-i", "-o"]
+max_operands = 0
+
+[commands.lsblk]
+flags = ["-a", "-f", "-l", "-p", "-d", "-m", "-t", "-J", "-b", "-S", "-n", "-r"]
+options = ["-o"]
+
+[commands.lscpu]
+flags = ["-a", "-b", "-c", "-e", "-p", "-J", "-x", "-y"]
+
+[commands.lsusb]
+flags = ["-v", "-t"]
+options = ["-s", "-d"]
+
+# Not `-H` (direct hardware access).
+[commands.lspci]
+flags = ["-v", "-vv", "-vvv", "-n", "-nn", "-k", "-t", "-D"]
+options = ["-s", "-d"]
+
+[commands.ps]
+flags = ["-e", "-f", "-F", "-A", "-a", "-l", "-H", "-x", "-w"]
+options = ["-u", "-U", "-p", "-C", "-o", "-g", "--sort"]
+
+[commands.nproc]
+flags = ["--all"]
+options = ["--ignore"]
+max_operands = 0
+
+# No operand: an operand sets the hostname (§6.4). Not `-F FILE` (sets it from a file),
+# not `-b`.
+[commands.hostname]
+flags = ["-s", "-f", "-d", "-i", "-I", "-A", "-a", "--short", "--fqdn", "--domain"]
+max_operands = 0
+
+# No operand: an operand sets the date (§6.4). That means `date +FORMAT` costs a confirm
+# too, since §6.2 can't tell `+FORMAT` from a new date. Not `-s`/`--set`.
+[commands.date]
+flags = ["-u", "-R", "--utc", "--rfc-email"]
+options = ["-d", "--date"]
+max_operands = 0
+
+# No operands: with one, `env` runs a command (§6.4, §4). Not `-i`, `-u`, `-C`, `-S`.
+[commands.env]
+flags = ["-0", "--null"]
+max_operands = 0
+
+[commands.printenv]
+flags = ["-0", "--null"]
+max_operands = 0
+
+# --- Command lookup and help -----------------------------------------------------------
+
+[commands.type]
+flags = ["-a", "-t", "-p", "-P", "-f"]
+
+[commands.which]
+flags = ["-a"]
+
+# No flags: `-c`, `-d`, `-a`, `-n`, `-r`, `-w`, `-s` change the history or its file.
+[commands.history]
+max_operands = 1
+
+# Not `-P`, `-H`, `--pager`, `--html`, `-k` (§6.4). Pager variables must match the
+# baseline (§7.5).
+[commands.man]
+flags = ["-f", "-a", "-w", "--where", "--whatis"]
+
+[commands.less]
+flags = ["-N", "-S", "-R", "-F", "-X", "-i"]
+stdin = true
+
+[commands.more]
+flags = ["-d", "-s"]
+stdin = true
+
+# --- Services, logs, network sockets ---------------------------------------------------
+
+[commands.systemctl]
+subcommands = [
+    "status", "is-active", "is-enabled", "is-failed", "list-units", "list-unit-files",
+    "show", "cat",
+]
+flags = ["--no-pager", "-a", "--all", "-l", "--full", "--failed", "--user", "--system"]
+options = ["-t", "--type", "--state", "-p", "--property", "-n"]
+
+# Exactly the §6.4 list. Not `--vacuum-*`, `--rotate`, `--flush`.
+[commands.journalctl]
+flags = ["-b", "-f", "--no-pager", "-x", "-e"]
+options = ["-u", "-n", "-p", "--since", "--until"]
+
+# Not `-K` (kills sockets), `-D` (dumps to a file), `-N` (enters a namespace).
+[commands.ss]
+flags = [
+    "-t", "-u", "-l", "-n", "-p", "-a", "-x", "-4", "-6", "-s", "-e", "-i", "-m", "-o",
+    "-w", "-H",
+]
+
+# --- Packages ---------------------------------------------------------------------------
+
+# Not `-o` or `-c`: an APT option or config file can make APT run commands.
+[commands.apt]
+subcommands = ["list", "show", "search", "policy"]
+flags = ["--installed", "--upgradable", "--all-versions"]
+
+[commands.apt-cache]
+subcommands = ["show", "search", "policy", "depends", "rdepends"]
+flags = ["--names-only", "--full", "--installed", "--recurse"]
+
+[commands.dpkg]
+flags = ["-l", "-L", "-S", "-s", "-W"]
+
+[commands.dpkg-query]
+flags = ["-l", "-L", "-S", "-s", "-W"]
+
+# --- GPU -------------------------------------------------------------------------------
+
+[commands.nvidia-smi]
+flags = ["-L", "-q"]
+
+[commands.rocminfo]
+
+[commands.vulkaninfo]
+flags = ["--summary"]
diff --git a/targets/ubuntu-26.04/target.toml b/targets/ubuntu-26.04/target.toml
new file mode 100644
index 0000000..d2fb135
--- /dev/null
+++ b/targets/ubuntu-26.04/target.toml
@@ -0,0 +1,26 @@
+# OS target ubuntu-26.04 (ADR-0023 §Decision). Everything nl-shell knows about this OS
+# release lives in this folder; the code reads it from here and names no OS itself.
+
+id = "ubuntu-26.04"
+display_name = "Ubuntu 26.04 LTS"
+
+# The shell nl-shell drives. `bash` is the only accepted value (ADR-0002, ADR-0023
+# §Shells later).
+shell = "bash"
+
+# The command, as argv words, that tells which installed package owns a file. The path
+# is appended as the last word. Used by the gate's live-session resolution (spec
+# policy-gate/v1 §7.4).
+package_owner_query = ["dpkg", "-S"]
+
+# Chosen at start-up only when both values equal /etc/os-release exactly; no `ID_LIKE`
+# or nearby-version fallback (ADR-0023 §Choosing the target).
+[match]
+ID = "ubuntu"
+VERSION_ID = "26.04"
+
+# The sudo implementation this target ships, and the version the sudo handling was
+# checked against (ADR-0015 §Context).
+[sudo]
+implementation = "sudo-rs"
+version = "0.2.13"
