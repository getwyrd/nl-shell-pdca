+def test_real_allowlist_parses_with_only_spec_fields(allowlist):
+    data = tomllib.loads((REAL_TARGETS / "ubuntu-26.04" / "allowlist.toml").read_text())
+    assert data["spec"] == "policy-gate/v1"
+    assert set(data) == {"spec", "commands"}
+    for word, entry in allowlist.items():
+        assert set(entry) <= ENTRY_FIELDS, word
+        for key in ("flags", "options", "subcommands"):
+            assert all(isinstance(v, str) for v in entry.get(key, [])), (word, key)
+        if "max_operands" in entry:
+            assert isinstance(entry["max_operands"], int) and entry["max_operands"] >= 0
+        if "stdin" in entry:
+            assert entry["stdin"] is True or entry["stdin"] is False
