diff --git a/tests/test_targets.py b/tests/test_targets.py
new file mode 100644
index 0000000..dd403da
--- /dev/null
+++ b/tests/test_targets.py
@@ -0,0 +1,510 @@
+"""OS targets (#92, ADR-0023): the target folder, the loader, and start-up selection.
+
+Every case uses a fake os-release file, so no result depends on the host's real
+/etc/os-release (CI runs on a GitHub image that is not the target OS). The suite's
+temporary HOME (#73, tests/conftest.py) keeps `config.toml` reads away from the real one.
+
+New modules are imported inside the test functions: with the production change reverted
+they don't exist, and a module-level import would stop the file from loading instead of
+letting each test fail.
+"""
+
+import io
+import os
+import re
+import tomllib
+from pathlib import Path
+
+import pytest
+
+from nl_shell import cli
+from nl_shell.repl import Repl
+
+REPO = Path(__file__).resolve().parents[1]
+REAL_TARGETS = REPO / "targets"
+
+MISMATCH = "target does not match this OS"
+
+TARGET_TOML = """\
+id = "{id}"
+display_name = "{display_name}"
+shell = "{shell}"
+package_owner_query = ["dpkg", "-S"]
+
+[match]
+ID = "{os_id}"
+VERSION_ID = "{version_id}"
+
+[sudo]
+implementation = "sudo-rs"
+version = "0.2.13"
+"""
+
+
+def scripted(*lines):
+    """A read function that returns ``lines`` in order, then signals end of input."""
+    it = iter(lines)
+
+    def read(_prompt):
+        try:
+            return next(it)
+        except StopIteration:
+            raise EOFError from None
+
+    return read
+
+
+def make_target(root, target_id, *, text=None, **fields):
+    """Write ``root/<target_id>/target.toml``; ``text`` replaces the whole file."""
+    values = {
+        "id": target_id,
+        "display_name": f"Fake {target_id}",
+        "shell": "bash",
+        "os_id": target_id.rsplit("-", 1)[0],
+        "version_id": target_id.rsplit("-", 1)[1],
+    }
+    values.update(fields)
+    folder = root / target_id
+    folder.mkdir(parents=True)
+    (folder / "target.toml").write_text(
+        TARGET_TOML.format(**values) if text is None else text, encoding="utf-8"
+    )
+    return folder
+
+
+@pytest.fixture
+def root(tmp_path):
+    """A fake targets directory holding one target, `ubuntu-26.04`."""
+    path = tmp_path / "targets"
+    path.mkdir()
+    make_target(path, "ubuntu-26.04", display_name="Ubuntu 26.04 LTS")
+    return path
+
+
+def os_release(tmp_path, text):
+    path = tmp_path / "os-release"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+UBUNTU_2604 = 'NAME="Ubuntu"\nID=ubuntu\nID_LIKE=debian\nVERSION_ID="26.04"\n'
+UBUNTU_2610 = 'NAME="Ubuntu"\nID=ubuntu\nID_LIKE=debian\nVERSION_ID="26.10"\n'
+DEBIAN_LIKE_UBUNTU = 'NAME="Debian"\nID=debian\nID_LIKE=ubuntu\nVERSION_ID="26.04"\n'
+DEBIAN_13 = 'NAME="Debian GNU/Linux"\nID=debian\nVERSION_ID="13"\n'
+
+
+def start(monkeypatch, tmp_path, argv, release_text, targets_root, *lines):
+    """Run ``cli.main`` with a fake os-release and targets root.
+
+    The REPL it starts reads ``lines`` (then end of input) and writes to a buffer. Returns
+    (exit status, REPL output, the Selection the REPL got, or None if it never started).
+    ``targets_root`` None keeps the real ``targets/``.
+    """
+    from nl_shell import os_release as osr
+    from nl_shell import targets
+
+    monkeypatch.setattr(osr, "PATHS", (os_release(tmp_path, release_text),))
+    if targets_root is not None:
+        monkeypatch.setattr(targets, "ROOT", targets_root)
+    out = io.StringIO()
+    started = []
+
+    def interactive(cls, selection=None):
+        started.append(selection)
+        return cls(scripted(*lines), out, selection)
+
+    monkeypatch.setattr(cli.Repl, "interactive", classmethod(interactive))
+    status = cli.main(argv)
+    return status, out.getvalue(), started[0] if started else None
+
+
+def write_config(text):
+    folder = Path(os.environ["XDG_CONFIG_HOME"]) / "nl-shell"
+    folder.mkdir(parents=True, exist_ok=True)
+    path = folder / "config.toml"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+# --- (a) exact match --------------------------------------------------------------------
+
+
+def test_exact_match_selects_the_target(monkeypatch, tmp_path, root, capsys):
+    status, out, selection = start(monkeypatch, tmp_path, [], UBUNTU_2604, root, ":status")
+    assert status == 0
+    assert selection.target.id == "ubuntu-26.04"
+    assert selection.matches is True
+    assert selection.reason is None
+    assert selection.target.path == root / "ubuntu-26.04"
+    assert selection.target.allowlist_path == root / "ubuntu-26.04" / "allowlist.toml"
+    lines = out.splitlines()
+    assert "target: ubuntu-26.04 (Ubuntu 26.04 LTS)" in lines
+    assert "target os: matches this OS" in lines
+    assert capsys.readouterr().err == ""
+
+
+def test_os_release_quoting_is_parsed_shell_style(tmp_path):
+    from nl_shell import os_release as osr
+
+    text = (
+        "# a comment\n"
+        "ID='ubuntu'\n"
+        'VERSION_ID="26.04"\n'
+        'PRETTY_NAME="Ubuntu \\"Plucky\\" \\$x"\n'
+        "not a line\n"
+        "\n"
+    )
+    values = osr.parse(text)
+    assert values["ID"] == "ubuntu"
+    assert values["VERSION_ID"] == "26.04"
+    assert values["PRETTY_NAME"] == 'Ubuntu "Plucky" $x'
+
+
+def test_os_release_falls_back_to_usr_lib(tmp_path):
+    """/etc/os-release missing ⇒ /usr/lib/os-release (os-release(5)). A file fallback."""
+    from nl_shell import os_release as osr
+
+    assert [str(p) for p in osr.PATHS] == ["/etc/os-release", "/usr/lib/os-release"]
+    second = os_release(tmp_path, UBUNTU_2604)
+    assert osr.read([tmp_path / "missing", second])["VERSION_ID"] == "26.04"
+    assert osr.read([tmp_path / "missing"]) == {}
+
+
+# --- (b) no exact match, nothing named ⇒ refused ----------------------------------------
+
+
+@pytest.mark.parametrize(
+    "release_text, detected",
+    [
+        (UBUNTU_2610, "ubuntu 26.10"),  # no near-version fallback
+        (DEBIAN_LIKE_UBUNTU, "debian 26.04"),  # no ID_LIKE fallback
+        ("NAME=Something\n", "unknown unknown"),
+    ],
+)
+def test_no_match_refuses_to_start(
+    monkeypatch, tmp_path, root, capsys, release_text, detected
+):
+    status, out, selection = start(monkeypatch, tmp_path, [], release_text, root)
+    assert status != 0
+    assert selection is None  # the REPL never started
+    err = capsys.readouterr().err
+    assert f"no target matches this OS (detected: {detected})" in err
+    assert "Available targets: ubuntu-26.04." in err
+    assert "--target <id>" in err
+    assert 'target = "<id>"' in err
+    assert str(Path(os.environ["XDG_CONFIG_HOME"]) / "nl-shell" / "config.toml") in err
+
+
+def test_folder_named_like_the_os_must_also_match_in_target_toml(
+    monkeypatch, tmp_path, capsys
+):
+    """`targets/<ID>-<VERSION_ID>` is only the candidate; its match fields must agree."""
+    root = tmp_path / "targets"
+    make_target(root, "ubuntu-26.04", version_id="26.10")
+    status, _, selection = start(monkeypatch, tmp_path, [], UBUNTU_2604, root)
+    assert status != 0
+    assert selection is None
+    assert "no target matches this OS (detected: ubuntu 26.04)" in capsys.readouterr().err
+
+
+# --- (c) --target on a non-matching OS --------------------------------------------------
+
+
+def test_named_target_on_other_os_starts_marked_as_not_matching(
+    monkeypatch, tmp_path, root, capsys
+):
+    status, out, selection = start(
+        monkeypatch, tmp_path, ["--target", "ubuntu-26.04"], DEBIAN_13, root, ":status"
+    )
+    assert status == 0
+    assert selection.target.id == "ubuntu-26.04"
+    assert selection.matches is False
+    assert selection.reason == MISMATCH
+    err = capsys.readouterr().err
+    assert "warning: target does not match this OS" in err
+    assert "debian 13" in err
+    lines = out.splitlines()
+    assert "target: ubuntu-26.04 (Ubuntu 26.04 LTS)" in lines
+    assert "target os: does not match this OS (detected: debian 13)" in lines
+
+
+def test_named_target_that_matches_is_not_degraded(monkeypatch, tmp_path, root, capsys):
+    status, _, selection = start(
+        monkeypatch, tmp_path, ["--target", "ubuntu-26.04"], UBUNTU_2604, root
+    )
+    assert status == 0
+    assert selection.matches is True
+    assert capsys.readouterr().err == ""
+
+
+# --- (d) target = in config.toml; the flag wins ----------------------------------------
+
+
+def test_config_target_behaves_like_the_flag(monkeypatch, tmp_path, root, capsys):
+    write_config('target = "ubuntu-26.04"\nsome_later_key = 1\n')
+    status, out, selection = start(monkeypatch, tmp_path, [], DEBIAN_13, root, ":status")
+    assert status == 0
+    assert selection.target.id == "ubuntu-26.04"
+    assert selection.matches is False
+    assert selection.reason == MISMATCH
+    assert "warning: target does not match this OS" in capsys.readouterr().err
+    assert "target os: does not match this OS (detected: debian 13)" in out.splitlines()
