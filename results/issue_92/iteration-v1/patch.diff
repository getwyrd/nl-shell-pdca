new file mode 100644
index 0000000..fa4fdd0
--- /dev/null
+++ b/src/nl_shell/os_release.py
@@ -0,0 +1,76 @@
+"""Reading os-release(5): which OS release nl-shell runs on.
+
+The file is ``/etc/os-release``, falling back to ``/usr/lib/os-release`` when the first
+does not exist, as os-release(5) specifies. That is a fallback between two copies of the
+same file, not between targets: target selection (``nl_shell.targets``) still compares
+``ID`` and ``VERSION_ID`` exactly.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable
+from pathlib import Path
+
+PATHS: tuple[Path, ...] = (Path("/etc/os-release"), Path("/usr/lib/os-release"))
+
+_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+
+
+def parse(text: str) -> dict[str, str]:
+    """The ``KEY=value`` pairs of an os-release file.
+
+    Values use shell-style quoting (os-release(5)); a line that is not a valid assignment
+    is ignored, as the man page asks of readers.
+    """
+    values: dict[str, str] = {}
+    for raw in text.splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, _, value = line.partition("=")
+        if not _KEY.fullmatch(key):
+            continue
+        unquoted = _unquote(value.strip())
+        if unquoted is not None:
+            values[key] = unquoted
+    return values
+
+
+def _unquote(value: str) -> str | None:
+    """One os-release value without its quoting, or None when it is not valid.
+
+    os-release(5): a value with spaces or special characters is enclosed in double or
+    single quotes, and inside double quotes ``$``, ``"``, ``\\`` and backquote are escaped
+    with a backslash.
+    """
+    if len(value) >= 2 and value[0] == value[-1] == "'":
+        inner = value[1:-1]
+        return None if "'" in inner else inner
+    if len(value) >= 2 and value[0] == value[-1] == '"':
+        inner = value[1:-1]
+        if re.search(r'(?<!\\)(?:\\\\)*"', inner):
+            return None  # an unescaped quote inside: not one quoted value
+        return _ESCAPE.sub(r"\1", inner)
+    if _UNSAFE.search(value):
+        return None
+    return value
+
+
+_ESCAPE = re.compile(r'\\([$"\\`])')
+# Characters that need quoting in an unquoted value.
+_UNSAFE = re.compile(r"[\s'\"`$\\;&|<>()]")
+
+
+def read(paths: Iterable[Path] | None = None) -> dict[str, str]:
+    """The parsed os-release of the first of ``paths`` that exists; empty if none does.
+
+    ``paths`` defaults to ``PATHS``, looked up at call time.
+    """
+    for path in PATHS if paths is None else paths:
+        try:
+            text = Path(path).read_text(encoding="utf-8")
+        except OSError:
+            continue
+        return parse(text)
+    return {}
