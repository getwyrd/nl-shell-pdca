+# --- (h) no OS name in code ------------------------------------------------------------
+
+# The product tagline, not an OS check (brief: an exception the human approves).
+TAGLINE_LINES = {("__init__.py", 1), ("cli.py", 14)}
+
+
+def test_no_os_name_in_code():
+    src = REPO / "src" / "nl_shell"
+    hits = []
+    for path in sorted(src.rglob("*.py")):
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+            if re.search(r"ubuntu|26\.04", line, re.IGNORECASE):
+                if (str(path.relative_to(src)), number) not in TAGLINE_LINES:
+                    hits.append(f"{path.relative_to(REPO)}:{number}: {line.strip()}")
+    assert hits == []
+
