+        "ID=ubuntu\n"
+        'VERSION_ID="26.04"\n'
+        "NAME='Ubuntu Linux'\n"
+        'PRETTY_NAME="say \\"hi\\" \\$HOME \\\\ \\`x\\` it\'s"\n'
+        "SINGLE='no \\\"escapes\\\" here'\n"
+        "EMPTY=\n"
+        'EMPTY_QUOTED=""\n'
+        "BAD=two words\n"
+        'UNBALANCED="open\n'
+        "  INDENTED=yes  \n"
