+
+[[command]]
+names = ["command"]
+flags = ["-p", "-v", "-V"]
+example = "command"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+in_shell = true
+when = { not_option = ["-v", "-V"] }
+
+[[command]]
+names = ["builtin"]
