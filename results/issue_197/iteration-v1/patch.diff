+    result = classify(command)
+    assert (result.cls, result.rejected) == ("mutating", False), result
+    assert has(result, NA), result
+    assert not has(result, CANNOT), result
+    assert not has(result, COULD_NOT), result
+    assert not has(result, SESSION), result
