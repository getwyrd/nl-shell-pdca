new file mode 100644
index 0000000..b6be118
--- /dev/null
+++ b/tests/test_gate_commands.py
@@ -0,0 +1,648 @@
+"""The policy gate's command layer (issue #197, spec ``docs/design/specs/policy-gate/v1.md``
+§3-§5 and §4.1): ``targets/<id>/commands.toml``, its loader, and the engine in
+``nl_shell.gate.rules`` with decisions A and B.
+
+Every case is listed here, not read from ``gate-vectors.toml``. Each asserts the class (or
+a floor), a reason substring, and that no reason is "could not class", so a rejected case
+cannot pass through decision C. The exceptions are named: the missing / invalid table
+cases assert "could not class"; the ten-``env`` and work-budget cases accept the engine's
+reason or "could not class", never a class below the stated one.
+
+``test_floor_cases_are_not_raised`` guards against over-raising: the shell layer's stub
+gives the same answers, so it proves nothing about the engine.
+
+``nl_shell.gate`` is imported inside each test, never at module top.
+"""
+
+from __future__ import annotations
+
+import inspect
+import time
+from pathlib import Path
+
+import pytest
+
+RANK = {
+    "read-only": 0,
+    "mutating": 1,
+    "session-altering": 1,
+    "destructive": 2,
+    "privileged": 3,
+}
+COULD_NOT = "could not class"
+NA = "not allowlisted"
+PRIV = "privileged command"
+DESTR = "destructive command"
+CANNOT = "runs code the gate cannot read"
+PIPE = "pipe, here-doc or here-string into"
+ROOT_SHELL = "interactive root shell"
+SESSION = "session-altering builtin"
+TARGET = "ubuntu-26.04"
+
+
+def classify(command, origin="typed", **kw):
+    import nl_shell.gate
+
+    from nl_shell import render
+
+    result = nl_shell.gate.classify(command, origin=origin, **kw)
+    for reason in result.reasons:  # Rule 6 holds for every reason
+        assert not any(ord(c) < 0x20 or 0x7F <= ord(c) <= 0x9F for c in reason), reason
+        assert not render.has_hidden(reason), reason
+    return result
+
+
+def has(result, needle: str) -> bool:
+    return any(needle in reason for reason in result.reasons)
+
+
+def expect(command, cls, reason, *, origin="typed", rejected=False, at_least=False):
+    """Class ``cls`` (or at least it), a reason holding ``reason``, the given rejection,
+    and no decision C."""
+    result = classify(command, origin)
+    if at_least:
+        assert RANK[result.cls] >= RANK[cls], (command, result)
+    else:
+        assert result.cls == cls, (command, result)
+    assert has(result, reason), (command, result)
+    assert result.rejected is rejected, (command, result)
+    assert not has(result, COULD_NOT), (command, result)
+    return result
+
+
+def expect_rejected(command, reason, *, origin="typed", cls="mutating"):
+    """Rejected, at least ``cls``, a reason holding ``reason``, and no decision C."""
+    result = classify(command, origin)
+    assert result.rejected, (command, result)
+    assert RANK[result.cls] >= RANK[cls], (command, result)
+    assert has(result, reason), (command, result)
+    assert not has(result, COULD_NOT), (command, result)
+    return result
+
+
+# --- §4 privileged -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "sudo apt update",  # row 24
+        "su",
+        "su - root",
+        "pkexec id",
+        "doas id",
+        "run0 id",
+        "machinectl shell",
+        "machinectl shell root@",
+        "//usr/bin/sudo true",
+        "/usr/bin/sudo true",
+    ],
+)
+def test_privileged_commands(command):
+    expect(command, "privileged", PRIV)
+
+
+# --- §4 destructive ------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "rm -rf build",  # row 26
+        '"r"m -rf ~',  # row 17
+        "ls; rm -rf ~",  # row 18
+        "systemctl stop ssh",  # row 29
+        "find . -exec rm {} \\;",  # row 9 (derived: `{}` is a non-literal operand)
+        "find . -execdir rm {} +",
+        "rm -r x",
+        "rm --recursive x",
+        "rm --rec x",  # an abbreviated long option
+        "rm *.o",
+        "rm x -rf",  # GNU argument permutation
+        "dd if=/dev/zero of=/dev/sda",
+        "mkfs.ext4 /dev/sda1",
+        "mkfs -t ext4 /dev/sda1",
+        "wipefs -a /dev/sda",
+        "shred f",
+        "truncate -s 0 f",
+        "fdisk /dev/sda",
+        "chmod -R 777 d",
+        "chown -R u d",
+        "find . -delete",
+        "git clean -fdx",
+        "git reset --hard",
+        "git push --force",
+        "git push -f origin main",
+        "systemctl disable ssh",
+        "systemctl --now mask ssh",
+        "systemctl reboot",
+        "kill -9 -1",
+    ],
+)
+def test_destructive_commands(command):
+    expect(command, "destructive", DESTR)
+
+
+# --- §4 wrappers ---------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "env rm -rf x",  # row 32 (second half)
+        "env A=1 rm -rf x",
+        "nice rm -rf x",
+        "nice -n 5 rm -rf x",
+        "nohup rm -rf x",
+        "timeout 5 rm -rf x",
+        "timeout -k 1 5 rm -rf x",
+        "time rm -rf x",
+        "time -p rm -rf x",
+        "xargs rm -rf x",
+        "watch rm -rf x",
+        "watch -x rm -rf x",
+        "bash -c 'rm -rf x'",
+        "sh -c 'rm -rf x'",
+        "env - rm -rf ~",
+        "find . -exec rm -rf x \\;",
+    ],
+)
+def test_wrappers_take_the_inner_class(command):
+    expect(command, "destructive", DESTR)
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "xargs $c",
+        "xargs -I% % -rf ~",
+        "printf rm | xargs -I% % -rf ~",
+        'find . -exec "$c" {} \\;',
+        "find . -exec {} \\;",
+    ],
+)
+def test_wrappers_with_a_non_literal_inner_command(command):
+    expect(command, "destructive", CANNOT, at_least=True)
+
+
+V2_ELEVATING = [
+    "env - sudo -i",
+    "env 'A=1' sudo -i",
+    "env -a x sudo -i",  # uutils env 0.10.0 takes a value for -a/--argv0
+    "env --argv0 x sudo -i",
+    "env -S 'sudo -i'",
+    "env --split-string='sudo -i'",
+    "exec -a x sudo -i",
+    "nice -n5 sudo -i",
+    "timeout -s9 5 sudo -i",
+    "stdbuf -o0 sudo -i",
+    "setsid sudo -i",
+    "flock /tmp/l sudo -i",
+    "flock /tmp/l -c 'sudo -i'",
+    "script -c 'sudo -i'",
+    "command sudo -i",
+    "builtin command sudo -i",
+    "xargs sudo -i",
+    "find . -exec sudo -i \\;",
+    "bash -c 'sudo -i'",
+    "eval 'sudo -i'",
+    "sudo env bash",
+]
+
+
+@pytest.mark.parametrize("command", V2_ELEVATING)
+def test_wrapped_root_shell_is_rejected(command):
+    expect(command, "privileged", ROOT_SHELL, origin="proposal", rejected=True)
+    # Typed, it is privileged; `xargs` may also append a word such as `-S` to sudo's
+    # options, which is rejected, so the rejection is not asserted here.
+    typed = classify(command)
+    assert typed.cls == "privileged", typed
+    assert has(typed, PRIV) and not has(typed, COULD_NOT), typed
+
+
+def test_ten_nested_envs():
+    # Through the inner command or decision C, never lower.
+    command = "env " * 10 + "sudo -i"
+    proposal = classify(command, "proposal")
+    assert (proposal.cls, proposal.rejected) == ("privileged", True), proposal
+    assert has(proposal, ROOT_SHELL) or has(proposal, COULD_NOT), proposal
+    typed = classify(command)
+    assert typed.cls == "privileged", typed
+    assert has(typed, PRIV) or has(typed, COULD_NOT), typed
+
+
+def test_every_runs_command_at_row_has_a_working_example():
+    from nl_shell.gate import commands
+
+    table = commands.load(TARGET)
+    rows = [row for row in table.rows if row.has("runs-command-at")]
+    assert len(rows) >= 15
+    for row in rows:
+        assert row.example, row.label
+        first = row.example.split()[0]
+        assert table.lookup(first) is row, row.example
+        expect(f"{row.example} rm -rf x", "destructive", DESTR, at_least=True)
+        expect(
+            f"{row.example} sudo -i",
+            "privileged",
+            ROOT_SHELL,
+            origin="proposal",
+            rejected=True,
+        )
+
+
+# --- §5 sudo rules -------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command,reason",
+    [
+        ("sudo -S true", "-S"),  # row 21
+        ("sudo -p x true", "-p"),
+        ("sudo -A true", "-A"),
+        ("sudo --stdin true", "--stdin"),
+        ("sudo --prompt=x true", "--prompt"),
+        ("sudo -nS true", "-S"),
+        ("echo pw | sudo -S true", PIPE),  # row 22
+        ('sudo "-S" true', "-S"),
+        ("sudo $'-S' true", "may be -S"),
+        ('sudo "$P" true', "may be -S"),
+        ("sudo -s <<<x", PIPE),
+        ("printf x | sudo -i", PIPE),
+        ("echo x | sudo -s", PIPE),
+        ("sudo -i <<E\nx\nE", PIPE),
+        ("echo x | sudo tee /etc/x", PIPE),
+        ("sudo tee /etc/x <<<x", PIPE),
+        ("echo x | su", PIPE),
+        ("su <<<x", PIPE),
+        ("echo x | pkexec id", PIPE),
+        ("pkexec id <<E\nx\nE", PIPE),
+        ("echo x | doas id", PIPE),
+        ("doas id <<<x", PIPE),
+        ("cat <<E | sudo tee /x\nx\nE", PIPE),  # v2 regression
+        ("cat <<E | doas id\nx\nE", PIPE),  # v2 regression
+        ("echo x | env sudo tee /x", PIPE),
+    ],
+)
+def test_sudo_rules_reject(command, reason):
+    expect_rejected(command, reason, cls="privileged")
+
+
+@pytest.mark.parametrize(
+    "command", ["sudo -i", "sudo -s", "sudo su", "sudo bash", "su", "pkexec bash"]
+)
+def test_root_shell(command):
+    expect(command, "privileged", ROOT_SHELL, origin="proposal", rejected=True)
+    typed = expect(command, "privileged", PRIV)
+    assert not has(typed, ROOT_SHELL)
+
+
+# --- §3 builtins ---------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "alias ll='ls -l'",  # row 33
+        "unalias ll",
+        "source f",
+        ". f",
+        "eval x",
+        "exec ls",
+        "trap x INT",
+        "enable -n echo",
+        "set -e",
+        "shopt -s nullglob",
+        "bind -x x",
+        "complete -F f x",
+        "hash -r",
+        "builtin echo",
+        "command ls",
+        "export X",
+        "export X=1",
+        "declare A=1",
+        "typeset A=1",
+        "local A=1",
+        "readonly A=1",
+        "unset X",
+    ],
+)
+def test_session_altering_builtins(command):
+    expect(command, "session-altering", SESSION, at_least=True)
+
+
+# --- sets-variable -------------------------------------------------------------------
+
+# Forms with no plain `variable_assignment` node: the shell layer cannot see them.
+SETS = [
+    'export "{}"=x',
+    "declare '{}'=/x",
+    "declare -n r={}; r=/x",
