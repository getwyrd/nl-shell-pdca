+
+[[command]]
+names = ["watch"]
+flags = [
+  "-b", "--beep", "-c", "--color", "-C", "--no-color", "-e", "--errexit", "-g",
+  "--chgexit", "-p", "--precise", "-t", "--no-title", "-w", "--no-wrap", "-x", "--exec",
+  "-r", "--no-rerun", "-h", "--help", "-v", "--version",
+]
+options = ["-n", "--interval", "-q", "--equexit", "-s", "--shotsdir"]
+optional = ["-d", "--differences"]
+example = "watch"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+when = { option = ["-x", "--exec"] }
+
+[[command.effect]]
+type = "runs-text"
+operands_from = 0
+when = { not_option = ["-x", "--exec"] }
+
+[[command]]
+names = ["script"]
+flags = [
+  "-a", "--append", "-e", "--return", "-f", "--flush", "--force", "-q", "--quiet",
+  "-h", "--help", "-V", "--version",
+]
+options = [
+  "-c", "--command", "-E", "--echo", "-B", "--log-io", "-I", "--log-in", "-O",
+  "--log-out", "-T", "--log-timing", "-m", "--logging-format", "-o", "--output-limit",
+]
+optional = ["-t", "--timing"]
+intermix = true
+
+[[command.effect]]
+type = "runs-text"
+option = ["-c", "--command"]
+
+[[command.effect]]
+type = "opens-shell"
