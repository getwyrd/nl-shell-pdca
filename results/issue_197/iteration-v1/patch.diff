+with_rest = true
+
+[[command]]
+names = ["nice"]
+flags = ["--help", "--version"]
+options = ["-n", "--adjustment"]
+numeric = true
+example = "nice"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["nohup"]
+flags = ["--help", "--version"]
+example = "nohup"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["timeout"]
+flags = ["--preserve-status", "-p", "--foreground", "-f", "-v", "--verbose", "--help",
+  "--version"]
+options = ["-s", "--signal", "-k", "--kill-after"]
+example = "timeout 5"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 1
+
+[[command]]
+names = ["time"]
+flags = ["-p"]
+example = "time"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["stdbuf"]
+flags = ["--help", "--version"]
+options = ["-i", "--input", "-o", "--output", "-e", "--error"]
+example = "stdbuf -o0"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["setsid"]
+flags = ["-c", "--ctty", "-f", "--fork", "-w", "--wait", "-h", "--help", "-V",
+  "--version"]
+example = "setsid"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["flock"]
+flags = [
+  "-s", "--shared", "-x", "-e", "--exclusive", "-u", "--unlock", "-n", "--nb",
+  "--nonblock", "-o", "--close", "-F", "--no-fork", "--verbose", "-h", "--help", "-V",
+  "--version",
+]
+options = ["-w", "--wait", "--timeout", "-E", "--conflict-exit-code", "-c", "--command"]
+intermix = true
+example = "flock /tmp/l"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 1
+when = { not_option = ["-c", "--command"] }
+
+[[command.effect]]
+type = "runs-text"
+option = ["-c", "--command"]
+
+[[command]]
+names = ["ionice"]
+flags = ["-t", "--ignore", "-h", "--help", "-V", "--version"]
+options = ["-c", "--class", "-n", "--classdata", "-p", "--pid", "-P", "--pgid", "-u",
+  "--uid"]
+example = "ionice"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["chrt"]
+flags = [
+  "-a", "--all-tasks", "-b", "--batch", "-d", "--deadline", "-e", "--ext", "-f",
+  "--fifo", "-i", "--idle", "-m", "--max", "-o", "--other", "-r", "--rr", "-R",
+  "--reset-on-fork", "-v", "--verbose", "-h", "--help", "-V", "--version",
+]
+options = ["-T", "--sched-runtime", "-P", "--sched-period", "-D", "--sched-deadline"]
+example = "chrt 0"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 1
+
+[[command]]
+names = ["taskset"]
+flags = ["-a", "--all-tasks", "-c", "--cpu-list", "-h", "--help", "-V", "--version"]
+example = "taskset 1"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 1
+
+[[command]]
+names = ["chroot"]
+flags = ["--skip-chdir", "--help", "--version"]
+options = ["--userspec", "--groups"]
