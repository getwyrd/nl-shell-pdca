+        raise CommandsError(f"{path}: unknown top-level key `{extra[0]}`")
+    if doc.get("version") != FORMAT_VERSION:
+        raise CommandsError(f"{path}: `version` must be {FORMAT_VERSION}")
+    entries = doc.get("command")
