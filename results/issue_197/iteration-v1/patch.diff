+@dataclass(frozen=True)
+class Effect:
+    """One effect of a row. Only the keys of its ``type`` are set."""
+
+    type: str
+    when: When = field(default_factory=When)
+    reason: str | None = None
+    operand: int | None = None
+    operands_from: int | None = None
+    option: tuple[str, ...] = ()
+    after_word: tuple[str, ...] = ()
+    until_word: tuple[str, ...] = ()
+    until_after_placeholder: tuple[str, ...] = ()
+    placeholder: str | None = None
+    placeholder_options: tuple[str, ...] = ()
+    appends: bool = False
+    unreadable_inner: bool = False
+    skip_assignments: bool = False
+    in_shell: bool = False
+    with_rest: bool = False
+    source: str | None = None  # sets-variable `from`
+    scope: str = "session"
+    nameref_options: tuple[str, ...] = ()
+    password_options: tuple[str, ...] = ()
+
