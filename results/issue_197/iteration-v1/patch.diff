+    """Make one classification's state current: its origin, work budget, command table,
+    and the gate's entry point for classing text again."""
+    token = _RUN.set(_Run(origin=origin, work=work, table=table, nested=nested))
+    try:
+        yield
+    finally:
+        _RUN.reset(token)
+
+
+def current() -> _Run | None:
+    """The classification in progress (``run``), or None."""
+    return _RUN.get()
+
+
+def load_table(target: str | None = None) -> commands.Table:
+    """The command table of ``target`` (the default target when None). A failure is a
+    ``GateFailure``: decision C for every command."""
+    try:
+        return commands.load(target)
+    except commands.CommandsError:
+        raise parse.GateFailure("commands.toml is missing or invalid") from None
+
+
+def classify(invocation: Invocation) -> Verdict:
     """Class one ``nl_shell.gate.parse.Invocation``."""
-    return Verdict("mutating", (NOT_ALLOWLISTED,))
+    state = _RUN.get()
+    if state is None:
+        from nl_shell import gate
+
+        with run("typed", parse.Work(), load_table(), gate.nested):
+            return _invocation(_RUN.get(), invocation)
+    return _invocation(state, invocation)
+
+
+class _Acc:
+    """Collects one command's class, reasons and rejection (§1: the highest wins)."""
+
+    def __init__(self) -> None:
+        self.rank = -1
+        self.cls = "read-only"
+        self.reasons: list[str] = []
+        self.rejected = False
+        self.opens_shell = False
+
+    def raise_to(self, cls: str, reason: str | None = None) -> None:
+        rank = RANK[cls]
+        if rank > self.rank or (rank == self.rank and cls == "session-altering"):
+            self.rank, self.cls = rank, cls
+        if reason and reason not in self.reasons:
+            self.reasons.append(reason)
+
+    def reject(self, reason: str) -> None:
+        self.rejected = True
+        self.raise_to("mutating", reason)
+
+    def merge(self, verdict: Verdict) -> None:
+        for reason in verdict.reasons or (None,):
+            self.raise_to(verdict.cls, reason)
+        self.rejected = self.rejected or verdict.rejected
+        self.opens_shell = self.opens_shell or verdict.opens_shell
+
+    def verdict(self) -> Verdict:
+        return Verdict(self.cls, tuple(self.reasons), self.rejected, self.opens_shell)
+
+
+def _invocation(state: _Run, invocation: Invocation) -> Verdict:
+    state.work.spend()
+    acc = _Acc()
+    acc.raise_to("mutating", NOT_ALLOWLISTED)
+    if not invocation.words:
+        return acc.verdict()
+    name = command_name(invocation.words[0])
+    row = state.table.lookup(name)
+    if row is None:
+        # A path elsewhere (`/usr/local/bin/sudo`) is not proven to be that command, but
+        # it names it: decision A reads the command word too.
+        _decision_a(state, acc, invocation.words[1:], head=invocation.words[0])
+    else:
+        _apply_row(state, acc, invocation, row, name)
+    return acc.verdict()
+
+
+def _names(word: Word) -> str | None:
+    """The command a word names, after quote removal: its last path component."""
+    if not word.literal or not word.text:
+        return None
+    return word.text.rstrip("/").rpartition("/")[2] or None
+
+
+def _decision_a(state: _Run, acc: _Acc, args, head: Word | None = None) -> None:
+    """Decision A: an opaque command's argument words, after quote removal; and its
+    command word ``head`` when that is a path elsewhere."""
+    for word in (head, *args):
+        name = _names(word) if word is not None else None
+        row = state.table.lookup(name)
+        if row is None:
+            continue
+        what = "command word" if word is head else "argument"
+        if row.has("elevates"):
+            acc.raise_to("privileged", f"{what} names a privileged command: {name}")
+            if state.proposal:
+                acc.reject(f"proposal passes a privileged command to an opaque one: {name}")
+        if row.has("destroys"):
+            acc.raise_to("destructive", f"{what} names a destructive command: {name}")
+
+
+def _nest(state: _Run):
+    state.work.spend()
+    if state.depth >= MAX_NESTING:
+        raise parse.GateFailure("nesting too deep")
+    state.depth += 1
+
+
+def _inner_invocation(state: _Run, invocation: Invocation) -> Verdict:
+    _nest(state)
+    try:
+        return _invocation(state, invocation)
+    finally:
+        state.depth -= 1
+
+
+def _inner_text(state: _Run, text: str, stdin: Stdin) -> Verdict:
+    key = (text, stdin.kind, stdin.value)
+    cached = state.cache.get(key)
+    if cached is not None:
+        state.work.spend()
+        return cached
+    _nest(state)
+    try:
+        verdict = state.nested(text, stdin)
+    finally:
+        state.depth -= 1
+    state.cache[key] = verdict
+    return verdict
+
+
+# --- reading the argv ----------------------------------------------------------------
+
+
+class Substituted(Word):
+    """A word that find or xargs replaces with input (``{}``, the ``-I`` string): its
+    text is not known."""
+
+
+def known_text(word: Word) -> str | None:
+    """The text bash passes for ``word``, or None when the gate cannot know it. A lone
+    ``{}`` is passed as it is (it is no brace expansion)."""
+    if isinstance(word, Substituted):
+        return None
+    if word.literal or word.source == "{}":
+        return word.text
+    return None
+
+
+@dataclass
+class Argv:
+    """A command's arguments read with its row's grammar. ``operands`` holds every
+    positional word, from the stop on too; ``stopped`` says the stop operand was reached.
+    ``unparsed`` (a reason) means the grammar could not read the options."""
+
+    options: list[tuple[str, Word | None]] = field(default_factory=list)
+    operands: list[Word] = field(default_factory=list)
+    stopped: bool = False
+    unparsed: str | None = None
+
+    def has(self, names) -> bool:
+        return any(name in names for name, _ in self.options)
+
+    def values(self, names) -> list[Word | None]:
+        return [value for name, value in self.options if name in names]
+
+
+def _value_word(text: str, word: Word) -> Word:
+    return Word(text=text, literal=word.literal, source=text)
+
+
+def read_argv(row: commands.Row, args, stop: int | None = None) -> Argv:
+    """Read ``args`` with ``row``'s grammar. Option parsing ends at ``--``, at the first
+    operand (unless the row intermixes), and always at operand number ``stop``."""
+    argv = Argv()
+    if row.raw:
+        argv.operands = list(args)
+        return argv
+    longs = sorted(o for o in row.flags | row.options | row.optional if o.startswith("--"))
+    i, n, ended = 0, len(args), False
+    while i < n:
+        word = args[i]
+        positional = ended or (argv.operands and not row.intermix)
+        if not positional and known_text(word) is None:
+            argv.unparsed = argv.unparsed or "an option word is not a literal"
+            positional = True
+        text = word.text
+        if not positional and text == "--" and row.end_of_options:
+            ended = True
+            i += 1
+            continue
+        if positional or not _option_like(row, text):
+            if stop is not None and len(argv.operands) == stop:
+                argv.operands.extend(args[i:])
+                argv.stopped = True
+                return argv
+            argv.operands.append(word)
+            i += 1
+            continue
+        i = _read_option(row, longs, args, i, argv)
+    return argv
+
+
+def _option_like(row: commands.Row, text: str) -> bool:
+    if text == "-":
+        return "-" in row.flags
+    if text.startswith("-") and len(text) > 1:
+        return True
+    return row.plus and text.startswith("+") and len(text) > 1
+
+
+def _read_option(row: commands.Row, longs: list[str], args, i: int, argv: Argv) -> int:
+    word = args[i]
+    text = word.text
+    if text in row.flags or (row.numeric and re.fullmatch(r"-[0-9]+", text)):
+        argv.options.append((text, None))
+        return i + 1
+    if text.startswith("--"):
+        name, eq, value = text.partition("=")
+        candidates = [name] if name in longs else [o for o in longs if o.startswith(name)]
+        kinds = {_kind(row, c) for c in candidates}
+        if not candidates or len(kinds) != 1:
+            argv.unparsed = argv.unparsed or "an option the command table does not list"
+            argv.options.append((name, None))
+            return i + 1
+        kind = kinds.pop()
+        if kind == "flag":
+            if eq:
+                argv.unparsed = argv.unparsed or "a flag given a value"
+            argv.options.extend((c, None) for c in candidates)
+            return i + 1
+        if eq:
+            argv.options.extend((c, _value_word(value, word)) for c in candidates)
+            return i + 1
+        if kind == "optional":
+            argv.options.extend((c, None) for c in candidates)
+            return i + 1
+        if i + 1 < len(args):
+            argv.options.extend((c, args[i + 1]) for c in candidates)
+            return i + 2
+        argv.unparsed = argv.unparsed or "an option with no value"
+        argv.options.extend((c, None) for c in candidates)
+        return i + 1
+    sign, cluster = text[0], text[1:]
+    for j, char in enumerate(cluster):
+        option = sign + char
+        rest = cluster[j + 1 :]
+        if option in row.flags:
+            argv.options.append((option, None))
+            continue
+        if option in row.options:
+            if rest:
+                argv.options.append((option, _value_word(rest, word)))
+                return i + 1
+            if i + 1 < len(args):
+                argv.options.append((option, args[i + 1]))
+                return i + 2
+            argv.unparsed = argv.unparsed or "an option with no value"
+            argv.options.append((option, None))
+            return i + 1
+        if option in row.optional:
+            argv.options.append((option, _value_word(rest, word) if rest else None))
+            return i + 1
+        argv.unparsed = argv.unparsed or "an option the command table does not list"
+        argv.options.append((option, None))
+        return i + 1
+    return i + 1
+
+
+def _kind(row: commands.Row, option: str) -> str:
+    if option in row.flags:
+        return "flag"
+    if option in row.options:
+        return "value"
+    return "optional"
+
+
+def holds(when: commands.When, argv: Argv, args, assume: bool = True) -> bool:
+    """Whether ``when`` holds. A part the gate cannot read is taken to hold (with
+    ``assume=False``: only what the gate can read counts)."""
+    unread = assume and argv.unparsed is not None
+    ops = argv.operands
+    if when.option and not (unread or argv.has(when.option)):
+        return False
+    if when.not_option and not (unread or not argv.has(when.not_option)):
+        return False
+    texts = [known_text(w) for w in args]
+    if not assume:
+        texts = [t for t in texts if t is not None]
+    if when.subcommand and not (
+        unread or (ops and known_text(ops[0]) in (None, *when.subcommand))
+    ):
+        return False
+    if when.word and not any(t is None or t in when.word for t in texts):
+        return False
+    if when.word_matches is not None and not any(
+        t is None or when.word_matches.fullmatch(t) for t in texts
+    ):
+        return False
+    if when.not_word and not (unread or not any(t in when.not_word for t in texts)):
+        return False
+    if when.no_operands and not (unread or not ops):
+        return False
+    if when.has_operands and not (unread or ops):
+        return False
+    if when.operand_nonliteral and not (unread or any(known_text(w) is None for w in ops)):
+        return False
+    return True
+
+
+# --- applying a row ------------------------------------------------------------------
+
+
+def _apply_row(state: _Run, acc: _Acc, invocation: Invocation, row, name: str) -> None:
+    args = invocation.words[1:]
+    stops = [
+        e.operand
+        for e in row.effects
+        if e.type == "runs-command-at" and e.operand is not None
+    ]
+    argv = read_argv(row, args, min(stops) if stops else None)
+    fired = [e for e in row.effects if holds(e.when, argv, args)]
+    elevated = False
+    for effect in fired:
+        handler = _HANDLERS[effect.type]
+        if handler(state, acc, invocation, row, name, effect, argv, args):
+            elevated = True
+    # §5: an elevating command that opens a shell, itself or through its inner command.
+    if elevated and acc.opens_shell and state.proposal:
+        acc.reject(ROOT_SHELL)
+
+
+def _elevates(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    acc.raise_to("privileged", f"privileged command: {name}")
+    if invocation.stdin.kind in _PIPED:
+        unplaced = ""
+        if invocation.stdin.kind == "unknown":
+            unplaced = ": its input cannot be placed"
+        acc.reject(f"pipe, here-doc or here-string into {name}{unplaced}")
+    for option in effect.password_options:
+        if argv.has((option,)):
+            acc.reject(
+                f"{name} {option} is rejected: the password would leave the terminal"
+            )
+    if argv.unparsed and effect.password_options:
+        acc.reject(
+            f"{name}: {argv.unparsed}; it may be "
+            f"{'/'.join(effect.password_options)}, which are rejected"
+        )
+    return True
+
+
+def _destroys(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    detail = f" ({effect.reason})" if effect.reason else ""
+    if effect.reason and argv.unparsed and not holds(effect.when, argv, args, assume=False):
+        detail = f" (may be {effect.reason}: {argv.unparsed})"
+    acc.raise_to("destructive", f"destructive command: {name}{detail}")
+    return False
+
+
+def _opens_shell(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    acc.opens_shell = True
+    return False
+
+
+def _reads_terminal(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    # Data for the terminal-read rule, which #198 applies; no class here.
+    return False
+
+
+def _in_shell(acc: _Acc, effect, name: str) -> None:
+    if effect.in_shell:
+        acc.raise_to("session-altering", f"session-altering builtin: {name}")
+
+
+def _unreadable(acc: _Acc, detail: str) -> None:
+    acc.raise_to("destructive", f"{CANNOT_READ}: {detail}")
+
+
+def _runs_command(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    _in_shell(acc, effect, name)
+    if argv.unparsed:
+        _unreadable(acc, f"cannot tell which command {name} runs ({argv.unparsed})")
+        _decision_a(state, acc, args)
+        return False
+    if effect.operand is not None:
+        segments = [argv.operands[effect.operand :]] if argv.stopped else []
+    elif any(known_text(w) is None for w in args):
+        # A word that is not a literal may be `-exec`, or the `;` that ends one.
+        _unreadable(acc, f"{name} has a word that may start or end a command")
+        _decision_a(state, acc, args)
+        return False
+    else:
+        segments = list(_segments(effect, args))
+    placeholder = _placeholder(effect, argv)
+    for words in segments:
+        words = list(words)
+        if effect.skip_assignments:
+            # `NAME=value` words before the command (sets-variable checks the names).
+            while words and words[0].literal and _ASSIGNMENT.fullmatch(words[0].text):
+                words.pop(0)
+        if placeholder is not None:
+            words = [_mark(w, placeholder) for w in words]
+        if not words:
+            continue
+        if effect.appends and placeholder is None:
+            words.append(Word(text="", literal=False, source=""))
+        head = words[0]
+        if known_text(head) is None:
+            acc.raise_to("mutating", f"command word is not a literal: {head.source}")
+            if effect.unreadable_inner:
+                _unreadable(acc, f"{name} runs a command word that is not a literal")
+        elif "/" in head.text and not system_path(head.text):
+            acc.raise_to(
+                "mutating",
+                f"command word is a path outside the system directories: {head.text}",
+            )
+        inner = replace(invocation, words=tuple(words), assignments=(), redirects=())
+        acc.merge(_inner_invocation(state, inner))
+    return False
+
+
+def _segments(effect, args) -> Iterator[list[Word]]:
+    i, n = 0, len(args)
+    while i < n:
+        if args[i].literal and args[i].text in effect.after_word:
+            start = i + 1
+            j = start
+            while j < n:
+                text = args[j].text if args[j].literal else None
+                if text in effect.until_word:
+                    break
+                if (
+                    text in effect.until_after_placeholder
+                    and j > start
+                    and effect.placeholder
+                    and effect.placeholder in args[j - 1].text
+                ):
+                    break
+                j += 1
+            yield list(args[start:j])
+            i = j + 1
+        else:
+            i += 1
+
+
+_ANY = object()  # placeholder value the gate cannot read: every word may hold it
+
+
+def _placeholder(effect, argv: Argv):
+    if effect.placeholder_options and argv.has(effect.placeholder_options):
+        values = argv.values(effect.placeholder_options)
+        value = values[-1]
+        if value is None:
+            return effect.placeholder or "{}"
+        if not value.literal or not value.text:
+            return _ANY
+        return value.text
+    return effect.placeholder
+
+
+def _mark(word: Word, placeholder) -> Word:
+    if placeholder is _ANY or placeholder in word.text:
+        return Substituted(text=word.text, literal=False, source=word.source)
+    return word
+
+
+def _text_words(effect, argv: Argv) -> list[list[Word]]:
+    if effect.operand is not None:
+        if len(argv.operands) > effect.operand:
+            return [[argv.operands[effect.operand]]]
+        return []
+    if effect.operands_from is not None:
+        words = argv.operands[effect.operands_from :]
+        return [words] if words else []
+    out = []
+    for value in argv.values(effect.option):
+        if value is None:
+            continue
+        out.append([value, *argv.operands] if effect.with_rest else [value])
+    return out
+
+
+def _runs_text(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    _in_shell(acc, effect, name)
+    if argv.unparsed:
+        _unreadable(acc, f"{name} ({argv.unparsed})")
+        return False
+    for words in _text_words(effect, argv):
+        if not all(w.literal for w in words):
+            _unreadable(acc, f"{name} runs text that is not a literal")
+            continue
+        text = " ".join(w.text for w in words)
+        acc.merge(_inner_text(state, text, invocation.stdin))
+    return False
+
+
+def _from_stdin(state, acc, invocation, name: str) -> None:
+    stdin = invocation.stdin
+    if stdin.kind == "terminal":
+        return  # an interactive shell: the user types it (opens-shell)
+    if stdin.kind == "literal" and stdin.value is not None:
+        # The code's own commands read what is left of it: not proven, so unknown.
+        acc.merge(_inner_text(state, stdin.value, parse.UNKNOWN))
+        return
+    where = {"pipe": "a pipe", "file": "a file"}.get(stdin.kind, "an input it cannot place")
+    _unreadable(acc, f"{name} reads code from {where}")
+
+
+def _runs_stdin(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    _from_stdin(state, acc, invocation, name)
+    return False
+
+
+def _runs_file(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    _in_shell(acc, effect, name)
+    if argv.unparsed:
+        _unreadable(acc, f"{name} ({argv.unparsed})")
+        return False
+    if effect.operand is not None:
+        files = argv.operands[effect.operand : effect.operand + 1]
+    else:
+        files = [v for v in argv.values(effect.option) if v is not None]
+    for word in files:
+        if word.literal and re.sub(r"/+", "/", word.text) in _STDIN_FILES:
+            _from_stdin(state, acc, invocation, name)
+        else:
+            _unreadable(acc, f"{name} runs the file {word.source}")
+    return False
+
+
+# --- sets-variable -------------------------------------------------------------------
+
+
+def _name_check(state: _Run, acc: _Acc, name: str | None, scope: str) -> None:
+    """One variable a command may assign. None: a name the gate cannot read."""
+    if name is None:
+        acc.reject("assignment to a variable the gate cannot name")
+        return
+    if name in SUDO_REJECTED:
+        acc.reject(f"assignment to {name} is rejected")
+    elif scope == "command":
+        acc.raise_to("mutating", f"assignment for one command: {name}")
+    elif is_session_name(name):
+        acc.raise_to("session-altering", f"assignment to {name}")
+
+
+def _target(text: str, acc: _Acc, cmd: str) -> str | None:
+    """The variable name in ``text`` (``NAME``, ``NAME[sub]``), or None. A subscript with
+    an expansion in it runs code (bash expands it again)."""
+    match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)(\[.*\])?", text, re.DOTALL)
+    if match is None:
+        return None
+    if match.group(2) and any(c in match.group(2) for c in "$`"):
+        _unreadable(acc, f"{cmd} assigns through a subscript with an expansion")
+    return match.group(1)
+
+
+def _assignment(word: Word) -> tuple[bool, str | None, Word | None]:
+    """Whether ``word`` is (or may be) an assignment ``NAME=value``; its name (None when
+    the gate cannot read it) and its value."""
+    if word.literal:
+        match = _ASSIGNMENT.fullmatch(word.text)
+        if match is None:
+            return False, None, None
+        value = match.group(3)
+        return True, match.group(1) + (match.group(2) or ""), Word(value, True, value)
+    # Bash expands the word first and the builtin reads the result: it may assign
+    # anything, unless the part before the `=` is a literal name.
+    eq = word.source.find("=")
+    if eq > 0:
+        head, causes = parse.lex_word(word.source[:eq])
+        if not causes and _IDENT.fullmatch(head.split("[", 1)[0]):
+            text, rest_causes = parse.lex_word(word.source[eq + 1 :])
+            return True, head, Word(text, not rest_causes, word.source[eq + 1 :])
+    return True, None, None
+
+
+def _sets_variable(state, acc, invocation, row, name, effect, argv, args) -> bool:
+    source, scope = effect.source, effect.scope
+    if source == "state":
+        acc.raise_to("session-altering", f"session-altering builtin: {name}")
+        return False
+    candidates: list[Word] = []
+    if source in ("assignments", "leading-assignments"):
+        nameref = bool(effect.nameref_options) and (
+            argv.has(effect.nameref_options) or argv.unparsed is not None
+        )
+        for word in argv.operands:
+            is_assignment, target, value = _assignment(word)
+            if not is_assignment:
+                if source == "leading-assignments":
+                    break
+                if nameref:
+                    _name_check(state, acc, None, scope)  # a nameref with no target yet
+                continue
+            _name_check(state, acc, _target(target, acc, name) if target else None, scope)
+            if nameref:
+                if value is None or not value.literal:
+                    _name_check(state, acc, None, scope)
+                else:
+                    _name_check(state, acc, _target(value.text, acc, name), scope)
+        return False
+    if argv.unparsed is not None:
+        # The option may be any word: every later word may be the name.
+        candidates = list(args)
+    elif source == "operands":
+        candidates = list(argv.operands)
+    elif source == "operand":
+        candidates = argv.operands[effect.operand : effect.operand + 1]
+    elif source == "option":
+        candidates = [v for v in argv.values(effect.option) if v is not None]
+    elif source == "arithmetic":
+        for word in argv.operands:
+            if not word.literal or any(c in word.text for c in "$`"):
+                _unreadable(acc, f"{name} evaluates text with an expansion in it")
+                if not word.literal:
+                    _name_check(state, acc, None, scope)
+                continue
+            for target in _IDENT.findall(word.text):
+                _name_check(state, acc, target, scope)
+        return False
+    for word in candidates:
+        if not word.literal:
+            _name_check(state, acc, None, scope)
+            continue
+        target = _target(word.text, acc, name)
+        if target is not None:  # a literal that is no name assigns nothing
+            _name_check(state, acc, target, scope)
+    return False
+
+
+_HANDLERS = {
+    "runs-command-at": _runs_command,
+    "runs-text": _runs_text,
+    "runs-stdin-as-code": _runs_stdin,
+    "runs-file-as-code": _runs_file,
+    "sets-variable": _sets_variable,
+    "elevates": _elevates,
+    "destroys": _destroys,
+    "reads-terminal": _reads_terminal,
+    "opens-shell": _opens_shell,
+}
+assert set(_HANDLERS) == set(commands.EFFECTS)
