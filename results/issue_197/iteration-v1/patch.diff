+
+def test_sets_variable_names_the_gate_cannot_read():
+    for command in ('export "$n"=x', 'read "$n"', "declare -n r", 'printf -v "$n" x'):
+        expect_rejected(command, "a variable the gate cannot name")
+    for command in ("env SUDO_ASKPASS=/x sudo -A true", "sudo SUDO_PROMPT=x true"):
+        expect_rejected(command, "SUDO_")
+    expect("let 'a[$(rm -rf ~)]=1'", "destructive", CANNOT)
