+def test_real_table_loads():
+    from nl_shell.gate import commands
+
+    table = commands.load(TARGET)
+    assert table is commands.load(TARGET)  # cached while the file is unchanged
+    types = {effect.type for row in table.rows for effect in row.effects}
+    assert types == set(commands.EFFECTS)
+    for name in ("sudo", "su", "pkexec", "doas", "run0", "machinectl"):
+        assert table.lookup(name).has("elevates"), name
+    for name in ("rm", "dd", "mkfs", "mkfs.ext4", "wipefs", "shred", "truncate", "git"):
+        assert table.lookup(name).has("destroys"), name
+    assert table.lookup("ls") is None
+    assert table.lookup("mkfsx") is None
+
