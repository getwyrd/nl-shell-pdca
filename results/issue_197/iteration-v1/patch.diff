+
+[[command.effect]]
+type = "runs-command-at"
+operand = 1
+
+[[command]]
+names = ["unshare"]
+flags = [
+  "-f", "--fork", "-r", "--map-root-user", "-c", "--map-current-user", "--kill-child",
+  "--keep-caps", "-h", "--help", "-V", "--version",
+]
+optional = [
+  "-m", "--mount", "-u", "--uts", "-i", "--ipc", "-n", "--net", "-p", "--pid", "-U",
+  "--user", "-C", "--cgroup", "-T", "--time",
+]
+options = ["-R", "--root", "-w", "--wd", "-S", "--setuid", "-G", "--setgroups",
+  "--propagation", "--map-user", "--map-group"]
+example = "unshare"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command]]
+names = ["xargs"]
+flags = [
+  "-0", "--null", "-o", "--open-tty", "-p", "--interactive", "-r", "--no-run-if-empty",
+  "-t", "--verbose", "-x", "--exit", "--show-limits", "--help", "--version",
+]
+options = [
+  "-a", "--arg-file", "-d", "--delimiter", "-E", "-I", "-L", "--max-lines", "-n",
+  "--max-args", "-P", "--max-procs", "-s", "--max-chars", "--process-slot-var",
+]
+optional = ["-e", "--eof", "-i", "--replace", "-l"]
