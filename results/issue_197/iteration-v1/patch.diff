@@ -0,0 +1,452 @@
+"""Loading a target's command table, ``targets/<id>/commands.toml`` (issue #197).
+
+Spec ``policy-gate/v1`` §4.1. Each ``[[command]]`` row gives one command's argv grammar
+(which options take a value, where the options end) and its effects, from one fixed set
+(``EFFECTS``). The engine in ``nl_shell.gate.rules`` reads the rows; it has no code path
+for a particular command. A command with no row is opaque (decision A).
+
+The file is read from one place only: ``nl_shell.targets.TARGETS_ROOT / <id> /
+commands.toml``. The loader takes no path, reads no environment variable, config file,
+working directory or home directory, and refuses a file that resolves outside
+``TARGETS_ROOT`` (as ``nl_shell.targets.load`` does). Anyone who can write that folder can
+also write the gate's code, so the file is not signed (threat model: code running as the
+user is out of scope).
+
+The loader follows ``nl_shell.targets.load``: it validates everything and raises
+``CommandsError`` naming the file and the row. The gate turns that into decision C.
+"""
+
+from __future__ import annotations
+
+import re
+import tomllib
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from nl_shell import targets
+
+COMMANDS_FILE = "commands.toml"
+FORMAT_VERSION = 1
+EFFECTS = (
+    "runs-command-at",
+    "runs-text",
+    "runs-stdin-as-code",
+    "runs-file-as-code",
+    "sets-variable",
+    "elevates",
+    "destroys",
+    "reads-terminal",
+    "opens-shell",
+)
+VARIABLE_SOURCES = (
+    "assignments",
+    "leading-assignments",
+    "operands",
+    "operand",
+    "option",
+    "arithmetic",
+    "state",
+)
+SCOPES = ("session", "command")
+
+_ROW_KEYS = frozenset(
+    (
+        "names",
+        "name_prefixes",
+        "flags",
+        "options",
+        "optional",
+        "numeric",
+        "plus",
+        "intermix",
+        "raw",
+        "end_of_options",
+        "example",
+        "effect",
+    )
+)
+_WHEN_KEYS = frozenset(
+    (
+        "option",
+        "not_option",
+        "subcommand",
+        "word",
+        "word_matches",
+        "not_word",
+        "no_operands",
+        "has_operands",
+        "operand_nonliteral",
+    )
+)
+_COMMON_KEYS = frozenset(("type", "when", "reason"))
+# The keys each effect type takes, besides type/when/reason.
+_EFFECT_KEYS = {
+    "runs-command-at": frozenset(
+        (
+            "operand",
+            "after_word",
+            "until_word",
+            "until_after_placeholder",
+            "placeholder",
+            "placeholder_options",
+            "appends",
+            "unreadable_inner",
+            "skip_assignments",
+            "in_shell",
+        )
+    ),
+    "runs-text": frozenset(("operand", "operands_from", "option", "with_rest", "in_shell")),
+    "runs-stdin-as-code": frozenset(()),
+    "runs-file-as-code": frozenset(("operand", "option", "in_shell")),
+    "sets-variable": frozenset(("from", "operand", "option", "scope", "nameref_options")),
+    "elevates": frozenset(("password_options",)),
+    "destroys": frozenset(()),
+    "reads-terminal": frozenset(()),
+    "opens-shell": frozenset(()),
+}
+_NAME = re.compile(r"[A-Za-z0-9_.+\[-][A-Za-z0-9_.+-]*")
+_OPTION = re.compile(r"(--?|\+)[A-Za-z0-9?][A-Za-z0-9_.-]*|-")
+
+
+class CommandsError(Exception):
+    """The command table could not be loaded; the message names the row."""
+
+
+@dataclass(frozen=True)
+class When:
+    """A condition on the argv. Every key given must hold; an effect with no ``when``
+    always holds."""
+
+    option: tuple[str, ...] = ()
+    not_option: tuple[str, ...] = ()
+    subcommand: tuple[str, ...] = ()
+    word: tuple[str, ...] = ()
+    word_matches: re.Pattern | None = None
+    not_word: tuple[str, ...] = ()
+    no_operands: bool = False
+    has_operands: bool = False
+    operand_nonliteral: bool = False
