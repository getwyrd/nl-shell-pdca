+def test_load_location_is_fixed(tmp_path, monkeypatch):
+    from nl_shell import targets
+    from nl_shell.gate import commands
+
+    # The loader takes no path and reads nothing but TARGETS_ROOT/<id>/commands.toml.
+    params = inspect.signature(commands.load).parameters
+    assert list(params) == ["target_id"], params
+    source = inspect.getsource(commands)
+    for forbidden in ("os.environ", "getenv", "Path.cwd", "Path.home", "expanduser"):
+        assert forbidden not in source, forbidden
+    assert commands.load(TARGET).path == targets.TARGETS_ROOT / TARGET / "commands.toml"
+
+    # A table declaring sudo harmless in the cwd, and in every folder an environment
+    # variable could point at, changes nothing.
+    decoy = tmp_path / "decoy"
+    for folder in (decoy, decoy / TARGET, decoy / "nl-shell", decoy / "nl-shell" / TARGET):
+        folder.mkdir(parents=True, exist_ok=True)
+        (folder / "commands.toml").write_text(HARMLESS, encoding="utf-8")
+    (tmp_path / "commands.toml").write_text(HARMLESS, encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("NL_SHELL_COMMANDS", str(decoy / "commands.toml"))
+    monkeypatch.setenv("NL_SHELL_TARGETS", str(decoy))
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(decoy))
+    monkeypatch.setenv("HOME", str(decoy))
+    expect("sudo -i", "privileged", PRIV)
+    expect("sudo -i", "privileged", ROOT_SHELL, origin="proposal", rejected=True)
+    expect("rm -rf x", "destructive", DESTR)
+
