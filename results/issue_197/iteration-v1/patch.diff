+  "-t", "-u", "-v", "-x", "-B", "-C", "-E", "-H", "-P", "-T", "--login", "--noprofile",
+  "--norc", "--posix", "--restricted", "--verbose", "--version", "--help",
+  "--noediting", "--debugger", "--dump-strings", "--dump-po-strings", "--pretty-print",
+  "+a", "+b", "+e", "+f", "+h", "+k", "+m", "+n", "+p", "+u", "+v", "+x", "+B", "+C",
+  "+E", "+H", "+P", "+T",
