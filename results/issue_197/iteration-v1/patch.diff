+++ b/targets/ubuntu-26.04/commands.toml
@@ -0,0 +1,832 @@
+# The policy gate's command table for the ubuntu-26.04 target
+# (docs/design/specs/policy-gate/v1.md §4.1). Loaded by nl_shell.gate.commands; the engine in
+# nl_shell.gate.rules interprets the rows. A command with no row is opaque (decision A).
+#
+# Rows are reviewed like allowlist entries: adding a row or an effect raises classes (a
+# compatible change within v1, reviewed by a human); removing a row or an effect, or
+# narrowing a condition, can lower a class, so it is a v2 change (spec Versioning).
+#
+# Row keys
+#   names          the command words this row is for (a system-directory path to one of
+#                  them, `/usr/bin/sudo`, is the same command)
+#   name_prefixes  command words starting with one of these (`mkfs.` for mkfs.ext4, ...)
+#   flags          options without a value
+#   options        options with a value: `-o V`, `-oV`, `--opt V`, `--opt=V`
+#   optional       options whose value is only ever attached: `-oV`, `--opt=V`
+#   numeric        `-<digits>` is a flag (`nice -5`)
+#   plus           `+x` words are options too (`set +o`, `declare +x`)
+#   intermix       options may follow operands (GNU argument permutation); otherwise the
+#                  options end at the first operand
+#   raw            no option grammar: every argument is an operand
+#   end_of_options `--` ends the options (default true)
+#   example        a minimal prefix in front of an inner command (required with
+#                  runs-command-at; tests/test_gate_commands.py runs `<example> rm -rf x`
+#                  and `<example> sudo -i` through the gate)
+#
+# A long option may be abbreviated (`--rec`): every listed option it may stand for is taken
+# as given. An option not listed, or a word in option position that is not a literal, means
+# the argv cannot be read: every condition of the row is then taken to hold.
+#
+# Effects ([[command.effect]], `type` from this fixed set; optional `when`, `reason`)
+#   runs-command-at     an inner command starts at `operand = N` (the Nth operand), or after
+#                       one of `after_word` up to one of `until_word` (or one of
+#                       `until_after_placeholder` right after the placeholder). The inner
+#                       command is classed as a command of its own, with this command's
+#                       stdin. `placeholder` / `placeholder_options` (the option's value, or
+#                       `{}`): words holding it are not literals. `appends`: operands read
+#                       from stdin are appended (a non-literal operand). `unreadable_inner`:
+#                       a non-literal inner command word is at least destructive (§4).
+#                       `skip_assignments`: `NAME=value` words come before the command.
+#   runs-text           runs shell text: `operand = N`, the operands from `operands_from = N`
+#                       joined by spaces, or the value of `option`; `with_rest` appends the
+#                       operands. Literal text is classed again; other text is decision B.
+#   runs-stdin-as-code  runs its stdin as shell code: a literal here-doc or here-string is
+#                       classed again; a pipe, a file or an unknown stdin is decision B.
+#   runs-file-as-code   runs a file (`operand = N` or `option`) as code: decision B, except
+#                       /dev/stdin, which is runs-stdin-as-code.
+#   sets-variable       assigns variables, named by `from`: `assignments` (each NAME=value
+#                       operand; `nameref_options` make the value a name too),
+#                       `leading-assignments` (NAME=value operands before the command),
+#                       `operands`, `operand` (with `operand = N`), `option` (the values of
+#                       `option`), `arithmetic` (every name in the expressions), or `state`
+#                       (shell state other than one named variable: always
+#                       session-altering). `scope`: `session` (default) or `command`.
+#                       SUDO_PROMPT / SUDO_ASKPASS, or a name the gate cannot read, is
+#                       rejected (§5); a §3 name is session-altering in session scope.
+#   elevates            privileged; a pipe, here-doc or here-string into it is rejected, and
+#                       so is any of `password_options` (§5).
+#   destroys            at least destructive.
+#   reads-terminal      reads the terminal when given no input (the terminal-read rule, #198).
+#   opens-shell         opens an interactive shell; with elevates (here or in the inner
+#                       command), a model proposal is rejected (§5).
+#   `in_shell = true` on a runs-* effect: it runs in the current shell (session-altering).
+#
+# Conditions (`when`; every key given must hold)
+#   option / not_option   one of these options is (not) given
+#   subcommand            the first operand is one of these
+#   word / word_matches   some argument word is one of these / matches this pattern
+#   not_word              no argument word is one of these
+#   no_operands / has_operands / operand_nonliteral
+
+version = 1
+
+# --- sudo family (§4 privileged, §5) -------------------------------------------------------
+
+[[command]]
+names = ["sudo", "sudoedit"]
+flags = [
+  "-A", "--askpass", "-b", "--background", "-B", "--bell", "-E", "-e", "--edit",
+  "-H", "--set-home", "-h", "--help", "-i", "--login", "-K", "--remove-timestamp",
+  "-k", "--reset-timestamp", "-l", "--list", "-n", "--non-interactive", "-P",
+  "--preserve-groups", "-S", "--stdin", "-s", "--shell", "-V", "--version", "-v",
+  "--validate", "-N", "--no-update",
+]
+options = [
+  "-C", "--close-from", "-D", "--chdir", "-g", "--group", "-p", "--prompt", "-R",
+  "--chroot", "-r", "--role", "-t", "--type", "-T", "--command-timeout", "-U",
+  "--other-user", "-u", "--user",
+]
+optional = ["--preserve-env", "--host"]
+example = "sudo"
+
+[[command.effect]]
+type = "elevates"
+password_options = ["-S", "--stdin", "-A", "--askpass", "-p", "--prompt"]
+
+[[command.effect]]
+type = "sets-variable"
+from = "leading-assignments"
+scope = "command"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+skip_assignments = true
+
+[[command.effect]]
+type = "opens-shell"
+when = { option = ["-i", "--login", "-s", "--shell"], no_operands = true }
+
+[[command]]
+names = ["su"]
+flags = [
+  "-", "-l", "--login", "-m", "-p", "--preserve-environment", "-P", "--pty", "-f",
+  "--fast", "-h", "--help", "-V", "--version",
+]
+options = [
+  "-c", "--command", "--session-command", "-g", "--group", "-G", "--supp-group",
+  "-s", "--shell", "-w", "--whitelist-environment",
+]
+intermix = true
+
+[[command.effect]]
+type = "elevates"
+
+[[command.effect]]
+type = "runs-text"
+option = ["-c", "--command", "--session-command"]
+
+[[command.effect]]
+type = "opens-shell"
+when = { not_option = ["-c", "--command", "--session-command"] }
+
+[[command]]
+names = ["pkexec"]
+flags = ["--disable-internal-agent", "--keep-cwd", "--help", "--version"]
+options = ["-u", "--user"]
+example = "pkexec"
+
+[[command.effect]]
+type = "elevates"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command.effect]]
+type = "opens-shell"
+when = { no_operands = true }
+
+[[command]]
+names = ["doas"]
+flags = ["-n", "-s", "-L"]
+options = ["-u", "-C"]
+example = "doas"
+
+[[command.effect]]
+type = "elevates"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command.effect]]
+type = "opens-shell"
+when = { option = ["-s"] }
+
+[[command.effect]]
+type = "opens-shell"
+when = { no_operands = true }
+
+[[command]]
+names = ["run0"]
+flags = [
+  "--no-ask-password", "--pty", "--pipe", "--via-shell", "-i", "--empower", "-h",
+  "--help", "--version",
+]
+options = [
+  "-u", "--user", "-g", "--group", "-D", "--chdir", "--nice", "--setenv", "--property",
+  "--description", "--slice", "--slice-inherit", "--unit", "--machine", "--background",
+  "--shell-prompt-prefix", "--area",
+]
+example = "run0"
+
+[[command.effect]]
+type = "elevates"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command.effect]]
+type = "opens-shell"
+when = { no_operands = true }
+
+[[command]]
+names = ["machinectl"]
+flags = [
+  "-a", "--all", "-l", "--full", "--value", "--no-pager", "--no-legend",
+  "--no-ask-password", "-q", "--quiet", "--read-only", "--mkdir", "--now", "--force",
+  "-h", "--help", "--version",
+]
+options = [
+  "-p", "--property", "--kill-whom", "-s", "--signal", "--uid", "-E", "--setenv",
+  "-H", "--host", "-M", "--machine", "-o", "--output", "--verify", "--format",
+  "-n", "--lines", "--max-addresses",
+]
+intermix = true
+example = "machinectl shell .host"
+
+[[command.effect]]
+type = "elevates"
+when = { subcommand = ["shell", "login"] }
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 2
+when = { subcommand = ["shell"] }
+
+[[command.effect]]
+type = "opens-shell"
+when = { subcommand = ["shell", "login"] }
+
+[[command]]
+names = ["systemd-run"]
+flags = [
+  "--user", "--system", "--scope", "-r", "--remain-after-exit", "--send-sighup", "-P",
+  "--pipe", "-t", "--pty", "-q", "--quiet", "-G", "--collect", "--wait", "-S",
+  "--shell", "--no-block", "--no-ask-password", "-h", "--help", "--version",
+]
+options = [
+  "-u", "--unit", "-p", "--property", "--description", "--slice", "--uid", "--gid",
+  "--nice", "--working-directory", "-E", "--setenv", "--on-active", "--on-boot",
+  "--on-startup", "--on-unit-active", "--on-unit-inactive", "--on-calendar",
+  "--timer-property", "--path-property", "--socket-property", "-H", "--host", "-M",
+  "--machine", "--service-type",
+]
+example = "systemd-run --user"
+
+[[command.effect]]
+type = "elevates"
+when = { not_option = ["--user"] }
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+
+[[command.effect]]
+type = "opens-shell"
+when = { option = ["-S", "--shell"] }
+
+# --- wrappers (§4: classed by their inner command) -----------------------------------------
+
+[[command]]
+names = ["env"]
+flags = [
+  "-", "-i", "--ignore-environment", "-0", "--null", "-v", "--debug",
+  "--list-signal-handling", "--help", "--version",
+]
+# uutils env 0.10.0 on this target takes a value for -a/--argv0.
+options = ["-u", "--unset", "-C", "--chdir", "-S", "--split-string", "-a", "--argv0"]
+optional = ["--block-signal", "--default-signal", "--ignore-signal"]
+example = "env"
+
+[[command.effect]]
+type = "sets-variable"
+from = "leading-assignments"
+scope = "command"
+
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+skip_assignments = true
+when = { not_option = ["-S", "--split-string"] }
+
+[[command.effect]]
+type = "runs-text"
