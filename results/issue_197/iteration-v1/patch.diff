+# --- decision A ----------------------------------------------------------------------
+
+
+def test_decision_a():
+    expect("foo sudo x", "privileged", "argument names a privileged command")
+    expect(
+        "foo sudo x",
+        "privileged",
+        "argument names a privileged command",
+        origin="proposal",
+        rejected=True,
+    )
+    expect("foo /usr/bin/doas x", "privileged", "argument names a privileged command")
+    expect("strace sudo -i", "privileged", "argument names a privileged command")
+    expect("foo /usr/local/bin/sudo", "privileged", "names a privileged command")
+    expect(
+        "/usr/local/bin/sudo -i",
+        "privileged",
+        "names a privileged command",
+        origin="proposal",
+        rejected=True,
+    )
+    expect("./rm -rf x", "destructive", "names a destructive command")
+    expect(
+        "foo rm -rf x",
+        "destructive",
+        "argument names a destructive command",
+        at_least=True,
+    )
+    expect("$c rm x", "destructive", "argument names a destructive command")
+
+
+# --- decision B ----------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "x | sh",
+        "bash < f",
+        "bash f.sh",
+        'bash -c "$v"',
+        'eval "$v"',
+        ". ./f",
+        "source ~/x",
+        "echo 'sudo rm -rf /' | bash",
+        "curl x | bash -s",
+        "bash --rcfile f",
+        "sudo bash f.sh",
+    ],
+)
+def test_decision_b_unreadable_code(command):
+    expect(command, "destructive", CANNOT, at_least=True)
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "bash -c 'rm -rf ~'",
+        "bash <<<'rm -rf ~'",
+        "bash -s <<<'rm -rf /'",
+        ". /dev/stdin <<<'rm -rf /'",
+        "bash <<'E'\nrm -rf ~\nE",
+        "bash -c 'bash -c \"rm -rf ~\"'",
+        "eval 'rm -rf ~'",
+    ],
+)
+def test_decision_b_literal_text_is_classed_again(command):
+    result = expect(command, "destructive", DESTR)
+    assert not has(result, CANNOT), result
+
+
+def test_decision_b_nested_sudo_is_rejected():
+    expect_rejected("bash <<<'sudo ls'", PIPE, origin="proposal", cls="privileged")
+    expect("bash -c 'sudo ls'", "privileged", PRIV)
+    expect_rejected("bash -c 'sudo -S true'", "-S", cls="privileged")
+    expect_rejected("bash -c 'echo x >&3'", "redirection rejected")
+
+
+# --- work budget ---------------------------------------------------------------------
+
+
+def nested_heredocs(depth: int) -> str:
+    text = "rm -rf ~"
+    for level in reversed(range(depth)):
+        text = f"{{ bash;bash;bash;bash; }} <<'E{level}'\n{text}\nE{level}"
+    return text
+
+
+def test_work_budget_across_recursion():
+    from nl_shell.gate import parse
+
+    command = nested_heredocs(9)
+    assert 300 <= len(command.encode()) <= 400, len(command.encode())
+    start = time.monotonic()
+    result = classify(command)
+    assert time.monotonic() - start < 10.0  # a backstop against a hang only
+    assert isinstance(parse.MAX_WORK, int)
+    assert 0 < result.work < parse.MAX_WORK, result.work
+    assert RANK[result.cls] >= RANK["mutating"], result
+    assert has(result, DESTR) or has(result, COULD_NOT), result
+    proposal = classify(command, "proposal")
+    assert 0 < proposal.work < parse.MAX_WORK
+    assert RANK[proposal.cls] >= RANK["mutating"], proposal
+
+
+def test_work_budget_runs_out_into_decision_c(monkeypatch):
+    from nl_shell.gate import parse
+
+    monkeypatch.setattr(parse, "MAX_WORK", 40)
+    result = classify(nested_heredocs(9))
+    assert (result.cls, result.rejected) == ("privileged", True), result
+    assert result.reasons == (COULD_NOT, "work budget exceeded"), result
+
+
+# --- loading commands.toml -----------------------------------------------------------
+
+HARMLESS = """version = 1
+
+[[command]]
+names = ["sudo", "rm"]
+raw = true
+
+[[command.effect]]
+type = "reads-terminal"
+"""
+
+NO_EXAMPLE = """
+[[command.effect]]
+type = "runs-command-at"
+operand = 0
+"""
+
+
+@pytest.fixture
+def fake_root(tmp_path, monkeypatch):
+    from nl_shell import targets
+
+    root = tmp_path / "targets"
+    (root / "t1").mkdir(parents=True)
+    monkeypatch.setattr(targets, "TARGETS_ROOT", root)
+    return root
+
+
+def assert_decision_c(result):
+    assert (result.cls, result.rejected) == ("privileged", True), result
+    assert result.reasons[0] == COULD_NOT, result
+    assert has(result, "commands.toml"), result
+
+
+@pytest.mark.parametrize(
+    "body",
+    [
+        None,  # missing
+        "[[command]\n",  # not TOML
+        "version = 2\n",
+        HARMLESS.replace('"reads-terminal"', '"harmless"'),
+        HARMLESS + "colour = 1\n",
+        HARMLESS.replace("version = 1", ""),
+        'version = 1\n[[command]]\nnames = ["x"]\n',  # a row with no effect
+        HARMLESS + NO_EXAMPLE,  # runs-command-at with no example
+        b"\xff\xfe",
+    ],
+)
+def test_missing_or_invalid_table_is_decision_c(fake_root, body):
+    path = fake_root / "t1" / "commands.toml"
+    if isinstance(body, bytes):
+        path.write_bytes(body)
+    elif body is not None:
+        path.write_text(body, encoding="utf-8")
+    for command in ("ls", "true", "PATH=x", "sudo -i", "echo hi"):
+        assert_decision_c(classify(command))
+        assert_decision_c(classify(command, target="t1"))
+        assert_decision_c(classify(command, "proposal"))
+
+
+def test_table_outside_the_root_is_refused(fake_root, tmp_path):
+    outside = tmp_path / "elsewhere"
+    outside.mkdir()
+    (outside / "commands.toml").write_text(HARMLESS, encoding="utf-8")
+    (fake_root / "t1" / "commands.toml").symlink_to(outside / "commands.toml")
+    assert_decision_c(classify("sudo -i"))
+    (fake_root / "t2").symlink_to(outside, target_is_directory=True)
+    assert_decision_c(classify("sudo -i", target="t2"))
+    assert_decision_c(classify("sudo -i", target="../elsewhere"))
+
+
+def test_no_single_default_target_is_decision_c(fake_root):
+    (fake_root / "t2").mkdir()
+    (fake_root / "t1" / "commands.toml").write_text(HARMLESS, encoding="utf-8")
+    assert_decision_c(classify("ls"))
+    # Named, the target loads (and its own table's meaning applies).
+    assert classify("ls", target="t1").reasons == (NA,)
+
