+@pytest.mark.parametrize("form", SETS)
+@pytest.mark.parametrize("name", ["SUDO_PROMPT", "SUDO_ASKPASS"])
+def test_sets_variable_sudo_names_are_rejected(form, name):
+    expect_rejected(form.format(name), f"assignment to {name} is rejected")
+
+
+@pytest.mark.parametrize("form", SETS)
+@pytest.mark.parametrize("name", ["PATH", "LD_PRELOAD"])
+def test_sets_variable_session_names(form, name):
