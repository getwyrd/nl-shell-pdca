+    reason = entry.get("reason")
+    if reason is not None and (not isinstance(reason, str) or not reason):
+        raise CommandsError(f"{where}: `reason` must be a non-empty string")
+    fields: dict[str, Any] = {"type": kind, "when": when, "reason": reason}
+    for key in ("operand", "operands_from"):
+        if key in entry:
+            fields[key] = _index(entry[key], where, key)
+    for key in (
+        "option",
+        "after_word",
+        "until_word",
+        "until_after_placeholder",
+        "placeholder_options",
+        "nameref_options",
+        "password_options",
+    ):
+        if key in entry:
+            fields[key] = _strings(entry[key], where, key)
+    for key in ("appends", "unreadable_inner", "skip_assignments", "in_shell", "with_rest"):
+        if key in entry:
+            fields[key] = _bool(entry[key], where, key)
+    if "placeholder" in entry:
+        if not isinstance(entry["placeholder"], str) or not entry["placeholder"]:
+            raise CommandsError(f"{where}: `placeholder` must be a non-empty string")
+        fields["placeholder"] = entry["placeholder"]
+    if kind == "runs-command-at":
+        located = ("operand" in entry) + ("after_word" in entry)
+        if located != 1:
+            raise CommandsError(f"{where}: give exactly one of `operand`, `after_word`")
+        if "after_word" in entry and "until_word" not in entry:
+            raise CommandsError(f"{where}: `after_word` needs `until_word`")
+    if kind == "runs-text":
+        located = ("operand" in entry) + ("operands_from" in entry) + ("option" in entry)
+        if located != 1:
+            raise CommandsError(
+                f"{where}: give exactly one of `operand`, `operands_from`, `option`"
+            )
+    if kind == "runs-file-as-code":
+        if ("operand" in entry) + ("option" in entry) != 1:
+            raise CommandsError(f"{where}: give exactly one of `operand`, `option`")
+    if kind == "sets-variable":
+        source = entry.get("from")
+        if source not in VARIABLE_SOURCES:
+            raise CommandsError(
+                f"{where}: `from` must be one of {', '.join(VARIABLE_SOURCES)}"
+            )
+        fields["source"] = source
+        if source == "operand" and "operand" not in entry:
+            raise CommandsError(f"{where}: `from = \"operand\"` needs `operand`")
+        if source == "option" and "option" not in entry:
+            raise CommandsError(f"{where}: `from = \"option\"` needs `option`")
+        scope = entry.get("scope", "session")
+        if scope not in SCOPES:
+            raise CommandsError(f"{where}: `scope` must be one of {', '.join(SCOPES)}")
+        fields["scope"] = scope
+    return Effect(**fields)
