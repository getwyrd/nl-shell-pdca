+        if key in value
+    }
+    return When(word_matches=pattern, **lists, **flags)
+
+
+def _effect(entry: dict[str, Any], where: str) -> Effect:
+    kind = entry.get("type")
+    if kind not in EFFECTS:
+        raise CommandsError(f"{where}: `type` must be one of {', '.join(EFFECTS)}")
+    where = f"{where} ({kind})"
+    unknown = sorted(set(entry) - _COMMON_KEYS - _EFFECT_KEYS[kind])
+    if unknown:
+        raise CommandsError(f"{where}: unknown key `{unknown[0]}`")
