+        resolved = path.resolve()
+        inside = folder.is_dir() and resolved.is_relative_to(root.resolve())
+    except OSError as exc:
+        raise CommandsError(f"{path}: cannot resolve: {exc.strerror or exc}") from None
+    if not inside:
+        raise CommandsError(f"{path}: not inside {root}")
