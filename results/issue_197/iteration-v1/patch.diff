+@dataclass(frozen=True)
+class Row:
+    """One ``[[command]]`` row."""
+
+    names: tuple[str, ...]
+    name_prefixes: tuple[str, ...]
+    flags: frozenset[str]
+    options: frozenset[str]
+    optional: frozenset[str]
+    numeric: bool
+    plus: bool
+    intermix: bool
+    raw: bool
+    end_of_options: bool
+    example: str | None
+    effects: tuple[Effect, ...]
