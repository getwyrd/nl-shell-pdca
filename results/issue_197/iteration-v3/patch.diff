+    def destroys(self, condition: commands.Destroys, st: _State) -> bool:
+        if condition.always:
+            return True
+        operands = st.operands
+        if condition.glob_operands and any(not w.literal for w in operands):
+            return True
+        if condition.words and any(w.literal and w.text in condition.words for w in st.words):
+            return True
+        return any(
+            w.literal and w.text.startswith(condition.operand_prefixes) for w in operands
+        ) if condition.operand_prefixes else False
