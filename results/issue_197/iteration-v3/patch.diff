+class _State:
+    """The argv parse of one row."""
+
+    def __init__(self, row: commands.Row) -> None:
+        self.grammar: commands.Grammar = row.grammar
+        self.mode: commands.Mode = row.grammar.modes["default"]
+        self.sub: commands.Subcommand | None = None
+        self.sub_default = False  # a subcommand the row does not describe
+        self.options_done = False
+        self.operand = 0  # index into the mode's operand roles
+        self.operands: list[Word] = []  # words read with the `arg` role
+        self.words: list[Word] = []  # every argv word of the row
+        self.attrs: set[str] = set()
+        self.shell_option = False
+        self.placeholder: str | None = None
+        self.positional: list[Word] = []  # words that become $1, $2, …
+        self.filled = False  # a command / script / text field was given
+        self.inner_opened = False
+
+    def elevates(self, row: commands.Row) -> bool:
+        return row.elevates or (self.sub is not None and self.sub.elevates)
+
+
+class _Engine:
+    def __init__(self, table: commands.Table, origin: str, recurse: Recurse | None) -> None:
+        self.table = table
+        self.proposal = origin == "proposal"
+        self.recurse = recurse
+        self.readings = 0
+
+    # --- decision B --------------------------------------------------------------
+
+    def cannot_read(self, acc: _Acc, detail: str) -> None:
+        acc.raise_to("destructive", f"{CANNOT_READ}: {detail}")
+
+    # --- a simple command (or an inner one) --------------------------------------
+
+    def command(self, acc: _Acc, words: list[Word], inv, depth: int) -> None:
+        if depth > MAX_ARGV_DEPTH:
+            raise GateFailure("nesting too deep")
+        if not words or not words[0].source:
+            acc.raise_to("mutating", NOT_ALLOWLISTED)
+            return
+        head = words[0]
+        if not head.literal:
+            if depth:
+                # Class 4: a run-time inner command word (`xargs -I% %`, `"$x"`).
+                self.cannot_read(acc, f"the inner command word is not a literal: {head.source}")
+            acc.raise_to("mutating", NOT_ALLOWLISTED)
+            self.decision_a(acc, words[1:], inv, depth)
+            return
+        text = head.text
+        if depth and "/" in text and not system_path(text):
+            acc.raise_to(
+                "mutating", f"inner command word is a path outside the system directories: {text}"
+            )
+        name = text.rsplit("/", 1)[-1] if "/" in text else text
+        row = self.table.lookup(name)
+        if row is None:
+            acc.raise_to("mutating", NOT_ALLOWLISTED)
+            self.decision_a(acc, words[1:], inv, depth)
+            return
+        mine = _Acc()
+        self.row(mine, row, name, list(words[1:]), inv, depth)
+        acc.merge(mine)
+
+    def decision_a(self, acc: _Acc, words, inv, depth: int) -> None:
+        """Decision A over argv the gate has no grammar for (an opaque command, a fixed
+        row, positional parameters): each word goes through the command-word check, and
+        each word that names a row is also read as a possible command position (class 4:
+        `ionice sh -c '…'`, `sh -c '"$@"' _ bash -c '…'`)."""
+        words = list(words)
+        for word in words:
+            self.word_a(acc, word)
+        self.possible(acc, words, inv, depth)
+
+    def possible(self, acc: _Acc, words: list[Word], inv, depth: int) -> None:
+        for i, word in enumerate(words):
+            if not word.literal or not word.text:
+                continue
+            name = word.text.rsplit("/", 1)[-1]
+            if not name or self.table.lookup(name) is None:
+                continue
+            self.readings += 1
+            if self.readings > MAX_READINGS:
+                raise GateFailure("work budget exceeded")
+            mine = _Acc()
+            self.command(mine, words[i:], inv, depth + 1)
+            # Its class, reasons and rejections count; whether it opens a shell does not
+            # (it may only be an argument: `apt install bash`).
+            mine.opens_shell = False
+            acc.merge(mine)
+
+    def word_a(self, acc: _Acc, word: Word) -> None:
+        if not word.literal or not word.text:
+            return
+        name = word.text.rsplit("/", 1)[-1]
+        if not name:
+            return
+        row = self.table.lookup(name)
+        if row is None:
+            return
+        if row.any_elevates():
+            reason = f"an argument names a command that elevates: {name}"
+            acc.raise_to("privileged", reason)
+            if self.proposal:
+                acc.reject(reason)
+        elif row.any_destroys():
+            acc.raise_to("destructive", f"an argument names a destructive command: {name}")
+
+    # --- one row -----------------------------------------------------------------
+
+    def row(self, acc: _Acc, row: commands.Row, name: str, args: list[Word], inv, depth) -> None:
+        if row.elevates:
+            acc.raise_to("privileged", f"runs as root: {name}")
+        if row.stdin == "reject" and inv.stdin.kind not in ("terminal", "file"):
