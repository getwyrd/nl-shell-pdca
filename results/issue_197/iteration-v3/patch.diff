+def test_class2_undeclared_options():
+    table = load_table()
+    c = Checks()
+    for row in table.rows:
+        assert row.example, row.names
+        if row.argv == "fixed":
+            continue
+        command = insert_after(row.example, 1, UNDECLARED)
+        c.expect(command, floor="destructive", reason=UNKNOWN)
+        if row.elevates:
+            c.rejected(command, UNKNOWN)
+        for sub in row.subcommands.values():
+            command = insert_after(sub.example, 2, UNDECLARED)
+            c.expect(command, floor="destructive", reason=UNKNOWN)
+            if row.elevates or sub.elevates:
+                c.rejected(command, UNKNOWN)
+        if row.shell_example is not None:
+            c.rejected(f"sudo {row.shell_example}", ROOT_SHELL)
+    c.done()
