+        self.cannot_read(acc, f"{name} reads code from stdin ({stdin.kind})")
+        return False
+
+    # --- fields ------------------------------------------------------------------
+
+    def field(self, acc, row, name, st: _State, role: commands.Role, word: Word, inv) -> None:
+        kind = role.kind
+        if kind in ("arg", "positional"):
+            if kind == "arg":
+                st.operands.append(word)
+            else:
+                st.positional.append(word)
+            self.word_a(acc, word)
+        elif kind == "fd":
+            if not (word.literal and word.text in ("0", "1", "2")):
+                acc.reject(f"{name} reads a descriptor other than 0, 1 or 2")
