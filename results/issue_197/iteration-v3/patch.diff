+        "trap - EXIT",
+        "enable -n test",
+        "set -e",
+        "shopt -s extglob",
+        "bind -l",
+        "complete -p",
+        "hash -r",
+        "builtin true",
+        "command true",
+        "export A=1",
+        "declare A=1",
+        "typeset A=1",
+        "f() { local A=1; }",
+        "readonly A=1",
+        "unset A",
+    ):
+        c.expect(command, floor="session-altering", reason="")
+    c.expect("command -v ls", floor="mutating", reason=NA)
+    c.done()
+
+
+# --- decisions A and B ---------------------------------------------------------------
+
+
+def test_decision_a():
+    c = Checks()
+    c.expect("foo sudo x", cls="privileged", reason=ELEVATES)
+    c.rejected("foo sudo x", ELEVATES)
+    c.expect("foo rm -rf x", floor="destructive", reason="rm")
+    c.done()
+
+
+def test_decision_b():
+    c = Checks()
+    for command in (
+        "x | sh",
+        "bash < f",
+        "bash f.sh",
+        'bash -c "$v"',
+        'eval "$v"',
+        ". ./f",
+        "echo 'sudo rm -rf /' | bash",
+    ):
+        c.expect(command, cls="destructive", reason=CANNOT)
+    for command in (
+        "bash -c 'rm -rf ~'",
+        "bash <<<'rm -rf ~'",
+        "bash -s <<<'rm -rf /'",
+        ". /dev/stdin <<<'rm -rf /'",
+        "bash <<'E'\nrm -rf ~\nE",
+    ):
+        c.expect(command, cls="destructive", reason="rm")
+    c.rejected("bash <<<'sudo ls'", "root")
+    c.done()
+
+
+# --- work budget ---------------------------------------------------------------------
+
+
+def test_work_budget():
+    from nl_shell.gate import parse
+
+    c = Checks()
+    # Nine levels of `{ bash; ×4 } <<'E'`: never below mutating, and no hang.
+    body = "rm -rf ~"
+    for level in range(9):
+        body = f"{{ bash;bash;bash;bash; }} <<'E{level}'\n{body}\nE{level}"
+    start = time.monotonic()
+    result = classify(body)
+    assert time.monotonic() - start < 10.0
+    assert RANK[result.cls] >= RANK["mutating"], result
+
+    # One shared budget: `bash -c 'T'` fits alone; three of them together do not.
+    text = ":;" * (parse.MAX_WORK // 4)
+    alone = f"bash -c '{text}'"
+    together = "; ".join([alone] * 3)
+    assert len(together.encode()) < parse.MAX_INPUT_BYTES
+    c.expect(alone, floor="mutating", reason=NA)
+    c.expect(together, cls="privileged", rejected=True, reason=COULD_NOT, decision_c_ok=True)
+    result = classify(together)
+    assert any(COULD_NOT in r for r in result.reasons), result
+    c.done()
+
+
+# --- decision C on a bad table, and the fixed load location --------------------------
+
+COMMANDS_FOR_ANY = ("ls", "sudo -i", "rm -rf x", "PATH=x", "true | cat")
+
+
+def test_decision_c_on_table_failure(tmp_path, monkeypatch):
+    from nl_shell.gate import commands
+
+    def all_could_not() -> None:
+        commands.cache_clear()
+        for command in COMMANDS_FOR_ANY:
+            result = classify(command)
+            assert (result.cls, result.rejected) == ("privileged", True), (command, result)
+            assert result.reasons[0] == COULD_NOT, (command, result)
+
+    try:
+        monkeypatch.setattr(commands, "TARGETS_ROOT", tmp_path)
+        all_could_not()  # missing
+        folder = tmp_path / commands.TARGET_ID
+        folder.mkdir()
+        (folder / "commands.toml").write_text("[[command]\nnames = ", encoding="utf-8")
+        all_could_not()  # not TOML
+        (folder / "commands.toml").write_text(MINIMAL + "raw = true\n", encoding="utf-8")
+        all_could_not()  # invalid row
+        outside = tmp_path / "outside"
+        outside.mkdir()
+        (outside / "commands.toml").write_text(MINIMAL, encoding="utf-8")
+        root = tmp_path / "root"
+        root.mkdir()
+        (root / commands.TARGET_ID).symlink_to(outside, target_is_directory=True)
+        monkeypatch.setattr(commands, "TARGETS_ROOT", root)
+        all_could_not()  # resolves outside the root
+    finally:
+        monkeypatch.undo()
+        commands.cache_clear()
+
+
+def test_fixed_load_location(tmp_path, monkeypatch):
+    from nl_shell import targets
+    from nl_shell.gate import commands
+
+    assert commands.TARGET_ID == "ubuntu-26.04"
+    assert commands.TARGETS_ROOT == targets.TARGETS_ROOT
+    assert commands.path() == targets.TARGETS_ROOT / "ubuntu-26.04" / "commands.toml"
+    harmless = MINIMAL.replace('"x"', '"sudo"').replace("example = \"sudo\"", 'example = "sudo"')
+    for folder in (tmp_path, tmp_path / "ubuntu-26.04", tmp_path / "nl-shell"):
+        folder.mkdir(exist_ok=True)
+        (folder / "commands.toml").write_text(harmless, encoding="utf-8")
+    try:
+        monkeypatch.chdir(tmp_path)
+        monkeypatch.setenv("NL_SHELL_COMMANDS", str(tmp_path / "commands.toml"))
+        monkeypatch.setenv("NL_SHELL_TARGETS", str(tmp_path))
+        monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path))
+        commands.cache_clear()
+        c = Checks()
+        c.expect("sudo -i", cls="privileged", reason="root")
+        c.rejected("sudo -i", ROOT_SHELL)
+        c.done()
+    finally:
+        monkeypatch.undo()
+        commands.cache_clear()
