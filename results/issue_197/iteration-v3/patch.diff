+  { names = ["-t", "--timing"], value = "optional" },
+]
+
+[command.modes.text]
+priority = 1
+operands = ["arg"]
+
+[[command]]
+names = ["watch"]
+example = "watch -n 1 date"
+argv = "options"
+class = "mutating"
+permute = false
+operands = [{ role = "joined-text:sh", example = "watch {}" }]
+no_command = "error"
+terminal_stdin = "error"
+options = [
+  { names = ["-b", "--beep", "-c", "--color", "-C", "--no-color", "-e", "--errexit", "-g", "--chgexit", "-p", "--precise", "-r", "--no-rerun", "-t", "--no-title", "-w", "--no-wrap", "-h", "--help", "-v", "--version"] },
+  { names = ["-d", "--differences"], value = "optional" },
+  { names = ["-n", "--interval", "-q", "--equexit"], value = "required" },
+  { names = ["-x", "--exec"], mode = "exec" },
+]
+
+[command.modes.exec]
+priority = 1
+operands = ["command"]
+no_command = "error"
+terminal_stdin = "error"
+
+[[command]]
+names = ["chroot"]
+example = "chroot / true"
+prefix = "chroot /"
+shell_example = "chroot /"
+argv = "options"
+class = "mutating"
+permute = false
+operands = ["arg", "command"]
+no_command = "opens-shell"
+terminal_stdin = "error"
+options = [
+  { names = ["--groups", "--userspec"], value = "required" },
+  { names = ["--skip-chdir", "-h", "--help", "-V", "--version"] },
+]
+
+[[command]]
+names = ["unshare"]
+example = "unshare true"
+prefix = "unshare"
+shell_example = "unshare"
+argv = "options"
+class = "mutating"
+permute = false
+operands = ["command"]
+no_command = "opens-shell"
+terminal_stdin = "error"
+options = [
+  { names = ["-m", "--mount", "-u", "--uts", "-i", "--ipc", "-n", "--net", "-p", "--pid", "-U", "--user", "-C", "--cgroup", "-T", "--time", "--kill-child", "--mount-proc", "--mount-binfmt"], value = "optional" },
+  { names = ["-f", "--fork", "-r", "--map-root-user", "-c", "--map-current-user", "--map-auto", "--keep-caps", "-l", "--load-interp", "-h", "--help", "-V", "--version"] },
+  { names = ["--map-user", "--map-group", "--map-users", "--map-groups", "--propagation", "--setgroups", "-R", "--root", "-w", "--wd", "-S", "--setuid", "-G", "--setgid", "--monotonic", "--boottime"], value = "required" },
+]
+
+[[command]]
+names = ["ssh-agent"]
+example = "ssh-agent -k"
+prefix = "ssh-agent"
+argv = "options"
+class = "mutating"
+permute = false
+operands = ["command"]
+no_command = "nothing"
+terminal_stdin = "error"
+options = [
+  { names = ["-c", "-s", "-D", "-d", "-k", "-T"] },
+  { names = ["-a", "-E", "-O", "-P", "-t"], value = "required" },
+]
+
+[[command]]
+names = ["xargs"]
+example = "xargs echo"
+prefix = "xargs"
+argv = "options"
+class = "mutating"
+permute = false
+runtime_args = true
+operands = ["command"]
+no_command = "nothing"
+terminal_stdin = "error"
+options = [
+  { names = ["-0", "--null", "-o", "--open-tty", "-p", "--interactive", "-r", "--no-run-if-empty", "--show-limits", "-t", "--verbose", "-x", "--exit", "--help", "--version"] },
+  { names = ["-a", "--arg-file", "-d", "--delimiter", "-E", "-L", "--max-lines", "-n", "--max-args", "-P", "--max-procs", "-s", "--max-chars"], value = "required" },
+  { names = ["-e", "--eof", "-l"], value = "optional" },
+  { names = ["--process-slot-var"], value = "required", role = "name", example = "xargs --process-slot-var={} echo" },
+  { names = ["-I"], value = "required", placeholder = true },
+  { names = ["-i", "--replace"], value = "optional", placeholder = true },
+]
+
+[[command]]
+names = ["find"]
+example = "find . -name x"
+prefix = "find . -exec"
+argv = "options"
+class = "mutating"
+rest = "arg"
+options = [
+  { names = ["-exec", "-execdir", "-ok", "-okdir"], exec = true },
+  { names = ["-delete"], destroys = "deletes what it finds" },
+  { names = ["-H", "-L", "-P", "-O0", "-O1", "-O2", "-O3"] },
+  { names = ["-D"], value = "required" },
+  { names = ["(", ")", "!", ",", "-not", "-a", "-and", "-o", "-or", "-print", "-print0", "-ls", "-prune", "-quit", "-true", "-false", "-empty", "-executable", "-readable", "-writable", "-nouser", "-nogroup", "-daystart", "-depth", "-d", "-follow", "-ignore_readdir_race", "-noignore_readdir_race", "-mount", "-xdev", "-noleaf", "-warn", "-nowarn", "-help", "--help", "-version", "--version"] },
+  { names = ["-name", "-iname", "-path", "-ipath", "-wholename", "-iwholename", "-regex", "-iregex", "-regextype", "-lname", "-ilname", "-type", "-xtype", "-size", "-perm", "-user", "-group", "-uid", "-gid", "-links", "-inum", "-samefile", "-newer", "-anewer", "-cnewer", "-amin", "-atime", "-cmin", "-ctime", "-mmin", "-mtime", "-used", "-maxdepth", "-mindepth", "-fstype", "-context", "-printf", "-files0-from", "-newerat", "-newerac", "-neweram", "-newerab", "-neweraB", "-newerca", "-newercc", "-newercm", "-newerct", "-newercB", "-newerma", "-newermc", "-newermm", "-newermt", "-newermB", "-newerBa", "-newerBc", "-newerBm", "-newerBt", "-newerBB", "-neweraa", "-newerat"], value = "required" },
+  { names = ["-fprint", "-fprint0", "-fls"], value = "required" },
+  { names = ["-fprintf"], value = "required", values = 2 },
+]
+
+# --- builtins and keywords that run or store code (§3) ---------------------------------
+
+[[command]]
+names = ["exec"]
+example = "exec true"
+prefix = "exec"
+argv = "options"
+class = "session-altering"
+reason = "exec replaces the shell"
+permute = false
+operands = ["command"]
+no_command = "nothing"
+terminal_stdin = "error"
+options = [
+  { names = ["-c", "-l"] },
+  { names = ["-a"], value = "required" },
+]
+
+[[command]]
+names = ["command"]
+example = "command true"
+prefix = "command"
+argv = "options"
+class = "session-altering"
+reason = "command bypasses functions and aliases"
+permute = false
+operands = ["command"]
+no_command = "nothing"
+terminal_stdin = "error"
+options = [
+  { names = ["-p"] },
+  { names = ["-v", "-V"], mode = "lookup" },
+]
+
+[command.modes.lookup]
+priority = 1
+class = "mutating"
+rest = "arg"
+
+[[command]]
+names = ["builtin"]
+example = "builtin true"
+prefix = "builtin"
+argv = "options"
+class = "session-altering"
+reason = "builtin bypasses functions"
+permute = false
+operands = ["command"]
+no_command = "nothing"
+terminal_stdin = "error"
+
+[[command]]
+names = ["eval"]
+example = "eval true"
+argv = "options"
+class = "session-altering"
+reason = "eval runs text as shell code"
+permute = false
+operands = [{ role = "joined-text:bash", example = "eval {}" }]
+no_command = "nothing"
+terminal_stdin = "error"
+
+[[command]]
+names = ["source", "."]
+example = "source /dev/stdin"
+shell_example = ". /dev/stdin"
+argv = "options"
+class = "session-altering"
+reason = "source runs a file in the shell"
+permute = false
+stdin_grammar = "bash"
+operands = ["script"]
+rest = "positional"
+no_command = "error"
+terminal_stdin = "opens-shell"
+options = [
+  { names = ["-p"], value = "required" },
+]
+
+[[command]]
+names = ["trap"]
+example = "trap - EXIT"
+argv = "options"
+class = "session-altering"
+reason = "trap stores code to run later"
+permute = false
+operands = [{ role = "stored:bash", example = "trap {} EXIT" }]
+rest = "arg"
+options = [
+  { names = ["-l", "-p", "-P"] },
+]
+
+[[command]]
+names = ["alias"]
+example = "alias"
+argv = "options"
+class = "session-altering"
+reason = "alias changes what a command word runs"
+permute = false
+rest = { role = "alias", example = "alias x={}" }
+options = [
+  { names = ["-p"] },
+]
+
+[[command]]
+names = ["unalias"]
+example = "unalias x"
+argv = "options"
+class = "session-altering"
+reason = "unalias changes what a command word runs"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-a"] },
+]
+
+[[command]]
+names = ["enable"]
+example = "enable -n test"
+argv = "options"
+class = "session-altering"
+reason = "enable changes which builtins run"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-a", "-d", "-n", "-p", "-s"] },
+  { names = ["-f"], value = "required", role = "script" },
+]
+
+[[command]]
+names = ["set"]
+example = "set -e"
+argv = "options"
+class = "session-altering"
+reason = "set changes shell options or the positional parameters"
+permute = false
+plus_options = true
+rest = "positional"
+options = [
+  { names = ["-a", "-b", "-e", "-f", "-h", "-k", "-m", "-n", "-p", "-t", "-u", "-v", "-x", "-B", "-C", "-E", "-H", "-P", "-T", "+a", "+b", "+e", "+f", "+h", "+k", "+m", "+n", "+p", "+t", "+u", "+v", "+x", "+B", "+C", "+E", "+H", "+P", "+T", "-"] },
+  { names = ["-o", "+o"], value = "required" },
+]
+
+[[command]]
+names = ["shopt"]
+example = "shopt -s extglob"
+argv = "options"
+class = "session-altering"
+reason = "shopt changes shell options"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-s", "-u", "-p", "-q", "-o"] },
+]
+
+[[command]]
+names = ["bind"]
+example = "bind -l"
+argv = "options"
+class = "session-altering"
+reason = "bind changes key bindings"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-l", "-p", "-P", "-v", "-V", "-s", "-S", "-X"] },
+  { names = ["-m", "-q", "-u", "-r", "-f"], value = "required" },
+  { names = ["-x"], value = "required", role = "bind-x", example = "bind -x {}" },
+]
+
+[[command]]
+names = ["complete", "compopt"]
+example = "complete -p"
+argv = "options"
+class = "session-altering"
+reason = "complete stores completion code"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-a", "-b", "-c", "-d", "-e", "-f", "-g", "-j", "-k", "-s", "-u", "-v", "-D", "-E", "-I", "-p", "-r", "+o"] },
+  { names = ["-A", "-G", "-P", "-S", "-X", "-o", "-F"], value = "required" },
+  { names = ["-C"], value = "required", role = "stored:bash", example = "complete -C {} x" },
+  { names = ["-W"], value = "required", role = "stored:prompt", example = "complete -W {} x" },
+]
+
+[[command]]
+names = ["compgen"]
+example = "compgen -c"
+argv = "options"
+class = "mutating"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-a", "-b", "-c", "-d", "-e", "-f", "-g", "-j", "-k", "-s", "-u", "-v"] },
+  { names = ["-A", "-G", "-P", "-S", "-X", "-o", "-F", "-V"], value = "required" },
+  { names = ["-C"], value = "required", role = "text:bash", example = "compgen -C {} x" },
+  { names = ["-W"], value = "required", role = "text:prompt", example = "compgen -W {} x" },
+]
+
+[[command]]
+names = ["hash"]
+example = "hash -r"
+argv = "options"
+class = "session-altering"
+reason = "hash changes where a command word is found"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-r", "-d", "-l", "-t"] },
+  { names = ["-p"], value = "required" },
+]
+
+[[command]]
+names = ["fc"]
+example = "fc -l"
+argv = "options"
+class = "mutating"
+permute = false
+operands = ["arg", "arg"]
+options = [
+  { names = ["-l", "-n", "-r"] },
+  { names = ["-e"], value = "required", role = "script" },
+  { names = ["-s"], value = "none", destroys = "runs a command from the history the gate cannot read" },
+]
+
+# --- variables (class 3, class 5) -------------------------------------------------------
+
+[[command]]
+names = ["export"]
+example = "export x=1"
+argv = "options"
+class = "session-altering"
+reason = "export changes the environment"
+permute = false
+rest = { role = "declare", example = "export {}" }
+options = [
+  { names = ["-f", "-n", "-p"] },
+]
+
+[[command]]
+names = ["declare", "typeset"]
+example = "declare x=1"
+argv = "options"
+class = "mutating"
+permute = false
+plus_options = true
+rest = { role = "declare", example = "declare {}" }
+options = [
+  { names = ["-i", "+i"], attribute = "integer" },
+  { names = ["-n", "+n"], attribute = "nameref" },
+  { names = ["-a", "-A", "-f", "-F", "-g", "-I", "-l", "-p", "-r", "-t", "-u", "-x", "+a", "+A", "+f", "+F", "+g", "+I", "+l", "+r", "+t", "+u", "+x"] },
+]
+
+[[command]]
+names = ["local"]
+example = "local x=1"
+argv = "options"
+class = "mutating"
+permute = false
+plus_options = true
+rest = { role = "declare", example = "local {}" }
+options = [
+  { names = ["-i", "+i"], attribute = "integer" },
+  { names = ["-n", "+n"], attribute = "nameref" },
+  { names = ["-a", "-A", "-f", "-F", "-I", "-l", "-p", "-r", "-t", "-u", "-x", "+a", "+A", "+f", "+F", "+I", "+l", "+r", "+t", "+u", "+x", "-"] },
+]
+
+[[command]]
+names = ["readonly"]
+example = "readonly x=1"
+argv = "options"
+class = "mutating"
+permute = false
+rest = { role = "declare", example = "readonly {}" }
+options = [
+  { names = ["-a", "-A", "-f", "-p", "-x"] },
+]
+
+[[command]]
+names = ["unset"]
+example = "unset x"
+argv = "options"
+class = "session-altering"
+reason = "unset removes variables or functions"
+permute = false
+rest = { role = "unset", example = "unset {}" }
+options = [
+  { names = ["-f", "-v", "-n"] },
+]
+
+[[command]]
+names = ["let"]
+example = "let x=1"
+argv = "options"
+class = "mutating"
+permute = false
+rest = { role = "arith", example = "let {}" }
+
+[[command]]
+names = ["test", "["]
+example = "test -f x"
+argv = "options"
+class = "mutating"
+rest = "arg"
+options = [
+  { names = ["-b", "-c", "-d", "-e", "-f", "-g", "-h", "-k", "-p", "-r", "-s", "-t", "-u", "-w", "-x", "-G", "-L", "-N", "-O", "-S", "-z", "-n", "-a", "-o"], value = "required" },
+  { names = ["-v", "-R"], value = "required", role = "subscript", example = "test -v {}" },
+  { names = ["-eq", "-ne", "-lt", "-le", "-gt", "-ge", "-nt", "-ot", "-ef"] },
+]
+
+[[command]]
+names = ["printf"]
+example = "printf x"
+argv = "options"
+class = "mutating"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-v"], value = "required", role = "name", example = "printf -v {} x" },
+]
+
+[[command]]
+names = ["read"]
+example = "read -r x"
+argv = "options"
+class = "mutating"
+permute = false
+rest = { role = "name", example = "read {}" }
+options = [
+  { names = ["-e", "-E", "-r", "-s"] },
+  { names = ["-a"], value = "required", role = "name", example = "read -a {}" },
+  { names = ["-d", "-i", "-n", "-N", "-p", "-t"], value = "required" },
+  { names = ["-u"], value = "required", role = "fd" },
+]
+
+[[command]]
+names = ["mapfile", "readarray"]
+example = "mapfile -t a"
+argv = "options"
+class = "mutating"
+permute = false
+operands = [{ role = "name", example = "mapfile {}" }]
+rest = "arg"
+options = [
+  { names = ["-t"] },
+  { names = ["-d", "-n", "-O", "-s", "-c"], value = "required" },
+  { names = ["-u"], value = "required", role = "fd" },
+  { names = ["-C"], value = "required", role = "stored:bash", example = "mapfile -C {} -c 1 a" },
+]
+
+[[command]]
+names = ["getopts"]
+example = "getopts x opt"
+argv = "options"
+class = "mutating"
+permute = false
+operands = ["arg", { role = "name", example = "getopts x {}" }]
+rest = "arg"
+
+[[command]]
+names = ["wait"]
+example = "wait"
+argv = "options"
+class = "mutating"
+permute = false
+rest = "arg"
+options = [
+  { names = ["-f", "-n"] },
+  { names = ["-p"], value = "required", role = "name", example = "wait -p {}" },
+]
+
+# --- destructive commands (§4) ----------------------------------------------------------
+
+[[command]]
+names = ["rm", "gnurm"]
+example = "rm x"
+argv = "options"
+class = "mutating"
+rest = "arg"
+destroys = { reason = "rm with a glob or an operand the gate cannot read", glob_operands = true }
+options = [
+  { names = ["-r", "-R", "--recursive"], destroys = "rm -r" },
+  { names = ["-f", "--force", "-i", "-I", "-d", "--dir", "-v", "--verbose", "--one-file-system", "--no-preserve-root", "--help", "--version"] },
+  { names = ["--interactive", "--preserve-root"], value = "optional" },
+]
+
+[[command]]
+names = ["dd", "wipefs", "shred", "truncate", "fdisk", "sfdisk", "cfdisk", "parted", "gdisk", "sgdisk", "mkfs", "mke2fs", "mkswap", "blkdiscard"]
+patterns = ["mkfs.*"]
+example = "dd if=/dev/zero of=x count=1"
+argv = "fixed"
+class = "destructive"
+reason = "destructive: writes or erases disks or files"
+
+[[command]]
+names = ["chmod"]
+example = "chmod 644 x"
+argv = "options"
+class = "mutating"
+rest = "arg"
+options = [
+  { names = ["-R", "--recursive"], destroys = "chmod -R" },
+  { names = ["-c", "--changes", "-f", "--silent", "--quiet", "-v", "--verbose", "--no-preserve-root", "--preserve-root", "-H", "-L", "-P", "--dereference", "--no-dereference", "--help", "--version"] },
+  { names = ["-r", "-w", "-x", "-X", "-s", "-t"] },
+  { names = ["--reference"], value = "required" },
+]
+
+[[command]]
+names = ["chown", "chgrp"]
+example = "chown root x"
+argv = "options"
+class = "mutating"
+rest = "arg"
+options = [
+  { names = ["-R", "--recursive"], destroys = "chown -R" },
+  { names = ["-c", "--changes", "-f", "--silent", "--quiet", "-v", "--verbose", "-h", "--no-dereference", "--dereference", "-H", "-L", "-P", "--no-preserve-root", "--preserve-root", "--help", "--version"] },
+  { names = ["--from", "--reference"], value = "required" },
+]
+
+[[command]]
+names = ["kill"]
+example = "kill 1234"
+argv = "options"
+class = "mutating"
+number_flags = true
+rest = "arg"
+destroys = { reason = "kill -1 signals every process", words = ["-1"] }
+options = [
+  { names = ["-l", "-L"] },
+  { names = ["-s", "-n"], value = "required" },
+]
+
+[[command]]
+names = ["systemctl"]
+example = "systemctl status ssh"
+argv = "options"
+class = "mutating"
+subcommand_default = "mutating"
+options = [
+  { names = ["-h", "--help", "--version", "-a", "--all", "-r", "--recursive", "--reverse", "--after", "--before", "-l", "--full", "--value", "--show-types", "-T", "--show-transaction", "-i", "--ignore-inhibitors", "--dry-run", "-q", "--quiet", "--no-warn", "--wait", "--user", "--system", "--no-block", "--no-wall", "--no-reload", "--no-ask-password", "--global", "--runtime", "-f", "--force", "--now", "--plain", "--no-legend", "--no-pager", "--firmware-setup", "--mkdir", "--marked", "--read-only", "-P"] },
+  { names = ["-t", "--type", "--state", "-p", "--property", "--job-mode", "-M", "--machine", "-H", "--host", "--root", "--image", "-n", "--lines", "-o", "--output", "--legend", "-s", "--signal", "--kill-whom", "--kill-value", "--what", "--boot-loader-menu", "--boot-loader-entry", "--reboot-argument", "--timestamp", "--check-inhibitors", "--message", "--preset-mode", "--drop-in", "--when", "--capsule"], value = "required" },
+]
+
+[command.subcommands.stop]
+example = "systemctl stop ssh"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl stop", always = true }
+
+[command.subcommands.disable]
+example = "systemctl disable ssh"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl disable", always = true }
+
+[command.subcommands.mask]
+example = "systemctl mask ssh"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl mask", always = true }
+
+[command.subcommands.kill]
+example = "systemctl kill ssh"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl kill", always = true }
+
+[command.subcommands.isolate]
+example = "systemctl isolate rescue.target"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl isolate", always = true }
+
+[command.subcommands.poweroff]
+example = "systemctl poweroff"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl poweroff", always = true }
+
+[command.subcommands.reboot]
+example = "systemctl reboot"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl reboot", always = true }
+
+[command.subcommands.halt]
+example = "systemctl halt"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl halt", always = true }
+
+[command.subcommands.soft-reboot]
+example = "systemctl soft-reboot"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl soft-reboot", always = true }
+
+[command.subcommands.kexec]
+example = "systemctl kexec"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl kexec", always = true }
+
+[command.subcommands.rescue]
+example = "systemctl rescue"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl rescue", always = true }
+
+[command.subcommands.emergency]
+example = "systemctl emergency"
+inherit_options = true
+rest = "arg"
+destroys = { reason = "systemctl emergency", always = true }
+
+# git: spec rows 8 and 27 keep it at the floor (`mutating`, "not allowlisted"). Only the
+# destructive subcommands are described. The global options that run code (`-c`,
+# `--config-env`, `--exec-path`) are the class-7 accepted gap (spec §4.1).
+[[command]]
+names = ["git"]
+example = "git status"
+argv = "options"
+class = "mutating"
+subcommand_default = "mutating"
+permute = false
+options = [
+  { names = ["-c", "--config-env"], value = "required", gap = "class-7-gap" },
+  { names = ["--exec-path"], value = "optional", gap = "class-7-gap" },
+  { names = ["-v", "--version", "-h", "--help", "--html-path", "--man-path", "--info-path", "-p", "--paginate", "-P", "--no-pager", "--no-replace-objects", "--no-lazy-fetch", "--no-optional-locks", "--no-advice", "--bare", "--literal-pathspecs", "--glob-pathspecs", "--noglob-pathspecs", "--icase-pathspecs"] },
+  { names = ["-C", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--list-cmds", "--attr-source"], value = "required" },
+]
+
+[command.subcommands.clean]
+example = "git clean -n"
+rest = "arg"
+destroys = { reason = "git clean", always = true }
+options = [
+  { names = ["-d", "-f", "--force", "-i", "--interactive", "-n", "--dry-run", "-q", "--quiet", "-x", "-X"] },
+  { names = ["-e", "--exclude"], value = "required" },
+]
+
+[command.subcommands.reset]
+example = "git reset HEAD"
+rest = "arg"
+options = [
+  { names = ["--hard"], destroys = "git reset --hard" },
+  { names = ["--soft", "--mixed", "--merge", "--keep", "-q", "--quiet", "--no-quiet", "--no-recurse-submodules", "-p", "--patch", "-N", "--intent-to-add", "--pathspec-file-nul", "--no-refresh", "--refresh"] },
+  { names = ["--recurse-submodules"], value = "optional" },
+  { names = ["--pathspec-from-file", "-U", "--unified", "--inter-hunk-context"], value = "required" },
+]
+
+[command.subcommands.push]
+example = "git push origin main"
+rest = "arg"
+destroys = { reason = "git push of a forced or deleting refspec", operand_prefixes = ["+", ":"] }
+options = [
+  { names = ["-f", "--force", "--force-if-includes", "--mirror", "-d", "--delete", "--prune"], destroys = "git push --force" },
+  { names = ["--force-with-lease"], value = "optional", destroys = "git push --force" },
+  { names = ["--all", "--branches", "-n", "--dry-run", "--porcelain", "--tags", "--follow-tags", "--no-follow-tags", "--no-signed", "--atomic", "--no-atomic", "-u", "--set-upstream", "--thin", "--no-thin", "-q", "--quiet", "-v", "--verbose", "--progress", "--no-progress", "--no-recurse-submodules", "--verify", "--no-verify", "-4", "--ipv4", "-6", "--ipv6", "--no-force-if-includes", "--no-force-with-lease"] },
+  { names = ["--signed", "--recurse-submodules"], value = "optional" },
+  { names = ["-o", "--push-option", "--repo"], value = "required" },
+  { names = ["--receive-pack", "--exec"], value = "required", role = "text:remote-sh", example = "git push --receive-pack={} origin" },
+]
+
+[[command]]
+names = ["halt", "poweroff", "reboot", "shutdown"]
+example = "shutdown -h now"
+argv = "fixed"
+class = "destructive"
+reason = "destructive: stops or restarts the system"
+
+# --- setuid, setgid and file-capability binaries that do not elevate (class 1) ----------
+# A row exists so that someone has reviewed each one; their class does not depend on argv.
+
+[[command]]
+names = ["passwd", "chage", "chfn", "chsh", "expiry", "gpasswd"]
+example = "passwd"
+argv = "fixed"
+class = "mutating"
+reason = "changes account settings (setuid)"
+
+[[command]]
+names = ["mount", "umount", "fusermount", "fusermount3", "ntfs-3g", "mount.ntfs", "mount.ntfs-3g"]
+example = "mount"
+argv = "fixed"
+class = "mutating"
+reason = "mounts or unmounts file systems"
+
+[[command]]
