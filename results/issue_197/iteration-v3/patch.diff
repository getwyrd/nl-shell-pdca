+def test_class2_loader_refuses():
+    from nl_shell.gate import commands
+
+    def refuse(text: str, needle: str) -> None:
+        with pytest.raises(commands.CommandTableError) as info:
+            commands.parse_table(tomllib.loads(text))
+        assert needle in str(info.value), str(info.value)
+
+    commands.parse_table(tomllib.loads(MINIMAL))  # the baseline loads
+    refuse(MINIMAL + "raw = true\n", "raw")
+    refuse(MINIMAL + "colour = 1\n", "unknown key `colour`")
+    refuse(MINIMAL + 'options = [{ names = ["-q"], colour = 1 }]\n', "unknown key `colour`")
+    wrapper = MINIMAL + 'prefix = "x"\noperands = ["command"]\n'
+    refuse(wrapper, "no_command")
+    refuse(wrapper + 'no_command = "nothing"\n', "terminal_stdin")
+    refuse(wrapper + 'terminal_stdin = "error"\n', "no_command")
+    commands.parse_table(
+        tomllib.loads(wrapper + 'no_command = "nothing"\nterminal_stdin = "error"\n')
+    )
+    refuse(MINIMAL + 'class = "read-only"\n', "at least mutating")
+    refuse(
+        MINIMAL + 'options = [{ names = ["-c"], value = "required", role = "text:basic", '
+        'example = "x -c {}" }]\n',
+        "no known grammar",
+    )
+    # class 7: `class-7-gap` only on the spec's named options
+    refuse(
+        MINIMAL + 'options = [{ names = ["-c"], value = "required", gap = "class-7-gap" }]\n',
+        "class-7",
+    )
+    git = MINIMAL.replace('"x"', '"git"').replace("example = \"git\"", 'example = "git"')
+    commands.parse_table(
+        tomllib.loads(
+            git + 'options = [{ names = ["-c"], value = "required", gap = "class-7-gap" }]\n'
+        )
+    )
+    refuse(
+        git + 'options = [{ names = ["-q"], gap = "class-7-gap" }]\n',
+        "class-7",
+    )
