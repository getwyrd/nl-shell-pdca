diff --git a/scripts/harvest_inventory.py b/scripts/harvest_inventory.py
new file mode 100644
index 0000000..053a3e8
--- /dev/null
+++ b/scripts/harvest_inventory.py
@@ -0,0 +1,214 @@
+"""Write ``targets/ubuntu-26.04/inventory.toml`` from this host (#197, spec §4.1 class 1).
+
+The inventory is the list of binaries on the target that elevate, or that run a shell or
+an interpreter. Every name in it must have a row in ``commands.toml``
+(``tests/test_gate_commands.py`` checks that). It holds:
+
+- the setuid, setgid and file-capability binaries in ``/usr/bin``, ``/usr/sbin`` and
+  ``/usr/lib/cargo/bin``;
+- every name in those folders whose real path is the same file as one of those, or the
+  same real path as a ``commands.toml`` row's binary (``sudo-rs``, ``su-rs`` …);
+- the shells in ``/etc/shells``;
+- the binaries of installed dpkg packages in the sections ``shells`` and ``interpreters``;
+- ``python3*``, ``perl*``, ``busybox`` and ``gdb``.
+
+Usage::
+
+    python3 scripts/harvest_inventory.py [--output PATH] [--expect-version TEXT]
+
+The file is checked in and reviewed like an allowlist change; the gate and the tests never
+run this script. It records the host's ``VERSION`` line from ``/etc/os-release``. With
+``--expect-version`` the run fails when that line differs, so a regenerated file never
+silently comes from another release.
+"""
+
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import os
+import stat
+import subprocess
+import sys
+import tomllib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+TARGET = REPO / "targets" / "ubuntu-26.04"
+OUTPUT = TARGET / "inventory.toml"
+COMMANDS = TARGET / "commands.toml"
+FOLDERS = (Path("/usr/bin"), Path("/usr/sbin"), Path("/usr/lib/cargo/bin"))
+SHELLS = Path("/etc/shells")
+OS_RELEASE = Path("/etc/os-release")
+SECTIONS = ("shells", "interpreters")
+NAMED = ("python3*", "perl*", "busybox", "gdb")
+HEADER = """\
+# The ubuntu-26.04 binary inventory (spec policy-gate/v1 §4.1, class 1).
+#
+# GENERATED by scripts/harvest_inventory.py on the reference host; do not edit by hand.
+# Reviewed like an allowlist change: every name here must have a commands.toml row
+# (tests/test_gate_commands.py). `why` says how each name got here.
+"""
+
+
+def version_line() -> str:
+    for line in OS_RELEASE.read_text(encoding="utf-8").splitlines():
+        if line.startswith("VERSION="):
+            return line
+    raise SystemExit(f"{OS_RELEASE}: no VERSION line")
+
+
+def entries() -> list[Path]:
+    """Every name directly in the three folders."""
+    found = []
+    for folder in FOLDERS:
+        try:
+            found.extend(sorted(folder.iterdir()))
+        except OSError:
+            continue
+    return found
+
+
+def identity(path: Path) -> tuple[int, int] | None:
+    try:
+        info = os.stat(os.path.realpath(path))
+    except OSError:
+        return None
+    if not stat.S_ISREG(info.st_mode):
+        return None
+    return info.st_dev, info.st_ino
+
+
+def capabilities(paths: list[Path]) -> set[Path]:
+    regular = [str(p) for p in paths if p.is_file() and not p.is_symlink()]
+    try:
+        out = subprocess.run(
+            ["getcap", *regular], capture_output=True, text=True, check=False
+        ).stdout
+    except FileNotFoundError:
+        raise SystemExit("getcap not found (package libcap2-bin)") from None
+    return {Path(line.split()[0]) for line in out.splitlines() if line.strip()}
+
+
+def package_binaries() -> dict[Path, str]:
+    listing = subprocess.run(
+        ["dpkg-query", "-W", "-f", "${Section}\t${Package}\n"],
+        capture_output=True,
+        text=True,
+        check=True,
+    ).stdout
+    found: dict[Path, str] = {}
+    for line in listing.splitlines():
+        section, _, package = line.partition("\t")
+        if section.rsplit("/", 1)[-1] not in SECTIONS:
+            continue
+        files = subprocess.run(
+            ["dpkg", "-L", package], capture_output=True, text=True, check=False
+        ).stdout
+        for name in files.splitlines():
+            path = Path(name)
+            if path.parent in (Path("/bin"), Path("/sbin")):
+                path = Path("/usr") / path.parent.name / path.name  # merged /usr
+            if path.parent in FOLDERS:
+                found.setdefault(path, f"package {package} ({section})")
+    return found
+
+
+def row_names() -> list[str]:
+    if not COMMANDS.exists():
+        return []
+    doc = tomllib.loads(COMMANDS.read_text(encoding="utf-8"))
+    return [name for row in doc.get("command", []) for name in row.get("names", [])]
+
+
+def harvest() -> dict[str, dict[str, set[str]]]:
+    all_paths = entries()
+    inventory: dict[str, dict[str, set[str]]] = {}
+
+    def add(path: Path, why: str) -> None:
+        item = inventory.setdefault(path.name, {"paths": set(), "why": set()})
+        item["paths"].add(str(path))
+        item["why"].add(why)
+
+    caps = capabilities(all_paths)
+    listed: set[tuple[int, int]] = set()
+    for path in all_paths:
+        if path.is_symlink() or not path.is_file():
+            continue
+        mode = path.stat().st_mode
+        for bit, why in ((stat.S_ISUID, "setuid"), (stat.S_ISGID, "setgid")):
+            if mode & bit:
+                add(path, why)
+                listed.add(identity(path))
+        if path in caps:
+            add(path, "file capability")
+            listed.add(identity(path))
+    for line in SHELLS.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if line and not line.startswith("#"):
+            path = Path(line)
+            if path.parent == Path("/bin"):
+                path = Path("/usr/bin") / path.name
+            if path.exists():
+                add(path, "/etc/shells")
+                listed.add(identity(path))
+    for path, why in package_binaries().items():
+        if path.exists() or path.is_symlink():
+            add(path, why)
+            listed.add(identity(path))
+    for path in all_paths:
+        if any(fnmatch.fnmatchcase(path.name, pattern) for pattern in NAMED):
+            add(path, "named interpreter or runner")
+            listed.add(identity(path))
+    listed.discard(None)
+    # Aliases: the same file as a listed binary, or the same real path as a row's binary.
+    names = set(row_names())
+    row_real = set()
+    for name in names:
+        for folder in FOLDERS:
+            candidate = folder / name
+            if candidate.is_file():
+                row_real.add(os.path.realpath(candidate))
+    for path in all_paths:
+        if identity(path) in listed:
+            add(path, "alias (same file)")
+        elif (
+            path.name not in names
+            and path.is_file()
+            and os.path.realpath(path) in row_real
+        ):
+            add(path, "alias (same real path as a row's binary)")
+    return inventory
+
+
+def render(inventory: dict[str, dict[str, set[str]]], version: str) -> str:
+    out = [HEADER, f"version_line = {toml_string(version)}", ""]
+    for name in sorted(inventory):
+        item = inventory[name]
+        out.append("[[binary]]")
+        out.append(f"name = {toml_string(name)}")
+        out.append("paths = [" + ", ".join(toml_string(p) for p in sorted(item["paths"])) + "]")
+        out.append("why = [" + ", ".join(toml_string(w) for w in sorted(item["why"])) + "]")
+        out.append("")
+    return "\n".join(out)
+
+
+def toml_string(text: str) -> str:
+    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    parser.add_argument("--expect-version", default=None)
+    args = parser.parse_args(argv)
+    version = version_line()
+    if args.expect_version is not None and version != args.expect_version:
+        print(f"host VERSION is {version!r}, expected {args.expect_version!r}", file=sys.stderr)
+        return 1
+    args.output.write_text(render(harvest(), version), encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
