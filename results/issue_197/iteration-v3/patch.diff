+                    acc.opens_shell = True
+                    acc.raise_to("mutating", f"{OPENS_SHELL}: {name}")
+            else:
+                self.cannot_read(acc, f"{name} runs a file as code: {word.source}")
+        elif kind == "text":
+            self.text(acc, word, role.grammar, inv.stdin)
+        elif kind == "stored":
+            self.text(acc, word, role.grammar, TERMINAL)
+        elif kind in ("name", "unset"):
+            self.name_field(acc, word, write=True, from_runtime=kind == "name")
+        elif kind == "subscript":
+            self.name_field(acc, word, write=False, from_runtime=False)
+        elif kind == "arith":
+            if word.literal:
+                self.arith(acc, word.text)
+            else:
+                self.cannot_read(acc, "arithmetic text that is not a literal")
+        elif kind == "declare":
+            self.declare(acc, name, st, word)
+        elif kind == "alias":
+            self.alias(acc, word)
+        elif kind == "bind-x":
+            self.bind_x(acc, word)
+        elif kind == "env-assign":
+            self.env_assign(acc, word)
+        else:  # pragma: no cover - the loader admits no other role
