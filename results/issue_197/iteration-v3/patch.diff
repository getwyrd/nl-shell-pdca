+    def stdin_code(self, acc, row, name, mode, inv, grammar=None) -> bool:
+        """The command reads code from stdin. Returns whether that opens a shell."""
+        grammar = grammar or row.stdin_grammar
+        stdin = inv.stdin
+        if stdin.kind == "terminal":
+            if mode.terminal_stdin == "opens-shell":
+                return True
+            if mode.terminal_stdin == "reads-terminal":
+                acc.raise_to("mutating", f"{name} reads code from the terminal")
+            return False
+        if stdin.kind == "literal" and stdin.value is not None:
+            # The code's own commands read the rest of that stdin: unknown to them.
+            self.text(acc, Word(stdin.value, True, stdin.value), grammar, UNKNOWN)
