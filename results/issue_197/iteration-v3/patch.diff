@@ -0,0 +1,777 @@
+"""Loading the gate's command table, ``targets/<id>/commands.toml`` (issue #197).
+
+Spec ``policy-gate/v1`` §4.1. The command table is reviewed data, like the allowlist: it
+says, per command word, how the command reads its argv and what each part of it does.
+``nl_shell.gate.rules`` is the one engine that reads it; no command has a code path of its
+own.
+
+The loader takes no path argument. It reads ``TARGETS_ROOT / TARGET_ID / COMMANDS_FILE``,
+where ``TARGET_ID`` is a module constant (the one target folder the repository ships),
+and refuses a resolved path outside ``TARGETS_ROOT`` (as ``nl_shell.targets.load`` does).
+It reads no environment variable, no working directory and no config file, so nothing
+outside the reviewed file can change what a command means. A missing or invalid file is a
+``CommandTableError``; the gate turns that into decision C.
+
+The format (every key is checked; an unknown key is an error):
+
+- top level: ``format = 1``, ``target`` (must be ``TARGET_ID``), optional
+  ``[variables]`` and the ``[[command]]`` rows;
+- ``[variables] stored``: the variables whose value is code run later, mapped to the
+  grammar it is read in (``bash``, ``prompt``) or ``file`` (a file run later);
+- a row: ``names`` (command words), optional ``patterns`` (``fnmatch`` globs such as
+  ``mkfs.*``), ``example`` (a minimal invocation), ``argv`` (``options``: the engine
+  parses argv with the row's grammar; ``fixed``: the row's class does not depend on argv),
+  ``class`` (at least ``mutating``), ``reason``, ``elevates``, ``stdin`` (``reject``: a
+  pipe, here-doc or here-string into it is rejected), ``permute`` (options may follow
+  operands), ``end_of_options`` (``--`` ends options), ``number_flags`` (``-9``, ``-KILL``
+  are flags), ``plus_options`` (``+x`` is read like ``-x``), ``options``, ``destroys``,
+  ``subcommands``, ``subcommand_default``, ``modes``, ``runtime_args``,
+  ``stdin_grammar``, ``prefix``, ``shell_example``, and the default mode's keys;
+- a mode (the row itself is the ``default`` mode): ``operands`` (roles, in order),
+  ``rest`` (the role of every later operand), ``stdin_code`` (this mode always reads
+  stdin as code in that grammar), ``no_command`` and ``terminal_stdin`` (what it does
+  when no command is given and when stdin is the terminal), ``opens_shell``, ``class``,
+  ``priority``;
+- an option: ``names``, ``value`` (``none``, ``required``, ``optional`` (long ``=`` or
+  short attached only) or ``attached``), ``values`` (how many words a required value
+  takes), ``role`` (of the value), ``reject``, ``destroys``, ``shell``, ``mode``,
+  ``attribute``, ``exec``, ``placeholder``, ``command``, ``gap``, ``example``.
+
+Roles: ``arg``, ``command``, ``script``, ``positional``, ``name``, ``unset``, ``subscript``,
+``arith``, ``declare``, ``alias``, ``bind-x``, ``env-assign``, ``fd``, ``split``, and
+``text:<grammar>``, ``joined-text:<grammar>``, ``stored:<grammar>``.
+"""
+
+from __future__ import annotations
+
+import functools
+import tomllib
+from dataclasses import dataclass, field
+from fnmatch import fnmatchcase
+from pathlib import Path
+from types import MappingProxyType
+from typing import Any
+
+from nl_shell import targets
+from nl_shell.gate.parse import CLASSES
+
+# The one place the table is read from. Tests patch TARGETS_ROOT (and clear the cache).
+TARGETS_ROOT: Path = targets.TARGETS_ROOT
+
+
+def _sole_target(root: Path) -> str | None:
+    """The one target the repository ships (v1 ships one). Code names no OS
+    (ADR-0023), so the id is the only folder under ``targets/``, fixed when this module
+    loads; never ``/etc/os-release``, the environment or a config file. With no target or
+    more than one, it is None and every command is decision C until this changes."""
+    names = targets.available(root)
+    return names[0] if len(names) == 1 else None
+
+
+TARGET_ID: str | None = _sole_target(TARGETS_ROOT)
+COMMANDS_FILE = "commands.toml"
+FORMAT = 1
+
+# Grammars the engine has a parser for, and grammars it names but does not parse (text in
+# those is decision B).
+PARSED_GRAMMARS = frozenset(("bash", "sh", "env-split", "arithmetic", "prompt", "bind-x"))
+UNPARSED_GRAMMARS = frozenset(
+    ("python", "perl", "tcl", "js", "gdb", "tmux", "screen", "gshell", "unit", "remote-sh")
+)
+GRAMMARS = PARSED_GRAMMARS | UNPARSED_GRAMMARS
+
+PLAIN_ROLES = frozenset(("arg", "command", "script", "positional", "fd", "split", "env-assign"))
+# Roles whose field must carry an `example` (a template with `{}`), so the tests can put
+# a chosen word in that field.
+EXAMPLE_ROLES = frozenset(
+    ("name", "unset", "subscript", "arith", "alias", "bind-x", "declare")
+)
+GRAMMAR_ROLES = ("text", "joined-text", "stored")
+RUN_ROLES = ("command", "script", "text", "joined-text")  # what `no_command` is about
+NO_COMMAND = frozenset(("opens-shell", "stdin-code", "nothing", "error"))
+TERMINAL_STDIN = frozenset(("opens-shell", "reads-terminal", "error"))
+VALUES = frozenset(("none", "required", "optional", "attached"))
+ATTRIBUTES = frozenset(("integer", "nameref"))
+STORED_KINDS = frozenset(("bash", "prompt", "file"))
+
+# Class 7: the only options that may carry `gap = "class-7-gap"` (spec §4.1, class 7).
+CLASS7_GAP = "class-7-gap"
+CLASS7_OPTIONS = MappingProxyType(
+    {
+        "git": frozenset(("-c", "--config-env", "--exec-path")),
+        "tar": frozenset(("--to-command",)),
+        "ssh": frozenset(("-o",)),
+    }
+)
+
+_ROW_KEYS = frozenset(
+    (
+        "names",
+        "patterns",
+        "example",
+        "argv",
+        "class",
+        "reason",
+        "elevates",
+        "stdin",
+        "permute",
+        "end_of_options",
+        "number_flags",
+        "plus_options",
+        "options",
+        "destroys",
+        "subcommands",
+        "subcommand_default",
+        "modes",
+        "runtime_args",
+        "stdin_grammar",
+        "prefix",
+        "shell_example",
+    )
+)
+_MODE_KEYS = frozenset(
+    (
+        "operands",
+        "rest",
+        "stdin_code",
+        "no_command",
+        "terminal_stdin",
+        "opens_shell",
+        "class",
+        "priority",
+    )
+)
+_SUB_ONLY_KEYS = frozenset(
+    ("example", "class", "reason", "elevates", "destroys", "inherit_options")
+)
+_SUB_KEYS = _SUB_ONLY_KEYS | {"options", "permute"} | _MODE_KEYS
+_OPTION_KEYS = frozenset(
+    (
+        "names",
+        "value",
+        "values",
+        "role",
+        "reject",
+        "destroys",
+        "shell",
+        "mode",
+        "attribute",
+        "exec",
+        "placeholder",
+        "command",
+        "gap",
+        "example",
+    )
+)
+_DESTROYS_KEYS = frozenset(("reason", "always", "glob_operands", "words", "operand_prefixes"))
+_OPERAND_KEYS = frozenset(("role", "example"))
+
+
+class CommandTableError(Exception):
+    """The command table could not be loaded; the message says why."""
+
+
+@dataclass(frozen=True)
+class Role:
+    """What one argv field is: ``kind`` (``arg``, ``command``, ``text``, …), the
+    ``grammar`` for the text kinds, and the field's ``example`` template."""
+
+    kind: str
+    grammar: str | None = None
+    example: str | None = None
+
+
+@dataclass(frozen=True)
+class Option:
+    names: tuple[str, ...]
+    value: str = "none"
+    values: int = 1
+    role: Role = Role("arg")
+    reject: str | None = None
+    destroys: str | None = None
+    shell: bool = False
+    mode: str | None = None
+    attribute: str | None = None
+    exec: bool = False
+    placeholder: bool = False
+    command: bool = False
+    gap: bool = False
+    example: str | None = None
+
+
+@dataclass(frozen=True)
+class Destroys:
+    reason: str
+    always: bool = False
+    glob_operands: bool = False
+    words: tuple[str, ...] = ()
+    operand_prefixes: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True)
+class Mode:
+    operands: tuple[Role, ...] = ()
+    rest: Role = Role("arg")
+    stdin_code: str | None = None
+    no_command: str | None = None
+    terminal_stdin: str | None = None
+    opens_shell: bool = False
+    cls: str | None = None
+    priority: int = 0
+
+    def roles(self) -> tuple[Role, ...]:
+        return (*self.operands, self.rest)
+
+    def runs(self) -> bool:
+        return any(r.kind in RUN_ROLES for r in self.roles()) or self.stdin_code is not None
+
+
+@dataclass(frozen=True)
+class Grammar:
+    """The argv grammar of a row or a described subcommand."""
+
+    options: tuple[Option, ...]
+    modes: MappingProxyType  # name -> Mode; always has "default"
+    permute: bool = True
+    end_of_options: bool = True
+    number_flags: bool = False
+    plus_options: bool = False
+
+    def find(self, name: str) -> Option | None:
+        for option in self.options:
+            if name in option.names:
+                return option
+        return None
+
+    def abbreviations(self, prefix: str) -> list[Option]:
+        found: list[Option] = []
+        for option in self.options:
+            if any(n.startswith("--") and n.startswith(prefix) for n in option.names):
+                if option not in found:
+                    found.append(option)
+        return found
+
+
+@dataclass(frozen=True)
+class Subcommand:
+    name: str
+    example: str
+    cls: str | None
+    reason: str | None
+    elevates: bool
+    destroys: Destroys | None
+    grammar: Grammar
+
+
+@dataclass(frozen=True)
+class Row:
+    names: tuple[str, ...]
+    patterns: tuple[str, ...]
+    example: str
+    argv: str  # options | fixed
+    cls: str
+    reason: str
+    elevates: bool
+    stdin: str | None
+    grammar: Grammar | None
+    destroys: Destroys | None
+    subcommands: MappingProxyType  # name -> Subcommand
+    subcommand_default: str | None
+    runtime_args: bool
+    stdin_grammar: str | None
+    prefix: str | None
+    shell_example: str | None
+
+    def any_elevates(self) -> bool:
+        return self.elevates or any(s.elevates for s in self.subcommands.values())
+
+    def any_destroys(self) -> bool:
+        if self.destroys is not None:
+            return True
+        grammars = [self.grammar] + [s.grammar for s in self.subcommands.values()]
+        if any(s.destroys is not None for s in self.subcommands.values()):
+            return True
+        return any(
+            g is not None and any(o.destroys for o in g.options) for g in grammars
+        )
+
+
+@dataclass(frozen=True)
+class Table:
+    rows: tuple[Row, ...]
+    stored: MappingProxyType  # variable name -> bash | prompt | file
+    by_name: MappingProxyType = field(default=MappingProxyType({}))
+
+    def lookup(self, name: str) -> Row | None:
+        row = self.by_name.get(name)
+        if row is not None:
+            return row
+        for candidate in self.rows:
+            if any(fnmatchcase(name, p) for p in candidate.patterns):
+                return candidate
+        return None
+
+
+def path() -> Path:
+    """Where the table is read from (``TARGETS_ROOT/TARGET_ID/COMMANDS_FILE``)."""
+    return TARGETS_ROOT / TARGET_ID / COMMANDS_FILE
+
+
+def load() -> Table:
+    """The command table. Cached per ``TARGETS_ROOT``; ``cache_clear`` drops it."""
+    return _load(TARGETS_ROOT)
+
+
+@functools.cache
+def _load(root: Path) -> Table:
+    if TARGET_ID is None or not targets.is_plain_id(TARGET_ID):
+        raise CommandTableError(f"no single target to read the command table of: {TARGET_ID!r}")
+    file = root / TARGET_ID / COMMANDS_FILE
+    try:
+        resolved = file.resolve()
+        inside = resolved.is_relative_to(root.resolve())
+    except OSError as exc:
+        raise CommandTableError(f"{file}: cannot resolve: {exc}") from None
+    if not inside:
+        raise CommandTableError(f"{file}: resolves outside {root}")
+    try:
+        data = resolved.read_bytes()
+    except FileNotFoundError:
+        raise CommandTableError(f"{file}: missing") from None
+    except OSError as exc:
+        raise CommandTableError(f"{file}: cannot read: {exc.strerror or exc}") from None
+    try:
+        doc = tomllib.loads(data.decode("utf-8"))
+    except UnicodeDecodeError:
+        raise CommandTableError(f"{file}: not valid TOML: not valid UTF-8") from None
+    except tomllib.TOMLDecodeError as exc:
+        raise CommandTableError(f"{file}: not valid TOML: {exc}") from None
+    return parse_table(doc, str(file))
+
+
+def cache_clear() -> None:
+    _load.cache_clear()
+
+
+# --- validation ----------------------------------------------------------------------
+
+
+def parse_table(doc: dict[str, Any], where: str = COMMANDS_FILE) -> Table:
+    """Validate a parsed ``commands.toml`` document."""
+    _keys(doc, {"format", "target", "variables", "command"}, where)
+    if doc.get("format") != FORMAT:
+        raise CommandTableError(f"{where}: `format` must be {FORMAT}")
+    if doc.get("target") != TARGET_ID:
+        raise CommandTableError(f"{where}: `target` must be {TARGET_ID!r}")
+    variables = doc.get("variables", {})
+    if not isinstance(variables, dict):
+        raise CommandTableError(f"{where}: `variables` must be a table")
+    _keys(variables, {"stored"}, f"{where}: variables")
+    stored = variables.get("stored", {})
+    if not isinstance(stored, dict) or any(v not in STORED_KINDS for v in stored.values()):
+        raise CommandTableError(
+            f"{where}: `variables.stored` maps names to one of {sorted(STORED_KINDS)}"
+        )
+    entries = doc.get("command", [])
+    if not isinstance(entries, list) or not entries:
+        raise CommandTableError(f"{where}: `command` must be a non-empty list of rows")
+    rows = []
+    by_name: dict[str, Row] = {}
+    for n, entry in enumerate(entries, 1):
+        if not isinstance(entry, dict):
+            raise CommandTableError(f"{where}: command {n} must be a table")
+        label = entry.get("names", [f"#{n}"])
+        row = _row(entry, f"{where}: command {n} ({label[0] if label else n})")
+        for name in row.names:
+            if name in by_name:
+                raise CommandTableError(f"{where}: command word {name!r} has two rows")
+            by_name[name] = row
+        rows.append(row)
+    return Table(
+        rows=tuple(rows),
+        stored=MappingProxyType(dict(stored)),
+        by_name=MappingProxyType(by_name),
+    )
+
+
+def _keys(table: dict, allowed, where: str) -> None:
+    if "raw" in table:
+        raise CommandTableError(f"{where}: `raw` is not allowed: every row parses its argv")
+    unknown = sorted(set(table) - set(allowed))
+    if unknown:
+        raise CommandTableError(f"{where}: unknown key `{unknown[0]}`")
+
+
+def _string(table: dict, key: str, where: str, required: bool = False) -> str | None:
+    if key not in table:
+        if required:
+            raise CommandTableError(f"{where}: missing required key `{key}`")
+        return None
+    value = table[key]
+    if not isinstance(value, str) or not value:
+        raise CommandTableError(f"{where}: `{key}` must be a non-empty string")
+    return value
+
+
+def _bool(table: dict, key: str, where: str, default: bool = False) -> bool:
+    value = table.get(key, default)
+    if not isinstance(value, bool):
+        raise CommandTableError(f"{where}: `{key}` must be a boolean")
+    return value
+
+
+def _strings(table: dict, key: str, where: str, required: bool = False) -> tuple[str, ...]:
+    if key not in table:
+        if required:
+            raise CommandTableError(f"{where}: missing required key `{key}`")
+        return ()
+    value = table[key]
+    if (
+        not isinstance(value, list)
+        or (required and not value)
+        or not all(isinstance(v, str) and v for v in value)
+    ):
+        raise CommandTableError(f"{where}: `{key}` must be a list of non-empty strings")
+    return tuple(value)
+
+
+def _class(table: dict, key: str, where: str) -> str | None:
+    value = table.get(key)
+    if value is None:
+        return None
+    if value not in CLASSES:
+        raise CommandTableError(f"{where}: `{key}` must be one of {', '.join(CLASSES)}")
+    if value == "read-only":
+        raise CommandTableError(f"{where}: `{key}` must be at least mutating (decision A)")
+    return value
+
+
+def _role(spec, where: str) -> Role:
+    example = None
+    if isinstance(spec, dict):
+        _keys(spec, _OPERAND_KEYS, where)
+        example = _string(spec, "example", where)
+        spec = spec.get("role")
+    if not isinstance(spec, str) or not spec:
+        raise CommandTableError(f"{where}: a role must be a non-empty string")
+    kind, _, grammar = spec.partition(":")
+    if kind in GRAMMAR_ROLES:
+        if grammar not in GRAMMARS:
+            raise CommandTableError(
+                f"{where}: role {spec!r} names no known grammar "
+                f"(known: {', '.join(sorted(GRAMMARS))})"
+            )
+        if grammar in ("env-split", "arithmetic", "bind-x"):
+            raise CommandTableError(f"{where}: grammar {grammar!r} has its own role")
+        role = Role(kind, grammar, example)
+    elif grammar:
+        raise CommandTableError(f"{where}: role {kind!r} takes no grammar")
+    elif kind in PLAIN_ROLES or kind in EXAMPLE_ROLES:
+        role = Role(kind, None, example)
+    else:
+        raise CommandTableError(f"{where}: unknown role {spec!r}")
+    if (role.kind in EXAMPLE_ROLES or role.kind in GRAMMAR_ROLES) and not (
+        example and "{}" in example
+    ):
+        raise CommandTableError(f"{where}: role {spec!r} needs an `example` with {{}}")
+    return role
+
+
+def _destroys(spec, where: str) -> Destroys | None:
+    if spec is None:
+        return None
+    if not isinstance(spec, dict):
+        raise CommandTableError(f"{where}: `destroys` must be a table")
+    _keys(spec, _DESTROYS_KEYS, f"{where}: destroys")
+    destroys = Destroys(
+        reason=_string(spec, "reason", f"{where}: destroys", required=True),
+        always=_bool(spec, "always", where),
+        glob_operands=_bool(spec, "glob_operands", where),
+        words=_strings(spec, "words", where),
+        operand_prefixes=_strings(spec, "operand_prefixes", where),
+    )
+    if not (
+        destroys.always or destroys.glob_operands or destroys.words or destroys.operand_prefixes
+    ):
+        raise CommandTableError(f"{where}: `destroys` names no condition")
+    return destroys
+
+
+def _option(spec, names_of_row: tuple[str, ...], where: str) -> Option:
+    if not isinstance(spec, dict):
+        raise CommandTableError(f"{where}: an option must be a table")
+    _keys(spec, _OPTION_KEYS, where)
+    names = _strings(spec, "names", where, required=True)
+    for name in names:
+        if not (name.startswith(("-", "+")) or name in ("(", ")", "!", ",")):
+            raise CommandTableError(f"{where}: option name {name!r} must start with - or +")
+    where = f"{where} {names[0]}"
+    value = spec.get("value", "none")
+    if value not in VALUES:
+        raise CommandTableError(f"{where}: `value` must be one of {sorted(VALUES)}")
+    values = spec.get("values", 1)
+    if not isinstance(values, int) or isinstance(values, bool) or values < 1:
+        raise CommandTableError(f"{where}: `values` must be a positive integer")
+    if values != 1 and value != "required":
+        raise CommandTableError(f"{where}: `values` needs `value = \"required\"`")
+    role_spec = spec.get("role", "arg")
+    role_where = where
+    if "example" in spec:
+        role_spec = {"role": role_spec, "example": spec["example"]}
+    role = _role(role_spec, role_where)
+    if value == "none" and role.kind != "arg":
+        raise CommandTableError(f"{where}: an option with no value has no value role")
+    if role.kind in ("command", "declare", "positional") or role.kind == "joined-text":
+        raise CommandTableError(f"{where}: role {role.kind!r} is not a value role")
+    gap = spec.get("gap")
+    if gap is not None:
+        if gap != CLASS7_GAP:
+            raise CommandTableError(f"{where}: `gap` must be {CLASS7_GAP!r}")
+        allowed = set()
+        for row_name in names_of_row:
+            allowed |= CLASS7_OPTIONS.get(row_name, frozenset())
+        if not set(names) <= allowed:
+            raise CommandTableError(
+                f"{where}: `{CLASS7_GAP}` is only for the spec's class-7 options "
+                "(git -c/--config-env/--exec-path, tar --to-command, ssh -o)"
+            )
+    attribute = _string(spec, "attribute", where)
+    if attribute is not None and attribute not in ATTRIBUTES:
+        raise CommandTableError(f"{where}: `attribute` must be one of {sorted(ATTRIBUTES)}")
+    option = Option(
+        names=names,
+        value=value,
+        values=values,
+        role=role,
+        reject=_string(spec, "reject", where),
+        destroys=_string(spec, "destroys", where),
+        shell=_bool(spec, "shell", where),
+        mode=_string(spec, "mode", where),
+        attribute=attribute,
+        exec=_bool(spec, "exec", where),
+        placeholder=_bool(spec, "placeholder", where),
+        command=_bool(spec, "command", where),
+        gap=gap is not None,
+        example=_string(spec, "example", where),
+    )
+    if (option.exec or option.command) and value != "none":
+        raise CommandTableError(f"{where}: `exec`/`command` options take no value")
+    if option.placeholder and value == "none":
+        raise CommandTableError(f"{where}: a `placeholder` option takes a value")
+    return option
+
+
+def _mode(spec: dict, where: str) -> Mode:
+    operands = spec.get("operands", [])
+    if not isinstance(operands, list):
+        raise CommandTableError(f"{where}: `operands` must be a list")
+    roles = tuple(_role(r, f"{where}: operand {i}") for i, r in enumerate(operands, 1))
+    rest = _role(spec.get("rest", "arg"), f"{where}: rest")
+    for role in roles[:-1]:
+        if role.kind in ("command", "joined-text"):
+            raise CommandTableError(f"{where}: a {role.kind!r} operand must come last")
+    if rest.kind == "command":
+        raise CommandTableError(f"{where}: `rest` cannot be `command`; use an operand")
+    stdin_code = _string(spec, "stdin_code", where)
+    if stdin_code is not None and stdin_code not in GRAMMARS:
+        raise CommandTableError(f"{where}: `stdin_code` names no known grammar")
+    no_command = _string(spec, "no_command", where)
+    if no_command is not None and no_command not in NO_COMMAND:
+        raise CommandTableError(f"{where}: `no_command` must be one of {sorted(NO_COMMAND)}")
+    terminal = _string(spec, "terminal_stdin", where)
+    if terminal is not None and terminal not in TERMINAL_STDIN:
+        raise CommandTableError(
+            f"{where}: `terminal_stdin` must be one of {sorted(TERMINAL_STDIN)}"
+        )
+    priority = spec.get("priority", 0)
+    if not isinstance(priority, int) or isinstance(priority, bool):
+        raise CommandTableError(f"{where}: `priority` must be an integer")
+    mode = Mode(
+        operands=roles,
+        rest=rest,
+        stdin_code=stdin_code,
+        no_command=no_command,
+        terminal_stdin=terminal,
+        opens_shell=_bool(spec, "opens_shell", where),
+        cls=_class(spec, "class", where),
+        priority=priority,
+    )
+    if mode.runs() or mode.no_command == "stdin-code":
+        # Class 2: a row that runs something says what it does with no command and with
+        # the terminal on stdin.
+        if mode.no_command is None or mode.terminal_stdin is None:
+            raise CommandTableError(
+                f"{where}: a mode that runs a command, a script or stdin must declare "
+                "`no_command` and `terminal_stdin`"
+            )
+    return mode
+
+
+def _grammar(spec: dict, names: tuple[str, ...], where: str, inherited=()) -> Grammar:
+    options = spec.get("options", [])
+    if not isinstance(options, list):
+        raise CommandTableError(f"{where}: `options` must be a list")
+    parsed = tuple(_option(o, names, f"{where}: option") for o in options)
+    # The row's (or subcommand's) `class` is its own, not a mode override.
+    own = {k: v for k, v in spec.items() if k in _MODE_KEYS and k != "class"}
+    modes = {"default": _mode(own, where)}
+    extra = spec.get("modes", {})
+    if not isinstance(extra, dict):
+        raise CommandTableError(f"{where}: `modes` must be a table")
+    for name, mode in extra.items():
+        if not isinstance(mode, dict):
+            raise CommandTableError(f"{where}: mode {name!r} must be a table")
+        _keys(mode, _MODE_KEYS, f"{where}: mode {name}")
+        modes[name] = _mode(mode, f"{where}: mode {name}")
+    for option in parsed:
+        if option.mode is not None and option.mode not in modes:
+            raise CommandTableError(f"{where}: option {option.names[0]} names no mode")
+    return Grammar(
+        options=tuple(inherited) + parsed,
+        modes=MappingProxyType(modes),
+        permute=_bool(spec, "permute", where, True),
+        end_of_options=_bool(spec, "end_of_options", where, True),
+        number_flags=_bool(spec, "number_flags", where),
+        plus_options=_bool(spec, "plus_options", where),
+    )
+
+
+def _starts_with(example: str, words: tuple[str, ...], where: str, key: str) -> None:
+    head = example.split()[0] if example.split() else ""
+    if head not in words:
+        raise CommandTableError(f"{where}: `{key}` must start with one of the row's names")
+
+
+def _row(entry: dict, where: str) -> Row:
+    _keys(entry, _ROW_KEYS | _MODE_KEYS, where)
+    names = _strings(entry, "names", where, required=True)
+    patterns = _strings(entry, "patterns", where)
+    example = _string(entry, "example", where, required=True)
+    _starts_with(example, names, where, "example")
+    argv = _string(entry, "argv", where, required=True)
+    if argv not in ("options", "fixed"):
+        raise CommandTableError(f"{where}: `argv` must be `options` or `fixed`")
+    cls = _class(entry, "class", where) or "mutating"
+    stdin = _string(entry, "stdin", where)
+    if stdin not in (None, "reject"):
+        raise CommandTableError(f"{where}: `stdin` must be `reject`")
+    grammar = None
+    subcommands: dict[str, Subcommand] = {}
+    if argv == "fixed":
+        allowed = {"names", "patterns", "example", "argv", "class", "reason", "elevates"}
+        extra = sorted(set(entry) - allowed)
+        if extra:
+            raise CommandTableError(f"{where}: a `fixed` row takes no `{extra[0]}`")
+    else:
+        grammar = _grammar(entry, names, where)
+        subs = entry.get("subcommands", {})
+        if not isinstance(subs, dict):
+            raise CommandTableError(f"{where}: `subcommands` must be a table")
+        for sub_name, spec in subs.items():
+            sub_where = f"{where}: subcommand {sub_name}"
+            if not isinstance(spec, dict):
+                raise CommandTableError(f"{sub_where}: must be a table")
+            _keys(spec, _SUB_KEYS, sub_where)
+            sub_example = _string(spec, "example", sub_where, required=True)
+            parts = sub_example.split()
+            if len(parts) < 2 or parts[0] not in names or parts[1] != sub_name:
+                raise CommandTableError(
+                    f"{sub_where}: `example` must start with the command and {sub_name!r}"
+                )
+            inherited = grammar.options if _bool(spec, "inherit_options", sub_where) else ()
+            subcommands[sub_name] = Subcommand(
+                name=sub_name,
+                example=sub_example,
+                cls=_class(spec, "class", sub_where),
+                reason=_string(spec, "reason", sub_where),
+                elevates=_bool(spec, "elevates", sub_where),
+                destroys=_destroys(spec.get("destroys"), sub_where),
+                grammar=_grammar(
+                    {k: v for k, v in spec.items() if k not in _SUB_ONLY_KEYS - {"class"}},
+                    names,
+                    sub_where,
+                    inherited,
+                ),
+            )
+    row = Row(
+        names=names,
+        patterns=patterns,
+        example=example,
+        argv=argv,
+        cls=cls,
+        reason=_string(entry, "reason", where) or "not allowlisted",
+        elevates=_bool(entry, "elevates", where),
+        stdin=stdin,
+        grammar=grammar,
+        destroys=_destroys(entry.get("destroys"), where),
+        subcommands=MappingProxyType(subcommands),
+        subcommand_default=_class(entry, "subcommand_default", where),
+        runtime_args=_bool(entry, "runtime_args", where),
+        stdin_grammar=_string(entry, "stdin_grammar", where),
+        prefix=_string(entry, "prefix", where),
+        shell_example=_string(entry, "shell_example", where),
+    )
+    if row.stdin_grammar is not None and row.stdin_grammar not in GRAMMARS:
+        raise CommandTableError(f"{where}: `stdin_grammar` names no known grammar")
+    grammars = [row.grammar] + [s.grammar for s in row.subcommands.values()]
+    modes = [m for g in grammars if g is not None for m in g.modes.values()]
+    if any(m.no_command == "stdin-code" or _reads_script(m) for m in modes) and (
+        row.stdin_grammar is None
+    ):
+        raise CommandTableError(f"{where}: a row that runs stdin as code needs `stdin_grammar`")
+    if row.grammar is not None and any(
+        r.kind == "command" for r in row.grammar.modes["default"].roles()
+    ):
+        if row.prefix is None:
+            raise CommandTableError(f"{where}: a row with a `command` operand needs `prefix`")
+    if row.prefix is not None:
+        _starts_with(row.prefix, names, where, "prefix")
+    if any(
+        m.opens_shell or m.no_command == "opens-shell" or m.terminal_stdin == "opens-shell"
+        for m in modes
+    ) or any(o.shell for g in grammars if g is not None for o in g.options):
+        if row.shell_example is None:
+            raise CommandTableError(f"{where}: a row that can open a shell needs `shell_example`")
+    if row.shell_example is not None:
+        _starts_with(row.shell_example, names, where, "shell_example")
+    return row
+
+
+def _reads_script(mode: Mode) -> bool:
+    return any(r.kind == "script" for r in mode.roles())
+
+
+# --- views for tests and review ------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Field:
+    """One annotated argv field: its ``example`` template (``{}`` is where a chosen word
+    goes), its ``role``, and whether later words become positional parameters."""
+
+    example: str
+    role: Role
+    positional: bool
+
+
+def fields(row: Row) -> list[Field]:
+    """Every annotated argv field of ``row``."""
+    found: list[Field] = []
+    grammars = [row.grammar] + [s.grammar for s in row.subcommands.values()]
+    for grammar in grammars:
+        if grammar is None:
+            continue
+        for option in grammar.options:
+            if option.role.example:
+                target = grammar.modes.get(option.mode or "default")
+                positional = target is not None and target.rest.kind == "positional"
+                found.append(Field(option.role.example, option.role, positional))
+        for mode in grammar.modes.values():
+            for role in mode.roles():
+                if role.example:
+                    found.append(Field(role.example, role, mode.rest.kind == "positional"))
+    unique: list[Field] = []
+    for item in found:
+        if item not in unique:
+            unique.append(item)
+    return unique
