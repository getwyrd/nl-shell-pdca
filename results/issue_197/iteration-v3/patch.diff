+class Recurse(Protocol):
+    """What ``nl_shell.gate`` passes in so inner text goes through the whole pipeline
+    with the one shared work budget."""
+
+    def bash(self, text: str, stdin: Stdin) -> Verdict: ...
+
+    def words(self, text: str) -> tuple[Word, ...] | None: ...
+
+
+def table() -> commands.Table:
+    """The command table, or decision C."""
+    try:
+        return commands.load()
+    except commands.CommandTableError:
+        raise GateFailure("command table missing or invalid") from None
+
+
+def system_path(path: str) -> bool:
+    """A literal absolute path whose directory is one of the system directories."""
+    if not path.startswith("/"):
+        return False
+    parts = path.split("/")
+    if ".." in parts or "." in parts:
+        return False
+    directory, _, name = re.sub(r"/+", "/", path).rpartition("/")
+    return bool(name) and directory in SYSTEM_DIRS
+
+
+def protected(name: str) -> bool:
+    return name in SUDO_REJECTED
+
+
+def session_name(name: str) -> bool:
+    return name in SESSION_NAMES or name.startswith(SESSION_PREFIXES)
+
+
+def classify(invocation, *, origin: str = "typed", recurse: Recurse | None = None) -> Verdict:
+    """Class one ``nl_shell.gate.parse.Invocation``. Without ``recurse`` no inner text
+    can be classed, so every piece of it is decision B."""
+    engine = _Engine(table(), origin, recurse)
+    acc = _Acc()
+    engine.command(acc, list(invocation.words), invocation, 0)
+    return acc.verdict()
+
+
+def assignment(name: str, value: Word | None, *, origin: str, recurse: Recurse | None) -> Verdict:
+    """§3/class 6 for a shell assignment the walk recorded (``PROMPT_COMMAND='…'``,
+    ``export PS1=…``, ``BASH_ENV=…``): the value of a stored-code variable is classed as
+    the code it is."""
+    engine = _Engine(table(), origin, recurse)
+    acc = _Acc()
+    engine.stored_value(acc, name, value)
+    return acc.verdict()
