+++ b/tests/test_gate_commands.py
@@ -0,0 +1,758 @@
+"""The policy gate's command layer (issue #197, spec ``policy-gate/v1`` §4.1, §3-§5).
+
+Each case goes through the public ``nl_shell.gate.classify``. The groups follow the seven
+bypass classes of spec §4.1 and the spec's §3-§5 rules; the class groups are properties
+over every row of ``targets/ubuntu-26.04/commands.toml``, so a new row cannot skip them.
+
+``nl_shell.gate`` and its loader are imported inside each test, and the inventory and the
+table are read inside test functions, so a missing piece is a failing test, not a
+collection error.
+
+Every case asserts a class (or a floor), a reason substring, and that no reason is
+"could not class" -- except the cases that are about decision C.
+"""
+
+from __future__ import annotations
+
+import time
+import tomllib
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+TARGET = REPO_ROOT / "targets" / "ubuntu-26.04"
+INVENTORY = TARGET / "inventory.toml"
+RANK = {
+    "read-only": 0,
+    "mutating": 1,
+    "session-altering": 1,
+    "destructive": 2,
+    "privileged": 3,
+}
+COULD_NOT = "could not class"
+NA = "not allowlisted"
+CANNOT = "runs code the gate cannot read"
+UNKNOWN = "option the gate does not know"
+ROOT_SHELL = "interactive root shell"
+ELEVATES = "elevates"
+UNDECLARED = "--pdca-undeclared"
+
+
+def classify(command: str, origin: str = "typed"):
+    from nl_shell.gate import classify as gate_classify
+
+    return gate_classify(command, origin=origin)
+
+
+def load_table():
+    from nl_shell.gate import commands
+
+    return commands.load()
+
+
+class Checks:
+    """Collects every failing case of a group, so one run shows them all."""
+
+    def __init__(self) -> None:
+        self.failures: list[str] = []
+
+    def expect(
+        self,
+        command: str,
+        *,
+        floor: str | None = None,
+        cls: str | None = None,
+        reason: str | tuple[str, ...] = "",
+        rejected: bool | None = None,
+        origin: str = "typed",
+        decision_c_ok: bool = False,
+        not_reason: str | None = None,
+    ):
+        result = classify(command, origin)
+        problems = []
+        if cls is not None and result.cls != cls:
+            problems.append(f"class {result.cls}, want {cls}")
+        if floor is not None and RANK[result.cls] < RANK[floor]:
+            problems.append(f"class {result.cls}, want at least {floor}")
+        if floor == "session-altering" and result.cls == "mutating":
+            problems.append("class mutating, want at least session-altering")
+        if rejected is not None and result.rejected is not rejected:
+            problems.append(f"rejected={result.rejected}, want {rejected}")
+        needles = (reason,) if isinstance(reason, str) else reason
+        joined = " | ".join(result.reasons)
+        could_not = any(COULD_NOT in r for r in result.reasons)
+        if not (decision_c_ok and could_not):
+            if not any(any(n in r for r in result.reasons) for n in needles):
+                problems.append(f"no reason holds {needles!r}")
+        if could_not and not decision_c_ok:
+            problems.append("a reason is 'could not class'")
+        if not_reason is not None and not_reason in joined:
+            problems.append(f"a reason holds {not_reason!r}")
+        if problems:
+            self.failures.append(
+                f"{command!r} ({origin}): {'; '.join(problems)} -> "
+                f"{result.cls} rejected={result.rejected} [{joined}]"
+            )
+        return result
+
+    def rejected(self, command: str, reason: str | tuple[str, ...], origin: str = "proposal"):
+        return self.expect(command, rejected=True, reason=reason, origin=origin)
+
+    def done(self) -> None:
+        assert not self.failures, "\n" + "\n".join(self.failures)
+
+
+def fill(template: str, word: str) -> str:
+    return template.replace("{}", word)
+
+
+def insert_after(example: str, count: int, word: str) -> str:
+    """``example`` with ``word`` put right after its first ``count`` words."""
+    parts = example.split(" ")
+    return " ".join([*parts[:count], word, *parts[count:]])
+
