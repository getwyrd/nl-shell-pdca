+# --- class-7 floor rows: git, tar, ssh (spec rows 8, 10, 11, 27) ----------------------
+
+[[command]]
+names = ["git"]
+example = "git status"
+permute = false
+flags = ["-p", "--paginate", "-P", "--no-pager", "--bare", "--no-replace-objects",
+  "--no-lazy-fetch", "--no-optional-locks", "--no-advice", "--literal-pathspecs",
+  "--glob-pathspecs", "--noglob-pathspecs", "--icase-pathspecs", "-v", "--version",
