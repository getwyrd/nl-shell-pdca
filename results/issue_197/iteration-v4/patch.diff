+    nested = "env " * 10 + "sudo -i"
+    result = classify(nested, "proposal")
+    assert (result.cls, result.rejected) == ("privileged", True), result
+    assert has_reason(result, ROOT_SHELL) or has_reason(result, COULD_NOT), result
