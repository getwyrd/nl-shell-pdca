new file mode 100644
index 0000000..320a1ae
--- /dev/null
+++ b/scripts/harvest_inventory.py
@@ -0,0 +1,191 @@
+"""Write ``targets/ubuntu-26.04/inventory.toml`` from this host (#197, policy-gate/v1 §4.1).
+
+The inventory is the list the gate's coverage test (class 1) checks ``commands.toml``
+against: every name on it must have a row. It lists, from the host it runs on:
+
+- setuid, setgid and file-capability binaries in ``/usr/bin``, ``/usr/sbin`` and
+  ``/usr/lib/cargo/bin``;
+- every shell in ``/etc/shells``;
+- the binaries (in those folders) of dpkg packages in the sections ``shells`` and
+  ``interpreters``;
+- the names in those folders matching ``python3*``, ``perl*``, ``busybox``, ``gdb``;
+- every name in those folders whose ``realpath`` is the same file as one of the above or
+  as the binary of a ``commands.toml`` row (``sudo-rs`` -> ``/usr/lib/cargo/bin/sudo``).
+
+Usage::
+
+    python3 scripts/harvest_inventory.py [--output PATH]
+
+The file is checked in and reviewed like an allowlist change; no test runs this script.
+It records the host's os-release ``VERSION`` line, so a reviewer can tell which release
+it describes. Re-running it on the reference host and diffing against the checked-in
+file is the reviewer's check that the inventory is current.
+"""
+
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import os
+import stat
+import subprocess
+import sys
+import tomllib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+TARGET = REPO / "targets" / "ubuntu-26.04"
+OUTPUT = TARGET / "inventory.toml"
+COMMANDS = TARGET / "commands.toml"
+FOLDERS = ("/usr/bin", "/usr/sbin", "/usr/lib/cargo/bin")
+PATTERNS = ("python3*", "perl*", "busybox", "gdb")
+SECTIONS = ("shells", "interpreters")
+HEADER = """\
+# The binaries on the ubuntu-26.04 reference host that the gate's command table MUST
+# cover (spec policy-gate/v1 §4.1, class 1). GENERATED by scripts/harvest_inventory.py;
+# do not edit by hand. Reviewed like an allowlist change: a name added here needs a row
+# in commands.toml, and removing a name needs a reason in the review.
+"""
+
+
+def folder_entries() -> dict[str, list[Path]]:
+    """Every entry name in the folders, with each path it appears at."""
+    out: dict[str, list[Path]] = {}
+    for folder in FOLDERS:
+        try:
+            names = sorted(os.listdir(folder))
+        except OSError:
+            continue
+        for name in names:
+            out.setdefault(name, []).append(Path(folder) / name)
+    return out
+
+
+def has_capability(path: Path) -> bool:
+    try:
+        return bool(os.getxattr(path, "security.capability", follow_symlinks=False))
+    except OSError:
+        return False
+
+
+def privileged(entries: dict[str, list[Path]]) -> dict[str, str]:
+    found: dict[str, str] = {}
+    for name, paths in entries.items():
+        for path in paths:
+            try:
+                info = path.lstat()
+            except OSError:
+                continue
+            if not stat.S_ISREG(info.st_mode):
+                continue
+            if info.st_mode & stat.S_ISUID:
+                found[name] = f"setuid {path}"
+            elif info.st_mode & stat.S_ISGID:
+                found[name] = f"setgid {path}"
+            elif has_capability(path):
+                found[name] = f"file capability {path}"
+    return found
+
+
+def shells() -> dict[str, str]:
+    found: dict[str, str] = {}
+    for line in Path("/etc/shells").read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if line and not line.startswith("#"):
+            found[Path(line).name] = f"/etc/shells {line}"
+    return found
+
+
+def package_binaries() -> dict[str, str]:
+    listing = subprocess.run(
+        ["dpkg-query", "-W", "-f", "${Package}\t${Section}\n"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+    found: dict[str, str] = {}
+    for line in sorted(listing.splitlines()):
+        package, _, section = line.partition("\t")
+        if section.rsplit("/", 1)[-1] not in SECTIONS:
+            continue
+        files = subprocess.run(
+            ["dpkg-query", "-L", package], check=True, capture_output=True, text=True
+        ).stdout
+        for path in files.splitlines():
+            if str(Path(path).parent) in FOLDERS:
+                found.setdefault(Path(path).name, f"dpkg {package} ({section})")
+    return found
+
+
+def patterned(entries: dict[str, list[Path]]) -> dict[str, str]:
+    return {
+        name: f"name matches {pattern}"
+        for name in entries
+        for pattern in PATTERNS
+        if fnmatch.fnmatchcase(name, pattern)
+    }
+
+
+def row_names() -> list[str]:
+    if not COMMANDS.exists():
+        return []
+    doc = tomllib.loads(COMMANDS.read_text(encoding="utf-8"))
+    return sorted({n for row in doc.get("command", []) for n in row.get("names", [])})
+
+
+def harvest() -> dict[str, list[str]]:
+    entries = folder_entries()
+    listed: dict[str, list[str]] = {}
+    for source in (privileged(entries), shells(), package_binaries(), patterned(entries)):
+        for name, why in source.items():
+            listed.setdefault(name, []).append(why)
+    sources: dict[str, set[str]] = {}
+    for name in set(listed) | set(row_names()):
+        for path in entries.get(name, []):
+            sources.setdefault(os.path.realpath(path), set()).add(name)
+    aliases: dict[str, list[str]] = {}
+    for name, paths in entries.items():
+        for path in paths:
+            real = os.path.realpath(path)
+            for other in sorted(sources.get(real, set()) - {name}):
+                why = f"same file as {other} ({real})"
+                if why not in aliases.get(name, []):
+                    aliases.setdefault(name, []).append(why)
+    for name, whys in aliases.items():
+        listed.setdefault(name, []).extend(w for w in whys if w not in listed.get(name, []))
+    return listed
+
+
+def host_version() -> str:
+    for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
+        if line.startswith("VERSION="):
+            return line
+    raise SystemExit("no VERSION line in /etc/os-release")
+
+
+def quote(text: str) -> str:
+    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+def render(listed: dict[str, list[str]], version: str) -> str:
+    lines = [HEADER, f"host = {quote(version)}", ""]
+    for name in sorted(listed):
+        lines.append("[[binary]]")
+        lines.append(f"name = {quote(name)}")
+        lines.append("why = [" + ", ".join(quote(w) for w in listed[name]) + "]")
+        lines.append("")
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    args = parser.parse_args(argv)
+    text = render(harvest(), host_version())
+    args.output.write_text(text, encoding="utf-8")
+    print(f"wrote {args.output}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
