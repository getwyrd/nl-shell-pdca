+        expect(f"{prefix} true", cls="mutating", reason=NA)
+        expect(f"{prefix} rm -rf x", cls="destructive", reason="rm -r")
+    expect('xargs "$c"', floor="destructive", reason="inner command word the gate cannot read")
+    expect(
+        'find . -exec "$c" {} \\;',
