+++ b/src/nl_shell/gate/commands.py
@@ -0,0 +1,589 @@
+"""Loading the gate's command table, ``targets/<id>/commands.toml`` (issue #197).
+
+Spec ``policy-gate/v1`` §4.1. The command table is reviewed data, like the allowlist: a
+command gets a meaning in the gate only from a row here. Each ``[[command]]`` row gives
+the command's argv grammar (its options, where operands and an inner command start) and
+its effects from one fixed set (``EFFECT_KINDS``). The engine in ``nl_shell.gate.rules``
+reads the rows; it names no command itself.
+
+The location is fixed. ``load()`` takes no path: it reads
+``ROOT / TARGET_ID / "commands.toml"`` and refuses a resolved path outside ``ROOT``, the
+way ``nl_shell.targets.load`` refuses a target folder outside its root. Nothing in the
+environment, the cwd, the home folder or a config file can point it elsewhere. v1 ships
+one target, and ``nl_shell.gate.classify`` has no target argument, so ``TARGET_ID`` is a
+module constant, read once at import from ``targets/gate.toml`` in the repository (code
+names no OS, ADR-0023). It is not chosen from ``/etc/os-release``.
+
+The loader is strict, so that a row cannot quietly mean less than it says: an unknown
+key (including v2's ``raw``), an unknown effect, condition or grammar, a row that runs an
+inner command but does not say what it does with no command or with the terminal as
+stdin, or a ``class_7_gap`` marker outside the spec's class-7 list, all refuse the whole
+table. A refused or missing table is decision C for every command (``rules.classify``).
+"""
+
+from __future__ import annotations
+
+import functools
+import re
+import tomllib
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import MappingProxyType
+from typing import Any
+
+from nl_shell import targets
+from nl_shell.gate.parse import RANK
+
+ROOT = targets.TARGETS_ROOT
+GATE_FILE = "gate.toml"  # names the one target whose table the gate reads
+COMMANDS_FILE = "commands.toml"
+
+
+def _fixed_target_id(root: Path) -> str | None:
+    """The target id in ``root/gate.toml`` (one key, ``target``), or None when the file is
+    missing or invalid (then ``load`` refuses, and every command is decision C)."""
+    try:
+        doc = tomllib.loads((root / GATE_FILE).read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
+        return None
+    value = doc.get("target")
+    if set(doc) != {"target"} or not isinstance(value, str) or not targets.is_plain_id(value):
+        return None
+    return value
+
+
+# Read once, from the repository's own targets/ folder: a module constant, not a choice
+# made per call or from the host. It lives in data because code names no OS (ADR-0023).
+TARGET_ID = _fixed_target_id(targets.TARGETS_ROOT)
+
+EFFECT_KINDS = (
+    "elevates",  # runs as another user (root): the command is `privileged`
+    "destroys",  # at least `destructive`
+    "runs-command-at",  # an inner command starts at `at`; it is classed too
+    "runs-text",  # runs text (at `at`) as code in `grammar`
+    "runs-stdin-as-code",  # reads its program from stdin, in `grammar`
+    "runs-file-as-code",  # runs a file (at `at`, or a place the gate cannot see) as code
+    "stores-code",  # keeps text (at `at`, in `grammar`) to run later
+    "sets-variable",  # the words at `at` are variable names it assigns
+    "reads-terminal",  # prompts on the terminal: stdin fed to it is rejected (§5)
+    "opens-shell",  # starts an interactive shell
+    "alters-session",  # §3: at least `session-altering`
+    "rejected",  # §5: the command is rejected (`reason` says why)
+)
+TEXT_KINDS = ("runs-text", "runs-stdin-as-code", "runs-file-as-code", "stores-code")
+# Grammars the gate has (or will have, #197 child-2) a parser for, and named grammars
+# it has none for. In this version every text effect is decision B whatever its grammar.
+PARSED_GRAMMARS = ("bash", "sh", "env-split", "arithmetic")
+UNPARSED_GRAMMARS = (
+    "python",
+    "perl",
+    "tcl",
+    "js",
+    "gdb",
+    "screen",
+    "tmux",
+    "readline",
+    "crontab",
+    "zsh",
+    "shell-arguments",
+)
+GRAMMARS = PARSED_GRAMMARS + UNPARSED_GRAMMARS
+NO_COMMAND = ("nothing", "opens-shell")
+TERMINAL_STDIN = ("passes-to-inner", "opens-shell")
+INNER_STDIN = ("inherit", "pipe", "null", "terminal")
+# The spec's class-7 accepted gap (§4.1): the only options that may carry
+# `class_7_gap`. They run code but stay at the row's default ("not allowlisted").
+CLASS_7_GAP = frozenset(
+    {
+        ("git", "-c"),
+        ("git", "--config-env"),
+        ("git", "--exec-path"),
+        ("tar", "--to-command"),
+        ("ssh", "-o"),
+    }
+)
+
+_ROW_KEYS = frozenset(
+    (
+        "names",
+        "example",
+        "prefix",
+        "class",
+        "reason",
+        "argv",
+        "flags",
+        "values",
+        "optional",
+        "class_7_gap",
+        "number_option",
+        "signal_option",
+        "plus",
+        "permute",
+        "end_of_options",
+        "max_options",
+        "bundle_first",
+        "modes",
+        "final",
+        "no_command",
+        "terminal_stdin",
+        "subcommands",
+        "inherit",
+        "effect",
+    )
+)
+_SUB_KEYS = _ROW_KEYS - {"names", "example", "argv", "subcommands", "inherit"}
+_EFFECT_KEYS = frozenset(
+    (
+        "kind",
+        "when",
+        "at",
+        "grammar",
+        "reason",
+        "inner_stdin",
+        "appends",
+        "placeholder",
+        "skip",
+        "joined",
+        "terminators",
+    )
+)
+_CONDITION = re.compile(
+    r"(?:(flag|no-flag):(\S+)"
+    r"|(operands|no-operands|inner|no-inner|operand-nonliteral|stdin-terminal|stdin-fed)"
+    r"|(operand|operand-prefix|operand-contains):(\S+)"
+    r"|operands>=([0-9]+))"
+)
+_AT = re.compile(r"(operand|operands):([0-9]+)|(value|until|rest):(\S+)")
+_OPTION = re.compile(r"(?:--?|\+)[^\s=]+|-")
+_NAME = re.compile(r"[A-Za-z0-9_.+-][A-Za-z0-9_.+:-]*|\.|\[")
+
+
+class CommandsError(Exception):
+    """The command table is missing or invalid; the message says where and why."""
+
+
+@dataclass(frozen=True)
+class Effect:
+    kind: str
+    when: tuple[str, ...] = ()
+    at: str | None = None
+    grammar: str | None = None
+    reason: str | None = None
+    inner_stdin: str = "inherit"
+    appends: bool = False
+    placeholder: tuple[str, ...] = ()
+    skip: str | None = None
+    joined: str | None = None
+    terminators: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True)
+class Argv:
+    """A row's (or subcommand's) option grammar."""
+
+    flags: frozenset[str] = frozenset()
+    values: frozenset[str] = frozenset()
+    optional: frozenset[str] = frozenset()
+    gap: frozenset[str] = frozenset()
+    number_option: bool = False
+    signal_option: bool = False
+    plus: bool = False
+    permute: bool = True
+    end_of_options: bool = True
+    max_options: int | None = None
+    bundle_first: bool = False
+    modes: bool = False
+    final: frozenset[str] = frozenset()
+
+    @property
+    def spellings(self) -> frozenset[str]:
+        return self.flags | self.values | self.optional
+
+
+@dataclass(frozen=True)
+class Row:
+    names: tuple[str, ...]
+    example: str
+    cls: str
+    reason: str
+    fixed: bool
+    argv: Argv
+    effects: tuple[Effect, ...]
+    prefix: str | None = None
+    no_command: str | None = None
+    terminal_stdin: str | None = None
+    subcommands: Mapping[str, Row] = field(default_factory=dict)
+    inherit: bool = False
+    where: str = ""
+
+    def all_effects(self) -> tuple[Effect, ...]:
+        out = list(self.effects)
+        for sub in self.subcommands.values():
+            out.extend(sub.all_effects())
+        return tuple(out)
+
+
+@dataclass(frozen=True)
+class Table:
+    rows: tuple[Row, ...]
+    by_name: Mapping[str, Row]
+    elevating: frozenset[str]  # names of rows with an `elevates` effect (decision A)
+    destroying: frozenset[str]  # names of rows with a `destroys` effect (decision A)
+
+    def lookup(self, word: str) -> Row | None:
+        """The row for a command word; a path is looked up by its last component."""
+        name = word.rsplit("/", 1)[-1]
+        return self.by_name.get(name) if name else None
+
+
+def path() -> Path:
+    """The one place the table is read from."""
+    return ROOT / TARGET_ID / COMMANDS_FILE
+
+
+def load() -> Table:
+    """Load and validate the command table. Raises ``CommandsError``."""
+    if TARGET_ID is None or not targets.is_plain_id(TARGET_ID):
+        raise CommandsError(f"{targets.TARGETS_ROOT / GATE_FILE}: missing or invalid")
+    file = path()
+    try:
+        inside = file.resolve().is_relative_to(Path(ROOT).resolve())
+    except OSError as exc:
+        raise CommandsError(f"{file}: cannot resolve: {exc}") from None
+    if not inside:
+        raise CommandsError(f"{file}: resolves outside {ROOT}")
+    try:
+        data = file.read_bytes()
+    except FileNotFoundError:
+        raise CommandsError(f"{file}: missing") from None
+    except OSError as exc:
+        raise CommandsError(f"{file}: cannot read: {exc.strerror or exc}") from None
+    try:
+        doc = tomllib.loads(data.decode("utf-8"))
+    except UnicodeDecodeError:
+        raise CommandsError(f"{file}: not valid TOML: not valid UTF-8") from None
+    except tomllib.TOMLDecodeError as exc:
+        raise CommandsError(f"{file}: not valid TOML: {exc}") from None
+    return validate(doc, str(file))
+
+
+@functools.lru_cache(maxsize=1)
+def table() -> Table:
+    """The loaded table, cached. ``clear_cache()`` forgets it (tests)."""
+    return load()
+
+
+def clear_cache() -> None:
+    table.cache_clear()
+
+
+# --- validation ----------------------------------------------------------------------
+
+
+def validate(doc: dict[str, Any], where: str) -> Table:
+    extra = sorted(set(doc) - {"command"})
+    if extra:
+        raise CommandsError(f"{where}: unknown top-level key `{extra[0]}`")
+    entries = doc.get("command")
+    if not isinstance(entries, list) or not entries:
+        raise CommandsError(f"{where}: `command` must be a non-empty list of [[command]]")
+    rows: list[Row] = []
+    by_name: dict[str, Row] = {}
+    for n, entry in enumerate(entries, 1):
+        if not isinstance(entry, dict):
+            raise CommandsError(f"{where}: command {n} must be a table")
+        row = _row(entry, f"{where}: command {n}")
+        for name in row.names:
+            if name in by_name:
+                raise CommandsError(f"{row.where}: name {name!r} is already a row")
+            by_name[name] = row
+        rows.append(row)
+    elevating = frozenset(
+        name for row in rows if any(e.kind == "elevates" for e in row.all_effects())
+        for name in row.names
+    )
+    destroying = frozenset(
+        name for row in rows if any(e.kind == "destroys" for e in row.all_effects())
+        for name in row.names
+    )
+    return Table(
+        rows=tuple(rows),
+        by_name=MappingProxyType(by_name),
+        elevating=elevating,
+        destroying=destroying,
+    )
+
+
+def _strings(entry: Mapping[str, Any], key: str, where: str) -> tuple[str, ...]:
+    value = entry.get(key, [])
+    if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):
+        raise CommandsError(f"{where}: `{key}` must be a list of non-empty strings")
+    return tuple(value)
+
+
+def _string(entry: Mapping[str, Any], key: str, where: str, default=None):
+    value = entry.get(key, default)
+    if value is default and key not in entry:
+        return default
+    if not isinstance(value, str) or not value:
+        raise CommandsError(f"{where}: `{key}` must be a non-empty string")
+    return value
+
+
+def _bool(entry: Mapping[str, Any], key: str, where: str, default: bool) -> bool:
+    value = entry.get(key, default)
+    if not isinstance(value, bool):
+        raise CommandsError(f"{where}: `{key}` must be a boolean")
+    return value
+
+
+def _check_keys(entry: Mapping[str, Any], allowed: frozenset[str], where: str) -> None:
+    if "raw" in entry:
+        raise CommandsError(f"{where}: unknown key `raw` (no row may skip argv parsing)")
+    unknown = sorted(set(entry) - allowed)
+    if unknown:
+        raise CommandsError(f"{where}: unknown key `{unknown[0]}`")
+
+
+def _row(entry: Mapping[str, Any], where: str) -> Row:
+    _check_keys(entry, _ROW_KEYS, where)
+    names = _strings(entry, "names", where)
+    if not names:
+        raise CommandsError(f"{where}: missing required key `names`")
+    for name in names:
+        if not _NAME.fullmatch(name):
+            raise CommandsError(f"{where}: name {name!r} is not a plain command name")
+    where = f"{where} ({names[0]})"
+    example = _string(entry, "example", where)
+    if example is None:
+        raise CommandsError(f"{where}: missing required key `example`")
+    if example.split()[0] not in names:
+        raise CommandsError(f"{where}: `example` must start with one of the row's names")
+    argv_kind = _string(entry, "argv", where, "parsed")
+    if argv_kind not in ("parsed", "fixed"):
+        raise CommandsError(f"{where}: `argv` must be \"parsed\" or \"fixed\"")
+    fixed = argv_kind == "fixed"
+    body = _body(entry, where, names, fixed)
+    subcommands: dict[str, Row] = {}
+    raw_subs = entry.get("subcommands", {})
+    if not isinstance(raw_subs, dict):
+        raise CommandsError(f"{where}: `subcommands` must be a table")
+    if raw_subs and fixed:
+        raise CommandsError(f"{where}: a fixed row cannot describe subcommands")
+    for sub_name, sub_entry in raw_subs.items():
+        sub_where = f"{where}: subcommand {sub_name!r}"
+        if not isinstance(sub_entry, dict):
+            raise CommandsError(f"{sub_where}: must be a table")
+        _check_keys(sub_entry, _SUB_KEYS, sub_where)
+        if not _NAME.fullmatch(sub_name):
+            raise CommandsError(f"{sub_where}: not a plain subcommand name")
+        sub = _body(sub_entry, sub_where, names, False)
+        subcommands[sub_name] = Row(
+            names=(sub_name,),
+            example=f"{names[0]} {sub_name}",
+            subcommands=MappingProxyType({}),
+            where=sub_where,
+            **sub,
+        )
+    inherit = _bool(entry, "inherit", where, False)
+    return Row(
+        names=names,
+        example=example,
+        subcommands=MappingProxyType(subcommands),
+        inherit=inherit,
+        where=where,
+        **body,
+    )
+
+
+def _body(entry: Mapping[str, Any], where: str, names: tuple[str, ...], fixed: bool) -> dict:
+    cls = _string(entry, "class", where, "mutating")
+    if cls not in RANK or RANK[cls] < RANK["mutating"]:
+        raise CommandsError(f"{where}: `class` must be a class of at least mutating")
+    reason = _string(entry, "reason", where, "not allowlisted")
+    option_keys = (
+        "flags",
+        "values",
+        "optional",
+        "class_7_gap",
+        "final",
+        "number_option",
+        "signal_option",
+        "plus",
+        "permute",
+        "end_of_options",
+        "max_options",
+        "bundle_first",
+        "modes",
+    )
+    if fixed and any(k in entry for k in option_keys):
+        raise CommandsError(f"{where}: a fixed row has no option grammar")
+    plus = _bool(entry, "plus", where, False)
+    flags = _options(entry, "flags", where, plus)
+    values = _options(entry, "values", where, plus)
+    optional = _options(entry, "optional", where, plus)
+    declared = flags | values | optional
+    if len(declared) != len(flags) + len(values) + len(optional):
+        raise CommandsError(f"{where}: an option is declared twice")
+    gap = _options(entry, "class_7_gap", where, plus)
+    for option in gap:
+        if option not in declared:
+            raise CommandsError(f"{where}: class_7_gap option {option} is not declared")
+        if not any((name, option) in CLASS_7_GAP for name in names):
+            raise CommandsError(
+                f"{where}: class_7_gap on {option} is outside the spec's class-7 list"
+            )
+    final = _options(entry, "final", where, plus)
+    if not final <= declared:
+        raise CommandsError(f"{where}: a `final` option is not declared")
+    max_options = entry.get("max_options")
+    if max_options is not None and (
+        not isinstance(max_options, int) or isinstance(max_options, bool) or max_options < 1
+    ):
+        raise CommandsError(f"{where}: `max_options` must be a positive integer")
+    argv = Argv(
+        flags=flags,
+        values=values,
+        optional=optional,
+        gap=gap,
+        number_option=_bool(entry, "number_option", where, False),
+        signal_option=_bool(entry, "signal_option", where, False),
+        plus=plus,
+        permute=_bool(entry, "permute", where, True),
+        end_of_options=_bool(entry, "end_of_options", where, True),
+        max_options=max_options,
+        bundle_first=_bool(entry, "bundle_first", where, False),
+        modes=_bool(entry, "modes", where, False),
+        final=final,
+    )
+    raw_effects = entry.get("effect", [])
+    if not isinstance(raw_effects, list):
+        raise CommandsError(f"{where}: `effect` must be a list of [[...effect]] tables")
+    effects = tuple(
+        _effect(e, f"{where}: effect {n}", fixed, declared)
+        for n, e in enumerate(raw_effects, 1)
+    )
+    prefix = _string(entry, "prefix", where)
+    no_command = _string(entry, "no_command", where)
+    terminal_stdin = _string(entry, "terminal_stdin", where)
+    if no_command is not None and no_command not in NO_COMMAND:
+        raise CommandsError(f"{where}: `no_command` must be one of {', '.join(NO_COMMAND)}")
+    if terminal_stdin is not None and terminal_stdin not in TERMINAL_STDIN:
+        raise CommandsError(
+            f"{where}: `terminal_stdin` must be one of {', '.join(TERMINAL_STDIN)}"
+        )
+    kinds = {e.kind for e in effects}
+    if "runs-command-at" in kinds or "runs-stdin-as-code" in kinds:
+        if no_command is None or terminal_stdin is None:
+            raise CommandsError(
+                f"{where}: a row that runs an inner command or reads code from stdin must "
+                "declare `no_command` and `terminal_stdin`"
+            )
+    if "runs-command-at" in kinds:
+        if prefix is None or prefix.split()[0] not in names:
+            raise CommandsError(
+                f"{where}: a row with runs-command-at needs a `prefix` starting with one "
+                "of the row's names"
+            )
+        positional = any(
+            e.kind == "runs-command-at" and (e.at or "").startswith("operand:")
+            for e in effects
+        )
+        if positional and argv.permute:
+            raise CommandsError(
+                f"{where}: an inner command at an operand needs permute = false (the "
+                "inner command's own options are not this row's)"
+            )
+    return {
+        "cls": cls,
+        "reason": reason,
+        "fixed": fixed,
+        "argv": argv,
+        "effects": effects,
+        "prefix": prefix,
+        "no_command": no_command,
+        "terminal_stdin": terminal_stdin,
+    }
+
+
+def _options(entry: Mapping[str, Any], key: str, where: str, plus: bool) -> frozenset[str]:
+    out = _strings(entry, key, where)
+    for option in out:
+        if not _OPTION.fullmatch(option) or (option.startswith("+") and not plus):
+            raise CommandsError(f"{where}: `{key}` entry {option!r} is not an option")
+    return frozenset(out)
+
+
+def _effect(entry: Any, where: str, fixed: bool, declared: frozenset[str]) -> Effect:
+    if not isinstance(entry, dict):
+        raise CommandsError(f"{where}: must be a table")
+    _check_keys(entry, _EFFECT_KEYS, where)
+    kind = _string(entry, "kind", where)
+    if kind not in EFFECT_KINDS:
+        raise CommandsError(f"{where}: unknown effect kind {kind!r}")
+    when = entry.get("when", [])
+    if isinstance(when, str):
+        when = [when]
+    if not isinstance(when, list) or not all(isinstance(w, str) for w in when):
+        raise CommandsError(f"{where}: `when` must be a string or a list of strings")
+    for condition in when:
+        match = _CONDITION.fullmatch(condition)
+        if match is None:
+            raise CommandsError(f"{where}: unknown condition {condition!r}")
+        if match.group(2):
+            for option in match.group(2).split("|"):
+                if option not in declared:
+                    raise CommandsError(f"{where}: condition names undeclared {option}")
+    at = _string(entry, "at", where)
+    if at is not None:
+        match = _AT.fullmatch(at)
+        if match is None:
+            raise CommandsError(f"{where}: unknown `at` {at!r}")
+        if match.group(3):
+            for option in match.group(4).split("|"):
+                if option not in declared:
+                    raise CommandsError(f"{where}: `at` names undeclared {option}")
+    grammar = _string(entry, "grammar", where)
+    if grammar is not None and grammar not in GRAMMARS:
+        raise CommandsError(f"{where}: unknown grammar {grammar!r}")
+    if kind in ("runs-text", "runs-stdin-as-code", "stores-code") and grammar is None:
+        raise CommandsError(f"{where}: a {kind} effect must name its `grammar`")
+    if kind in ("runs-command-at", "runs-text", "stores-code", "sets-variable") and at is None:
+        raise CommandsError(f"{where}: a {kind} effect needs `at`")
+    inner_stdin = _string(entry, "inner_stdin", where, "inherit")
+    if inner_stdin not in INNER_STDIN:
+        raise CommandsError(f"{where}: `inner_stdin` must be one of {', '.join(INNER_STDIN)}")
+    skip = _string(entry, "skip", where)
+    if skip is not None and skip != "assignments":
+        raise CommandsError(f"{where}: `skip` must be \"assignments\"")
+    joined = _string(entry, "joined", where)
+    if joined is not None and joined not in GRAMMARS:
+        raise CommandsError(f"{where}: unknown grammar {joined!r} in `joined`")
+    placeholder = _strings(entry, "placeholder", where)
+    for option in placeholder:
+        if option not in declared:
+            raise CommandsError(f"{where}: placeholder option {option} is not declared")
+    terminators = _strings(entry, "terminators", where)
+    if at is not None and at.startswith("until:") and not terminators:
+        raise CommandsError(f"{where}: `until:` needs `terminators`")
+    if fixed and (when or at is not None or kind == "runs-command-at"):
+        raise CommandsError(f"{where}: a fixed row's effects take no `when` or `at`")
+    if kind != "runs-command-at" and (
+        inner_stdin != "inherit" or skip or joined or placeholder or terminators
+        or entry.get("appends")
+    ):
+        raise CommandsError(f"{where}: inner-command keys on a {kind} effect")
+    return Effect(
+        kind=kind,
+        when=tuple(when),
+        at=at,
+        grammar=grammar,
+        reason=_string(entry, "reason", where),
+        inner_stdin=inner_stdin,
+        appends=_bool(entry, "appends", where, False),
+        placeholder=placeholder,
+        skip=skip,
+        joined=joined,
+        terminators=terminators,
+    )
