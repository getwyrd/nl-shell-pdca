+
+def _option(
+    argv: Argv, args: list[Word], i: int, longs: list[str], parsed: _Parsed, record
+) -> int:
+    """Read the option word ``args[i]``; return the index of the next word."""
+    word = args[i]
+    text = word.text
+    nxt = args[i + 1] if i + 1 < len(args) else None
