+flags = ["-c", "--changes", "-f", "--silent", "--quiet", "-v", "--verbose", "-R",
+  "--recursive", "--no-preserve-root", "--preserve-root", "-H", "-L", "-P",
+  "--dereference", "--no-dereference", "--help", "--version"]
+values = ["--reference"]
+[[command.effect]]
+kind = "destroys"
+when = "flag:-R|--recursive"
+reason = "recursive chmod"
+
+[[command]]
