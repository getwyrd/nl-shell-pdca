+
+def _option_like(text: str, argv: Argv) -> bool:
+    if text == "-":
+        return "-" in argv.spellings
+    if argv.modes and _MODE.fullmatch(text) and text not in argv.spellings:
+        return False
+    if text.startswith("-") and len(text) > 1:
+        return True
+    return argv.plus and text.startswith("+") and len(text) > 1
