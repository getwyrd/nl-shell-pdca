+  "--read-full-records", "--help", "--usage", "--version", "--restrict",
+  "--force-local", "--seek", "--no-seek", "--check-device", "--no-check-device",
+  "--ignore-command-error", "--no-ignore-command-error", "-n",
+]
+values = [
+  "-f", "--file", "-C", "--directory", "-T", "--files-from", "-X", "--exclude-from",
