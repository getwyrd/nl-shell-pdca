+# --- destructive commands (spec §4) ---------------------------------------------------
+
+[[command]]
+names = ["rm", "gnurm"]
+example = "rm x"
+flags = ["-f", "--force", "-i", "-I", "-r", "-R", "--recursive", "-d", "--dir", "-v",
+  "--verbose", "--one-file-system", "--no-preserve-root", "--help", "--version"]
+optional = ["--interactive", "--preserve-root"]
+[[command.effect]]
+kind = "destroys"
+when = "flag:-r|-R|--recursive"
+reason = "rm -r removes a whole tree"
+[[command.effect]]
+# A glob, an expansion or find's `{}` may name anything (spec §4, row 9).
+kind = "destroys"
+when = "operand-nonliteral"
+reason = "rm with an operand the gate cannot read"
+[[command.effect]]
+kind = "destroys"
+when = "flag:--no-preserve-root"
+reason = "rm --no-preserve-root"
