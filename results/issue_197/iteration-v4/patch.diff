+        record(text, None)
+        return i + 1
+    if text in argv.values:
+        record(text, nxt)
+        return i + 2
+    if text.startswith("--"):
+        name, eq, value = text.partition("=")
+        if eq:
+            if name in argv.values or name in argv.optional:
+                record(name, _value_word(word, value))
+            else:
+                # `--stdin=x` is not `--stdin` to getopt, but it is no safer.
+                parsed.undeclared.append(name)
+                parsed.abbreviates.update(s for s in longs if s.startswith(name))
+            return i + 1
+        matches = [s for s in longs if s.startswith(text)]
+        if len(matches) == 1 and matches[0] in argv.spellings:
+            spelling = matches[0]
+            if spelling in argv.values:
+                record(spelling, nxt)
+                return i + 2
+            record(spelling, None)
+            return i + 1
+        parsed.undeclared.append(text)
+        parsed.abbreviates.update(matches)
+        return i + 1
+    if argv.signal_option and _SIGNAL.fullmatch(text):
+        record("-SIGNAL", None)
+        return i + 1
+    if argv.number_option and _NUMBER.fullmatch(text):
+        record("-NUMBER", None)
+        return i + 1
