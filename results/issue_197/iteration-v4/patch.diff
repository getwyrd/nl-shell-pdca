new file mode 100644
index 0000000..a439516
--- /dev/null
+++ b/targets/ubuntu-26.04/commands.toml
@@ -0,0 +1,1612 @@
+# The gate's command table for the ubuntu-26.04 target (spec policy-gate/v1 §4.1, #197).
+# Loaded by nl_shell.gate.commands; read by the one engine in nl_shell.gate.rules.
+#
+# Reviewed like an allowlist change. A row is what gives a command a meaning in the gate:
+# removing a row or an effect can lower a class, so that is a v2 change (spec
+# Versioning). Every name in inventory.toml MUST have a row (class 1).
+#
+# Row keys (the loader refuses any other key, including `raw`):
+#   names           command words this row is for (a path is looked up by its last part)
+#   example         a minimal invocation (class 2's test adds an undeclared option to it)
+#   prefix          rows with runs-command-at: the words before the inner command
+#   class, reason   the row's floor (at least mutating; default mutating, "not allowlisted")
+#   argv            "parsed" (default) or "fixed" (effects do not depend on argv; the
+#                   undeclared-option rule is off, decision A still reads the words)
+#   flags / values / optional
+#                   options without a value / with a value (`-u x`, `-ux`, `--user=x`,
+#                   `--user x`) / long options with an optional `=value` (short: attached)
+#   class_7_gap     code-running options of the class-7 floor rows (spec §4.1); they give
+#                   the row's default, not "option the gate does not know"
+#   number_option, signal_option   `-N` / `-N` and `-SIGNAME` are options
+#   plus            `+x` options (bash, declare)
+#   permute         options may follow operands (GNU); false: options end at the first
+#                   operand (required for an inner command at an operand)
+#   end_of_options  `--` ends options (default true)
+#   max_options     options end after this many (kill: `kill -9 -1`)
+#   bundle_first    the first word may be option letters with no dash (`tar xf a.tar`)
+#   modes           words like `-w`, `u+x`, `644` are chmod modes, not options
+#   final           options after which every word is an operand (`python3 -c`)
+#   no_command      what the row does with no inner command: "nothing" | "opens-shell"
+#   terminal_stdin  what it does when stdin is the terminal: "passes-to-inner" |
+#                   "opens-shell"
+#   subcommands     described subcommands (others get the row's default); `inherit`
+#                   lets a subcommand take the row's options too
+#
+# Effect keys ([[command.effect]]): kind, when (all must hold), at, grammar, reason;
+# runs-command-at also: inner_stdin, appends, placeholder, skip, joined, terminators.
+#   when: flag:A|B, no-flag:A|B, operands, no-operands, inner, no-inner,
+#         operand-nonliteral, operand:V, operand-prefix:P, operand-contains:S,
+#         operands>=N, stdin-terminal, stdin-fed
+#   at:   operand:N, operands:N, value:A|B, until:A|B (with terminators), rest:A|B
+#
+# In this version every text effect (runs-text, runs-stdin-as-code, runs-file-as-code,
+# stores-code) is decision B: at least destructive, "runs code the gate cannot read".
+
+# --- elevation (spec §4 privileged, §5) ------------------------------------------------
+
+[[command]]
+names = ["sudo", "sudo.ws", "sudo-rs"]
+example = "sudo true"
+prefix = "sudo"
+class = "privileged"
+reason = "sudo runs commands as root"
+permute = false
+no_command = "nothing"
+terminal_stdin = "passes-to-inner"
+flags = [
+  "-A", "--askpass", "-b", "--background", "-B", "--bell", "-E", "-e", "--edit",
+  "-H", "--set-home", "-h", "--help", "-i", "--login", "-K", "--remove-timestamp",
+  "-k", "--reset-timestamp", "-l", "--list", "-N", "--no-update", "-n",
+  "--non-interactive", "-P", "--preserve-groups", "-S", "--stdin", "-s", "--shell",
+  "-V", "--version", "-v", "--validate",
+]
+values = [
+  "-C", "--close-from", "-D", "--chdir", "-g", "--group", "-p", "--prompt", "-R",
+  "--chroot", "-r", "--role", "-T", "--command-timeout", "-t", "--type", "-U",
+  "--other-user", "-u", "--user", "--host",
+]
+optional = ["--preserve-env"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-S|--stdin"
+reason = "sudo -S reads the password from stdin (§5)"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-A|--askpass"
+reason = "sudo -A runs an askpass program (§5)"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-p|--prompt"
+reason = "sudo -p sets the password prompt (§5)"
+[[command.effect]]
+kind = "opens-shell"
+when = ["flag:-i|--login|-s|--shell", "no-inner"]
+[[command.effect]]
+kind = "runs-command-at"
+at = "operand:0"
+skip = "assignments"
+when = "no-flag:-e|--edit|-l|--list"
+
