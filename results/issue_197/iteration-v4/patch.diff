+    sign = text[0]
+    for j in range(1, len(text)):
+        spelling = sign + text[j]
+        rest = text[j + 1 :]
+        if spelling in argv.flags:
+            record(spelling, None)
+            continue
+        if spelling in argv.values:
+            if rest:
+                record(spelling, _value_word(word, rest))
+                return i + 1
+            record(spelling, nxt)
+            return i + 2
+        if spelling in argv.optional:
+            record(spelling, _value_word(word, rest) if rest else None)
+            return i + 1
+        parsed.undeclared.append(spelling if j == 1 else f"{spelling} (in {text})")
+        return i + 1
+    return i + 1
+
+
+def _old_bundle(argv: Argv, args: list[Word], i: int, parsed: _Parsed, record) -> int:
+    """A first word of option letters with no dash (`tar xzf a.tar`): value-taking
+    letters take the following words in order."""
+    word = args[i]
+    j = i + 1
+    for letter in word.text:
+        spelling = "-" + letter
+        if spelling in argv.flags:
+            record(spelling, None)
+        elif spelling in argv.values:
+            record(spelling, args[j] if j < len(args) else None)
+            j += 1
+        else:
+            parsed.undeclared.append(f"{spelling} (in {word.text})")
+    return j
+
+
+# --- effects -------------------------------------------------------------------------
+
+
+def _operand_matches(parsed: _Parsed, test) -> bool:
+    # A word the gate cannot read may be any value, so it matches.
+    return any(_unreadable(w) or test(w.text) for w in parsed.operands)
+
+
+def _active(effect: Effect, parsed: _Parsed, stdin: Stdin) -> bool:
+    spellings = parsed.spellings
+    for condition in effect.when:
+        kind, _, arg = condition.partition(":")
+        if kind == "flag":
+            ok = bool(spellings & set(arg.split("|")))
+        elif kind == "no-flag":
+            ok = not spellings & set(arg.split("|"))
+        elif kind == "operands":
+            ok = bool(parsed.operands)
+        elif kind == "no-operands":
+            ok = not parsed.operands
+        elif kind == "inner":
+            ok = bool(parsed.inner)
+        elif kind == "no-inner":
+            ok = not parsed.inner
+        elif kind == "operand-nonliteral":
+            ok = any(_unreadable(w) for w in parsed.operands)
+        elif kind == "stdin-terminal":
+            ok = stdin.kind == "terminal"
+        elif kind == "stdin-fed":
+            ok = stdin.kind != "terminal"
+        elif kind == "operand":
+            ok = _operand_matches(parsed, lambda t: t == arg)
+        elif kind == "operand-prefix":
+            ok = _operand_matches(parsed, lambda t: t.startswith(arg))
+        elif kind == "operand-contains":
+            ok = _operand_matches(parsed, lambda t: arg in t)
+        elif condition.startswith("operands>="):
+            ok = len(parsed.operands) >= int(condition[len("operands>=") :])
+        else:  # the loader refuses anything else
+            raise GateFailure("unknown condition in the command table")
+        if not ok:
+            return False
+    return True
+
+
+def _targets(effect: Effect, parsed: _Parsed) -> list[Word] | None:
+    """The words an effect acts on; None when its place is empty (the effect is off)."""
+    if effect.at is None:
+        return []
+    kind, _, arg = effect.at.partition(":")
+    if kind == "operand":
+        index = int(arg)
+        return [parsed.operands[index]] if index < len(parsed.operands) else None
+    if kind == "operands":
+        words = parsed.operands[int(arg) :]
+        return words or None
+    if kind == "value":
+        names = set(arg.split("|"))
+        words = [v for s, v in parsed.options if s in names and v is not None]
+        return words or None
+    return None
+
+
+def _decision_b(out: _Outcome) -> None:
+    out.raise_to("destructive", UNREADABLE_CODE)
+
+
+def _effects(
+    table: Table,
+    row: Row,
+    name: str,
+    parsed: _Parsed,
+    stdin: Stdin,
+    out: _Outcome,
+    depth: int,
+    effects: tuple[Effect, ...],
+    elevated: bool,
+) -> bool:
+    opens = False  # this row, or its inner command, opens an interactive shell
+    own_shell = False  # the shell is this row's own (it reads this row's stdin)
+    has_command = False
+    for effect in effects:
+        if not _active(effect, parsed, stdin):
+            continue
+        kind = effect.kind
+        if kind == "elevates":
+            default = row.reason if row.cls == "privileged" else None
+            out.raise_to(
+                "privileged",
+                effect.reason or default or f"{name} runs commands as another user",
+            )
+        elif kind == "destroys":
+            out.raise_to("destructive", effect.reason or f"destructive command: {name}")
+        elif kind == "alters-session":
+            reason = effect.reason or f"changes the shell session: {name}"
+            out.raise_to("session-altering", reason)
+        elif kind == "rejected":
+            out.reject(effect.reason or f"{name}: rejected")
+        elif kind == "reads-terminal":
+            if stdin.kind == "unknown" or (stdin.kind == "file" and not _plain_file(stdin)):
+                out.reject(f"pipe, here-doc or here-string into {name} (stdin not proven)")
+            elif stdin.kind not in ("terminal", "file"):
+                out.reject(f"pipe, here-doc or here-string into {name}")
+        elif kind == "opens-shell":
+            opens = own_shell = True
+        elif kind == "runs-command-at":
+            for inner in _inner_commands(effect, parsed):
+                if inner:
+                    has_command = True
+                    opens |= _inner(table, effect, parsed, inner, stdin, out, depth)
+        elif kind == "runs-stdin-as-code":
+            has_command = True
+            if stdin.kind == "terminal":
+                if row.terminal_stdin == "opens-shell":
+                    opens = True
+            else:
+                _decision_b(out)
+        elif kind == "runs-file-as-code":
+            words = _targets(effect, parsed)
+            if words is None:
+                continue
+            has_command = True
+            if words and all(w.literal and w.text in STDIN_PATHS for w in words):
+                if stdin.kind == "terminal":
+                    opens = True
+                else:
+                    _decision_b(out)
+            else:
+                _decision_b(out)
+        elif kind in ("runs-text", "stores-code"):
+            if _targets(effect, parsed) is None:
+                continue
+            has_command = True
+            _decision_b(out)
+        # sets-variable: names are read by the protected-variable rules (#197 child-3).
+    if not has_command and row.no_command == "opens-shell":
+        opens = own_shell = True
+    if own_shell and stdin.kind != "terminal":
+        _decision_b(out)  # the shell reads its commands from that stdin
+    if opens:
+        out.raise_to("mutating", OPENS_SHELL)
+        if elevated:
+            out.raise_to("privileged", ROOT_SHELL)
+            out.reject_proposal(ROOT_SHELL)
+    return opens
+
+
+def _inner_commands(effect: Effect, parsed: _Parsed) -> list[list[Word]]:
+    kind, _, arg = (effect.at or "").partition(":")
+    if kind == "operand":
+        return [parsed.inner] if parsed.inner and parsed.inner_at == int(arg) else []
+    if kind in ("until", "rest"):
+        out: list[list[Word]] = []
+        for option in arg.split("|"):
+            out.extend(parsed.captured.get(option, []))
+        return out
+    if kind == "value":
+        words = _targets(effect, parsed)
+        return [[w] for w in words or []]
+    return []
+
+
+def _plain_file(stdin: Stdin) -> bool:
+    """A stdin file that is not the shell's own stdin, a descriptor or a device the gate
+    cannot place (`</dev/stdin` is the pipe in front of it)."""
+    path = stdin.value or ""
+    if path in ("/dev/null", "/dev/tty"):
+        return True
+    return path not in STDIN_PATHS and not path.startswith(("/dev/", "/proc/"))
+
+
+def _stdin_for(effect: Effect, stdin: Stdin) -> Stdin:
+    return {
+        "inherit": stdin,
+        "pipe": _PIPE,
+        "null": _NULL,
+        "terminal": _TERMINAL,
+    }[effect.inner_stdin]
+
+
+def _inner(
+    table: Table,
+    effect: Effect,
+    parsed: _Parsed,
+    words: list[Word],
+    stdin: Stdin,
+    out: _Outcome,
+    depth: int,
+) -> bool:
+    words = list(words)
+    replace = [v.text for s, v in parsed.options if s in effect.placeholder and v is not None]
+    if any(s in effect.placeholder for s, v in parsed.options if v is None):
+        replace.append("{}")  # `xargs -i` with no string replaces `{}`
+    if replace:
+        words = [
+            Word(w.text, False, w.source) if any(r and r in w.text for r in replace) else w
+            for w in words
+        ]
+    elif effect.appends:
+        words.append(_ARGUMENTS_FROM_INPUT)
+    if effect.joined is not None and any(
+        not w.literal or not w.text or _SHELL_SPECIAL.search(w.text) for w in words
+    ):
+        _decision_b(out)
+        return False
+    head = words[0]
+    if head.literal and head.text.startswith("-"):
+        out.raise_to("destructive", f"{UNKNOWN_OPTION}: {head.text}")
+        _decision_a(table, words[1:], out)
+        return False
+    return _command(table, words, _stdin_for(effect, stdin), out, depth + 1)
diff --git a/targets/gate.toml b/targets/gate.toml
new file mode 100644
index 0000000..f5930ab
--- /dev/null
+++ b/targets/gate.toml
@@ -0,0 +1,6 @@
+# The one target whose command table (targets/<id>/commands.toml) the policy gate reads
+# (#197, spec policy-gate/v1 §4.1). v1 ships one target and nl_shell.gate.classify has no
+# target argument, so the gate's table is fixed here, in reviewed data, and not chosen from
+# /etc/os-release or the environment. It lives in data because code names no OS
+# (ADR-0023). Changing it changes every command's class: review it like the table itself.
+target = "ubuntu-26.04"
