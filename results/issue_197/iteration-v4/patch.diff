+[command.subcommands.stop]
+[[command.subcommands.stop.effect]]
+kind = "destroys"
+[command.subcommands.disable]
+[[command.subcommands.disable.effect]]
+kind = "destroys"
+[command.subcommands.mask]
+[[command.subcommands.mask.effect]]
+kind = "destroys"
+[command.subcommands.kill]
+[[command.subcommands.kill.effect]]
+kind = "destroys"
+[command.subcommands.isolate]
+[[command.subcommands.isolate.effect]]
+kind = "destroys"
+[command.subcommands.poweroff]
+[[command.subcommands.poweroff.effect]]
+kind = "destroys"
+[command.subcommands.reboot]
+[[command.subcommands.reboot.effect]]
+kind = "destroys"
+[command.subcommands.halt]
+[[command.subcommands.halt.effect]]
+kind = "destroys"
+[command.subcommands.soft-reboot]
+[[command.subcommands.soft-reboot.effect]]
+kind = "destroys"
+[command.subcommands.kexec]
+[[command.subcommands.kexec.effect]]
+kind = "destroys"
+[command.subcommands.emergency]
+[[command.subcommands.emergency.effect]]
+kind = "destroys"
+[command.subcommands.rescue]
+[[command.subcommands.rescue.effect]]
