+values = ["-o", "--push-option", "--receive-pack", "--exec", "--repo"]
+optional = ["--force-with-lease", "--recurse-submodules", "--signed"]
+[[command.subcommands.push.effect]]
+kind = "destroys"
+when = "flag:-f|--force|--force-with-lease|--force-if-includes|--mirror|-d|--delete|--prune"
+reason = "git push that rewrites or deletes remote refs"
+[[command.subcommands.push.effect]]
+kind = "destroys"
+when = "operand-prefix:+"
+reason = "git push with a forced refspec"
+[[command.subcommands.push.effect]]
+kind = "destroys"
+when = "operand-prefix::"
