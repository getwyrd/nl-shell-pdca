+def _may_be_option(word: Word, argv: Argv) -> bool:
+    """Whether a word the gate cannot read may expand to an option: its first character,
+    past any opening quotes, is a dash or something that expands (`$x`, a glob, a
+    brace). `~/x`, `a$b` or `/tmp/*.c` cannot start with a dash."""
+    source = word.source
+    i = 0
+    while i < len(source) and source[i] in "\"'":
+        i += 1
+    first = source[i : i + 1]
+    return first in ("", "-", "$", "`", "*", "?", "[", "{", "\\") or (
+        argv.plus and first == "+"
