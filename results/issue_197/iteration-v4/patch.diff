+values = ["-u", "-T"]
+[[command.effect]]
+kind = "destroys"
+when = "flag:-r"
+reason = "crontab -r removes every job"
+[[command.effect]]
+# A crontab file is commands run later.
+kind = "stores-code"
+at = "operand:0"
+grammar = "crontab"
+when = "no-flag:-l|-r|-e"
