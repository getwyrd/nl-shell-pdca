+
+def _until(args: list[Word], i: int, terminators: tuple[str, ...]) -> tuple[list[Word], int]:
+    start = i
+    while i < len(args):
+        if args[i].literal and args[i].text in terminators:
+            return args[start:i], i + 1
+        i += 1
+    return args[start:], i
+
+
+def _value_word(word: Word, text: str) -> Word:
+    return Word(text=text, literal=word.literal, source=text if word.literal else word.source)
