+  "-r", "--role", "-t", "--type", "-T", "--command-timeout", "-u", "--user", "--host"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-S|--stdin"
+reason = "sudoedit -S reads the password from stdin (§5)"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-A|--askpass"
+reason = "sudoedit -A runs an askpass program (§5)"
+[[command.effect]]
+kind = "rejected"
+when = "flag:-p|--prompt"
+reason = "sudoedit -p sets the password prompt (§5)"
+
+[[command]]
+names = ["su", "su-rs"]
+example = "su"
+class = "privileged"
+reason = "su runs a shell as another user"
+no_command = "opens-shell"
+terminal_stdin = "passes-to-inner"
+flags = ["-f", "--fast", "-l", "--login", "-", "-m", "-p", "--preserve-environment",
+  "-P", "--pty", "-h", "--help", "-V", "--version"]
+values = ["-c", "--command", "--session-command", "-g", "--group", "-G",
+  "--supp-group", "-s", "--shell", "-w", "--whitelist-environment"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "runs-text"
+at = "value:-c|--command|--session-command"
+grammar = "sh"
+[[command.effect]]
+# Words after the user name are arguments to the user's shell (`su root -c x`).
+kind = "runs-text"
+at = "operands:1"
+grammar = "shell-arguments"
+
+[[command]]
+names = ["pkexec"]
+example = "pkexec true"
+prefix = "pkexec"
+class = "privileged"
+reason = "pkexec runs commands as root"
+permute = false
+no_command = "opens-shell"
+terminal_stdin = "passes-to-inner"
+flags = ["--keep-cwd", "--disable-internal-agent", "--version", "--help"]
+values = ["--user"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "runs-command-at"
+at = "operand:0"
+
+[[command]]
+names = ["doas"]
+example = "doas true"
+prefix = "doas"
+class = "privileged"
+reason = "doas runs commands as root"
+permute = false
+no_command = "nothing"
+terminal_stdin = "passes-to-inner"
+flags = ["-L", "-n", "-s"]
+values = ["-C", "-u"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "opens-shell"
+when = ["flag:-s", "no-inner"]
+[[command.effect]]
+kind = "runs-command-at"
+at = "operand:0"
+
+[[command]]
+names = ["run0"]
+example = "run0 true"
+prefix = "run0"
+class = "privileged"
+reason = "run0 runs commands as root"
+permute = false
+no_command = "opens-shell"
+terminal_stdin = "passes-to-inner"
+flags = ["--no-ask-password", "-h", "--help", "--version", "--pty", "--pipe",
+  "--slice-inherit", "--empower"]
+values = ["--unit", "--property", "--description", "--slice", "-u", "--user", "-g",
+  "--group", "--nice", "-D", "--chdir", "--setenv", "--background", "--machine",
+  "--shell-prompt-prefix", "--area", "--lightweight"]
+[[command.effect]]
+kind = "elevates"
+[[command.effect]]
+kind = "reads-terminal"
+[[command.effect]]
+kind = "runs-command-at"
+at = "operand:0"
+inner_stdin = "terminal"
+
+[[command]]
