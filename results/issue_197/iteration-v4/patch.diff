+no_command = "nothing"
+terminal_stdin = "passes-to-inner"
+flags = ["-i", "--ignore-environment", "-", "-0", "--null", "-v", "--debug",
+  "--list-signal-handling", "-h", "--help", "-V", "--version"]
+values = ["-C", "--chdir", "-f", "--file", "-u", "--unset", "-S", "--split-string",
