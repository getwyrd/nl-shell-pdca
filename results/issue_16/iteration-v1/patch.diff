diff --git a/src/nl_shell/backend.py b/src/nl_shell/backend.py
new file mode 100644
index 0000000..0bd79a4
--- /dev/null
+++ b/src/nl_shell/backend.py
@@ -0,0 +1,67 @@
+"""The model backend interface, the model input it is handed, and a recording stub.
+
+The model input is an ordered tuple of chat ``Message``s (system, few-shot examples, then
+the request), because the teacher speaks the OpenAI chat API (#77). The REPL builds it
+once (``nl_shell.prompts.build_messages``), hands that same tuple to the backend and keeps
+it for ``:context``, so what the model was sent and what ``:context`` shows can't drift.
+
+``context_text`` is the documented text form ``:context`` prints: for each message, a line
+``--- <role> ---`` followed by the message content, messages separated by one ``\\n``. The
+REPL escapes hidden characters when it prints it (``nl_shell.render.escape_hidden``); the
+backend gets the raw content.
+
+``RecordingStub`` is the only backend until the model client (#77). It returns the
+responses it was built with, in order, and records every model input it was sent in
+``inputs``, one entry per request. Tests (#13, #78) build a ``Repl`` with it.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+from typing import Protocol
+
+SYSTEM = "system"
+USER = "user"
+ASSISTANT = "assistant"
+
+
+@dataclass(frozen=True)
+class Message:
+    role: str
+    content: str
+
+
+ModelInput = tuple[Message, ...]
+
+
+class BackendError(Exception):
+    """The backend gave no response; the message says why."""
+
+
+class Backend(Protocol):
+    def complete(self, messages: ModelInput) -> str:
+        """The model's raw response text for ``messages``. Raises BackendError."""
+        ...
+
+
+def context_text(messages: Sequence[Message]) -> str:
+    """The text form of a model input, as ``:context`` prints it (before escaping)."""
+    return "\n".join(f"--- {m.role} ---\n{m.content}" for m in messages)
+
+
+class RecordingStub:
+    """A backend that returns fixed responses and records what it was sent."""
+
+    def __init__(self, responses: Iterable[str] = ()) -> None:
+        self._responses = list(responses)
+        self.inputs: list[ModelInput] = []
+
+    def add_response(self, response: str) -> None:
+        self._responses.append(response)
+
+    def complete(self, messages: ModelInput) -> str:
+        self.inputs.append(tuple(messages))
+        if not self._responses:
+            raise BackendError("the stub backend has no response left")
+        return self._responses.pop(0)
