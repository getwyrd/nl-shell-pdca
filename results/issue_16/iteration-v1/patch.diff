diff --git a/src/nl_shell/prompts.py b/src/nl_shell/prompts.py
new file mode 100644
index 0000000..0d1d471
--- /dev/null
+++ b/src/nl_shell/prompts.py
@@ -0,0 +1,234 @@
+"""The editable prompts (``prompts.yaml``) and the model input built from them.
+
+Two layers, ADR-0020 §1-§2 and ADR-0023: the active target's ``prompts/prompts.yaml`` is
+the default layer, and the user's ``$XDG_CONFIG_HOME/nl-shell/prompts.yaml`` overrides it
+key by key. Either file may be missing. Both are read with PyYAML's safe loader only, so a
+tag such as ``!!python/object`` is refused, never run.
+
+The keys, all of which a layer may set:
+
+    system            the system prompt (a non-empty string)
+    examples          the few-shot examples, a list (may be empty) of mappings with
+                        request   the request text (a non-empty string)
+                        response  the answer, a valid ``proposal/v1`` object
+    request_template  the volatile part of the model input; it holds ``{state}`` once
+                      and ends with ``{request}``, which it holds once
+
+Unknown keys, a key with the wrong type, a duplicate key, a file that is not valid YAML or
+whose top level is not a mapping are errors that name the file (``PromptsError``). An
+empty file sets no keys. After merging, ``system`` and ``request_template`` must be set by
+some layer; ``examples`` defaults to none.
+
+The model input (``build_messages``) follows ADR-0018 §4: the stable part first (the
+system prompt, then each example as a user and an assistant message, in file order), the
+volatile part last (one user message: ``request_template`` with ``{state}`` replaced by
+the state block, empty until #11, and the request appended at the end).
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from nl_shell import config, proposal
+from nl_shell.backend import ASSISTANT, SYSTEM, USER, Message, ModelInput
+
+PROMPTS_NAME = "prompts.yaml"
+TARGET_PROMPTS_DIR = "prompts"
+STATE = "{state}"
+REQUEST = "{request}"
+KEYS = ("system", "examples", "request_template")
+REQUIRED = ("system", "request_template")
+EXAMPLE_KEYS = ("request", "response")
+
+
+class PromptsError(Exception):
+    """A prompts file could not be used; the message names the file and the problem."""
+
+
+@dataclass(frozen=True)
+class Example:
+    request: str
+    response: str  # the proposal/v1 object as JSON text
+
+
+@dataclass(frozen=True)
+class Prompts:
+    system: str
+    examples: tuple[Example, ...]
+    request_template: str
+    files: tuple[Path, ...]  # the files that were loaded, default layer first
+
+
+def default_path(target_folder: Path) -> Path:
+    return target_folder / TARGET_PROMPTS_DIR / PROMPTS_NAME
+
+
+def user_path(env: Mapping[str, str] | None = None) -> Path:
+    """The user's prompts.yaml: next to config.toml (ADR-0020 §1)."""
+    return config.config_path(env).with_name(PROMPTS_NAME)
+
+
+class _SafeLoader(yaml.SafeLoader):
+    """PyYAML's safe loader, refusing duplicate mapping keys."""
+
+
+def _construct_mapping(loader: _SafeLoader, node: yaml.MappingNode) -> dict[Any, Any]:
+    loader.flatten_mapping(node)
+    result: dict[Any, Any] = {}
+    for key_node, value_node in node.value:
+        key = loader.construct_object(key_node, deep=True)
+        if key in result:
+            raise yaml.constructor.ConstructorError(
+                None, None, f"duplicate key {key!r}", key_node.start_mark
+            )
+        result[key] = loader.construct_object(value_node, deep=True)
+    return result
+
+
+_SafeLoader.add_constructor(
+    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _construct_mapping
+)
+
+
+def _read_layer(path: Path) -> dict[str, Any] | None:
+    """The validated keys ``path`` sets, or None when it does not exist."""
+    try:
+        data = path.read_bytes()
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise PromptsError(f"{path}: cannot read: {exc.strerror or exc}") from None
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError:
+        raise PromptsError(f"{path}: not valid YAML: not valid UTF-8") from None
+    try:
+        doc = yaml.load(text, Loader=_SafeLoader)
+    except yaml.YAMLError as exc:
+        detail = " ".join(str(exc).split())
+        raise PromptsError(f"{path}: not valid YAML: {detail}") from None
+    if doc is None:
+        return {}
+    if not isinstance(doc, dict):
+        raise PromptsError(f"{path}: must be a mapping of the keys {', '.join(KEYS)}")
+    unknown = [key for key in doc if key not in KEYS]
+    if unknown:
+        names = ", ".join(repr(key) for key in unknown)
+        raise PromptsError(f"{path}: unknown key {names} (known: {', '.join(KEYS)})")
+    layer: dict[str, Any] = {}
+    if "system" in doc:
+        layer["system"] = _string(path, doc["system"], "system")
+    if "examples" in doc:
+        layer["examples"] = _examples(path, doc["examples"])
+    if "request_template" in doc:
+        layer["request_template"] = _template(path, doc["request_template"])
+    return layer
+
+
+def _string(path: Path, value: Any, name: str) -> str:
+    if not isinstance(value, str) or not value:
+        raise PromptsError(f"{path}: `{name}` must be a non-empty string")
+    return value
+
+
+def _examples(path: Path, value: Any) -> tuple[Example, ...]:
+    if not isinstance(value, list):
+        raise PromptsError(f"{path}: `examples` must be a list")
+    examples = []
+    for number, item in enumerate(value, 1):
+        name = f"examples[{number}]"
+        if not isinstance(item, dict) or set(item) != set(EXAMPLE_KEYS):
+            raise PromptsError(
+                f"{path}: `{name}` must be a mapping with exactly the keys "
+                f"{', '.join(EXAMPLE_KEYS)}"
+            )
+        request = _string(path, item["request"], f"{name}.request")
+        response = item["response"]
+        if not isinstance(response, dict):
+            raise PromptsError(f"{path}: `{name}.response` must be a mapping")
+        try:
+            text = json.dumps(response, ensure_ascii=False)
+        except (TypeError, ValueError):
+            raise PromptsError(
+                f"{path}: `{name}.response` must hold only strings"
+            ) from None
+        parsed = proposal.parse(text)
+        if isinstance(parsed, proposal.Rejected):
+            raise PromptsError(
+                f"{path}: `{name}.response` is not a valid proposal/v1 object: "
+                f"{parsed.why}"
+            )
+        examples.append(Example(request=request, response=text))
+    return tuple(examples)
+
+
+def _template(path: Path, value: Any) -> str:
+    template = _string(path, value, "request_template")
+    if (
+        template.count(STATE) != 1
+        or template.count(REQUEST) != 1
+        or not template.endswith(REQUEST)
+    ):
+        raise PromptsError(
+            f"{path}: `request_template` must hold {STATE} once and end with {REQUEST}"
+        )
+    return template
+
+
+def load(target_folder: Path, user: Path | None = None) -> Prompts | None:
+    """The merged prompts, or None when neither layer exists.
+
+    ``target_folder`` is the active target's folder (``Target.folder``); ``user`` is the
+    user's file (``user_path()`` by default).
+    """
+    user = user_path() if user is None else user
+    merged: dict[str, Any] = {}
+    files: list[Path] = []
+    for path in (default_path(target_folder), user):
+        layer = _read_layer(path)
+        if layer is not None:
+            merged.update(layer)
+            files.append(path)
+    if not files:
+        return None
+    for key in REQUIRED:
+        if key not in merged:
+            raise PromptsError(
+                f"{files[-1]}: `{key}` is not set (looked in {', '.join(map(str, files))})"
+            )
+    return Prompts(
+        system=merged["system"],
+        examples=merged.get("examples", ()),
+        request_template=merged["request_template"],
+        files=tuple(files),
+    )
+
+
+def status_line(prompts: Prompts | None) -> str:
+    """The ``:status`` line naming the prompt files that were loaded (ADR-0020 §4)."""
+    if prompts is None:
+        return "prompt files: none"
+    return f"prompt files: {', '.join(str(path) for path in prompts.files)}"
+
+
+def _volatile(template: str, request: str, state: str) -> str:
+    # Plain replacement, never str.format: braces in the request or state are text.
+    return template[: -len(REQUEST)].replace(STATE, state) + request
+
+
+def build_messages(prompts: Prompts, request: str, state: str = "") -> ModelInput:
+    """The model input for one request, stable part first (ADR-0018 §4)."""
+    messages: list[Message] = [Message(SYSTEM, prompts.system)]
+    for example in prompts.examples:
+        user_text = _volatile(prompts.request_template, example.request, "")
+        messages.append(Message(USER, user_text))
+        messages.append(Message(ASSISTANT, example.response))
+    messages.append(Message(USER, _volatile(prompts.request_template, request, state)))
+    return tuple(messages)
+
diff --git a/src/nl_shell/proposal.py b/src/nl_shell/proposal.py
new file mode 100644
index 0000000..872f8ca
--- /dev/null
+++ b/src/nl_shell/proposal.py
@@ -0,0 +1,155 @@
+"""The ``proposal/v1`` parser: strict, reject not repair.
+
+Spec ``docs/design/specs/proposal/v1.md`` (Requirements 1-5) and ADR-0018 §3. ``SCHEMA`` is
+the spec's JSON schema, kept here once: the parser checks against it, and the model client
+(#77) sends the same object for constrained decoding.
+
+``parse`` returns exactly one of:
+
+- ``CommandProposal`` (``kind = "command"``, with ``command`` and ``risk``);
+- ``Decline`` (``kind = "clarify"`` or ``"refuse"``, with ``reason``);
+- ``Rejected``, with a short reason for the log, when the text is not one valid object.
+
+Nothing in between: a response that fails to parse as JSON, fails the schema or breaks
+rule 2 is rejected, never repaired. Beyond the schema, a ``command`` that holds a hidden
+character (``nl_shell.render.is_hidden``: C0 controls other than LF and TAB, DEL, C1
+controls, bidi controls) is rejected too (threat model: "proposals with bidi or control
+characters are rejected"). LF (a multi-line command, rule 3) and TAB are allowed.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any
+
+from nl_shell.render import is_hidden
+
+SCHEMA: Mapping[str, Any] = {
+    "type": "object",
+    "additionalProperties": False,
+    "required": ["kind"],
+    "properties": {
+        "kind": {"enum": ["command", "clarify", "refuse"]},
+        "command": {"type": "string", "minLength": 1, "maxLength": 2000},
+        "risk": {
+            "enum": [
+                "read-only",
+                "mutating",
+                "session-altering",
+                "destructive",
+                "privileged",
+            ]
+        },
+        "reason": {
+            "enum": [
+                "unclear-request",
+                "not-a-shell-task",
+                "unsafe-request",
+                "missing-information",
+            ]
+        },
+    },
+}
+
+
+@dataclass(frozen=True)
+class CommandProposal:
+    command: str
+    risk: str
+
+
+@dataclass(frozen=True)
+class Decline:
+    kind: str  # "clarify" or "refuse"
+    reason: str
+
+
+@dataclass(frozen=True)
+class Rejected:
+    why: str
+
+
+Result = CommandProposal | Decline | Rejected
+
+
+class _Invalid(Exception):
+    pass
+
+
+def _no_constants(name: str) -> Any:
+    raise _Invalid(f"not valid JSON: {name} is not a JSON value")
+
+
+def _no_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    obj: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in obj:
+            raise _Invalid(f"duplicate property {key!r}")
+        obj[key] = value
+    return obj
+
+
+def _check_value(name: str, value: Any, rule: Mapping[str, Any]) -> None:
+    if "enum" in rule:
+        if not isinstance(value, str) or value not in rule["enum"]:
+            raise _Invalid(f"`{name}` is not one of {', '.join(rule['enum'])}")
+        return
+    if rule.get("type") == "string":
+        if not isinstance(value, str):
+            raise _Invalid(f"`{name}` is not a string")
+        if len(value) < rule.get("minLength", 0):
+            raise _Invalid(f"`{name}` is shorter than {rule['minLength']} code points")
+        if "maxLength" in rule and len(value) > rule["maxLength"]:
+            raise _Invalid(f"`{name}` is longer than {rule['maxLength']} code points")
+        return
+    raise AssertionError(f"SCHEMA rule for {name} not handled")  # pragma: no cover
+
+
+def _check(raw: str) -> Result:
+    try:
+        doc = json.loads(
+            raw, object_pairs_hook=_no_duplicates, parse_constant=_no_constants
+        )
+    except json.JSONDecodeError as exc:
+        raise _Invalid(f"not valid JSON: {exc.msg}") from None
+    except RecursionError:
+        raise _Invalid("not valid JSON: nested too deeply") from None
+    if not isinstance(doc, dict):
+        raise _Invalid("not a JSON object")
+    properties = SCHEMA["properties"]
+    extra = sorted(set(doc) - set(properties))
+    if extra and SCHEMA["additionalProperties"] is False:
+        raise _Invalid(f"unknown properties: {', '.join(extra)}")
+    for name in SCHEMA["required"]:
+        if name not in doc:
+            raise _Invalid(f"missing `{name}`")
+    for name, value in doc.items():
+        _check_value(name, value, properties[name])
+
+    # Rule 2.
+    kind = doc["kind"]
+    if kind == "command":
+        if "command" not in doc or "risk" not in doc:
+            raise _Invalid("`kind` command needs `command` and `risk`")
+        if "reason" in doc:
+            raise _Invalid("`kind` command must not have `reason`")
+        command = doc["command"]
+        hidden = [c for c in command if is_hidden(c)]
+        if hidden:
+            raise _Invalid(f"`command` holds a hidden character (U+{ord(hidden[0]):04X})")
+        return CommandProposal(command=command, risk=doc["risk"])
+    if "reason" not in doc:
+        raise _Invalid(f"`kind` {kind} needs `reason`")
+    if "command" in doc:
+        raise _Invalid(f"`kind` {kind} must not have `command`")
+    return Decline(kind=kind, reason=doc["reason"])
+
+
+def parse(raw: str) -> Result:
+    """The parsed response, or ``Rejected`` saying why it is not a valid proposal."""
+    try:
+        return _check(raw)
+    except _Invalid as exc:
+        return Rejected(why=str(exc))
diff --git a/src/nl_shell/render.py b/src/nl_shell/render.py
new file mode 100644
index 0000000..d5664ae
--- /dev/null
+++ b/src/nl_shell/render.py
@@ -0,0 +1,41 @@
+"""Escaping hidden characters in text nl-shell shows (threat model: rendering is filtered
+everywhere).
+
+A hidden character is one that can move the cursor, change the terminal's state or
+reorder what the user sees: every C0 control except LF and TAB, DEL, every C1 control
+(U+0080-U+009F) and the bidi controls in ``BIDI_CONTROLS``. ``escape_hidden`` prints each
+one as ``\\xHH`` (code points up to U+00FF) or ``\\uHHHH``, in lowercase hex. LF and TAB
+are printed as they are, and every other character is left unchanged, so ordinary text is
+byte-identical.
+
+The proposal parser (``nl_shell.proposal``) rejects a ``command`` that holds any of these
+characters, with the same ``is_hidden`` test, so what is shown and what is rejected can't
+drift apart.
+"""
+
+from __future__ import annotations
+
+# U+061C ARABIC LETTER MARK, U+200E/U+200F LRM/RLM, U+202A-U+202E embeddings and
+# overrides, U+2066-U+2069 isolates.
+BIDI_CONTROLS = frozenset(
+    {0x061C, 0x200E, 0x200F, *range(0x202A, 0x202F), *range(0x2066, 0x206A)}
+)
+SHOWN_AS_IS = frozenset("\n\t")
+
+
+def is_hidden(char: str) -> bool:
+    """True for one character that ``escape_hidden`` escapes."""
+    if char in SHOWN_AS_IS:
+        return False
+    cp = ord(char)
+    return cp < 0x20 or cp == 0x7F or 0x80 <= cp <= 0x9F or cp in BIDI_CONTROLS
+
+
+def escape_char(char: str) -> str:
+    cp = ord(char)
+    return f"\\x{cp:02x}" if cp <= 0xFF else f"\\u{cp:04x}"
+
+
+def escape_hidden(text: str) -> str:
+    """``text`` with every hidden character written out as an escape."""
+    return "".join(escape_char(c) if is_hidden(c) else c for c in text)
