+def _slow_termios_check(monkeypatch, delay=0.15):
+    """Make nl-shell slow to read the terminal settings, as on a loaded machine: the real
+    check still runs, ``delay`` seconds late (long after bash's hooks would have ended)."""
+    session_cls = _session_module().Session
+    real = session_cls._check_termios
+
+    def slow(self, *args, **kwargs):
+        time.sleep(delay)
+        return real(self, *args, **kwargs)
+
+    monkeypatch.setattr(session_cls, "_check_termios", slow)
+
