+def _changed_hook_lines(session, result):
+    """The ``H`` lines of ``result``'s snapshot that the baseline does not have."""
+    expected = _protocol_module().expected_hooks(session.baseline, result.snapshot.seq)
+    return sorted(set(result.snapshot.hooks.split("\n")) - set(expected.split("\n")))
