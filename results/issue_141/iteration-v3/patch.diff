+@pytest.mark.parametrize(
+    "setup, command, changed",
+    [
+        ("", "set -x", ['declare -- __nls_x="1"']),
+        ("", "set -o xtrace", ['declare -- __nls_x="1"']),
+        ("exec 9>/dev/null", "BASH_XTRACEFD=9", ['declare -- BASH_XTRACEFD="9"']),
+    ],
+    ids=["set-x", "set-o-xtrace", "xtracefd"],
+)
+def test_r_each_xtrace_row_degrades_at_its_own_snapshot(start_session, monkeypatch, tmp_path,
+                                                        setup, command, changed):
+    # Assert which H line fired, so a regression in one row is not hidden by another.
+    pty_writes = _spy_on_pty_writes(monkeypatch)
+    session_mod = _session_module()
+    marker = tmp_path / "MARK"
+    session, _ = start_session()
+    if setup:
+        _run(session, setup)
+        assert not session.degraded, session.degraded_reason
+    # The PS4 payload first: refused (readonly), so xtrace would trace with the baseline.
+    _run(session, f"PS4='$(echo x >> {marker})'")
+    assert not session.degraded, session.degraded_reason
+    with pytest.raises(session_mod.SessionDegraded) as caught:
+        _run(session, command)
+    _assert_degraded_with(session, caught.value, "h-changed")
+    result = caught.value.result
+    assert result is not None
+    lines = _changed_hook_lines(session, result)
+    for line in changed:
+        assert line in lines, lines
+    assert not any("PS4" in line for line in lines), lines
+    _assert_refused_unsent(session, pty_writes, "true", marker)
+    time.sleep(0.3)
+    assert not marker.exists()
+
