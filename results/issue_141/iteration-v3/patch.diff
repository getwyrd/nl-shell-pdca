+def test_r_brief_line_degrades_and_its_payload_never_runs(start_session, monkeypatch,
+                                                          tmp_path):
+    # The parent brief's line, as one paste. PS4 is readonly (bash traces PROMPT_COMMAND,
+    # so a PS4 the command set would run before any snapshot): the assignment fails and
+    # bash drops the rest of the line, so `set -x` does not run. BASH_XTRACEFD, set
+    # before it, is what changes H. The xtrace and PS4 rows are tested one by one below.
+    pty_writes = _spy_on_pty_writes(monkeypatch)
+    session_mod = _session_module()
+    marker = tmp_path / "MARK"
+    session, _ = start_session()
+    command = f"exec 9>/dev/null; BASH_XTRACEFD=9; PS4='$(echo x >> {marker})'; set -x"
+    with pytest.raises(session_mod.SessionDegraded) as caught:
+        _run(session, command)
+    _assert_degraded_with(session, caught.value, "h-changed")
+    result = caught.value.result
+    assert result is not None and result.seq == 1
+    assert "PS4: readonly variable" in result.text
+    assert _changed_hook_lines(session, result) == ['declare -- BASH_XTRACEFD="9"']
+    _assert_refused_unsent(session, pty_writes, "true", marker)
+    time.sleep(0.3)
+    assert not marker.exists()
+
+
+def test_r_ps4_payload_is_refused_and_never_runs(start_session, tmp_path):
+    marker = tmp_path / "MARK"
+    session, _ = start_session()
+    for command in (f"PS4='$(echo x >> {marker})'", f"declare PS4='$(echo x >> {marker})'",
+                    f"printf -v PS4 '%s' '$(echo x >> {marker})'"):
+        result = _run(session, command)
+        assert "PS4: readonly variable" in result.text, result.text
+        assert result.status != 0
+    # PS4 kept its value, so H did not change; set -x now traces with the baseline PS4.
+    assert not session.degraded, session.degraded_reason
+    assert _changed_hook_lines(session, result) == []
+    time.sleep(0.3)
+    assert not marker.exists()
