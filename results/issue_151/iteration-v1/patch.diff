+    started = []
+
+    def start(script, *, unix: bool = False) -> Fake:
+        fake = Fake(script)
+        if unix:
+            directory = tempfile.mkdtemp(prefix="nls-")
+            fake.path = os.path.join(directory, "s")
+            server = _UnixServer(fake.path, _Handler)
+        else:
+            directory = None
