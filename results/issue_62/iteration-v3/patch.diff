diff --git a/src/nl_shell/failure_classes.py b/src/nl_shell/failure_classes.py
new file mode 100644
index 0000000..60216af
--- /dev/null
+++ b/src/nl_shell/failure_classes.py
@@ -0,0 +1,375 @@
+"""Failure classes by exit code: a deterministic first pass over a finished command (#62).
+
+The classifier reads trusted facts only: the exit status from the control channel's done
+record (ADR-0014 Decision 2; never the PTY output), the session state the control channel
+reported with it, and the command text the user confirmed. It never sees stderr:
+"bash: x: command not found" is text an attacker can shape (threat model item 1), and
+stderr goes, if at all, to the quarantined reader (ADR-0017), which only the "other" class
+is sent to.
+
+Order (first match wins):
+
+1. Nothing ran (a ``D`` record without ``S``, pty-protocol v1 §4.1: an empty line, a
+   comment, a syntax error): not run. ``$?`` may then be an earlier command's status.
+2. exit status 0: no failure.
+3. A privilege wrapper (the confirmed command's first word is sudo, su, pkexec or doas, or
+   another installed name of one of them such as sudo-rs or sudoedit) exiting with that
+   wrapper's own failure status: a privilege-wrapper failure. Nothing
+   about it may touch the password (ADR-0006, ADR-0015), so there is no correction offer
+   and it never goes to the reader.
+4. 127 not found, 126 not executable, 130 interrupted, 129-192 killed by signal n
+   (128 + n, n = 1-64), as bash(1) EXIT STATUS defines them.
+5. Everything else: other, the only class sent to the reader.
+
+The package that provides a not-found command comes from local data that the active
+target names in its ``target.toml`` (``[command_provider]``, ADR-0023: this code names
+no OS). It is read-only and local (ADR-0003). A package is suggested only when the
+not-found word is certain: a simple command whose first word the session could not
+resolve (not a builtin, keyword, function or alias, and not an executable on the
+session's ``$PATH``). If bash found the first word, a 127 came from something that word
+ran (``timeout 5 x``, ``npm run x``), and naming the first word's package would be a
+confident wrong answer, which is worse than none.
+"""
+
+from __future__ import annotations
+
+import enum
+import os
+import posixpath
+import re
+import signal
+import sqlite3
+from collections.abc import Callable, Iterable
+from contextlib import closing
+from dataclasses import dataclass
+from pathlib import Path
+
+from nl_shell.pty_protocol import Done, Snapshot
+from nl_shell.router import BASH_BUILTINS, first_token
+from nl_shell.session import CommandResult
+from nl_shell.targets import CommandProvider
+
+# A lookup takes a command word and returns the names of packages that provide it.
+Lookup = Callable[[str], Iterable[str]]
+
+NOT_FOUND = 127
+NOT_EXECUTABLE = 126
+INTERRUPTED = 130  # 128 + SIGINT
+SIGNAL_BASE = 128
+MAX_SIGNAL = 64
+
+# The status each privilege wrapper exits with when it fails itself, before or instead of
+# running the command:
+# - su(1) EXIT STATUS: 1 is su's own error before it runs the command.
+# - pkexec(1) RETURN VALUE: 126 the authentication dialog was dismissed, 127 not authorized
+#   or authentication failed.
+# - sudo: classic sudo(8) EXIT VALUE says 1 when sudo itself fails. The sudo-rs man page on
+#   the reference host documents no exit status, so 1 is UNVERIFIED for sudo-rs; the real
+#   check is #24 (sudo-rs behaviour) and #75 (VM test). doas(1) also exits 1 on its own
+#   failure.
+# A command run under the wrapper that itself exits with the same status is classed as a
+# wrapper failure too: that only drops the correction offer and the reader, the safe side.
+WRAPPER_FAILURE_STATUS = {
+    "sudo": frozenset({1}),
+    "su": frozenset({1}),
+    "doas": frozenset({1}),
+    "pkexec": frozenset({126, 127}),
+}
+
+# Other names the same programs are installed and run under, mapped to the program whose
+# failure status they share. sudo-rs ships `sudo-rs`, `sudoedit-rs` and `su-rs`; classic
+# sudo is also installed as `sudo.ws`; `sudoedit` is sudo's edit mode (sudo -e) and fails
+# the same way. A program name, not an OS path (ADR-0023).
+WRAPPER_ALIASES = {
+    "sudo-rs": "sudo",
+    "sudo.ws": "sudo",
+    "sudoedit": "sudo",
+    "sudoedit-rs": "sudo",
+    "sudoedit.ws": "sudo",
+    "su-rs": "su",
+}
+
+# First words after which the first word is not the command that was not found. The
+# session check (``_resolves``) catches any other first word that bash found; this list
+# also covers a done record that comes without session state.
+_COMMAND_WRAPPERS = frozenset(
+    {"env", "nohup", "time", "nice", "command", "exec", "xargs"}
+    | set(WRAPPER_FAILURE_STATUS)
+    | set(WRAPPER_ALIASES)
+)
+# Output of `compgen -k` in bash 5: words bash itself handles, never looked up on $PATH.
+_BASH_KEYWORDS = frozenset(
+    "if then else elif fi case esac for select while until do done in function time "
+    "{ } ! [[ ]] coproc".split()
+)
+# Text that makes the confirmed command more than one simple command: `$?` is then the
+# status of the last one, which need not be the first word.
+_COMPOUND = ("|", ";", "&", "\n", "`", "$(")
+# `alias -p` prints `alias NAME='VALUE'`; `enable -n` prints `enable -n NAME`.
+_ALIAS_LINE = re.compile(r"alias (?:-- )?([^=\s]+)=")
+_DISABLED_LINE = re.compile(r"enable -n (\S+)")
+
+# Debian package-name rule, matched against the whole string (re.fullmatch, so a trailing
+# newline or any suffix is rejected).
+_PACKAGE_NAME = re.compile(r"[a-z0-9][a-z0-9+.-]+")
+_MAX_PACKAGES = 5
+_MAX_SHOWN_WORD = 64
+
+
+class FailureClass(enum.Enum):
+    NONE = "none"
+    NOT_RUN = "not_run"
+    NOT_FOUND = "not_found"
+    NOT_EXECUTABLE = "not_executable"
+    INTERRUPTED = "interrupted"
+    SIGNAL = "signal"
+    PRIVILEGE_WRAPPER = "privilege_wrapper"
+    OTHER = "other"
+
+
+_NOT_AN_ERROR = frozenset({FailureClass.NONE, FailureClass.NOT_RUN, FailureClass.INTERRUPTED})
+# Nothing to correct when nothing ran or nothing failed; Ctrl-C is not a mistake to correct;
+# and nothing may touch the sudo password (ADR-0006).
+_NO_CORRECTION = frozenset(
+    {
+        FailureClass.NONE,
+        FailureClass.NOT_RUN,
+        FailureClass.INTERRUPTED,
+        FailureClass.PRIVILEGE_WRAPPER,
+    }
+)
+
+
+@dataclass(frozen=True)
+class Failure:
+    """The class of one finished command and its fixed response.
+
+    ``status`` is bash's ``$?`` from the done record (the last command of a pipeline);
+    ``pipestatus`` is ``PIPESTATUS`` from the same record, for callers. ``message`` is a
+    fixed template, never model text. ``is_error`` is False for no failure, for nothing
+    run and for an interrupt (Ctrl-C is not an error). ``offer_correction`` is False for
+    those and for a privilege-wrapper failure; ``to_reader`` is True only for ``OTHER``.
+
+    ``command_word`` is set only for ``NOT_FOUND`` when the not-found word is certain, and
+    only when it is safe to display (printable, at most 64 characters): no escape or bidi
+    character from the confirmed text reaches it or ``message``.
+    """
+
+    kind: FailureClass
+    status: int
+    pipestatus: tuple[int, ...]
+    message: str
+    is_error: bool
+    offer_correction: bool
+    to_reader: bool
+    signal_number: int | None = None
+    signal_name: str | None = None
+    wrapper: str | None = None
+    command_word: str | None = None  # the not-found word, only when certain and printable
+    packages: tuple[str, ...] = ()  # packages that provide command_word
+
+
+def classify(
+    result: Done | CommandResult, command: str, lookup: Lookup | None = None
+) -> Failure:
+    """Classify a finished command.
+
+    ``result`` is the session's completion result (``session.CommandResult``) or the bare
+    done record it was built from (``pty_protocol.Done``). Its status, pipestatus, ``ran``
+    and snapshot are read, never its output. A bare ``Done`` carries no session state, so
+    the not-found word can't be checked against the session and no package is suggested.
+    ``command`` is the command text the user confirmed. ``lookup`` names the packages that
+    provide a command word (see ``provider_lookup``); None gives no suggestion.
+    """
+    if not isinstance(result, (Done, CommandResult)):
+        raise TypeError(
+            "classify() needs the done record (pty_protocol.Done or session.CommandResult), "
+            f"not {type(result).__name__}"
+        )
+    status = result.status
+    pipestatus = tuple(result.pipestatus)
+    snapshot = result.snapshot if isinstance(result, CommandResult) else None
+
+    def failure(kind: FailureClass, message: str, **kwargs) -> Failure:
+        return Failure(
+            kind=kind,
+            status=status,
+            pipestatus=pipestatus,
+            message=message,
+            is_error=kind not in _NOT_AN_ERROR,
+            offer_correction=kind not in _NO_CORRECTION,
+            to_reader=kind is FailureClass.OTHER,
+            **kwargs,
+        )
+
+    # D without S: bash read the line but ran nothing (§4.1). For an empty line or a
+    # comment `$?` is the previous command's status, so it must not be classed.
+    if isinstance(result, CommandResult) and not result.ran:
+        return failure(FailureClass.NOT_RUN, "No command ran.")
+
+    if status == 0:
+        return failure(FailureClass.NONE, "")
+
+    # The first shell word of the confirmed command, with the router's tokenizer. The policy
+    # gate's parse (#12) replaces this once it exists.
+    word = first_token(command)
+    name = posixpath.basename(word)
+    wrapper = WRAPPER_ALIASES.get(name, name)
+    if status in WRAPPER_FAILURE_STATUS.get(wrapper, ()):
+        # `name` is one of the fixed names above, so it is safe to show.
+        return failure(
+            FailureClass.PRIVILEGE_WRAPPER,
+            _wrapper_message(wrapper, name, status),
+            wrapper=wrapper,
+        )
+
+    if status == NOT_FOUND:
+        certain = (
+            _is_simple(command, word)
+            and _is_shown_safely(word)
+            and snapshot is not None
+            and not _resolves(word, snapshot)
+        )
+        if not certain:
+            return failure(FailureClass.NOT_FOUND, "Command not found.")
+        packages = _packages(lookup, word)
+        if not packages:
+            message = f"Command not found: {word}."
+        else:
+            names = ", ".join(packages)
+            noun = "package" if len(packages) == 1 else "packages"
+            message = f"Command not found: {word}. It is provided by the {noun} {names}."
+        return failure(FailureClass.NOT_FOUND, message, command_word=word, packages=packages)
+
+    if status == NOT_EXECUTABLE:
+        return failure(
+            FailureClass.NOT_EXECUTABLE,
+            "The command was found but could not be run (permission or noexec).",
+        )
+
+    if status == INTERRUPTED:
+        return failure(
+            FailureClass.INTERRUPTED,
+            "Interrupted (Ctrl-C).",
+            signal_number=status - SIGNAL_BASE,
+            signal_name="SIGINT",
+        )
+
+    if SIGNAL_BASE < status <= SIGNAL_BASE + MAX_SIGNAL:
+        number = status - SIGNAL_BASE
+        name = _signal_name(number)
+        message = f"The command was killed by {name} (signal {number})."
+        if number == signal.SIGKILL:
+            message += (
+                " If nobody killed it, the kernel's out-of-memory (OOM) killer may have,"
+                " because the system ran out of memory."
+            )
+        return failure(FailureClass.SIGNAL, message, signal_number=number, signal_name=name)
+
+    return failure(FailureClass.OTHER, f"The command failed with exit status {status}.")
+
+
+def _wrapper_message(wrapper: str, name: str, status: int) -> str:
+    """The fixed message for ``wrapper`` (the program), shown under ``name`` (as typed)."""
+    if wrapper == "pkexec":
+        if status == 126:
+            return "pkexec did not run the command: the authentication dialog was dismissed."
+        return (
+            "pkexec did not run the command: you are not authorized, or authentication "
+            "failed."
+        )
+    if wrapper == "su":
+        return (
+            f"{name} failed with exit status 1: the password was wrong, or {name} could not "
+            "run the command."
+        )
+    return (
+        f"{name} failed with exit status 1: the password was wrong, or you may not use "
+        f"{name}. A command run under {name} that exits with 1 looks the same."
+    )
+
+
+def _is_simple(command: str, word: str) -> bool:
+    """True when ``word`` is the only command whose status ``$?`` can be."""
+    if not word or any(mark in command for mark in _COMPOUND):
+        return False
+    if "=" in word or "/" in word:  # a leading assignment, or a path (no package for it)
+        return False
+    return word not in _COMMAND_WRAPPERS
+
+
+def _is_shown_safely(word: str) -> bool:
+    """No control, escape or bidi character, and short enough to show."""
+    return word.isprintable() and len(word) <= _MAX_SHOWN_WORD
+
+
+def _resolves(word: str, snapshot: Snapshot) -> bool:
+    """True when the session could have found ``word``, so its 127 came from elsewhere.
+
+    Uses the snapshot the control channel reported after the command: functions, aliases,
+    disabled builtins and ``$PATH``. When ``$PATH`` holds an empty or relative entry the
+    session's working directory would matter, which the snapshot doesn't carry, so the
+    word counts as found (no suggestion: the safe side).
+    """
+    if word in _BASH_KEYWORDS or word in snapshot.functions:
+        return True
+    if word in {m.group(1) for m in _ALIAS_LINE.finditer(snapshot.aliases)}:
+        return True
+    disabled = {m.group(1) for m in _DISABLED_LINE.finditer(snapshot.disabled_builtins)}
+    if word in BASH_BUILTINS and word not in disabled:
+        return True
+    for entry in snapshot.path.split(":"):
+        if not entry or not os.path.isabs(entry):
+            return True
+        candidate = os.path.join(entry, word)
+        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return True
+    return False
+
+
+def _packages(lookup: Lookup | None, word: str) -> tuple[str, ...]:
+    if lookup is None:
+        return ()
+    names = lookup(word)
+    if isinstance(names, str):
+        names = (names,)
+    kept: list[str] = []
+    for name in names:
+        if isinstance(name, str) and _PACKAGE_NAME.fullmatch(name) and name not in kept:
+            kept.append(name)
+            if len(kept) == _MAX_PACKAGES:
+                break
+    return tuple(kept)
+
+
+def _signal_name(number: int) -> str:
+    try:
+        return signal.Signals(number).name
+    except ValueError:
+        if signal.SIGRTMIN < number < signal.SIGRTMAX:
+            return f"SIGRTMIN+{number - signal.SIGRTMIN}"
+        return f"signal {number}"
+
+
+def provider_lookup(provider: CommandProvider | None) -> Lookup:
+    """The package lookup the target's ``[command_provider]`` describes.
+
+    The data is opened read-only and never fetched (ADR-0003). When the target has no
+    provider or its data is absent or unreadable, the lookup returns nothing.
+    """
+
+    def lookup(word: str) -> tuple[str, ...]:
+        if provider is None or provider.format != "sqlite":
+            return ()
+        path = Path(provider.path)
+        if not path.is_file():
+            return ()
+        try:
+            uri = path.as_uri() + "?mode=ro"
+            with closing(sqlite3.connect(uri, uri=True, timeout=1.0)) as db:
+                rows = db.execute(provider.query, (word,)).fetchall()
+        except (sqlite3.Error, OSError, ValueError):
+            return ()
+        return tuple(row[0] for row in rows if row and isinstance(row[0], str))
+
+    return lookup
