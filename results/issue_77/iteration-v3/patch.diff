diff --git a/src/nl_shell/teacher_client.py b/src/nl_shell/teacher_client.py
new file mode 100644
index 0000000..fd35051
--- /dev/null
+++ b/src/nl_shell/teacher_client.py
@@ -0,0 +1,335 @@
+"""The model client: OpenAI chat completions over HTTP.
+
+ADR-0018 §1–§3 and §5, ADR-0020 §3. It talks to an OpenAI-compatible chat endpoint —
+llama.cpp ``llama-server`` or vLLM, with no API key — either over the local Unix socket
+(the default) or, for a session started with ``--dev-teacher``, over a TCP URL
+(``http://`` or ``https://``).
+
+Endpoint rules (ADR-0020 §3). By default nl-shell talks only to
+``$XDG_RUNTIME_DIR/nl-shell/model.sock``. Any other URL, a loopback TCP port included, is
+used only when the session was started with ``--dev-teacher``; a ``teacher_url`` in
+``config.toml`` on its own is refused with a message and the default socket is used. An
+unset ``XDG_RUNTIME_DIR`` means there is no default socket (we never guess
+``/run/user/<uid>``). A plain ``http://`` URL whose host is not loopback gets a warning: the
+state block would go out in clear.
+
+Responses are rejected, never repaired, and never retried (ADR-0018 §3): a non-2xx status,
+a redirect (never followed: it could send the state block to a host the user didn't
+name), a body over ``MAX_RESPONSE_BYTES``, a body that is not JSON, a missing
+``choices[0].message.content``, a TLS failure (certificate and protocol checks stay on;
+there is no plain-HTTP fallback), or no answer within the timeout. Each rejection is a
+``TeacherError`` whose ``reason`` says why.
+
+The request asks for constrained decoding with a JSON-schema ``response_format``; the
+schema is passed in by the caller, so the one ``proposal/v1`` schema the parser uses is
+also the one the model is held to (ADR-0018 §2). No credential is ever sent.
+"""
+
+from __future__ import annotations
+
+import http.client
+import ipaddress
+import json
+import os
+import socket
+import ssl
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+from urllib.parse import urlsplit
+
+# Connect and read timeouts, in seconds. A CPU-only teacher can be slow to answer.
+CONNECT_TIMEOUT_S = 5
+READ_TIMEOUT_S = 120
+# A maximal proposal/v1 answer (`command` is at most 2000 code points) plus the
+# chat-completions envelope fits in this with plenty of room.
+MAX_RESPONSE_BYTES = 64 * 1024
+CHAT_COMPLETIONS_PATH = "/v1/chat/completions"
+SOCKET_DIR = "nl-shell"
+SOCKET_NAME = "model.sock"
+SCHEMA_NAME = "proposal_v1"
+
+MODEL_SERVER_NOT_RUNNING = "the model server isn't running"
+CLEAR_TEXT_WARNING = (
+    "the dev teacher at {url} is plain HTTP on a non-loopback host, so the state block "
+    "goes over the network in clear; use an SSH tunnel to a loopback port, or https://"
+)
+CONFIG_URL_REFUSED = (
+    "config.toml sets teacher_url = {url!r}, but a model endpoint other than the local "
+    "socket is used only with --dev-teacher; using the local model socket"
+)
+
+
+class TeacherError(Exception):
+    """A request to the model server was rejected; ``reason`` says why."""
+
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+class ModelServerUnavailable(TeacherError):
+    """Nothing is listening at the endpoint (or there is no default socket)."""
+
+
+class EndpointError(Exception):
+    """The endpoint the user named can't be used; the message says why."""
+
+
+@dataclass(frozen=True)
+class Endpoint:
+    """Where the model server is: a Unix socket path or an http(s) URL."""
+
+    socket_path: Path | None = None
+    url: str | None = None
+
+    @property
+    def is_default(self) -> bool:
+        return self.url is None
+
+    def describe(self) -> str:
+        if self.url is not None:
+            return f"{self.url} (dev teacher)"
+        return f"unix:{self.socket_path} (local model socket)"
+
+
+@dataclass(frozen=True)
+class EndpointDecision:
+    """The session's endpoint (``None``: no default socket) and what to tell the user."""
+
+    endpoint: Endpoint | None
+    messages: tuple[str, ...] = ()
+
+    def status_lines(self) -> tuple[str, ...]:
+        """The ``:status`` lines for this decision (ADR-0020 §4)."""
+        if self.endpoint is None:
+            endpoint = (
+                "endpoint: none (XDG_RUNTIME_DIR is not set, "
+                "so there is no local model socket)"
+            )
+        else:
+            endpoint = f"endpoint: {self.endpoint.describe()}"
+        return (endpoint, "backend: OpenAI chat completions (no API key)")
+
+
+def default_socket(env: Mapping[str, str] | None = None) -> Path | None:
+    """``$XDG_RUNTIME_DIR/nl-shell/model.sock``; ``None`` if that variable is unusable."""
+    env = os.environ if env is None else env
+    runtime = env.get("XDG_RUNTIME_DIR", "")
+    if not runtime or not os.path.isabs(runtime):
+        return None
+    return Path(runtime) / SOCKET_DIR / SOCKET_NAME
+
+
+def is_loopback_host(host: str) -> bool:
+    """``localhost``, ``127.0.0.0/8`` or ``::1``; other names are non-loopback (no DNS)."""
+    if host.lower() == "localhost":
+        return True
+    try:
+        return ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        return False
+
+
+def check_url(url: str) -> None:
+    """Raise ``EndpointError`` unless ``url`` is an ``http(s)://`` URL with a host."""
+    parts = urlsplit(url)
+    if parts.scheme not in ("http", "https") or not parts.hostname:
+        raise EndpointError(f"model endpoint {url!r} must be an http:// or https:// URL")
+    try:
+        parts.port
+    except ValueError:
+        raise EndpointError(f"model endpoint {url!r} has an invalid port") from None
+    if parts.username is not None or parts.password is not None:
+        raise EndpointError(f"model endpoint {url!r} must not carry credentials")
+
+
+def choose_endpoint(
+    dev_teacher: bool,
+    flag_url: str | None,
+    config_url: str | None,
+    env: Mapping[str, str] | None = None,
+) -> EndpointDecision:
+    """The endpoint for this session, by ADR-0020 §3.
+
+    ``dev_teacher`` says whether ``--dev-teacher`` was given; ``flag_url`` is its URL (if
+    any). Without the flag a ``config_url`` is refused (a message) and the default socket
+    is used. Raises ``EndpointError`` for an unusable URL, or for the flag with no URL.
+    """
+    if not dev_teacher:
+        messages = (CONFIG_URL_REFUSED.format(url=config_url),) if config_url else ()
+        socket_path = default_socket(env)
+        endpoint = None if socket_path is None else Endpoint(socket_path=socket_path)
+        return EndpointDecision(endpoint, messages)
+    url = flag_url if flag_url else config_url
+    if not url:
+        raise EndpointError(
+            "--dev-teacher needs a URL: give one after the flag, or set teacher_url in "
+            "config.toml"
+        )
+    check_url(url)
+    parts = urlsplit(url)
+    messages: tuple[str, ...] = ()
+    if parts.scheme == "http" and not is_loopback_host(parts.hostname or ""):
+        messages = (CLEAR_TEXT_WARNING.format(url=url),)
+    return EndpointDecision(Endpoint(url=url), messages)
+
+
+class _UnixHTTPConnection(http.client.HTTPConnection):
+    """HTTP over a Unix stream socket."""
+
+    def __init__(self, path: Path, timeout: float) -> None:
+        super().__init__("localhost", timeout=timeout)
+        self._path = str(path)
+
+    def connect(self) -> None:
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        sock.settimeout(self.timeout)
+        try:
+            sock.connect(self._path)
+        except BaseException:
+            sock.close()
+            raise
+        self.sock = sock
+
+
+class TeacherClient:
+    """One model server endpoint; ``complete`` sends one chat request."""
+
+    def __init__(
+        self,
+        endpoint: Endpoint | None,
+        response_schema: Mapping[str, Any],
+        *,
+        model: str | None = None,
+        connect_timeout: float = CONNECT_TIMEOUT_S,
+        read_timeout: float = READ_TIMEOUT_S,
+        max_response_bytes: int = MAX_RESPONSE_BYTES,
+    ) -> None:
+        if endpoint is not None and endpoint.url is not None:
+            check_url(endpoint.url)
+        self.endpoint = endpoint
+        self._schema = response_schema
+        self._model = model
+        self._connect_timeout = connect_timeout
+        self._read_timeout = read_timeout
+        self._max_bytes = max_response_bytes
+
+    def request_body(self, messages: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+        """The chat-completions request body for ``messages``."""
+        body: dict[str, Any] = {
+            "messages": [dict(m) for m in messages],
+            "response_format": {
+                "type": "json_schema",
+                "json_schema": {
+                    "name": SCHEMA_NAME,
+                    "strict": True,
+                    "schema": self._schema,
+                },
+            },
+        }
+        if self._model is not None:
+            body["model"] = self._model
+        return body
+
+    def complete(self, messages: Sequence[Mapping[str, Any]]) -> str:
+        """Send ``messages``; return ``choices[0].message.content``.
+
+        Raises ``TeacherError`` (``ModelServerUnavailable`` if nothing is listening).
+        """
+        if self.endpoint is None:
+            raise ModelServerUnavailable(MODEL_SERVER_NOT_RUNNING)
+        payload = json.dumps(self.request_body(messages)).encode("utf-8")
+        conn, path = self._connection()
+        try:
+            try:
+                conn.connect()
+            except (FileNotFoundError, ConnectionRefusedError):
+                raise ModelServerUnavailable(MODEL_SERVER_NOT_RUNNING) from None
+            except ssl.SSLError as exc:
+                raise TeacherError(f"TLS error: {exc}") from None
+            except TimeoutError:
+                raise TeacherError(
+                    f"could not connect within {self._connect_timeout:g} s"
+                ) from None
+            except OSError as exc:
+                raise TeacherError(f"could not connect: {exc}") from None
+            conn.sock.settimeout(self._read_timeout)
+            try:
+                conn.request(
+                    "POST",
+                    path,
+                    body=payload,
+                    headers={
+                        "Content-Type": "application/json",
+                        "Accept": "application/json",
+                    },
+                )
+                response = conn.getresponse()
+                raw = self._read_body(response)
+            except TimeoutError:
+                raise TeacherError(
+                    f"the model server did not answer within {self._read_timeout:g} s"
+                ) from None
+            except ssl.SSLError as exc:
+                raise TeacherError(f"TLS error: {exc}") from None
+            except (http.client.HTTPException, OSError) as exc:
+                raise TeacherError(f"the connection failed: {exc}") from None
+        finally:
+            conn.close()
+        return _content(raw)
+
+    def _connection(self) -> tuple[http.client.HTTPConnection, str]:
+        assert self.endpoint is not None
+        if self.endpoint.url is None:
+            assert self.endpoint.socket_path is not None
+            conn = _UnixHTTPConnection(self.endpoint.socket_path, self._connect_timeout)
+            return conn, CHAT_COMPLETIONS_PATH
+        parts = urlsplit(self.endpoint.url)
+        base = parts.path.rstrip("/")
+        if base.endswith("/v1"):
+            base = base[: -len("/v1")]
+        path = base + CHAT_COMPLETIONS_PATH
+        if parts.scheme == "https":
+            context = ssl.create_default_context()
+            conn = http.client.HTTPSConnection(
+                parts.hostname, parts.port, timeout=self._connect_timeout, context=context
+            )
+        else:
+            conn = http.client.HTTPConnection(
+                parts.hostname, parts.port, timeout=self._connect_timeout
+            )
+        return conn, path
+
+    def _read_body(self, response: http.client.HTTPResponse) -> bytes:
+        status = response.status
+        if 300 <= status < 400:
+            raise TeacherError(
+                f"the model server answered with a redirect ({status}); not followed"
+            )
+        if not 200 <= status < 300:
+            raise TeacherError(
+                f"the model server answered with HTTP {status} {response.reason}"
+            )
+        length = response.getheader("Content-Length")
+        if length is not None and length.isdigit() and int(length) > self._max_bytes:
+            raise TeacherError(f"the response is larger than {self._max_bytes} bytes")
+        raw = response.read(self._max_bytes + 1)
+        if len(raw) > self._max_bytes:
+            raise TeacherError(f"the response is larger than {self._max_bytes} bytes")
+        return raw
+
+
+def _content(raw: bytes) -> str:
+    try:
+        doc = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        raise TeacherError("the response body is not JSON") from None
+    try:
+        content = doc["choices"][0]["message"]["content"]
+    except (KeyError, IndexError, TypeError):
+        raise TeacherError("the response has no choices[0].message.content") from None
+    if not isinstance(content, str):
+        raise TeacherError("choices[0].message.content is not a string")
+    return content
