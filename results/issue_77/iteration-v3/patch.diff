+def test_config_url_without_the_flag_makes_no_tcp_connection(
+    cli_env, runtime_dir, monkeypatch, capsys
+):
+    run, seen = cli_env
+    write_config('teacher_url = "http://127.0.0.1:9"\n')
+    connects = []
+    real_connect = socket.socket.connect
+    real_create = socket.create_connection
+
+    def record_connect(self, address):
+        connects.append((self.family, address))
+        return real_connect(self, address)
+
+    def record_create(address, *args, **kwargs):
+        connects.append((socket.AF_INET, address))
+        return real_create(address, *args, **kwargs)
+
+    monkeypatch.setattr(socket.socket, "connect", record_connect)
+    monkeypatch.setattr(socket, "create_connection", record_create)
+    assert run([]) == 0
+    err = capsys.readouterr().err
+    assert "teacher_url" in err and "--dev-teacher" in err
+    lines = [line() for line in seen["status_lines"]]
+    assert any(line.startswith("endpoint: unix:") for line in lines)
+    assert [c for c in connects if c[0] in (socket.AF_INET, socket.AF_INET6)] == []
