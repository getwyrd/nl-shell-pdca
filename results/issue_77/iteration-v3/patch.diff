index 0000000..d7eac27
--- /dev/null
+++ b/tests/test_teacher_client.py
@@ -0,0 +1,530 @@
+"""The model client and the endpoint rules (#77; ADR-0018 §1–§3, §5; ADR-0020 §3–§4).
+
+Every server here is a small in-process ``http.server`` fake, on ``127.0.0.1`` (port 0) or
+on a Unix socket in a short temporary directory, so nothing reaches the network or a real
+model. The new modules are imported inside each test: the C4 red leg reverts them, and a
+module-level import would stop the file from loading instead of making it fail.
+"""
+
+from __future__ import annotations
+
+import http.server
+import json
+import os
+import shutil
+import socket
+import socketserver
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from nl_shell import cli
+
+# A stand-in schema object. The client sends whatever schema it is given, unchanged; the
+# test checks that it arrives as the request's response_format schema.
+SCHEMA = {
+    "type": "object",
+    "properties": {"command": {"type": "string"}, "risk": {"type": "string"}},
+    "required": ["command", "risk"],
+    "additionalProperties": False,
+}
+PROPOSAL = {"command": "ls -la", "risk": "read_only"}
+MESSAGES = [
+    {"role": "system", "content": "You propose one bash command."},
+    {"role": "user", "content": "list the files here"},
+]
+
+TARGET_TOML = """\
+id = "testos-1"
+display_name = "Test OS 1"
+shell = "bash"
+package_owner_query = ["owner-of"]
+
+[os_release]
+ID = "testos"
+VERSION_ID = "1"
+
+[sudo]
+implementation = "test-sudo"
+version = "1.0"
+"""
+
+
+def chat_body(content):
+    return json.dumps(
+        {"choices": [{"index": 0, "message": {"role": "assistant", "content": content}}]}
+    ).encode("utf-8")
+
+
+class Reply:
+    """What the fake server answers: status, headers, body, and an optional delay."""
+
+    def __init__(self, status=200, body=b"", headers=None, delay=0.0):
+        self.status = status
+        self.body = body
+        self.headers = headers or {}
+        self.delay = delay
+
+
+def make_handler(fake):
+    class Handler(http.server.BaseHTTPRequestHandler):
+        def do_POST(self):
+            length = int(self.headers.get("Content-Length") or 0)
+            body = self.rfile.read(length)
+            fake.requests.append(
+                {
+                    "method": "POST",
+                    "path": self.path,
+                    "headers": {k.lower(): v for k, v in self.headers.items()},
+                    "body": body,
+                }
+            )
+            reply = fake.reply
+            if reply.delay:
+                fake.release.wait(reply.delay)
+            try:
+                self.send_response(reply.status)
+                for name, value in reply.headers.items():
+                    self.send_header(name, value)
+                self.send_header("Content-Length", str(len(reply.body)))
+                self.end_headers()
+                self.wfile.write(reply.body)
+            except OSError:
+                pass  # the client gave up first (the timeout test)
+
+        def do_GET(self):
+            fake.requests.append({"method": "GET", "path": self.path})
+            self.send_response(404)
+            self.end_headers()
+
+        def log_message(self, *args):
+            pass
+
+        def log_error(self, *args):
+            fake.errors.append(args)
+
+    return Handler
+
+
+class _TCPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
+    daemon_threads = True
+    block_on_close = False
+
+
+class _UnixServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
+    daemon_threads = True
+    block_on_close = False
+
+
+class FakeServer:
+    def __init__(self, reply=None, unix_path=None):
+        self.reply = reply or Reply(body=chat_body(json.dumps(PROPOSAL)))
+        self.requests = []
+        self.errors = []
+        self.release = threading.Event()
+        handler = make_handler(self)
+        if unix_path is None:
+            self.server = _TCPServer(("127.0.0.1", 0), handler)
+            self.url = f"http://127.0.0.1:{self.server.server_address[1]}"
+            self.port = self.server.server_address[1]
+        else:
+            self.server = _UnixServer(str(unix_path), handler)
+            self.url = None
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+
+    def stop(self):
+        self.release.set()
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(timeout=2)
+
+
