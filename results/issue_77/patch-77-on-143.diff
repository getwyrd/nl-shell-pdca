diff --git a/src/nl_shell/teacher_client.py b/src/nl_shell/teacher_client.py
new file mode 100644
index 0000000..912f8c3
--- /dev/null
+++ b/src/nl_shell/teacher_client.py
@@ -0,0 +1,377 @@
+"""The model client: OpenAI-compatible chat completions over HTTP (ADR-0018 §1, §2, §5).
+
+``TeacherClient`` is a backend (``nl_shell.backend.Backend``): it sends the model input
+to a ``llama-server`` or vLLM endpoint and returns the raw ``message.content`` text. It
+never parses, repairs or retries it; the REPL hands it to the one strict ``proposal/v1``
+parser (ADR-0018 §3). Each request asks for constrained decoding against
+``nl_shell.proposal.SCHEMA``.
+
+Which endpoint (``select_endpoint``, ADR-0020 §3): by default only the local model
+socket ``$XDG_RUNTIME_DIR/nl-shell/model.sock``. Any URL, including a loopback TCP port,
+is used only when the user passes ``--dev-teacher`` for the session; a ``teacher_url``
+in ``config.toml`` alone is refused with a message. So without the flag nl-shell opens
+no TCP connection (ADR-0003).
+
+Transport rules: the stdlib ``http.client`` (it ignores ``HTTP(S)_PROXY`` and never
+follows a redirect); certificate and host-name checks on for ``https``, no plain-HTTP
+fallback; no credentials; any non-2xx status, a body over ``MAX_RESPONSE_BYTES``, a body
+that is not JSON or has no string ``choices[0].message.content`` is an error. One
+timeout, ``timeout_s``: a total deadline for the whole request (connect, send, read).
+Errors are ``TeacherError`` (a ``BackendError``); any text the server supplied is
+escaped in the error's reason before it is built.
+"""
+
+from __future__ import annotations
+
+import http.client
+import ipaddress
+import json
+import os
+import socket
+import ssl
+import threading
+import time
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+from urllib.parse import urlsplit
+
+from nl_shell import render
+from nl_shell.backend import BackendError
+
+if TYPE_CHECKING:
+    from nl_shell.prompts import Message
+
+SOCKET_DIR = "nl-shell"
+SOCKET_NAME = "model.sock"
+DEFAULT_SOCKET_TEXT = f"$XDG_RUNTIME_DIR/{SOCKET_DIR}/{SOCKET_NAME}"
+CHAT_PATH = "/v1/chat/completions"
+# A maximal proposal/v1 answer (a 2000-code-point command, up to 4 UTF-8 bytes each,
+# JSON-escaped) plus the chat-completions envelope fits well inside this.
+MAX_RESPONSE_BYTES = 64 * 1024
+DEFAULT_TIMEOUT_S = 10.0
+_CHUNK = 4096
+_EXCERPT = 200
+
+REFUSED_CONFIG_URL = (
+    "nl-shell: teacher_url in {config} is ignored without --dev-teacher; "
+    "using the local model socket. Pass --dev-teacher to use it for this session."
+)
+NO_DEV_URL = (
+    "nl-shell: --dev-teacher was given without a URL and config.toml has no "
+    "teacher_url; using the local model socket."
+)
+CLEAR_TEXT_WARNING = (
+    "nl-shell: warning: {url} is plain http:// to a host that is not this machine; "
+    "the state block goes over the network in clear text. "
+    "Use an SSH tunnel to a loopback port, or https://."
+)
+
+
+class EndpointError(ValueError):
+    """A teacher URL nl-shell will not use (bad scheme, credentials, no host)."""
+
+
+class TeacherError(BackendError):
+    """One model request failed. ``reason`` holds no unescaped server text."""
+
+
+@dataclass(frozen=True)
+class Endpoint:
+    """Where model requests go.
+
+    ``kind`` is ``"unix"`` (the local socket), ``"http"`` or ``"https"``. ``address`` is
+    the socket path or the URL; it is ``None`` for ``"unix"`` when there is no default
+    socket (``XDG_RUNTIME_DIR`` unset, empty or relative).
+    """
+
+    kind: str
+    address: str | None
+
+    def describe(self) -> str:
+        if self.address is not None:
+            return self.address
+        return f"{DEFAULT_SOCKET_TEXT} (XDG_RUNTIME_DIR is not set)"
+
+
+def default_socket(runtime_dir: str | None) -> str | None:
+    """``$XDG_RUNTIME_DIR/nl-shell/model.sock``, or None without a usable runtime dir."""
+    if not runtime_dir or not os.path.isabs(runtime_dir):
+        return None
+    return os.path.join(runtime_dir, SOCKET_DIR, SOCKET_NAME)
+
+
+def select_endpoint(
+    dev_teacher: str | bool | None,
+    teacher_url: str | None,
+    runtime_dir: str | None,
+    *,
+    config_file: str = "config.toml",
+) -> tuple[Endpoint, list[str]]:
+    """The endpoint for this session, and the messages to show on stderr.
+
+    ``dev_teacher`` is None without ``--dev-teacher``, True for the bare flag, or the URL
+    given with it. Opens no connection and does no DNS lookup. Raises ``EndpointError``
+    for a URL nl-shell will not use.
+    """
+    default = Endpoint("unix", default_socket(runtime_dir))
+    messages: list[str] = []
+    if dev_teacher is None:
+        if teacher_url:
+            messages.append(REFUSED_CONFIG_URL.format(config=config_file))
+        return default, messages
+    url = dev_teacher if isinstance(dev_teacher, str) else teacher_url
+    if not url:
+        messages.append(NO_DEV_URL)
+        return default, messages
+    scheme, host = _check_url(url)
+    if scheme == "http" and not _is_loopback(host):
+        messages.append(CLEAR_TEXT_WARNING.format(url=url))
+    return Endpoint(scheme, url), messages
+
+
+def _check_url(url: str) -> tuple[str, str]:
+    try:
+        parts = urlsplit(url)
+        parts.port  # raises ValueError for a bad port
+    except ValueError as exc:
+        raise EndpointError(f"teacher URL {url}: {exc}") from None
+    scheme = parts.scheme.lower()
+    if scheme not in ("http", "https"):
+        raise EndpointError(f"teacher URL {url}: must start with http:// or https://")
+    if parts.username is not None or parts.password is not None or "@" in parts.netloc:
+        raise EndpointError(f"teacher URL {url}: credentials in the URL are refused")
+    if not parts.hostname:
+        raise EndpointError(f"teacher URL {url}: no host")
+    if parts.query or parts.fragment:
+        raise EndpointError(f"teacher URL {url}: no query or fragment allowed")
+    return scheme, parts.hostname
+
+
+def _is_loopback(host: str) -> bool:
+    """``localhost``, 127.0.0.0/8 or ::1. Any other name counts as remote; no DNS."""
+    if host.lower() == "localhost":
+        return True
+    try:
+        return ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        return False
+
+
+class _UnixHTTPConnection(http.client.HTTPConnection):
+    """HTTP over the local model socket. The ``Host`` header is ``localhost``."""
+
+    def __init__(self, path: str, timeout: float) -> None:
+        super().__init__("localhost", timeout=timeout)
+        self._path = path
+
+    def connect(self) -> None:
+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            sock.settimeout(self.timeout)
+            sock.connect(self._path)
+        except BaseException:
+            sock.close()
+            raise
+        self.sock = sock
+
+
+class TeacherClient:
+    """A ``Backend`` that asks an OpenAI-compatible chat endpoint for a proposal."""
+
+    kind = "openai-chat (constrained decoding, proposal/v1)"
+
+    def __init__(
+        self,
+        endpoint: Endpoint,
+        *,
+        model: str | None = None,
+        timeout_s: float = DEFAULT_TIMEOUT_S,
+        max_response_bytes: int = MAX_RESPONSE_BYTES,
+    ) -> None:
+        self.endpoint = endpoint
+        self._model = model
+        self._timeout_s = timeout_s
+        self._max = max_response_bytes
+
+    def complete(self, messages: Sequence[Message]) -> str:
+        """The raw ``message.content`` of the answer to one model input."""
+        body = json.dumps(self._request(messages)).encode("utf-8")
+        deadline = time.monotonic() + self._timeout_s
+        conn, path = self._connection()
+        timer = threading.Timer(self._timeout_s, _cut, (conn,))
+        timer.daemon = True
+        timer.start()
+        try:
+            return self._exchange(conn, path, body, deadline)
+        finally:
+            timer.cancel()
+            conn.close()
+
+    def _request(self, messages: Sequence[Message]) -> dict[str, Any]:
+        from nl_shell import proposal
+
+        request: dict[str, Any] = {
+            "messages": [{"role": m.role, "content": m.content} for m in messages],
+            "response_format": {
+                "type": "json_schema",
+                "json_schema": {
+                    "name": "proposal_v1",
+                    "strict": True,
+                    "schema": proposal.SCHEMA,
+                },
+            },
+        }
+        if self._model is not None:
+            request["model"] = self._model
+        return request
+
+    def _connection(self) -> tuple[http.client.HTTPConnection, str]:
+        endpoint = self.endpoint
+        if endpoint.kind == "unix":
+            if endpoint.address is None:
+                raise TeacherError(
+                    "no model socket", not_running_at=endpoint.describe()
+                )
+            return _UnixHTTPConnection(endpoint.address, self._timeout_s), CHAT_PATH
+        assert endpoint.address is not None
+        parts = urlsplit(endpoint.address)
+        path = parts.path.rstrip("/") + CHAT_PATH
+        assert parts.hostname is not None
+        if endpoint.kind == "https":
+            return (
+                http.client.HTTPSConnection(
+                    parts.hostname,
+                    parts.port,
+                    timeout=self._timeout_s,
+                    context=ssl.create_default_context(),
+                ),
+                path,
+            )
+        return (
+            http.client.HTTPConnection(
+                parts.hostname, parts.port, timeout=self._timeout_s
+            ),
+            path,
+        )
+
+    def _exchange(
+        self,
+        conn: http.client.HTTPConnection,
+        path: str,
+        body: bytes,
+        deadline: float,
+    ) -> str:
+        endpoint = self.endpoint
+        try:
+            conn.connect()
+            _tick(conn, deadline)
+            conn.request(
+                "POST",
+                path,
+                body=body,
+                headers={
+                    "Content-Type": "application/json",
+                    "Accept": "application/json",
+                },
+            )
+            _tick(conn, deadline)
+            response = conn.getresponse()
+            status = response.status
+            if 300 <= status < 400:
+                raise TeacherError(
+                    f"the server answered with a redirect ({status}), not followed"
+                )
+            if not 200 <= status < 300:
+                excerpt = _read(response, conn, deadline, _EXCERPT, truncate=True)
+                text = excerpt.decode("utf-8", "replace").strip()
+                reason = f"HTTP status {status} {response.reason}".strip()
+                if text:
+                    reason += f" ({text})"
+                raise TeacherError(_escape(reason))
+            data = _read(response, conn, deadline, self._max, truncate=False)
+        except TeacherError:
+            raise
+        except ssl.SSLError as exc:
+            raise TeacherError(_escape(f"TLS error: {exc}")) from None
+        except (FileNotFoundError, ConnectionRefusedError) as exc:
+            if endpoint.kind == "unix":
+                raise TeacherError(
+                    _escape(str(exc)), not_running_at=endpoint.describe()
+                ) from None
+            raise TeacherError(_escape(f"cannot connect: {exc}")) from None
+        except (OSError, http.client.HTTPException, ValueError) as exc:
+            if time.monotonic() >= deadline or isinstance(exc, TimeoutError):
+                raise TeacherError(_timed_out(self._timeout_s)) from None
+            raise TeacherError(_escape(f"{type(exc).__name__}: {exc}")) from None
+        return _content(data)
+
+
+def _cut(conn: http.client.HTTPConnection) -> None:
+    """At the deadline: shut the socket so a read blocked in any phase returns."""
+    sock = conn.sock
+    if sock is not None:
+        try:
+            # The base-class method: an SSLSocket's own shutdown would drop its TLS state
+            # under the reading thread.
+            socket.socket.shutdown(sock, socket.SHUT_RDWR)
+        except OSError:
+            pass
+
+
+def _tick(conn: http.client.HTTPConnection, deadline: float) -> None:
+    """Give the next socket operation only what is left of the deadline."""
+    left = deadline - time.monotonic()
+    if left <= 0:
+        raise TimeoutError
+    if conn.sock is not None:
+        conn.sock.settimeout(left)
+
+
+def _read(
+    response: http.client.HTTPResponse,
+    conn: http.client.HTTPConnection,
+    deadline: float,
+    limit: int,
+    *,
+    truncate: bool,
+) -> bytes:
+    """Read the body in chunks, checking the deadline before each; stop past ``limit``."""
+    chunks: list[bytes] = []
+    size = 0
+    while True:
+        _tick(conn, deadline)
+        chunk = response.read1(min(_CHUNK, limit + 1 - size))
+        if not chunk:
+            break
+        chunks.append(chunk)
+        size += len(chunk)
+        if size > limit:
+            if truncate:
+                return b"".join(chunks)[:limit]
+            raise TeacherError(f"the response is larger than {limit} bytes")
+    if time.monotonic() >= deadline:
+        raise TimeoutError
+    return b"".join(chunks)
+
+
+def _content(data: bytes) -> str:
+    try:
+        doc = json.loads(data.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError, RecursionError):
+        raise TeacherError("the response is not JSON") from None
+    try:
+        content = doc["choices"][0]["message"]["content"]
+    except (KeyError, IndexError, TypeError):
+        content = None
+    if not isinstance(content, str):
+        raise TeacherError("the response has no string choices[0].message.content")
+    return content
+
+
+def _timed_out(timeout_s: float) -> str:
+    return f"no complete answer within {timeout_s:g} s (model.timeout_s)"
+
+
+def _escape(text: str) -> str:
+    return render.escape(text)
