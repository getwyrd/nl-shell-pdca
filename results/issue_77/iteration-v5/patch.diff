+def slow_drip(handler, fake):
+    handler.send_response(200)
+    handler.send_header("Content-Type", "application/json")
+    handler.send_header("Content-Length", "100")
+    handler.end_headers()
+    handler.wfile.flush()
+    for _ in range(100):
+        if fake.stop.wait(0.2):
+            return
+        handler.wfile.write(b" ")
+        handler.wfile.flush()
+
