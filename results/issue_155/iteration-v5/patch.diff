@@ -0,0 +1,662 @@
+"""Failure classes by exit code: the deterministic first pass over a failed command.
+
+``classify`` looks only at trusted facts: the ``session.CommandResult`` built from the
+control channel's done record (ADR-0014 Decision 2) and the command text the user
+confirmed. It never reads the command's output, so printed text cannot change the class.
+Every message is fixed text; no model is involved.
+
+The classes, in order of precedence (``bash(1)`` EXIT STATUS for 126, 127 and 128+n):
+
+- nothing ran (``ran`` is False, pty-protocol v1 section 4.1): blank or comment-only text
+  is ``NONE``; privileged text is ``PRIVILEGE``; anything else was a syntax error, ``OTHER``;
+- status 0 is ``NONE``; 130 is ``INTERRUPTED`` (the user pressed Ctrl-C, not an error);
+- a command that bash could have run as a privilege program is ``PRIVILEGE``: one neutral
+  message, no correction offer, never to the reader (ADR-0015, ADR-0006, ADR-0017);
+- 127 ``NOT_FOUND`` (with an optional package suggestion), 126 ``NOT_EXECUTABLE``,
+  129-192 ``SIGNAL`` (named, with an out-of-memory hint for SIGKILL), else ``OTHER``.
+
+``to_reader`` only says the failure is eligible for the reader by its exit status. The
+caller still drops output labelled secret (ADR-0025) before anything reaches the reader
+(#61).
+
+The privilege match is text-only. A command is privileged when either holds, in the text
+or in the value of any alias a word names (chains followed up to 8 deep; a cycle or a
+deeper chain counts as privileged):
+
+- 1a: any shell word, anywhere, whose basename after quote removal is a privilege
+  program's name, or that names a shell function in the snapshot (bash can run one from
+  argument position, as in ``eval f``). A word that still holds whitespace or a shell
+  operator after quote removal (``bash -c 'sudo x'``) is split again and 1a is applied to
+  the pieces, up to 8 levels; deeper nesting counts as privileged.
+- 1b: a command word (the first word of a simple command) that is not plainly a name,
+  or that names a shell function in the snapshot. In the pieces of a re-split quoted word
+  only the command words inside a ``$(`` or backtick substitution count, because bash
+  runs a substitution inside double quotes. Nothing is expanded: a name built from an
+  expansion counts as privileged instead.
+
+The word splitter and the keyword list below stand in until #12's bash parse replaces
+both. Known misses are listed in the threat model's Known gaps. The package lookup is
+injected (the package provider, #156); this module holds no package data.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import enum
+import itertools
+import os
+import re
+import shlex
+import signal
+from collections.abc import Callable, Iterable
+
+from nl_shell.router import BASH_BUILTINS
+from nl_shell.session import CommandResult
+
+# Policy-gate spec section 4 (docs/design/specs/policy-gate/v1.md:111) plus the sudo-rs,
+# sudo.ws and sudoedit variants.
+PRIVILEGE_PROGRAMS = frozenset(
+    "sudo su pkexec doas run0 machinectl sudo-rs sudo.ws sudoedit sudoedit-rs".split()
+)
+
+# Output of `compgen -k` in bash 5. `router.BASH_BUILTINS` leaves keywords out on purpose.
+BASH_KEYWORDS = frozenset(
+    "if then else elif fi case esac for select while until do done in function time "
+    "{ } ! [[ ]] coproc".split()
+)
+
+# The word after one of these keywords starts a simple command; after any other keyword
+# it does not (the word after `for`, `select`, `case`, `in`, `function`, and every word
+# between `[[` and `]]`).
+_COMMAND_STARTING_KEYWORDS = frozenset("if then else elif do while until ! time { coproc".split())
+
+_MAX_DEPTH = 8  # quoted-word re-splits, and alias chains
+_MAX_PACKAGES = 5
+_MAX_SHOWN = 64  # longest command word or package name shown in a message
+_MAX_LOOKUP_ITEMS = 100  # the most items read from a lookup result
+
+PRIVILEGE_MESSAGE = (
+    "The command did not succeed. It may involve a privileged program, so nl-shell "
+    "does not suggest a fix for it."
+)
+
+_PLAIN_WORD = re.compile(r"(?:~/)?[A-Za-z0-9._+/-]+", re.ASCII)
+_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(?:\[[^\]]*\])?\+?=", re.ASCII)
+_SHOWN_WORD = re.compile(r"[A-Za-z0-9._+-]{1,%d}" % _MAX_SHOWN, re.ASCII)
+_SHOWN_PACKAGE = re.compile(r"[\x21-\x7e]{1,%d}" % _MAX_SHOWN, re.ASCII)
+_ALIAS_LINE = re.compile(r"alias\s+(?:--\s+)?([^=\s]+)=(.*)")
+
+# Characters that make a word split again after quote removal.
+_RESPLIT_CHARS = frozenset(" \t\n|&;()<>`")
+
+# Shell operators, longest first per leading character.
+_OPERATORS = {
+    "|": ("||", "|&", "|"),
+    "&": ("&&", "&"),
+    ";": (";;&", ";;", ";&", ";"),
+    "(": ("(",),
+    ")": (")",),
+}
+# Redirection operators; an optional fd number before them belongs to them.
+_REDIRECTIONS = {
+    "<": ("<<<", "<<-", "<<", "<>", "<&", "<"),
+    ">": (">>", ">|", ">&", ">"),
+    "&": ("&>>", "&>"),
+}
+
+_SUBST_OPEN = ("$(", "`(")  # `$(` and an opening backtick
+_SUBST_CLOSE = (")", "`)")  # `)` and a closing backtick
+
+
+class FailureClass(enum.Enum):
+    NONE = "none"
+    INTERRUPTED = "interrupted"
+    PRIVILEGE = "privilege"
+    NOT_FOUND = "not-found"
+    NOT_EXECUTABLE = "not-executable"
+    SIGNAL = "signal"
+    OTHER = "other"
+
+
+@dataclasses.dataclass(frozen=True)
+class Failure:
+    kind: FailureClass
+    status: int
+    pipestatus: tuple[int, ...]
+    message: str  # fixed text, "" for NONE
+    offer_correction: bool
+    to_reader: bool  # eligible by exit status only; see the module docstring
+    is_error: bool
+    signal_number: int | None = None
+    signal_name: str | None = None
+    command_word: str | None = None  # NOT_FOUND: the unresolved word, when safe to show
+    packages: tuple[str, ...] = ()  # NOT_FOUND: packages that provide it
+
+
+Lookup = Callable[[str], Iterable[str]]
+
+
+# --- the word splitter -----------------------------------------------------------------
+
+
+@dataclasses.dataclass(frozen=True)
+class _Token:
+    kind: str  # "word", "op" or "redir"
+    text: str  # a word after quote removal, or the operator
+    raw: str  # the source text of a word
+    glued: bool  # no whitespace between this token and the one before it
+
+
+def _scan(text: str, quotes: bool = True) -> tuple[list[_Token], bool]:
+    """Split ``text`` into words and operators in one pass. Never raises.
+
+    Quote removal follows bash: single quotes are literal, a backslash escapes the next
+    character (backslash-newline joins lines), and inside double quotes it escapes only
+    ``$``, backtick, ``"``, ``\\`` and newline. ``$'...'`` keeps its ``$`` and its
+    backslashes. Unquoted ``$(``, backticks, shell operators, redirections (with an fd
+    number) and newlines are split off as tokens; ``#`` at the start of a word starts a
+    comment. With ``quotes`` False, quote characters are plain characters (the fallback
+    for broken quoting). Returns the tokens and whether quoting was broken.
+    """
+    tokens: list[_Token] = []
+    chars: list[str] = []
+    in_word = False
+    word_start = 0
+    word_glued = False
+    touching = False  # the next token touches the previous one
+    backtick_open = False
+    broken = False
+    i, n = 0, len(text)
+
+    def start_word() -> None:
+        nonlocal in_word, word_start, word_glued
+        if not in_word:
+            in_word, word_start, word_glued = True, i, touching
+
+    def end_word(at: int) -> None:
+        nonlocal in_word
+        if in_word:
+            tokens.append(_Token("word", "".join(chars), text[word_start:at], word_glued))
+            chars.clear()
+            in_word = False
+
+    def emit(kind: str, op: str) -> None:
+        nonlocal touching
+        tokens.append(_Token(kind, op, op, touching))
+        touching = True
+
+    while i < n:
+        c = text[i]
+        if c in " \t":
+            end_word(i)
+            touching = False
+            i += 1
+        elif c == "\n":
+            end_word(i)
+            touching = False
+            emit("op", "\n")
+            touching = False
+            i += 1
+        elif c == "#" and not in_word and not _glues_to_word(tokens, touching):
+            end = text.find("\n", i)
+            i = n if end < 0 else end
+        elif c == "\\":
+            if i + 1 < n and text[i + 1] == "\n":
+                i += 2  # line continuation: bash removes both characters
+                continue
+            start_word()
+            chars.append(text[i + 1] if i + 1 < n else "\\")
+            touching = True
+            i += 2
+        elif quotes and c == "'":
+            start_word()
+            end = text.find("'", i + 1)
+            if end < 0:
+                broken = True
+                end = n
+            chars.append(text[i + 1 : end])
+            touching = True
+            i = end + 1
+        elif quotes and c == "$" and text.startswith("$'", i):
+            # ANSI-C quoting: keep `$` and every backslash pair; nothing is decoded.
+            start_word()
+            chars.append("$")
+            j = i + 2
+            while j < n and text[j] != "'":
+                chars.append(text[j : j + 2] if text[j] == "\\" else text[j])
+                j += 2 if text[j] == "\\" else 1
+            if j >= n:
+                broken = True
+            touching = True
+            i = j + 1
+        elif quotes and c == '"':
+            start_word()
+            j = i + 1
+            while j < n and text[j] != '"':
+                if text[j] == "\\" and j + 1 < n and text[j + 1] in '$`"\\\n':
+                    if text[j + 1] != "\n":
+                        chars.append(text[j + 1])
+                    j += 2
+                else:
+                    chars.append(text[j])
+                    j += 1
+            if j >= n:
+                broken = True
+            touching = True
+            i = j + 1
+        elif c == "$" and text.startswith("$(", i):
+            end_word(i)
+            emit("op", "$(")
+            i += 2
+        elif c == "`":
+            end_word(i)
+            emit("op", "`)" if backtick_open else "`(")
+            backtick_open = not backtick_open
+            i += 1
+        elif c in "<>" or c in _OPERATORS:
+            if c in "<>" and in_word and text[word_start:i].isdigit():
+                # `2>`: the fd number belongs to the redirection.
+                chars.clear()
+                in_word = False
+            else:
+                end_word(i)
+            kind, op = "op", c
+            for candidate in _REDIRECTIONS.get(c, ()):
+                if text.startswith(candidate, i):
+                    kind, op = "redir", candidate
+                    break
+            else:
+                for candidate in _OPERATORS[c]:
+                    if text.startswith(candidate, i):
+                        op = candidate
+                        break
+            emit(kind, op)
+            i += len(op)
+        else:
+            start_word()
+            chars.append(c)
+            touching = True
+            i += 1
+    end_word(n)
+    return tokens, broken or backtick_open
+
+
+def _glues_to_word(tokens: list[_Token], touching: bool) -> bool:
+    """A ``#`` right after a closing ``)`` or backtick of a substitution is part of that
+    word (``echo $(true)#``), so it does not start a comment."""
+    return touching and bool(tokens) and tokens[-1].text in _SUBST_CLOSE
+
+
+def _split(text: str) -> list[list[_Token]]:
+    """``_scan`` as one token list. When quoting is broken, also the scan that reads quote
+    characters as plain characters; each scan can see words the other drops (a ``#``
+    inside quotes is a comment start only in the second), so both are checked."""
+    tokens, broken = _scan(text)
+    if broken:
+        return [tokens, _scan(text, quotes=False)[0]]
+    return [tokens]
+
+
+# --- rule 1: privilege ------------------------------------------------------------------
+
+
+@dataclasses.dataclass
+class _Session:
+    functions: frozenset[str]
+    aliases: dict[str, str]
+    clean_aliases: set[str] = dataclasses.field(default_factory=set)
+
+
+def _parse_aliases(text: str) -> dict[str, str]:
+    """``alias -p`` text as name -> value. A value that cannot be unquoted is kept raw."""
+    aliases: dict[str, str] = {}
+    try:
+        words = shlex.split(text)
+    except ValueError:
+        for line in text.splitlines():
+            match = _ALIAS_LINE.match(line.strip())
+            if match:
+                # The leftover quote characters make its command word unclear.
+                aliases[match.group(1)] = match.group(2)
+        return aliases
+    for word in words:
+        if word in ("alias", "--"):
+            continue
+        name, sep, value = word.partition("=")
+        if sep and name:
+            aliases[name] = value
+    return aliases
+
+
+def _names_privilege_program(word: str) -> bool:
+    base = word.rsplit("/", 1)[-1]
+    if base in PRIVILEGE_PROGRAMS:
+        return True
+    # Broken quoting leaves quote characters in words; read past them.
+    return base.replace("'", "").replace('"', "") in PRIVILEGE_PROGRAMS
+
+
+def _is_plain(word: str) -> bool:
+    return word in BASH_BUILTINS or word in BASH_KEYWORDS or bool(_PLAIN_WORD.fullmatch(word))
+
+
+def _keyword(token: _Token) -> str | None:
+    """The keyword a word is, or None. A quoted word (``'[['``, ``\\[[``) is never a
+    keyword: bash runs it as a command."""
+    if token.raw == token.text and token.text in BASH_KEYWORDS:
+        return token.text
+    return None
+
+
+# Operators that end a `[[ ... ]]` test early. Inside `[[`, `&&`, `||`, `(` and `)` are part
+# of the test, but these are not, so the test cannot run past them.
+_TEST_ENDERS = frozenset(("\n", ";", ";;", ";&", ";;&", "&", "|", "|&"))
+
+
+def _unclear_command_word(
+    tokens: list[_Token], functions: frozenset[str], pieces: bool = False
+) -> bool:
+    """Rule 1b: a command word that is not plainly a name, or that names a function.
+
+    With ``pieces`` True, ``tokens`` come from re-splitting a quoted word: its own words
+    are arguments, checked by 1a only, but the command words inside a ``$(`` or backtick
+    substitution in it are still command words (bash runs them inside double quotes).
+    """
+    expect = not pieces  # the next word is a command word
+    quiet = pieces  # outside any substitution in a re-split quoted word
+    in_test = False  # between `[[` and `]]`
+    redirect_target = False
+    # (expect, in_test, quiet) to restore when a `$(`, `(` or backtick closes.
+    restore: list[tuple[bool, bool, bool]] = []
+    previous: _Token | None = None
+    function_name = False  # the next word names a function being defined
+    coproc_name = False  # the last command word was `coproc`
+    after_time = False  # the last command word was `time`; its options follow
+    for index, token in enumerate(tokens):
+        prev, previous = previous, token
+        if token.kind == "op" and token.text in _SUBST_OPEN:
+            # A substitution runs its own commands, wherever it is: inside `[[ ... ]]`,
+            # inside a re-split quoted word, or in argument position.
+            # Inside a leading assignment (`X=$(date) cmd`), the command word still comes
+            # after it.
+            in_assignment = (
+                expect
+                and token.glued
+                and prev is not None
+                and prev.kind == "word"
+                and bool(_ASSIGNMENT.match(prev.raw))
+            )
+            if expect and not quiet and not in_test and not in_assignment:
+                return True  # the command word begins with a substitution
+            restore.append((in_assignment, in_test, quiet))
+            expect, in_test, quiet = True, False, False
+            redirect_target = function_name = coproc_name = after_time = False
+            continue
+        if in_test:
+            if token.kind == "word" and _keyword(token) == "]]":
+                in_test = False
+            elif token.kind == "op" and token.text in _TEST_ENDERS:
+                in_test = False
+                expect = not quiet
+            continue
+        if redirect_target:
+            redirect_target = False
+            if token.kind == "word":
+                continue  # a redirection's target is checked by 1a only
+        if token.kind == "redir":
+            redirect_target = True
+            continue
+        if token.kind == "op":
+            coproc_name = after_time = False
+            if token.text == "(":
+                restore.append((False, False, quiet))
+                expect = not quiet
+            elif token.text in _SUBST_CLOSE:
+                if restore:
+                    expect, in_test, quiet = restore.pop()
+                else:
+                    expect = False
+                if token.text == ")" and prev is not None and prev.text == "(":
+                    expect = not quiet  # `f()`: the function's body follows
+            else:
+                expect = not quiet
+            continue
+        # A word.
+        if token.glued and prev is not None and prev.kind == "op" and prev.text in _SUBST_CLOSE:
+            continue  # the rest of the word the substitution is part of
+        if function_name:
+            function_name = False
+            expect = True  # `function f { ...`: the body follows the name
+            continue
+        if after_time and token.text.startswith("-"):
+            continue  # `time -p cmd`
+        after_time = False
+        if coproc_name:
+            # `coproc NAME { ...`: the body after the name starts a command.
+            coproc_name = False
+            following = tokens[index + 1] if index + 1 < len(tokens) else None
+            if following is not None and following.kind == "word" and _keyword(following) == "{":
+                if not _is_plain(token.text):
+                    return True
+                continue
+        if not expect:
+            continue
+        if _ASSIGNMENT.match(token.raw):
+            continue
+        following = tokens[index + 1] if index + 1 < len(tokens) else None
+        if following is not None and following.glued and following.text in _SUBST_OPEN:
+            return True  # a substitution inside the command word
+        if token.text in functions or not _is_plain(token.text):
+            return True
+        keyword = _keyword(token)
+        if keyword == "[[":
+            in_test = True
+            expect = False
+        elif keyword == "function":
+            function_name = True
+            expect = False
+        else:
+            expect = keyword in _COMMAND_STARTING_KEYWORDS
+            after_time = keyword == "time"
+            coproc_name = keyword == "coproc"
+    return False
+
+
+def _text_is_privileged(text: str, session: _Session, alias_path: tuple[str, ...]) -> bool:
+    pending = [(tokens, 0) for tokens in _split(text)]
+    while pending:
+        level, depth = pending.pop()
+        # Depth 0 is the text itself; deeper levels are pieces of a re-split quoted word.
+        if _unclear_command_word(level, session.functions, pieces=depth > 0):
+            return True
+        for token in level:
+            if token.kind != "word":
+                continue
+            word = token.text
+            if _names_privilege_program(word):
+                return True
+            if word in session.functions:
+                # Bash can run a function from argument position too (`eval f`).
+                return True
+            if word in session.aliases and _alias_is_privileged(word, session, alias_path):
+                return True
+            if any(ch in _RESPLIT_CHARS for ch in word):
+                # A quoted word such as `bash -c 'sudo x'`: rule 1a on its pieces, and
+                # rule 1b only inside a substitution in it (`echo "$(sud${X}o x)"`).
+                if depth + 1 > _MAX_DEPTH:
+                    return True
+                pending.extend((tokens, depth + 1) for tokens in _split(word))
+    return False
+
+
+def _alias_is_privileged(name: str, session: _Session, alias_path: tuple[str, ...]) -> bool:
+    if alias_path and name == alias_path[-1]:
+        # `alias ls='ls --color=auto'`: bash does not expand an alias inside its own
+        # value, and that value is the one being checked already.
+        return False
+    if name in alias_path or len(alias_path) >= _MAX_DEPTH:
+        return True  # a cycle, or a chain too deep to follow
+    if name in session.clean_aliases:
+        return False
+    if _text_is_privileged(session.aliases[name], session, alias_path + (name,)):
+        return True
+    session.clean_aliases.add(name)
+    return False
+
+
+def _is_privileged(command: str, result: CommandResult) -> bool:
+    snapshot = result.snapshot
+    session = _Session(
+        functions=frozenset(snapshot.functions), aliases=_parse_aliases(snapshot.aliases)
+    )
+    return _text_is_privileged(command, session, ())
+
+
+# --- rule 4: the 127 suggestion ---------------------------------------------------------
+
+
+def _unresolved_word(command: str, result: CommandResult) -> str | None:
+    """The command word bash did not find, or None when that is not certain or not safe
+    to show. Only for one simple command: no list, pipe, substitution or assignment."""
+    tokens, broken = _scan(command)
+    while tokens and tokens[-1].kind == "op" and tokens[-1].text == "\n":
+        tokens.pop()
+    if broken or not tokens:
+        return None
+    for token in tokens:
+        if token.kind != "word" or "$(" in token.raw or "`" in token.raw:
+            return None
+    word = tokens[0].text
+    if _ASSIGNMENT.match(tokens[0].raw) or not _SHOWN_WORD.fullmatch(word):
+        return None
+    snapshot = result.snapshot
+    if word in snapshot.functions or word in _parse_aliases(snapshot.aliases):
+        return None
+    disabled = set(snapshot.disabled_builtins.split()) - {"enable", "-n"}
+    if word in BASH_KEYWORDS or (word in BASH_BUILTINS and word not in disabled):
+        return None
+    for directory in snapshot.path.split(":"):
+        if not directory.startswith("/"):
+            return None  # empty, `.` or relative: depends on the working directory
+        program = os.path.join(directory, word)
+        if os.path.isfile(program) and os.access(program, os.X_OK):
+            return None
+    return word
+
+
+def _packages(word: str, lookup: Lookup | None) -> tuple[str, ...]:
+    if lookup is None:
+        return ()
+    try:
+        found = lookup(word)
+        if found is None:
+            return ()
+        if isinstance(found, str):
+            found = (found,)
+        shown: list[str] = []
+        for name in itertools.islice(found, _MAX_LOOKUP_ITEMS):
+            if isinstance(name, str) and _SHOWN_PACKAGE.fullmatch(name) and name not in shown:
+                shown.append(name)
+                if len(shown) == _MAX_PACKAGES:
+                    break
+        return tuple(shown)
+    except Exception:
+        return ()
+
+
+def _not_found_message(word: str | None, packages: tuple[str, ...]) -> str:
+    if word is None:
+        return "Command not found."
+    if not packages:
+        return f"Command not found: {word}."
+    noun = "package" if len(packages) == 1 else "packages"
+    return f"Command not found: {word}. It is provided by the {noun} {', '.join(packages)}."
+
+
+# --- classify ---------------------------------------------------------------------------
+
+
+def _is_blank(command: str) -> bool:
+    return all(
+        not line.strip(" \t\r") or line.strip(" \t\r").startswith("#")
+        for line in command.split("\n")
+    )
+
+
+def _failure(result: CommandResult, kind: FailureClass, message: str, **extra) -> Failure:
+    offer = kind in (
+        FailureClass.NOT_FOUND,
+        FailureClass.NOT_EXECUTABLE,
+        FailureClass.SIGNAL,
+        FailureClass.OTHER,
+    )
+    return Failure(
+        kind=kind,
+        status=result.status,
+        pipestatus=tuple(result.pipestatus),
+        message=message,
+        offer_correction=offer,
+        to_reader=kind is FailureClass.OTHER,
+        is_error=kind not in (FailureClass.NONE, FailureClass.INTERRUPTED),
+        **extra,
+    )
+
+
+def classify(result: CommandResult, command: str, lookup: Lookup | None = None) -> Failure:
+    """Classify one command from its ``CommandResult`` and the confirmed ``command``.
+
+    ``lookup`` maps an unresolved command word to the packages that provide it (the
+    package provider, #156). A bare ``str`` is one name; ``None`` or an exception means
+    none.
+    """
+    if not isinstance(result, CommandResult):
+        raise TypeError(f"classify needs a session.CommandResult, not {type(result).__name__}")
+    if not isinstance(command, str):
+        raise TypeError(f"command must be str, not {type(command).__name__}")
+
+    if not result.ran:
+        if _is_blank(command):
+            return _failure(result, FailureClass.NONE, "")
+        if _is_privileged(command, result):
+            return _failure(result, FailureClass.PRIVILEGE, PRIVILEGE_MESSAGE)
+        return _failure(
+            result, FailureClass.OTHER, "Bash could not parse the command; nothing ran."
+        )
+
+    status = result.status
+    if status == 0:
+        return _failure(result, FailureClass.NONE, "")
+    if status == 130:
+        return _failure(result, FailureClass.INTERRUPTED, "Interrupted.")
+    if _is_privileged(command, result):
+        return _failure(result, FailureClass.PRIVILEGE, PRIVILEGE_MESSAGE)
+    if status == 127:
+        word = _unresolved_word(command, result)
+        packages = _packages(word, lookup) if word is not None else ()
+        return _failure(
+            result,
+            FailureClass.NOT_FOUND,
+            _not_found_message(word, packages),
+            command_word=word,
+            packages=packages,
+        )
+    if status == 126:
+        return _failure(
+            result,
+            FailureClass.NOT_EXECUTABLE,
+            "The command was found but could not be run (permission or noexec).",
+        )
+    if 129 <= status <= 192:
+        number = status - 128
+        try:
+            name: str | None = signal.Signals(number).name
+        except ValueError:
+            name = None
+        message = f"The command was killed by signal {number}"
+        message += f" ({name})." if name else "."
+        if number == signal.SIGKILL:
+            message += " This is often the out-of-memory killer."
+        return _failure(
+            result, FailureClass.SIGNAL, message, signal_number=number, signal_name=name
+        )
+    return _failure(result, FailureClass.OTHER, f"The command failed with exit status {status}.")
