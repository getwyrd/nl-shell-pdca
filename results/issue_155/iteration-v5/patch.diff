+def test_word_in_a_later_path_directory_is_found(tmp_path, bin_dir):
+    other = tmp_path / "other"
+    other.mkdir()
+    install(other, "htop")
+    failure = classify(127, "htop", f"{bin_dir}:{other}")
+    assert failure.packages == ()
+    assert failure.command_word is None
