+def test_no_message_in_any_table_says_none(bin_dir):
+    rows = [(status, command, "") for _, status, command, *_ in TABLE]
+    rows += PRIVILEGED_LITERAL + PRIVILEGED_UNCLEAR
+    rows += [(status, command, "") for status in (1, 2) for command in NOT_PRIVILEGED]
+    rows += [(1, command, aliases) for _, command, aliases, _ in BOUNDED]
+    for status, command, aliases in rows:
+        assert "None" not in classify(status, command, bin_dir, aliases=aliases).message
+    for _, command, installed, state in NO_SUGGESTION:
+        assert "None" not in classify(127, command, bin_dir, **state).message
