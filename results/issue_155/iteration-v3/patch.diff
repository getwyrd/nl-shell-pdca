+def test_only_other_goes_to_the_reader(bin_dir):
+    for _, status, command, cls, _offer, _reader in TABLE:
+        failure = classify(status, command, bin_dir)
+        assert failure.to_reader is (cls == "OTHER"), (status, command)
+    for status, command, aliases in PRIVILEGED:
+        assert classify(status, command, bin_dir, aliases=aliases).to_reader is False
