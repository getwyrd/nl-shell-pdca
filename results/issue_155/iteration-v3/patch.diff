@@ -0,0 +1,575 @@
+"""Failure classes by exit code: the deterministic first pass over a failed command (#62).
+
+``classify`` reads trusted facts only: the ``session.CommandResult`` built from the
+control channel's done record (ADR-0014 Decision 2: the exit status is trusted only from
+there) and the command text the user confirmed. It never reads the command's output, so
+nothing a failing program prints can choose the class, the message or the suggestion
+(ADR-0017: only the reader sees raw untrusted text). Every message is a fixed template;
+no model writes it.
+
+Precedence:
+
+1. ``ran`` is False (protocol §4.1: bash read the input but ran nothing): blank or
+   comment-only text is NONE; anything else was a syntax error, handled as OTHER.
+2. Status 0 is NONE.
+3. Status 130 is INTERRUPTED (Ctrl-C), even for a privileged command.
+4. A privileged command (see ``is_privileged``) with any other non-zero status is
+   PRIVILEGE: one neutral message, no correction offer, not sent to the reader
+   (ADR-0015, ADR-0006: never offer anything that touches the sudo password).
+5. 127 is NOT_FOUND, 126 is NOT_EXECUTABLE, 129-192 is SIGNAL (128 + n, ``bash(1)``
+   EXIT STATUS), anything else is OTHER. Only OTHER goes to the reader.
+
+For NOT_FOUND the package that provides the missing command is looked up through an
+injected ``lookup`` (``Callable[[str], Iterable[str]]``), and only for one simple command
+whose first word bash cannot have found (``_unresolved_word``). The package data and its
+reader live elsewhere (#156); this module only applies display safety to what it returns.
+
+The word splitting here is a placeholder, like ``router.first_token``: the policy gate's
+parse (#12) replaces both.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import enum
+import fnmatch
+import re
+import shlex
+import signal
+from collections.abc import Callable, Iterable
+
+from nl_shell import render, router, session
+
+Lookup = Callable[[str], Iterable[str]]
+
+# Policy-gate spec §4 (docs/design/specs/policy-gate/v1.md:111), plus the other installed
+# names of sudo (sudo-rs, classic sudo as sudo.ws, sudo's edit mode).
+PRIVILEGE_PROGRAMS = frozenset(
+    "sudo su pkexec doas run0 machinectl sudo-rs sudo.ws sudoedit sudoedit-rs".split()
+)
+
+# Output of `compgen -k` in bash 5. ``router.BASH_BUILTINS`` leaves keywords out on
+# purpose (router.py:26), so the not-found rule adds them here.
+BASH_KEYWORDS = frozenset(
+    "if then else elif fi case esac for select while until do done in function time "
+    "{ } ! [[ ]] coproc".split()
+)
+
+# A word or package name longer than this is never shown.
+MAX_SHOWN = 64
+# At most this many packages are named in a message.
+MAX_PACKAGES = 5
+
+PRIVILEGE_MESSAGE = (
+    "The command ran a program that changes privileges, and it did not succeed. "
+    "nl-shell offers no correction for it."
+)
+INTERRUPTED_MESSAGE = "Interrupted."
+NOT_EXECUTABLE_MESSAGE = (
+    "The command was found but could not be run (permission or noexec)."
+)
+NOTHING_RAN_MESSAGE = "Bash read the command but ran nothing: it may be a syntax error."
+
+# The shell operators the whole-text splitter cuts off words: lists, pipes, background,
+# subshells and command substitution, redirections, and backticks.
+_OPERATOR_CHARS = ";&|()<>`"
+# The coarse pass: line continuations removed, `$'...'` decoded, the operator of a
+# `${NAME:-word}`-style expansion cut off, `$`, quotes and backslashes removed, then cut
+# at whitespace, operators, and the characters of brace expansion, assignment and
+# `${...}`. It over-splits on purpose.
+_LINE_CONTINUATION = re.compile(r"\\\r?\n")
+_ANSI_C = re.compile(r"\$'((?:[^'\\]|\\.)*)'", re.DOTALL)
+_ANSI_C_ESCAPE = re.compile(
+    r"\\(?:([abeEfnrtv\\'\"?])|([0-7]{1,3})|x([0-9A-Fa-f]{1,2})|u([0-9A-Fa-f]{1,4})"
+    r"|U([0-9A-Fa-f]{1,8})|c(.)|(.))",
+    re.DOTALL,
+)
+_ANSI_C_SIMPLE = {
+    "a": "\a", "b": "\b", "e": "\x1b", "E": "\x1b", "f": "\f", "n": "\n", "r": "\r",
+    "t": "\t", "v": "\v", "\\": "\\", "'": "'", '"': '"', "?": "?",
+}
+# `${NAME-`, `${NAME:-`, `${NAME:=`, `${NAME+`, `${NAME:?` and the like: the word after
+# the operator may be what runs.
+_EXPANSION_OPERATOR = re.compile(r"\$\{[#!]?[A-Za-z0-9_@*]*(?:\[[^\]]*\])?:?[-=+?]")
+_COARSE_DROP = str.maketrans("", "", "$'\"\\")
+_COARSE_SPLIT = re.compile(r"[\s;&|()<>`{},=:]+")
+# A word with a glob character is matched as a pattern, when it has a letter of its own
+# (`sud[o]`, `/bin/su?o`); a bare `*` or `?` is not taken to name a program.
+_GLOB_CHARS = frozenset("*?[")
+_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\+?=")
+# A first word bash looks up on $PATH by name: no path, expansion, glob or quoting left.
+_PLAIN_NAME = re.compile(r"[^/$`*?\[\]{}~\s'\"\\]+")
+
+
+class FailureClass(enum.Enum):
+    NONE = "none"
+    INTERRUPTED = "interrupted"
+    PRIVILEGE = "privilege"
+    NOT_FOUND = "not-found"
+    NOT_EXECUTABLE = "not-executable"
+    SIGNAL = "signal"
+    OTHER = "other"
+
+
+@dataclasses.dataclass(frozen=True)
+class Failure:
+    """How one finished command failed, from trusted facts only."""
+
+    kind: FailureClass
+    status: int  # `$?`: the last command of a pipeline
+    pipestatus: tuple[int, ...]
+    message: str  # a fixed template, safe to print
+    offer_correction: bool
+    to_reader: bool
+    command_word: str | None = None  # NOT_FOUND: the missing word, when safe to show
+    packages: tuple[str, ...] = ()  # NOT_FOUND: packages that provide it, safe to show
+    signal_number: int | None = None
+    signal_name: str | None = None
+
+    @property
+    def is_error(self) -> bool:
+        return self.kind not in (FailureClass.NONE, FailureClass.INTERRUPTED)
+
+
+def classify(
+    result: session.CommandResult, command: str, lookup: Lookup | None = None
+) -> Failure:
+    """Classify ``result`` of running the confirmed ``command``."""
+    if not isinstance(result, session.CommandResult):
+        raise TypeError(
+            f"classify needs a session.CommandResult, not {type(result).__name__}"
+        )
+    status = result.status
+    pipestatus = tuple(result.pipestatus)
+
+    def failure(kind: FailureClass, message: str, **extra) -> Failure:
+        quiet = kind in (FailureClass.NONE, FailureClass.INTERRUPTED, FailureClass.PRIVILEGE)
+        return Failure(
+            kind=kind,
+            status=status,
+            pipestatus=pipestatus,
+            message=message,
+            offer_correction=not quiet,
+            to_reader=kind is FailureClass.OTHER,
+            **extra,
+        )
+
+    if not result.ran:
+        if _blank_or_comment(command):
+            return failure(FailureClass.NONE, "")
+        return failure(FailureClass.OTHER, NOTHING_RAN_MESSAGE)
+    if status == 0:
+        return failure(FailureClass.NONE, "")
+    if status == 130:
+        return failure(FailureClass.INTERRUPTED, INTERRUPTED_MESSAGE)
+    if is_privileged(command, result.snapshot):
+        return failure(FailureClass.PRIVILEGE, PRIVILEGE_MESSAGE)
+    if status == 127:
+        word, packages = _suggestion(command, result.snapshot, lookup)
+        return failure(
+            FailureClass.NOT_FOUND,
+            _not_found_message(word, packages),
+            command_word=word,
+            packages=packages,
+        )
+    if status == 126:
+        return failure(FailureClass.NOT_EXECUTABLE, NOT_EXECUTABLE_MESSAGE)
+    if 129 <= status <= 192:
+        number = status - 128
+        name = _signal_name(number)
+        return failure(
+            FailureClass.SIGNAL,
+            _signal_message(number, name),
+            signal_number=number,
+            signal_name=name,
+        )
+    return failure(FailureClass.OTHER, f"The command ended with exit status {status}.")
+
+
+def _blank_or_comment(text: str) -> bool:
+    return all(not line.strip() or line.lstrip().startswith("#") for line in text.splitlines())
+
+
+# --- privilege ---------------------------------------------------------------------
+
+
+def words(text: str) -> list[str]:
+    """Every shell word of ``text``, with shell operators split off. Never raises.
+
+    Built like ``router.first_token`` (``shlex`` in posix mode, whitespace fallback on bad
+    quoting), but over the whole text, with ``#`` not treated as a comment (bash only
+    starts one at the start of a word) and with the operators cut off words, so
+    ``a&&sudo x``, ``$(sudo x)`` and backticks each yield ``sudo``. A coarse pass is added
+    on top (``_coarse``), so a word inside quotes or brace expansion is seen too:
+    over-matching is the safe direction for the privilege rule.
+    """
+    lexer = shlex.shlex(text, posix=True, punctuation_chars=_OPERATOR_CHARS)
+    lexer.whitespace_split = True
+    lexer.commenters = ""
+    try:
+        found = list(lexer)
+    except ValueError:
+        found = text.split()
+    return found + _coarse(text)
+
+
+def _coarse(text: str) -> list[str]:
+    text = _LINE_CONTINUATION.sub("", text)
+    text = _ANSI_C.sub(lambda match: _decode_ansi_c(match.group(1)), text)
+    text = _EXPANSION_OPERATOR.sub(" ", text)
+    return [word for word in _COARSE_SPLIT.split(text.translate(_COARSE_DROP)) if word]
+
+
+def _decode_ansi_c(body: str) -> str:
+    """The value of bash's ``$'...'`` quoting (``bash(1)`` QUOTING), for matching only."""
+
+    def escape(match: re.Match) -> str:
+        simple, octal, hex2, hex4, hex8, control, other = match.groups()
+        if simple is not None:
+            return _ANSI_C_SIMPLE[simple]
+        if octal is not None:
+            return chr(int(octal, 8) & 0xFF)
+        number = hex2 or hex4 or hex8
+        if number is not None:
+            value = int(number, 16)
+            return chr(value) if value <= 0x10FFFF else ""
+        if control is not None:
+            return chr(ord(control) & 0x1F)
+        return "\\" + other
+
+    # Bash ends the quoted string at the first NUL; the rest of the word still follows.
+    return _ANSI_C_ESCAPE.sub(escape, body).split("\0", 1)[0]
+
+
+# --- the expanded pass: what each word can become before bash runs it ---------------
+#
+# Bash builds the program name from quotes, expansions and braces before it runs it, so
+# `sud${X}o`, `sud$(:)o`, `s{u,}do` and `${X:-su}do` all run `sudo`. This pass rewrites
+# each expansion as the values it may take, then brace-expands each word:
+#
+# - `$NAME`, `$@`, `$1`, `$(...)`, backticks and `${NAME...}`: the value is not in the
+#   text, and it may be empty, so the expansion is dropped (the words inside `$(...)`
+#   and backticks are still seen by ``words``);
+# - `${NAME-word}` and the other operators that can yield their word (`:-`, `=`, `:=`,
+#   `+`, `:+`): empty or the word, `{,word}` (the word itself rewritten the same way);
+# - `$((...))` and `$[...]`: empty or one digit (`run$((0))` runs `run0`).
+#
+# Values the text does not hold (`c=sud; c+=o; $c`) stay out of reach of any word
+# matcher; the policy gate's parse (#12) owns that.
+
+# More than this many results for one word is treated as privileged: a word built to be
+# too large to expand must not slip past the rule (over-matching is the safe direction).
+MAX_EXPANSIONS = 4096
+_EXPANDED_SPLIT = re.compile(r"[\s;&|()<>]+")
+_PIECE_SPLIT = re.compile(r"[=:]+")
+_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+_YIELDS_WORD = re.compile(r"[#!]?[A-Za-z0-9_@*]*(?:\[[^\]]*\])?(:?[-=+])")
+_ARITHMETIC_VALUES = "{," + ",".join("0123456789") + "}"
+_SEQUENCE = re.compile(r"(-?\d+|[A-Za-z])\.\.(-?\d+|[A-Za-z])(?:\.\.(-?\d+))?")
+
+
+class _TooMany(Exception):
+    """A word has more than ``MAX_EXPANSIONS`` expansions."""
+
+
+def _matching(text: str, start: int, open_char: str, close_char: str) -> int:
+    """The index of the ``close_char`` that closes ``text[start]``, or ``len(text)``."""
+    depth = 0
+    index = start
+    while index < len(text):
+        char = text[index]
+        if char == "\\":
+            index += 2
+            continue
+        if char == open_char:
+            depth += 1
+        elif char == close_char:
+            depth -= 1
+            if depth == 0:
+                return index
+        index += 1
+    return len(text)
+
+
+def _as_braces(text: str) -> str:
+    """``text`` with every expansion dropped or rewritten as a brace set of its values."""
+    out = []
+    index = 0
+    while index < len(text):
+        char = text[index]
+        if char == "`":
+            end = text.find("`", index + 1)
+            index = len(text) if end < 0 else end + 1
+            continue
+        if char != "$" or index + 1 == len(text):
+            out.append(char)
+            index += 1
+            continue
+        after = text[index + 1]
+        name = _NAME.match(text, index + 1)
+        if text.startswith("$((", index):
+            index = _matching(text, index + 1, "(", ")") + 1
+            out.append(_ARITHMETIC_VALUES)
+        elif after == "(":
+            index = _matching(text, index + 1, "(", ")") + 1
+        elif after == "[":
+            index = _matching(text, index + 1, "[", "]") + 1
+            out.append(_ARITHMETIC_VALUES)
+        elif after == "{":
+            end = _matching(text, index + 1, "{", "}")
+            body = text[index + 2 : end]
+            index = end + 1
+            operator = _YIELDS_WORD.match(body)
+            if operator:
+                out.append("{," + _as_braces(body[operator.end() :]) + "}")
+        elif name:
+            index = name.end()
+        elif after.isdigit() or after in "@*#?-$!":
+            index += 2
+        else:  # `$"..."` and a lone `$`
+            index += 1
+    return "".join(out)
+
+
+def _brace_close(word: str, start: int) -> tuple[int, list[str]] | None:
+    """For the `{` at ``start``: the index of its `}` and its alternatives, or None when
+    bash would leave it as a literal brace."""
+    depth = 0
+    commas = []
+    index = start
+    while index < len(word):
+        char = word[index]
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                break
+        elif char == "," and depth == 1:
+            commas.append(index)
+        index += 1
+    else:
+        return None
+    if commas:
+        bounds = [start, *commas, index]
+        return index, [word[a + 1 : b] for a, b in zip(bounds, bounds[1:])]
+    sequence = _SEQUENCE.fullmatch(word[start + 1 : index])
+    if sequence is None:
+        return None
+    return index, _sequence(*sequence.groups())
+
+
+def _sequence(first: str, last: str, step: str | None) -> list[str]:
+    stride = abs(int(step)) if step and int(step) else 1
+    if first.lstrip("-").isdigit() and last.lstrip("-").isdigit():
+        low, high = int(first), int(last)
+        if abs(high - low) // stride >= MAX_EXPANSIONS:
+            raise _TooMany
+        values = range(low, high + 1, stride) if low <= high else range(low, high - 1, -stride)
+        return [str(value) for value in values]
+    if first.isalpha() and last.isalpha():
+        low, high = ord(first), ord(last)
+        values = range(low, high + 1, stride) if low <= high else range(low, high - 1, -stride)
+        return [chr(value) for value in values]
+    return [f"{{{first}..{last}}}"]
+
+
+def _brace_expand(word: str) -> list[str]:
+    """``word`` brace-expanded the way bash does it (``bash(1)`` Brace Expansion)."""
+    start = word.find("{")
+    while start >= 0:
+        found = _brace_close(word, start)
+        if found is not None:
+            end, alternatives = found
+            prefix, suffix = word[:start], word[end + 1 :]
+            results = []
+            tails = _brace_expand(suffix)
+            for alternative in alternatives:
+                for middle in _brace_expand(alternative):
+                    for tail in tails:
+                        results.append(prefix + middle + tail)
+                        if len(results) > MAX_EXPANSIONS:
+                            raise _TooMany
+            return results
+        start = word.find("{", start + 1)
+    return [word]
+
+
+def _expanded(text: str) -> list[str]:
+    """Every name a word of ``text`` may become once bash has expanded it.
+
+    Raises ``_TooMany`` when one word has more than ``MAX_EXPANSIONS`` results.
+    """
+    text = _LINE_CONTINUATION.sub("", text)
+    text = _ANSI_C.sub(lambda match: _decode_ansi_c(match.group(1)), text)
+    text = _as_braces(text).translate(_COARSE_DROP)
+    found = []
+    for word in _EXPANDED_SPLIT.split(text):
+        for result in _brace_expand(word) if word else ():
+            found.append(result)
+            found.extend(_PIECE_SPLIT.split(result))
+    return [word for word in found if word]
+
+
+def _basename(word: str) -> str:
+    return word.rsplit("/", 1)[-1]
+
+
+def _names_privilege_program(word: str) -> bool:
+    name = _basename(word)
+    if name in PRIVILEGE_PROGRAMS:
+        return True
+    if _GLOB_CHARS & set(name) and any(char.isalnum() for char in name):
+        return any(fnmatch.fnmatchcase(program, name) for program in PRIVILEGE_PROGRAMS)
+    return False
+
+
+def is_privileged(command: str, snapshot) -> bool:
+    """True when any word of ``command``, or of the value of a session alias named by a
+    word (followed through aliases of aliases), has a privilege program's basename.
+
+    Any word, on purpose: ``man sudo`` counts. A failed privileged command is never
+    offered a correction, so matching too much costs a suggestion, never safety.
+    """
+    aliases = _aliases(snapshot.aliases)
+    try:
+        pending = _candidates(command)
+    except _TooMany:
+        return True
+    seen_aliases: set[str] = set()
+    while pending:
+        word = pending.pop()
+        if _names_privilege_program(word):
+            return True
+        if word in aliases and word not in seen_aliases:
+            seen_aliases.add(word)
+            try:
+                pending.extend(_candidates(aliases[word]))
+            except _TooMany:
+                return True
+    return False
+
+
+def _candidates(text: str) -> list[str]:
+    """The words of ``text`` as written (``words``) and as bash may expand them."""
+    return words(text) + _expanded(text)
+
+
+def _aliases(text: str) -> dict[str, str]:
+    """``alias -p`` text as ``{name: value}``. Lines that do not parse are skipped."""
+    found = {}
+    for line in text.splitlines():
+        try:
+            parts = shlex.split(line)
+        except ValueError:
+            continue
+        if parts[:1] != ["alias"]:
+            continue
+        parts = [part for part in parts[1:] if part != "--"]
+        if len(parts) != 1 or "=" not in parts[0]:
+            continue
+        name, _, value = parts[0].partition("=")
+        found[name] = value
+    return found
+
+
+# --- not found ---------------------------------------------------------------------
+
+
+def _suggestion(
+    command: str, snapshot, lookup: Lookup | None
+) -> tuple[str | None, tuple[str, ...]]:
+    """The missing word to show, and the packages that provide it."""
+    word = _unresolved_word(command, snapshot)
+    if word is None or not _safe_to_show(word):
+        return None, ()
+    if lookup is None:
+        return word, ()
+    found = lookup(word)
+    # A bare string is an Iterable[str] too, but it means one name, not its letters.
+    if found is None:
+        found = ()
+    elif isinstance(found, str):
+        found = (found,)
+    packages = []
+    for name in found:
+        if isinstance(name, str) and _safe_to_show(name) and name not in packages:
+            packages.append(name)
+        if len(packages) == MAX_PACKAGES:
+            break
+    return word, tuple(packages)
+
+
+def _unresolved_word(command: str, snapshot) -> str | None:
+    """The first word of ``command`` when it is one simple command and bash cannot have
+    found that word; otherwise None, because the 127 may have come from somewhere else
+    (a later command, a program the first word ran, a substitution)."""
+    if "\n" in command.strip():
+        return None
+    split = words(command)
+    if any(set(word) & set(_OPERATOR_CHARS) for word in split) or "$(" in command:
+        return None
+    word = router.first_token(command)
+    if not word or _ASSIGNMENT.match(word) or not _PLAIN_NAME.fullmatch(word):
+        return None
+    if word in snapshot.functions or word in _aliases(snapshot.aliases):
+        return None
+    if word in BASH_KEYWORDS:
+        return None
+    if word in router.BASH_BUILTINS - _disabled_builtins(snapshot.disabled_builtins):
+        return None
+    directories = snapshot.path.split(":")
+    # An empty, `.` or relative entry depends on the session's directory, which the
+    # snapshot does not carry: bash may have found the word there.
+    if any(not directory.startswith("/") for directory in directories):
+        return None
+    if any(router.is_executable_file(f"{directory}/{word}") for directory in directories):
+        return None
+    return word
+
+
+def _disabled_builtins(text: str) -> frozenset[str]:
+    """``enable -n`` text (``enable -n NAME`` lines) as a set of names."""
+    found = set()
+    for line in text.splitlines():
+        parts = line.split()
+        if len(parts) == 3 and parts[:2] == ["enable", "-n"]:
+            found.add(parts[2])
+    return frozenset(found)
+
+
+def _safe_to_show(text: str) -> bool:
+    return (
+        0 < len(text) <= MAX_SHOWN
+        and text.isprintable()
+        and not render.has_hidden(text)
+        and not render.too_many_marks(text)
+    )
+
+
+def _not_found_message(word: str | None, packages: tuple[str, ...]) -> str:
+    if word is None:
+        return "Command not found."
+    if not packages:
+        return f"Command not found: {word}."
+    if len(packages) == 1:
+        return f"Command not found: {word}. It is provided by the package {packages[0]}."
+    return f"Command not found: {word}. It is provided by the packages {', '.join(packages)}."
+
+
+# --- signals -----------------------------------------------------------------------
+
+
+def _signal_name(number: int) -> str | None:
+    try:
+        return signal.Signals(number).name
+    except ValueError:
+        return None
+
+
+def _signal_message(number: int, name: str | None) -> str:
+    shown = f"signal {number} ({name})" if name else f"signal {number}"
+    message = f"The command was killed by {shown}."
+    if number == signal.SIGKILL:
+        message += " If nobody killed it, the kernel's out-of-memory killer may have."
+    return message
