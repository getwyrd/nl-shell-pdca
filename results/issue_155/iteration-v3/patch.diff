+# --- privilege (decision 1) ----------------------------------------------------------
+
+# (status, command, aliases)
+PRIVILEGED = [
+    (1, "sudo apt update", ""),
+    (127, "sudo frobnicate", ""),
+    (126, "pkexec x", ""),
+    (127, "pkexec x", ""),
+    (1, "su -c x", ""),
+    (1, "doas x", ""),
+    (1, "run0 x", ""),
+    (1, "machinectl shell x", ""),
+    (1, "sudo-rs x", ""),
+    (1, "sudo.ws x", ""),
+    (1, "sudoedit /etc/hosts", ""),
+    (1, "sudoedit-rs f", ""),
+    (1, "/usr/bin/sudo x", ""),
+    (1, "time sudo x", ""),
+    (1, "FOO=1 sudo x", ""),
+    (1, "env sudo x", ""),
+    (1, "nohup sudo x", ""),
+    (1, "cd d && sudo x", ""),
+    (1, "cd d&&sudo x", ""),
+    (1, "true; sudo x", ""),
+    (1, "true;sudo x", ""),
+    (1, "a || sudo x", ""),
+    (1, "a||sudo x", ""),
+    (1, "x & sudo y", ""),
+    (1, "echo pw | sudo -S x", ""),
+    (1, "echo $(sudo x)", ""),
+    (1, "echo `sudo x`", ""),
+    (1, 'echo "$(sudo x)"', ""),
+    (137, "sudo big-job", ""),
+    # Spellings bash turns into a privilege program's name before it runs anything.
+    (1, "$'sudo' apt update", ""),
+    (1, "$'\\x73udo' x", ""),
+    (1, "$'\\163udo' x", ""),
+    (1, "$'su\\u0064o' x", ""),
+    (1, "pk$'exec' x", ""),
+    (1, '$"sudo" x', ""),
+    (1, "${X:-sudo} apt update", ""),
+    (1, "${X-sudo} x", ""),
+    (1, "${X:=doas} x", ""),
+    (1, "${X:+pkexec} x", ""),
+    (1, "${X:-/usr/bin/sudo} x", ""),
+    (1, "sud\\\no apt update", ""),
+    (1, "/usr/bin/sud[o] apt update", ""),
+    (1, "/usr/bin/sud? x", ""),
+    (1, "pke*c x", ""),
+    # Bash ends a `$'...'` string at the first NUL; the rest of the word still follows.
+    (1, "$'sudo\\0ignored' x", ""),
+    (1, "$'sudo\\x00' x", ""),
+    (1, "$'su\\0x'do x", ""),
+    # Brace expansion builds the name.
+    (1, "s{u,}do x", ""),
+    (1, "{s,}udo x", ""),
+    (1, "pk{e,}xec x", ""),
+    (1, "s{x,u}do x", ""),
+    (1, "{r..s}udo x", ""),
+    (1, "r{u,}n{0..1} x", ""),
+    # An expansion that is empty at run time joins the pieces around it.
+    (1, "pkexec$X x", ""),
+    (1, "doas$IFS x", ""),
+    (1, "pke${X}xec x", ""),
+    (1, "pke$()xec x", ""),
+    (1, "do${X}as x", ""),
+    (1, "sud${X}o apt update", ""),
+    (1, "sud$X'o' apt update", ""),
+    (1, "pk${X}exec x", ""),
+    (1, "sud${X:+q}o x", ""),
+    (1, "sud${X#q}o x", ""),
+    (1, "sud$@o x", ""),
+    (1, "sud$(:)o x", ""),
+    (1, "sud`:`o x", ""),
+    (1, '"sud${X}o" x', ""),
+    (1, "${X:-su}do x", ""),
+    (1, "${A:-su}${B:+x}do x", ""),
+    (1, "sud${X:-${Y:-}}o x", ""),
+    (1, "run$((0)) x", ""),
+    (127, "sud${X}o x", ""),
+    # A word with more expansions than the classifier enumerates counts as privileged.
+    (1, "echo {1..100000}", ""),
+    (1, "s x", "alias s='sudo'\n"),
+    (1, "s x", "alias s='s{u,}do'\n"),
+    (1, "s x", "alias s='t -n'\nalias t='sudo'\n"),
+    # Any word matches, on purpose: over-matching is the safe direction.
+    (16, "man sudo", ""),
+    (1, "echo sudo", ""),
+    (1, "machinectl status", ""),
+]
+
+
+@pytest.mark.parametrize(
+    "status, command, aliases", PRIVILEGED, ids=[row[1] for row in PRIVILEGED]
+)
+def test_privileged_failure(bin_dir, status, command, aliases):
+    from nl_shell.failure_classes import PRIVILEGE_MESSAGE
+
+    failure = classify(status, command, bin_dir, aliases=aliases)
+    check(failure, "PRIVILEGE", False, False)
+    assert failure.packages == ()
+    assert failure.command_word is None
+    # One fixed message, whatever ran and however it failed.
+    assert failure.message == PRIVILEGE_MESSAGE
+
+
+def test_privilege_message_is_neutral():
+    from nl_shell.failure_classes import PRIVILEGE_MESSAGE
+
+    lowered = PRIVILEGE_MESSAGE.lower()
+    for phrase in (
+        "password",
+        "authoriz",
+        "permission",
+        "sudo",
+        "try again",
+        "re-run",
+        "rerun",
+        "run it again",
+        "retry",
+    ):
+        assert phrase not in lowered, phrase
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "echo sudo-ish",
+        "pseudo x",
+        "sudoers-check x",
+        "visudo x",
+        "${X:-pseudo} x",
+        "$'visudo' x",
+        "ls *",
+        "ls *.txt",
+        "awk '{print $1}' f",
+        "echo {a,b}{c,d}",
+        "for i in {1..100}; do echo $i; done",
+        "git log --format=%H",
+        "echo $HOME/s",
+        "pseud${X}o x",
+    ],
+)
+def test_lookalike_is_not_privilege(bin_dir, command):
+    check(classify(1, command, bin_dir), "OTHER", True, True)
+
+
+def test_alias_value_is_only_read_when_its_name_is_a_word(bin_dir):
