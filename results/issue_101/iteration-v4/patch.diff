index 0000000..c47cd76
--- /dev/null
+++ b/src/nl_shell/session.py
@@ -0,0 +1,829 @@
+"""The persistent bash session: one interactive bash on a PTY, driven by pty-protocol v1.
+
+``Session.start()`` runs ``bash --noprofile --rcfile <rcfile> -i`` on a PTY (ptyprocess,
+ADR-0021 §2) with the write end of a pipe as fd 3, the control channel, and the read end
+of a second pipe as fd 4, the check-point channel (spec
+``docs/design/specs/pty-protocol/v1.md`` §1.1, ADR-0014 Decision 1). ``Session.run()``
+sends one confirmed command as a bracketed paste (§5) and returns its exit status,
+``PIPESTATUS``, the PTY output between its start and done records and the snapshot that
+followed. Start, completion and status come only from control-channel records
+(``pty_protocol``) and from the outside checks below, never from text on the PTY.
+
+Outside checks (§3): nl-shell reads, from outside bash, the PTY's terminal settings
+(``termios`` through the master), the files behind bash's fds 0-4 and bash's process state
+(``/proc``). It does so at every snapshot's check point (bash waits in its hook after
+``E`` until nl-shell has looked) and again immediately before every paste. Any
+difference from the baseline degrades the session.
+
+Any protocol violation puts the session in degraded mode (§4.2) with a reason. It stays
+there until ``restart()``, and while degraded nothing more is written to the PTY: ``run``
+raises (§4.3). No real terminal is attached here: terminal ownership (§6) and wiring into
+the REPL are later work. The outside checks read Linux ``/proc``.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import fcntl
+import os
+import platform
+import select
+import shutil
+import tempfile
+import termios
+import time
+from typing import Callable
+
+import ptyprocess
+
+from nl_shell.pty_protocol import (
+    PASTE_END,
+    PASTE_START,
+    CommandRefused,
+    Done,
+    Phase,
+    ProtocolTracker,
+    Snapshot,
+    check_command,
+)
+
+__all__ = [
+    "CommandRefused",
+    "CommandResult",
+    "HOOK_STATE_VARS",
+    "RCFILE",
+    "Session",
+    "SessionDegraded",
+    "SessionError",
+    "SessionTimeout",
+    "Snapshot",
+]
+
+# Every shell name the rcfile's hooks read or write, variables and functions alike. The
+# hooks use no other variable of their own (no `local`: a readonly global of the same name
+# would make `local` fail), and H reports whether each of these names is a variable and
+# with which attributes, so a confirmed `readonly`, `declare -n`, `declare -i` or a new
+# variable under one of these names changes H at that command's snapshot.
+HOOK_STATE_VARS = (
+    "__nls_ack",
+    "__nls_c",
+    "__nls_done",
+    "__nls_ea",
+    "__nls_enc",
+    "__nls_n",
+    "__nls_ps",
+    "__nls_ret",
+    "__nls_seq",
+    "__nls_snap",
+    "__nls_st",
+    "__nls_user_pc",
+    "__nls_v",
+    "__nls_x",
+)
+
+# The pager and loader variables of policy-gate v1 §7.5, reported in V.
+_V_VARS = (
+    "PAGER MANPAGER SYSTEMD_PAGER GIT_PAGER LESSOPEN LESSCLOSE LD_PRELOAD LD_LIBRARY_PATH"
+    " BASH_ENV ENV"
+)
+
+# The rcfile: the spec's reference (§1.3). How it keeps the invariants of brief #101:
+# - S is written by PS0 for every line bash reads, with no guard variable: whether it is
+#   sent depends only on PS0 and `promptvars`, both in H (I2). The tracker accepts a
+#   repeated `S n+1` before `D n+1`.
+# - order at every prompt: `__nls_done` writes D, runs the user's PROMPT_COMMAND and sets
+#   PS1/PS2 to fixed values; then PROMPT_COMMAND lists the traps at its top level (bash
+#   hides DEBUG, RETURN and ERR traps inside a function, and a DEBUG trap runs before the
+#   arguments are expanded, so it can't hide itself) and passes them to `__nls_snap`,
+#   which writes the snapshot and E. So everything that runs at prompt time runs before
+#   the snapshot, and the snapshot sees what it did (I3); no user prompt string is ever
+#   expanded (spec §1.2). xtrace is off from the start of the hook to its last command,
+#   so PS4 is not expanded after the snapshot either.
+# - after E the hook waits on fd 4 (`read -t`) until nl-shell has run the outside checks
+#   and answered. bash is then still in the hook, so the terminal settings are the ones
+#   the next command will run with, not readline's (which forces ISIG on, for one).
+# - H is the exact text of: `declare -p` of PROMPT_COMMAND, PS0, PS1, PS2 and the saved
+#   user hook; the attributes (or absence) of every name in HOOK_STATE_VARS; the
+#   DEBUG/RETURN traps; extdebug and promptvars; functrace, history expansion and the
+#   emacs/vi line-editing mode; every readline variable (`bind -v`); every key binding of
+#   the emacs, vi-insert and vi-command keymaps (functions, macros and `bind -x`
+#   commands); and the hook functions. It is compared with the baseline exactly (§4.2).
+# - V is the `declare -p` text of the pager and loader variables (policy-gate §7.5).
+# - the hooks call no external program, only bash builtins (through `builtin`) and
+#   parameter expansion, so a `hash -p`, `BASH_CMDS` entry or `PATH` change cannot replace
+#   part of them. Every free-text field goes through `__nls_enc` (§2): `\` → `\\`, LF →
+#   `\n`, CR → `\r`. `\\n` in PS0: bash decodes prompt escapes first and would turn `\n`
+#   into CR LF.
+# - they are defined with alias expansion off, and are safe under `set -u` and `set -e`.
+# - this stops accidental and indirect changes. It does not stop confirmed code that sets
+#   out to replace the hooks (a function named `builtin`, `enable -f`): see the threat
+#   model's Known gaps.
+RCFILE = (
+    r"""# nl-shell session rcfile (pty-protocol v1 §1.3). Written by nl-shell; do not edit.
+[ -f ~/.bashrc ] && . ~/.bashrc
+set +H
+unset HISTFILE
+[[ -o emacs || -o vi ]] || set -o emacs
+bind 'set enable-bracketed-paste on' 2>/dev/null
+shopt -s promptvars
+__nls_ea=$(shopt -p expand_aliases); shopt -u expand_aliases
+__nls_user_pc=()
+if declare -p PROMPT_COMMAND >/dev/null 2>&1; then __nls_user_pc=("${PROMPT_COMMAND[@]}"); fi
+__nls_seq=-1 __nls_ack=
+PS0='$(builtin printf "S %s\\n" "$((__nls_seq + 1))" >&3)'
+__nls_ret() { return "$1"; }
+__nls_enc() {
+  __nls_v=$2
+  __nls_v=${__nls_v//'\'/'\\'}
+  __nls_v=${__nls_v//$'\n'/'\n'}
+  __nls_v=${__nls_v//$'\r'/'\r'}
+  builtin printf '%s %s\n' "$1" "$__nls_v" >&3
+}
+__nls_done() {
+  __nls_st=$? __nls_ps=("${PIPESTATUS[@]}") __nls_x=0
+  if [[ -o xtrace ]]; then __nls_x=1; builtin set +x; fi
+  __nls_seq=$((__nls_seq + 1))
+  builtin printf -v __nls_v ' %s' "${__nls_ps[@]}"
+  builtin printf 'D %s %s%s\n' "$__nls_seq" "$__nls_st" "$__nls_v" >&3
+  for __nls_c in "${__nls_user_pc[@]}"; do
+    if __nls_ret "$__nls_st"; then builtin eval "$__nls_c"; else builtin eval "$__nls_c"; fi
+  done
+  if [[ -o xtrace ]]; then __nls_x=1; builtin set +x; fi
+  PS1='\$ ' PS2='> '
+}
+__nls_snap() {
+  __nls_enc F "$(builtin compgen -A function)"
+  __nls_enc L "$(builtin alias -p)"
+  __nls_enc T "$1"
+  __nls_enc B "$(builtin enable -n)"
+  __nls_enc X "$(builtin shopt -p extdebug)"
+  __nls_enc P "${PATH-}"
+  __nls_v=$(builtin jobs -ps) __nls_n=0
+  if [[ -n $__nls_v ]]; then __nls_c=${__nls_v//[!$'\n']/}; __nls_n=$((${#__nls_c} + 1)); fi
+  builtin printf 'J %s\n' "$__nls_n" >&3
+  __nls_enc H "$( {
+    builtin declare -p PROMPT_COMMAND PS0 PS1 PS2 __nls_user_pc
+    for __nls_c in """
+    + " ".join(HOOK_STATE_VARS)
+    + r"""; do
+      if __nls_v=$(builtin declare -p "$__nls_c" 2>/dev/null); then
+        builtin printf '%s\n' "${__nls_v%%=*}"
+      else
+        builtin printf '%s unset\n' "$__nls_c"
+      fi
+    done
+    builtin printf 'traps %s\n' "$2"
+    builtin shopt -p extdebug promptvars
+    for __nls_c in functrace histexpand emacs vi; do
+      __nls_v=off
+      if [[ -o $__nls_c ]]; then __nls_v=on; fi
+      builtin printf '%s %s\n' "$__nls_c" "$__nls_v"
+    done
