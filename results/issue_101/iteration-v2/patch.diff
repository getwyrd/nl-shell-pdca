@@ -0,0 +1,557 @@
+"""The persistent bash session: one interactive bash on a PTY, driven by pty-protocol v1.
+
+``Session.start()`` runs ``bash --noprofile --rcfile <rcfile> -i`` on a PTY (ptyprocess,
+ADR-0021 §2) with the write end of a pipe as fd 3, the control channel (spec
+``docs/design/specs/pty-protocol/v1.md`` §1.1, ADR-0014 Decision 1). ``Session.run()``
+sends one confirmed command as a bracketed paste (§5) and returns its exit status,
+``PIPESTATUS``, the PTY output between its start and done records and the snapshot that
+followed. Start, completion and status come only from control-channel records
+(``pty_protocol``), never from text on the PTY.
+
+Any protocol violation puts the session in degraded mode (§4.2) with a reason; it stays
+there until ``restart()``. No real terminal is attached here: terminal ownership (§6) and
+wiring into the REPL are later work.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+import select
+import shutil
+import tempfile
+import time
+from typing import Callable
+
+import ptyprocess
+
+from nl_shell.pty_protocol import (
+    PASTE_END,
+    PASTE_START,
+    CommandRefused,
+    Done,
+    Phase,
+    ProtocolTracker,
+    Snapshot,
+    check_command,
+)
+
+__all__ = [
+    "CommandRefused",
+    "CommandResult",
+    "RCFILE",
+    "Session",
+    "SessionDegraded",
+    "SessionError",
+    "SessionTimeout",
+    "Snapshot",
+]
+
+# The rcfile: the spec's reference (§1.3) with the v1 snapshot records (§3). The hooks call
+# no external program, only bash builtins and parameter expansion, so a `hash -p`,
+# `BASH_CMDS` entry or `PATH` change cannot replace part of them.
+# - `\\n` in PS0: bash decodes prompt escapes before `printf` sees the format, and turns
+#   `\n` into CR LF, which would put a CR in the record.
+# - PS0 writes `S` once per command: bash expands PS0 again for every line of a
+#   multi-line command. The `$(...)` runs in a subshell, but the `${__nls_once[...]}`
+#   subscript is evaluated by the shell itself and records which number has started.
+# - every free-text field goes through `__nls_enc` (§2): `\` → `\\`, LF → `\n`,
+#   CR → `\r`, so no session state can put a line break into a record.
+# - H is the `declare -p` text of PROMPT_COMMAND (every element) and PS0, the
+#   `promptvars` setting PS0 depends on, the saved user hook, the hooks' state variables
+#   (`__nls_once`, `__nls_ps0` in full; `__nls_seq`, `__nls_started` without their
+#   changing values, so only their attributes count), readline's bracketed-paste setting
+#   and whether line editing is on (§5.1 and the output capture need both) and the hook
+#   functions. It is compared with the baseline exactly (§4.2).
+# - V is the `declare -p` text of the pager and loader variables (policy-gate §7.5).
+# - the hooks are defined with alias expansion off, so a user alias does not change
+#   them. They call `printf`, `unset`, `declare` and the other builtins they use through
+#   `builtin`, so a function with one of those names does not change them; `local` and
+#   `return` are called bare (bash refuses `builtin local` with an array assignment), so
+#   a function named `local` or `return` does. Neither this nor anything else here stops
+#   confirmed code that sets out to replace the hooks (a function named `builtin`,
+#   `enable -f`): see the threat model's Known gaps.
+# - `readonly -f` makes an accidental redefinition of a hook fail; it is not a defence.
+# - every expansion in the hooks is safe under `set -u` (`${PATH-}`), so a confirmed
+#   `set -u` cannot cut a snapshot short.
+# - bracketed paste is forced on after ~/.bashrc (§5.1 needs it), and `promptvars` on.
+# - the user's PROMPT_COMMAND (string or array) runs after nl-shell's hook and sees the
+#   command's real `$?`.
+RCFILE = r"""# nl-shell session rcfile (pty-protocol v1 §1.3). Written by nl-shell; do not edit.
+[ -f ~/.bashrc ] && . ~/.bashrc
+set +H
+unset HISTFILE
+bind 'set enable-bracketed-paste on' 2>/dev/null
+shopt -s promptvars
+__nls_ea=$(shopt -p expand_aliases); shopt -u expand_aliases
+__nls_user_pc=("${PROMPT_COMMAND[@]}")
+__nls_seq=0 __nls_started=0
+__nls_once=()
+unset __nls_ps0
+PS0='$( [[ ${__nls_ps0-} == "$__nls_seq" ]] || builtin printf "S %s\\n" "$((__nls_seq + 1))" >&3 )${__nls_once[__nls_ps0=__nls_seq]-}'
+__nls_ret() { return "$1"; }
+__nls_enc() {
+  local v=$2 b='\' n=$'\n' r=$'\r'
+  v=${v//"$b"/"$b$b"}
+  v=${v//"$n"/"${b}n"}
+  v=${v//"$r"/"${b}r"}
+  builtin printf '%s %s\n' "$1" "$v" >&3
+}
+__nls_done() {
+  local st=$? ps=("${PIPESTATUS[@]}") v c n=0
+  if (( __nls_started )); then (( ++__nls_seq )); fi
+  builtin unset __nls_ps0
+  builtin printf -v v ' %s' "${ps[@]}"
+  builtin printf 'D %s %s%s\n' "$__nls_seq" "$st" "$v" >&3
+  __nls_enc F "$(builtin compgen -A function)"
+  __nls_enc L "$(builtin alias -p)"
+  __nls_enc T "$(builtin trap -p)"
+  __nls_enc B "$(builtin enable -n)"
+  __nls_enc X "$(builtin shopt -p extdebug)"
+  __nls_enc P "${PATH-}"
+  v=$(builtin jobs -ps)
+  if [[ -n $v ]]; then c=${v//[!$'\n']/}; n=$(( ${#c} + 1 )); fi
+  builtin printf 'J %s\n' "$n" >&3
+  __nls_enc H "$( { builtin declare -p PROMPT_COMMAND PS0 __nls_user_pc __nls_once __nls_ps0
+    for c in __nls_seq __nls_started; do
+      v=$(builtin declare -p "$c" 2>&1); builtin printf '%s\n' "${v%%=*}"
+    done
+    builtin shopt -p promptvars
+    v=$(builtin bind -v 2>&1); v=${v#*'set enable-bracketed-paste '}
+    builtin printf 'enable-bracketed-paste %s\n' "${v%%[!a-z]*}"
+    if [[ -o emacs || -o vi ]]; then builtin printf 'line editing on\n'; fi
+    builtin declare -f __nls_done __nls_enc __nls_ret; } 2>&1 )"
+  __nls_enc V "$(builtin declare -p PAGER MANPAGER SYSTEMD_PAGER GIT_PAGER \
+    LESSOPEN LESSCLOSE LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV 2>&1)"
+  builtin printf 'E\n' >&3
+  for c in "${__nls_user_pc[@]}"; do __nls_ret "$st"; builtin eval "$c"; done
+  return "$st"
+}
+PROMPT_COMMAND='__nls_done; __nls_started=1'
+builtin readonly -f __nls_done __nls_enc __nls_ret
+builtin readonly __nls_user_pc
+builtin eval "$__nls_ea"; unset __nls_ea
+"""
+
+# Readline writes this when it hands a finished line to bash (it turns bracketed paste
+# mode off), just before PS0 and the command run. PTY output after it belongs to the
+# command; before it is readline's echo of the paste.
+_LINE_ACCEPTED = b"\x1b[?2004l"
+
+# Captured output kept per command; past this only the tail is kept and
+# ``output_truncated`` is set.
+MAX_OUTPUT = 1 << 20
+
+# §4.2 third trigger: how long the PTY's foreground process group must have been bash's
+# own, with no `D` for the command, before the session is degraded.
+PROMPT_GRACE = 1.0
+
+_POLL = 0.05
+
+
+class SessionError(Exception):
+    """The session cannot do what was asked."""
+
+
+class SessionDegraded(SessionError):
+    """The session is in degraded mode (§4.2); ``reason`` says why. Restart it.
+
+    ``result`` is the command's result when the degradation was found only in the
+    snapshot that followed its done record (``H`` changed), else ``None``.
+    """
+
+    def __init__(self, reason: str, result: "CommandResult | None" = None):
+        super().__init__(f"session degraded: {reason}")
+        self.reason = reason
+        self.result = result
+
+
+class SessionTimeout(SessionError, TimeoutError):
+    """The caller's timeout ran out before the done record arrived (the session degrades)."""
+
+
+@dataclasses.dataclass(frozen=True)
+class CommandResult:
+    """One command, as the control channel reported it."""
+
+    seq: int
+    ran: bool  # False: `D` came without `S`, bash read the input but ran nothing (§4.1)
+    status: int  # `$?` from the D record
+    pipestatus: tuple[int, ...]
+    output: bytes  # PTY output between S and D, the tail when truncated
+    output_truncated: bool
+    snapshot: Snapshot
+    variables_changed: bool  # the snapshot's V differs from the baseline's
+
+    @property
+    def text(self) -> str:
+        """``output`` decoded, with the PTY's CR LF turned back into LF."""
+        return self.output.decode("utf-8", "replace").replace("\r\n", "\n")
+
+
+class _Output:
+    """The command's share of the PTY stream: after readline accepted the line, bounded."""
+
+    def __init__(self, limit: int) -> None:
+        self.limit = limit
+        self.data = bytearray()
+        self.truncated = False
+        self._accepted = False
+        self._skip_cr = False
+        self._window = b""
+
+    @property
+    def delimited(self) -> bool:
+        """Readline's end-of-paste marker was seen, so ``data`` is the command's output."""
+        return self._accepted
+
+    def feed(self, chunk: bytes) -> None:
+        if not self._accepted:
+            buf = self._window + chunk
+            pos = buf.find(_LINE_ACCEPTED)
+            if pos < 0:
+                self._window = buf[-(len(_LINE_ACCEPTED) - 1) :]
+                return
+            self._accepted = True
+            self._skip_cr = True
+            chunk = buf[pos + len(_LINE_ACCEPTED) :]
+        if self._skip_cr and chunk:
+            # readline moves to column 0 after the accepted line; that CR isn't output.
+            self._skip_cr = False
+            if chunk[:1] == b"\r":
+                chunk = chunk[1:]
+        self.data += chunk
+        excess = len(self.data) - self.limit
+        if excess > 0:
+            del self.data[:excess]
+            self.truncated = True
+
+
+class Session:
+    """One long-lived interactive bash on a PTY with nl-shell's control channel on fd 3."""
+
+    def __init__(
+        self,
+        *,
+        env: dict[str, str] | None = None,
+        cwd: str | None = None,
+        dimensions: tuple[int, int] = (24, 80),
+        on_record: Callable[[bytes], None] | None = None,
+        max_output: int = MAX_OUTPUT,
+    ):
+        """Prefer :meth:`start`. ``on_record`` sees every control record, ``\\n`` included."""
+        if max_output < 1:
+            raise ValueError("max_output must be at least 1")
+        self.max_output = max_output
+        self._env = dict(os.environ if env is None else env)
+        if self._env.get("TERM", "dumb") == "dumb":
+            # Readline turns bracketed paste off on a dumb terminal (§5.1 needs it).
+            self._env["TERM"] = "xterm-256color"
+        self._cwd = cwd
+        self._dimensions = dimensions
+        self._on_record = on_record
+        self._proc: ptyprocess.PtyProcess | None = None
+        self._ctl: int | None = None
+        self._ctl_open = False
+        self._rcdir: str | None = None
+        self._tracker = ProtocolTracker(on_record)
+
+    # ----- lifecycle -------------------------------------------------------------
+
+    @classmethod
+    def start(cls, *, timeout: float = 10.0, **kwargs) -> "Session":
+        """Start bash and wait for the baseline snapshot (§1, §3)."""
+        session = cls(**kwargs)
+        try:
+            session._spawn(timeout)
+        except BaseException:
+            session.close()
+            raise
+        return session
+
+    def restart(self, timeout: float = 10.0) -> None:
+        """Replace bash with a fresh one and a fresh baseline; clears degraded mode."""
+        self.close()
+        self._tracker = ProtocolTracker(self._on_record)
+        try:
+            self._spawn(timeout)
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self) -> None:
+        """End bash (and its jobs, via SIGHUP) and release every descriptor."""
+        proc, self._proc = self._proc, None
+        if proc is not None:
+            try:
+                proc.close(force=True)
+            except Exception:
+                pass
+        if self._ctl is not None:
+            os.close(self._ctl)
+            self._ctl = None
+            self._ctl_open = False
+        self._remove_rcfile()
+
+    def __enter__(self) -> "Session":
+        return self
+
+    def __exit__(self, *exc) -> None:
+        self.close()
+
+    def _spawn(self, timeout: float) -> None:
+        self._rcdir = tempfile.mkdtemp(prefix="nl-shell-session-")
+        rcfile = os.path.join(self._rcdir, "rc.bash")
+        with open(rcfile, "w", encoding="utf-8") as fh:
+            fh.write(RCFILE)
+        read_end, write_end = os.pipe()
+
+        def control_channel_on_fd3() -> None:  # runs in the child, after fork
+            if write_end != 3:
+                os.dup2(write_end, 3)  # the copy on fd 3 is inheritable
+                os.close(write_end)
+            else:
+                os.set_inheritable(3, True)
+
+        try:
+            self._proc = ptyprocess.PtyProcess.spawn(
+                ["bash", "--noprofile", "--rcfile", rcfile, "-i"],
+                cwd=self._cwd,
+                env=self._env,
+                dimensions=self._dimensions,
+                pass_fds=(write_end,),
+                preexec_fn=control_channel_on_fd3,
+            )
+        except BaseException:
+            os.close(read_end)
+            raise
+        finally:
+            os.close(write_end)  # only bash (and what it starts) holds the write end
+        self._ctl, self._ctl_open = read_end, True
+
+        deadline = time.monotonic() + timeout
+        while self._tracker.phase in (Phase.BASELINE, Phase.SNAPSHOT):
+            if time.monotonic() > deadline:
+                raise SessionTimeout("bash did not report its first snapshot in time")
+            ready = _select([self._proc.fd, self._ctl], _POLL)
+            if self._proc.fd in ready:
+                self._read_pty()  # start-up output and the first prompt: not kept
+            if self._ctl in ready:
+                self._read_control()
+            if self._tracker.degraded:
+                raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+        self._remove_rcfile()  # bash has read it
+
+    def _remove_rcfile(self) -> None:
+        if self._rcdir is not None:
+            shutil.rmtree(self._rcdir, ignore_errors=True)
+            self._rcdir = None
+
+    # ----- state -----------------------------------------------------------------
+
+    @property
+    def pid(self) -> int | None:
+        return self._proc.pid if self._proc is not None else None
+
+    @property
+    def degraded(self) -> bool:
+        return self._tracker.degraded
+
+    @property
+    def degraded_reason(self) -> str | None:
+        return self._tracker.degraded_reason
+
+    @property
+    def baseline(self) -> Snapshot | None:
+        return self._tracker.baseline
+
+    @property
+    def snapshot(self) -> Snapshot | None:
+        return self._tracker.snapshot
+
+    # ----- running a command -------------------------------------------------------
+
+    def interrupt(self) -> bool:
+        """Write Ctrl-C (``\\x03``) to the PTY; its line discipline signals the foreground job.
+
+        Only while a command runs (its ``S`` has arrived, its ``D`` has not); otherwise
+        nothing is written and ``False`` is returned. At a prompt Ctrl-C makes bash run
+        its prompt hook again, and the unrequested ``D`` would degrade the session (§4.2).
+        A Ctrl-C written just as the command ends can still land in the hook or at the
+        prompt; the session then degrades (it fails closed, it never misreports).
+        """
+        if self._proc is None:
+            raise SessionError("the session is closed")
+        if self._tracker.phase is not Phase.RUNNING:
+            return False
+        _write_all(self._proc.fd, b"\x03")
+        return True
+
+    def run(self, command: str | bytes, *, timeout: float | None = None) -> CommandResult:
+        """Send one confirmed command (§5) and wait for its done record and snapshot.
+
+        Raises :class:`CommandRefused` (nothing is written), :class:`SessionDegraded`, or
+        :class:`SessionTimeout` (which also degrades the session: the command may still
+        be running).
+        """
+        data = check_command(command)
+        if self._proc is None:
+            raise SessionError("the session is closed")
+        if self._tracker.degraded:
+            raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+
+        self._drain_pty()  # the last prompt and any job notices: not this command's
+        # A record that arrived after the last E is out of order; the session must
+        # degrade before bash gets the next command (§4.2).
+        self._drain_control()
+        if self._tracker.degraded:
+            raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+        self._tracker.command_sent()
+        _write_all(self._proc.fd, PASTE_START + data + PASTE_END + b"\r")
+        return self._wait_for_result(timeout)
+
+    def _wait_for_result(self, timeout: float | None) -> CommandResult:
+        assert self._proc is not None and self._ctl is not None
+        fd = self._proc.fd
+        deadline = None if timeout is None else time.monotonic() + timeout
+        output = _Output(self.max_output)
+        done: Done | None = None
+        finished: Snapshot | None = None
+        bash_since: float | None = None  # bash has held the foreground since then
+
+        while True:
+            watch = [fd, self._ctl] if self._ctl_open else [fd]
+            ready = _select(watch, _POLL)
+            # PTY output first, so whatever was printed before a D record read in the same
+            # round counts as this command's.
+            if fd in ready:
+                chunk = self._read_pty()
+                if done is None:
+                    output.feed(chunk)
+            if self._ctl_open and self._ctl in ready:
+                for kind, value in self._read_control():
+                    if kind == "D" and done is None:
+                        # The command's output was written before bash wrote D.
+                        for chunk in self._drain_pty():
+                            output.feed(chunk)
+                        done = value  # type: ignore[assignment]
+                        if self._tracker.started and not output.delimited:
+                            # Readline never ended a bracketed paste (it is off, or TERM
+                            # changed), so which bytes are the command's is unknown.
+                            # Reporting empty output for a command that ran would lie.
+                            self._tracker.degrade(
+                                "the command's output could not be delimited"
+                                " (readline did not end a bracketed paste)"
+                            )
+                    elif kind == "E":
+                        finished = value  # type: ignore[assignment]
+                if finished is not None:
+                    self._drain_control()  # a record after E degrades, checked below
+
+            if self._tracker.degraded:
+                result = None
+                snapshot = self._tracker.snapshot
+                if done is not None and snapshot is not None and snapshot.seq == done.seq:
+                    result = self._result(done, snapshot, output)
+                raise SessionDegraded(self._tracker.degraded_reason or "unknown", result)
+            if finished is not None:
+                assert done is not None
+                return self._result(done, finished, output)
+
+            now = time.monotonic()
+            # Until E: a snapshot cut short after D (§4.2 first trigger, "a record is
+            # missing") leaves bash at its prompt just like a lost D does.
+            if self._bash_in_foreground():
+                if bash_since is None:
+                    bash_since = now
+                elif now - bash_since >= PROMPT_GRACE:
+                    self._tracker.degrade(
+                        "no done record after the shell returned to a prompt"
+                        if done is None
+                        else "the snapshot did not finish after the shell returned to a prompt"
+                    )
+                    raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+            else:
+                bash_since = None
+            if deadline is not None and now > deadline:
+                self._tracker.degrade("no done record within the caller's timeout")
+                raise SessionTimeout(f"command did not finish within {timeout} s")
+
+    def _result(self, done: Done, snapshot: Snapshot, output: _Output) -> CommandResult:
+        baseline = self._tracker.baseline
+        assert baseline is not None
+        return CommandResult(
+            seq=done.seq,
+            ran=self._tracker.started,
+            status=done.status,
+            pipestatus=done.pipestatus,
+            output=bytes(output.data) if self._tracker.started else b"",
+            output_truncated=output.truncated and self._tracker.started,
+            snapshot=snapshot,
+            variables_changed=snapshot.variables != baseline.variables,
+        )
+
+    # ----- helpers -----------------------------------------------------------------
+
+    def _bash_in_foreground(self) -> bool:
+        """The PTY's foreground process group is bash's own (§4.2 third trigger).
+
+        It is while bash reads input (its prompt, PS2) or runs a builtin; it is the
+        command's group while an external command runs.
+        """
+        assert self._proc is not None
+        try:
+            return os.tcgetpgrp(self._proc.fd) == self._proc.pid
+        except OSError:
+            return False
+
+    def _read_pty(self) -> bytes:
+        assert self._proc is not None
+        try:
+            chunk = os.read(self._proc.fd, 65536)
+        except OSError:
+            chunk = b""  # EIO: bash has exited and the slave side is gone
+        if not chunk:
+            self._tracker.degrade("the shell exited")
+        return chunk
+
+    def _drain_pty(self) -> list[bytes]:
+        """Read what the PTY holds right now, without waiting for more."""
+        assert self._proc is not None
+        chunks = []
+        while not self._tracker.degraded and _select([self._proc.fd], 0):
+            chunk = self._read_pty()
+            if not chunk:
+                break
+            chunks.append(chunk)
+        return chunks
+
+    def _drain_control(self) -> None:
+        """Feed the tracker whatever the control channel holds right now."""
+        while self._ctl_open and not self._tracker.degraded and _select([self._ctl], 0):
+            self._read_control()
+
+    def _read_control(self) -> list[tuple[str, object]]:
+        assert self._ctl is not None
+        data = os.read(self._ctl, 65536)
+        if not data:
+            self._ctl_open = False
+            self._tracker.eof()
+            return []
+        return self._tracker.feed(data)
+
+
+def _select(fds: list[int], timeout: float) -> list[int]:
+    ready, _, _ = select.select(fds, [], [], timeout)
+    return ready
+
+
+def _write_all(fd: int, data: bytes) -> None:
+    view = memoryview(data)
+    while view:
+        try:
+            written = os.write(fd, view)
+        except BlockingIOError:
+            select.select([], [fd], [], _POLL)
+            continue
+        view = view[written:]
