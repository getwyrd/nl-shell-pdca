+def test_bashrc_alias_and_prompt_command_are_kept(start_session):
+    _write_bashrc(
+        "alias hello_nls='echo hi'\n"
+        'PROMPT_COMMAND=\'echo "$__nls_seq $?" >> ~/pc.log\'\n'
+    )
+    session, _ = start_session()
+    assert "alias hello_nls='echo hi'" in session.baseline.aliases.split("\n")
+    _run(session, "true")
+    _run(session, "(exit 4)")
+    _run(session, "true")  # the previous prompt's user hook has run by now
+    log = os.path.join(os.environ["HOME"], "pc.log")
+    with open(log, encoding="utf-8") as fh:
+        seen = fh.read().split("\n")
+    # It runs at every prompt, after nl-shell's hook advanced the sequence number, and
+    # sees the command's real $?.
+    assert seen[:3] == ["0 0", "1 0", "2 4"]
+    assert not session.degraded
