+def test_bracketed_paste_off_between_snapshots_degrades(start_session):
+    # The user's PROMPT_COMMAND runs after the snapshot, so H can't see what it does to
+    # the next command; the missing end-of-paste marker must still degrade.
+    _write_bashrc("PROMPT_COMMAND='bind \"set enable-bracketed-paste off\"'\n")
+    session_mod = _session_module()
+    session, _ = start_session()
+    with pytest.raises(session_mod.SessionDegraded):
+        _run(session, "echo hello")
+    assert session.degraded_reason == (
+        "the command's output could not be delimited (readline did not end a bracketed paste)"
+    )
