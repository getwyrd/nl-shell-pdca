+)
+def test_command_turning_bracketed_paste_off_degrades(start_session, change):
+    # Without readline's end-of-paste marker the command's output can't be delimited;
+    # a later `echo hello` must never come back as a healthy result with no output.
+    session_mod = _session_module()
+    session, _ = start_session()
+    with pytest.raises(session_mod.SessionDegraded):
+        _run(session, change)
+    assert "H differs" in session.degraded_reason
+    with pytest.raises(session_mod.SessionDegraded):
+        _run(session, "echo hello")
+
