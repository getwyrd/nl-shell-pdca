@@ -0,0 +1,24 @@
+"""The command layer of the gate: what one simple command means — a stub for now.
+
+Spec ``policy-gate/v1`` §1.4: the per-command rules (§2 operand rules, §3 builtins, §4
+destructive and privileged commands and wrappers, §5 ``sudo`` options and pipes) and the
+allowlist (§6). The shell layer (``nl_shell.gate.parse``) hands every simple command here
+as an ``Invocation``. Until #197 gives commands meaning and #198 brings the allowlist, no
+command is allowlisted, so every one is at least ``mutating``, reason "not allowlisted"
+(decision A's floor: an opaque command is at least ``mutating``).
+"""
+
+from __future__ import annotations
+
+from nl_shell.gate.parse import Budget, Invocation
+from nl_shell.gate.verdict import MUTATING, Verdict
+
+NOT_ALLOWLISTED = "not allowlisted"
+
+
+def classify(invocation: Invocation, budget: Budget) -> Verdict:
+    """The class of one simple command. ``budget`` is the classification's shared work
+    budget, for rules that class inner text (``bash -c``) with ``parse.walk``."""
+    verdict = Verdict()
+    verdict.raise_to(MUTATING, NOT_ALLOWLISTED)
+    return verdict
