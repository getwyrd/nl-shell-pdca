@@ -0,0 +1,133 @@
+"""The policy gate: the class of a command before anything runs (ADR-0013).
+
+``classify`` follows the decision procedure of spec ``policy-gate/v1`` §1. The result is
+the highest class any step produces:
+
+1. §1.1 characters: a character ``nl_shell.render`` hides, or a run of combining marks
+   it caps, rejects a model proposal, as the proposal parser does
+   (``nl_shell.proposal``), and makes typed input at least ``mutating``. The check is
+   ``render.has_hidden``, which looks at quoted text too, so it is stricter than §1.1.
+2. §1.2 parse with the pinned tree-sitter-bash; an ERROR or MISSING node makes the
+   command unparseable, at least ``mutating``.
+3. §1.3 and §1.4: the shell layer (``nl_shell.gate.parse``) walks every node and
+   decides what holds whatever the commands are (prefix assignments, redirections,
+   descriptors, function definitions, assignments to session variables); the command
+   layer (``nl_shell.gate.rules``) classes each simple command.
+4. §1.5 live-session resolution (``nl_shell.gate.live``) for each simple command still
+   ``read-only``; §1.6 sensitive locations (``nl_shell.gate.sensitive``) and mixed-script
+   words (``nl_shell.gate.words``) for every one.
+5. §1.7 the model's label raises the class, never lowers it.
+
+Decision C: when the gate cannot class a command (a node kind with no handler, the work
+budget exceeded, any internal error) the command is ``privileged`` and rejected, reason
+"could not class". ``classify`` never raises.
+
+The gate is not wired to the REPL yet (#78).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from nl_shell import render
+from nl_shell.gate import live, parse, rules, sensitive, words
+from nl_shell.gate.verdict import (
+    CLASSES,
+    DESTRUCTIVE,
+    MUTATING,
+    PRIVILEGED,
+    READ_ONLY,
+    SESSION_ALTERING,
+    Verdict,
+    rank,
+)
+
+__all__ = [
+    "CLASSES",
+    "COULD_NOT_CLASS",
+    "DESTRUCTIVE",
+    "MUTATING",
+    "ORIGINS",
+    "PRIVILEGED",
+    "READ_ONLY",
+    "SESSION_ALTERING",
+    "GateResult",
+    "classify",
+    "rank",
+]
+
+ORIGINS = ("proposal", "typed")
+COULD_NOT_CLASS = "could not class"
+UNPARSEABLE_REASON = "unparseable: the parser found an ERROR or MISSING node"
+NOTHING_CLASSED_REASON = "no simple command was classed"
+
+
+@dataclass(frozen=True)
+class GateResult:
+    """The gate's answer for one command. ``as_log`` is the session-log ``gate`` object
+    (spec ``session-log/v1``)."""
+
+    cls: str
+    reasons: tuple[str, ...]
+    rejected: bool
+
+    def as_log(self) -> dict[str, object]:
+        return {"class": self.cls, "reasons": list(self.reasons), "rejected": self.rejected}
+
+
+def classify(
+    command: str, *, origin: str = "proposal", label: str | None = None
+) -> GateResult:
+    """Class ``command`` (spec ``policy-gate/v1`` §1). Never raises.
+
+    ``origin`` is ``"proposal"`` for a model proposal and ``"typed"`` for the user's own
+    input; ``label`` is the class the model gave its proposal (§1.7)."""
+    try:
+        if origin not in ORIGINS:
+            raise ValueError(f"origin must be one of {ORIGINS}")
+        if label is not None and label not in CLASSES:
+            raise ValueError(f"label must be one of {CLASSES}")
+        verdict = _classify(command, origin)
+        if label is not None and rank(label) > rank(verdict.cls):  # §1.7
+            verdict.raise_to(label, f"the model labelled it {label}")
+    except Exception as error:  # noqa: BLE001 - decision C: never raise, fail closed
+        verdict = Verdict()
+        verdict.raise_to(PRIVILEGED, f"{COULD_NOT_CLASS}: {_describe(error)}")
+        verdict.reject(f"{COULD_NOT_CLASS}: {_describe(error)}")
+    return GateResult(
+        cls=verdict.cls, reasons=tuple(verdict.reasons), rejected=verdict.rejected
+    )
+
+
+def _describe(error: Exception) -> str:
+    if isinstance(error, parse.GateFailure):
+        return str(error)
+    return f"internal error ({type(error).__name__})"
+
+
+def _classify(command: str, origin: str) -> Verdict:
+    """§1.1–§1.6; ``classify`` adds §1.7 and decision C."""
+    total = Verdict()
+    if not isinstance(command, str):
+        raise TypeError("command must be text")
+    if render.has_hidden(command) or render.too_many_marks(command):  # §1.1
+        if origin == "proposal":
+            total.reject("hidden character in a model proposal")
+        else:
+            total.raise_to(MUTATING, "hidden character in typed input")
+    budget = parse.Budget()
+    walked = parse.walk(command, budget)  # §1.2, and the shell layer of §1.3 / §1.4
+    if walked.unparseable:
+        total.raise_to(MUTATING, UNPARSEABLE_REASON)
+    total.merge(walked.findings)
+    for invocation in walked.invocations:
+        verdict = rules.classify(invocation, budget)  # §1.3, §1.4
+        if verdict.cls == READ_ONLY:
+            verdict = live.resolve(invocation, verdict)  # §1.5
+        verdict.merge(sensitive.check(invocation))  # §1.6
+        verdict.merge(words.check(invocation))
+        total.merge(verdict)
+    if not walked.invocations and total.cls == READ_ONLY:
+        # Nothing was classed (empty text, a comment, `a=1`): nothing proved it read-only.
+        total.raise_to(MUTATING, NOTHING_CLASSED_REASON)
+    return total
