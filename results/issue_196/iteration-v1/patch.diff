index 0000000..099a0d1
--- /dev/null
+++ b/src/nl_shell/gate/live.py
@@ -0,0 +1,25 @@
+"""Live-session resolution, spec ``policy-gate/v1`` §7 — a fail-closed stub for now.
+
+The pipeline (``nl_shell.gate.classify``, step §1.5) calls ``resolve`` for every simple
+command still ``read-only`` after §1–§6. Resolving aliases, functions, disabled
+builtins, ``PATH``, traps and the pager and loader variables needs the session snapshot
+(spec ``pty-protocol/v1`` §3); #192 replaces this module. Until then nothing is proved
+read-only: every such command becomes ``mutating``, reason ``STUB_REASON``.
+"""
+
+from __future__ import annotations
+
+from nl_shell.gate.parse import Invocation
+from nl_shell.gate.verdict import MUTATING, READ_ONLY, Verdict
+
+STUB_REASON = "live-session resolution not implemented"
+
+
+def resolve(invocation: Invocation, verdict: Verdict) -> Verdict:
+    """§7 for one simple command and its verdict so far. Returns the new verdict."""
+    result = Verdict(
+        cls=verdict.cls, reasons=list(verdict.reasons), rejected=verdict.rejected
+    )
+    if result.cls == READ_ONLY:
+        result.raise_to(MUTATING, STUB_REASON)
+    return result
diff --git a/src/nl_shell/gate/parse.py b/src/nl_shell/gate/parse.py
new file mode 100644
index 0000000..6781072
--- /dev/null
+++ b/src/nl_shell/gate/parse.py
@@ -0,0 +1,766 @@
+"""The shell layer of the gate: parse with the pinned grammar and walk every node.
+
+Spec ``policy-gate/v1`` §1.2 and §1.4. ``walk`` parses a command with the tree-sitter-bash
+grammar pinned in ``pyproject.toml`` and visits every node of the tree. Each named node
+kind of the grammar has exactly one handler in ``HANDLERS``; a node whose kind has none
+raises ``UnhandledNode``, so syntax the gate does not know fails closed (decision C in
+``nl_shell.gate``). ``grammar_node_kinds`` lists the kinds from the grammar itself, at run
+time, so a test can hold the two together.
+
+One ``Context`` travels the walk: where standard input comes from (``Stdin``), the
+redirections of the statements around the current node, the depth, and the ``Budget``,
+which counts every node visited across the whole classification (a caller that classes
+inner text, such as ``bash -c``, passes the same budget on).
+
+The walker hands each simple command to the command layer (``nl_shell.gate.rules``) as an
+``Invocation``: its words after quote removal, each marked literal or not; its prefix
+assignments; its redirections (its own and those around it); and its standard input.
+``declaration_command`` (``export``, ``declare``, ``typeset``, ``local``, ``readonly``)
+and ``unset_command`` nodes become invocations too, with their keyword as command word.
+
+What the shell layer decides itself (``Walk.findings``), because it holds whatever the
+command is: §2 prefix assignments, output redirections, ``/dev/tcp`` and ``/dev/udp``
+words, a command word that is not a literal or is a path outside the system directories,
+process substitution; §3 function definitions and assignments to the listed variables;
+§5 redirections the gate cannot prove use only descriptors 0-2, and assignments to
+``SUDO_PROMPT`` or ``SUDO_ASKPASS``.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Callable
+from dataclasses import dataclass, field, replace
+from functools import cache
+
+import tree_sitter
+import tree_sitter_bash
+
+from nl_shell.gate.verdict import MUTATING, SESSION_ALTERING, Verdict
+
+_ENCODING = ("utf-8", "surrogatepass")
+
+# The total work of one classification: nodes visited, and how deep the walk may go.
+MAX_WORK = 20_000
+MAX_DEPTH = 150
+
+# Spec Conventions: the system directories.
+SYSTEM_DIRECTORIES = frozenset({"/usr/bin", "/usr/sbin", "/bin", "/sbin"})
+
+# §3: variables an assignment to which alters the session.
+SESSION_VARIABLES = frozenset(
+    {
+        "PATH", "BASH_ENV", "ENV", "CDPATH", "PROMPT_COMMAND",
+        "PS0", "PS1", "PS2", "PS3", "PS4",
+        "IFS", "HISTFILE", "PAGER", "MANPAGER", "SYSTEMD_PAGER", "GIT_PAGER",
+        "LESSOPEN", "LESSCLOSE", "EDITOR", "VISUAL", "BROWSER", "NODE_OPTIONS",
+    }
+)  # fmt: skip
+SESSION_VARIABLE_PREFIXES = ("LD_", "SUDO_", "PYTHON", "PERL5", "GIT_")
+# §5: assigning or exporting these is rejected.
+REJECTED_VARIABLES = frozenset({"SUDO_PROMPT", "SUDO_ASKPASS"})
+
+_NETWORK_PATH = re.compile(r"/dev/(?:tcp|udp)/")
+_GLOB = frozenset("*?[")
+_BRACE = re.compile(r"\{[^{}]*(?:,|\.\.)[^{}]*\}")
+# `{name}>file`: bash's named descriptor. tree-sitter-bash does not give it a node of its
+# own (it is an argument word, or an ERROR), so it is read from the bytes just before
+# the redirection.
+_NAMED_FD = re.compile(rb"\{[A-Za-z_][A-Za-z0-9_]*\}$")
+_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+
+_OUTPUT_OPERATORS = frozenset({">", ">>", ">|", "&>", "&>>", "<>"})
+_DUPLICATE_OPERATORS = frozenset({">&", "<&"})
+_CLOSE_OPERATORS = frozenset({">&-", "<&-"})
+_INPUT_FIRST = ("<",)  # operators that act on descriptor 0 when none is given
+
+
+class GateFailure(Exception):
+    """The walk cannot class the command; ``nl_shell.gate`` fails closed (decision C)."""
+
+
+class UnhandledNode(GateFailure):
+    def __init__(self, kind: str) -> None:
+        super().__init__(f"no handler for node kind {kind!r}")
+        self.kind = kind
+
+
+class BudgetExceeded(GateFailure):
+    pass
+
+
+@dataclass
+class Budget:
+    """Work left for one classification, shared by every walk that is part of it."""
+
+    work: int = MAX_WORK
+    depth: int = MAX_DEPTH
+    used: int = 0
+
+    def spend(self, amount: int = 1) -> None:
+        self.used += amount
+        if self.used > self.work:
+            raise BudgetExceeded(f"work budget exceeded ({self.work} nodes)")
+
+
+@dataclass(frozen=True)
+class Stdin:
+    """Where a simple command's standard input comes from.
+
+    ``source`` is one of ``terminal``, ``pipe``, ``file``, ``heredoc``, ``herestring``,
+    ``descriptor`` (duplicated from another descriptor) or ``closed``. ``text`` is the
+    literal text a here-document or here-string feeds (None when it is not literal), or
+    the file name for ``file`` when it is literal.
+    """
+
+    source: str
+    text: str | None = None
+
+
+TERMINAL = Stdin("terminal")
+PIPE = Stdin("pipe")
+
+
+@dataclass(frozen=True)
+class Word:
+    """One shell word. ``value`` is the word after quote removal (None when an expansion
+    makes it unknowable); ``literal`` is False when the shell would still expand it
+    (an expansion, a substitution, a glob or brace expansion)."""
+
+    text: str
+    value: str | None
+    literal: bool
+
+
+@dataclass(frozen=True)
+class Assignment:
+    """``NAME=value`` or ``NAME+=value``."""
+
+    name: str
+    operator: str
+    value: Word | None
+    text: str
+
+
+@dataclass(frozen=True)
+class Redirect:
+    """One redirection. ``kind`` is ``file``, ``heredoc`` or ``herestring``; ``operator``
+    the operator token; ``descriptor`` the explicit descriptor text, if any;
+    ``target`` the destination word (None for a here-document); ``named_fd`` True for
+    ``{name}>``; ``body`` the literal text a here-document or here-string feeds."""
+
+    kind: str
+    operator: str
+    descriptor: str | None
+    target: Word | None
+    named_fd: bool
+    text: str
+    body: str | None = None
+
+    @property
+    def acts_on(self) -> str:
+        """The descriptor it acts on: the explicit one, or bash's default."""
+        if self.descriptor is not None:
+            return self.descriptor
+        if self.kind != "file" or self.operator.startswith(_INPUT_FIRST):
+            return "0"
+        return "1"
+
+
+@dataclass(frozen=True)
+class Invocation:
+    """One simple command, as the command layer sees it.
+
+    ``kind`` is ``command``, ``declaration`` or ``unset``. ``words`` holds the command
+    word first (the keyword for a declaration or ``unset``); it is empty for a command
+    with no command word. ``assignments`` are the prefix assignments (``VAR=x cmd``);
+    ``redirects`` its own redirections, then those of the statements around it."""
+
+    kind: str
+    text: str
+    words: tuple[Word, ...]
+    assignments: tuple[Assignment, ...]
+    redirects: tuple[Redirect, ...]
+    stdin: Stdin
+
+    @property
+    def command_word(self) -> Word | None:
+        return self.words[0] if self.words else None
+
+
+@dataclass(frozen=True)
+class Context:
+    """What travels the walk."""
+
+    stdin: Stdin
+    redirects: tuple[Redirect, ...]
+    depth: int
+    budget: Budget
+
+    def nested(self, **changes: object) -> Context:
+        return replace(self, **changes)  # type: ignore[arg-type]
+
+
+@dataclass
+class Walk:
+    """The result of walking one command."""
+
+    unparseable: bool
+    invocations: list[Invocation] = field(default_factory=list)
+    findings: Verdict = field(default_factory=Verdict)
+
+
+@cache
+def language() -> tree_sitter.Language:
+    return tree_sitter.Language(tree_sitter_bash.language())
+
+
+@cache
+def _parser() -> tree_sitter.Parser:
+    return tree_sitter.Parser(language())
+
+
+def grammar_node_kinds() -> frozenset[str]:
+    """Every named node kind of the pinned grammar, read from the grammar itself."""
+    lang = language()
+    return frozenset(
+        lang.node_kind_for_id(kind)
+        for kind in range(lang.node_kind_count)
+        if lang.node_kind_is_named(kind) and lang.node_kind_is_visible(kind)
+    )
+
+
+def walk(text: str, budget: Budget | None = None, stdin: Stdin = TERMINAL) -> Walk:
+    """Parse ``text`` and walk every node of it.
+
+    Raises ``GateFailure`` (an unhandled node kind, the budget exceeded); the caller
+    fails closed."""
+    budget = budget if budget is not None else Budget()
+    source = text.encode(*_ENCODING)
+    tree = _parser().parse(source)
+    walker = _Walker(source, Walk(unparseable=tree.root_node.has_error))
+    if _NETWORK_PATH.search(text):
+        walker.result.findings.raise_to(MUTATING, NETWORK_REASON)
+    walker.walk(tree.root_node, Context(stdin, (), 0, budget))
+    return walker.result
+
+
+# -- reasons -------------------------------------------------------------------------------
+
+NETWORK_REASON = "a /dev/tcp or /dev/udp path"
+PROCESS_SUBSTITUTION_REASON = "process substitution"
+DESCRIPTOR_REASON = "a redirection the gate cannot prove uses only descriptors 0-2"
+
+
+# -- words ---------------------------------------------------------------------------------
+
+
+def _text(node: tree_sitter.Node) -> str:
+    """The node's source text. tree-sitter splits bytes it cannot read as UTF-8 (a lone
+    surrogate) into nodes of their own, so a piece that does not decode keeps its bytes
+    as escapes (§1.1 has already flagged such text)."""
+    raw = node.text or b""
+    try:
+        return raw.decode(*_ENCODING)
+    except UnicodeDecodeError:
+        return raw.decode("utf-8", "surrogateescape")
+
+
+def word(node: tree_sitter.Node) -> Word:
+    """The ``Word`` for a word-like node, after quote removal."""
+    value, shape = _evaluate(node)
+    literal = (
+        value is not None
+        and shape is not None
+        and not any(char in _GLOB for char in shape)
+        and not _BRACE.search(shape)
+    )
+    return Word(text=_text(node), value=value, literal=literal)
+
+
+def _literal(text: str) -> Word:
+    return Word(text=text, value=text, literal=True)
+
+
+def _unescape_unquoted(raw: str) -> tuple[str, str]:
+    value, shape = [], []
+    chars = iter(raw)
+    for char in chars:
+        if char == "\\":
+            escaped = next(chars, "")
+            if escaped in ("\n", ""):
+                continue
+            value.append(escaped)
+            shape.append("x")
+        else:
+            value.append(char)
+            shape.append(char)
+    return "".join(value), "".join(shape)
+
+
+def _unescape_double(raw: str) -> str:
+    out = []
+    chars = iter(raw)
+    for char in chars:
+        if char == "\\":
+            escaped = next(chars, "")
+            if escaped == "\n":
+                continue
+            out.append(escaped if escaped in ('"', "\\", "$", "`") else char + escaped)
+        else:
+            out.append(char)
+    return "".join(out)
+
+
+def _evaluate(node: tree_sitter.Node) -> tuple[str | None, str | None]:
+    """(the value after quote removal, its shape with quoted characters as "x"), or
+    (None, None) when an expansion makes the value unknowable."""
+    kind = node.type
+    if kind in ("word", "number"):
+        if node.named_child_count:
+            return None, None
+        return _unescape_unquoted(_text(node))
+    if kind == "command_name":
+        if node.named_child_count != 1:
+            return None, None
+        return _evaluate(node.named_children[0])
+    if kind == "raw_string":
+        inner = _text(node)[1:-1]
+        return inner, "x" * len(inner)
+    if kind == "string":
+        parts = []
+        for child in node.named_children:
+            if child.type != "string_content":
+                return None, None
+            parts.append(_unescape_double(_text(child)))
+        inner = "".join(parts)
+        return inner, "x" * len(inner)
+    if kind == "concatenation":
+        values, shapes = [], []
+        for child in node.children:
+            value, shape = _evaluate(child)
+            if value is None or shape is None:
+                return None, None
+            values.append(value)
+            shapes.append(shape)
+        return "".join(values), "".join(shapes)
+    # $'…', $"…", $x, ${x}, $(…), `…`, $((…)), <(…), and anything else.
+    return None, None
+
+
+def _below_three(text: str) -> bool:
+    """True when ``text`` names descriptor 0, 1 or 2 (ASCII digits, leading zeros allowed).
+    Never converts the number, so a 40-digit descriptor costs nothing."""
+    if not text or not text.isascii() or not text.isdigit():
+        return False
+    return (text.lstrip("0") or "0") in ("0", "1", "2")
+
+
+def _is_zero(text: str) -> bool:
+    return bool(text) and text.isascii() and text.isdigit() and not text.lstrip("0")
+
+
+def _system_command_path(value: str) -> bool:
+    """True when ``value`` names a file directly in a system directory. Repeated slashes
+    collapse, as Linux resolves them (``//usr/bin/rm``); ``.`` and ``..`` never pass."""
+    collapsed = re.sub("/+", "/", value)
+    directory, _, name = collapsed.rpartition("/")
+    parts = collapsed.split("/")
+    if not name or "." in parts or ".." in parts:
+        return False
+    return directory in SYSTEM_DIRECTORIES
+
+
+def is_session_variable(name: str) -> bool:
+    """§3: an assignment to ``name`` alters the session."""
+    return name in SESSION_VARIABLES or name.startswith(SESSION_VARIABLE_PREFIXES)
+
+
+# -- the walker ----------------------------------------------------------------------------
+
+Handler = Callable[["_Walker", tree_sitter.Node, Context], object]
+
+
+class _Walker:
+    def __init__(self, source: bytes, result: Walk) -> None:
+        self.source = source
+        self.result = result
+
+    @property
+    def findings(self) -> Verdict:
+        return self.result.findings
+
+    def walk(
+        self, node: tree_sitter.Node, ctx: Context, handler: Handler | None = None
+    ) -> object:
+        """Visit ``node``: charge the budget, then run its kind's handler (or ``handler``,
+        which a parent uses for a node whose meaning depends on where it sits)."""
+        ctx.budget.spend()
+        depth = ctx.depth + 1
+        if depth > ctx.budget.depth:
+            raise BudgetExceeded(f"nesting deeper than {ctx.budget.depth} nodes")
+        registered = HANDLERS.get(node.type)
+        if registered is None:
+            raise UnhandledNode(node.type)
+        return (handler or registered)(self, node, ctx.nested(depth=depth))
+
+    def children(self, node: tree_sitter.Node, ctx: Context) -> None:
+        for child in node.named_children:
+            self.walk(child, ctx)
+
+    # -- redirections ----------------------------------------------------------------------
+
+    def redirect(self, node: tree_sitter.Node) -> Redirect:
+        descriptor: str | None = None
+        operator = ""
+        target: Word | None = None
+        start: tree_sitter.Node | None = None
+        body: tree_sitter.Node | None = None
+        for index, child in enumerate(node.children):
+            name = node.field_name_for_child(index)
+            if child.type == "file_descriptor" or name == "descriptor":
+                descriptor = _text(child)
+            elif child.type == "heredoc_start":
+                start = child
+            elif child.type == "heredoc_body":
+                body = child
+            elif not child.is_named:
+                operator = operator or _text(child)
+            elif target is None and (
+                name == "destination" or node.type == "herestring_redirect"
+            ):
+                target = word(child)
+        kind = {"heredoc_redirect": "heredoc", "herestring_redirect": "herestring"}.get(
+            node.type, "file"
+        )
+        text: str | None = None
+        if kind == "herestring" and target is not None and target.literal:
+            text = f"{target.value}\n"
+        elif kind == "heredoc":
+            text = _heredoc_text(start, body, strip_tabs=operator == "<<-")
+        named_fd = descriptor is None and bool(
+            _NAMED_FD.search(self.source[: node.start_byte])
+        )
+        return Redirect(
+            kind=kind,
+            operator=operator,
+            descriptor=descriptor,
+            target=None if kind == "heredoc" else target,
+            named_fd=named_fd,
+            text=_text(node),
+            body=text,
+        )
+
+    def check_redirect(self, redirect: Redirect) -> None:
+        """§2 output redirections and ``/dev/tcp``, §5 descriptors."""
+        findings = self.findings
+        target = redirect.target
+        if redirect.named_fd:
+            findings.reject(f"{DESCRIPTOR_REASON}: a named descriptor in {redirect.text!r}")
+        if redirect.descriptor is not None and not _below_three(redirect.descriptor):
+            findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+        if target is not None and target.value is not None:
+            if _NETWORK_PATH.search(target.value):
+                findings.raise_to(MUTATING, NETWORK_REASON)
+        op = redirect.operator
+        if op in _DUPLICATE_OPERATORS:
+            if target is None or not target.literal or target.value is None:
+                findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+            elif target.value.isascii() and target.value.isdigit():
+                if not _below_three(target.value):
+                    findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+            elif target.value == "-":
+                pass
+            elif op == ">&":
+                # `>&file` is `&>file`: both output descriptors go to a file.
+                self._output(redirect, target)
+            else:
+                findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+        elif op in _OUTPUT_OPERATORS:
+            self._output(redirect, target)
+
+    def _output(self, redirect: Redirect, target: Word | None) -> None:
+        if target is not None and target.literal and target.value == "/dev/null":
+            return
+        self.findings.raise_to(MUTATING, f"output redirection: {redirect.text!r}")
+
+    # -- assignments -----------------------------------------------------------------------
+
+    def check_assignment(self, assignment: Assignment, *, prefix: bool) -> None:
+        name = assignment.name
+        if name in REJECTED_VARIABLES:
+            self.findings.reject(f"assignment to {name}")
+        if prefix:
+            self.findings.raise_to(MUTATING, f"prefix assignment: {name}")
+        elif is_session_variable(name):
+            self.findings.raise_to(SESSION_ALTERING, f"assignment to {name}")
+
+
+def _assignment(node: tree_sitter.Node) -> Assignment:
+    name_node = node.child_by_field_name("name")
+    if name_node is None:
+        name_node = node.named_children[0] if node.named_child_count else node
+    if name_node.type == "subscript":
+        inner = name_node.child_by_field_name("name")
+        name_node = inner if inner is not None else name_node
+    match = _IDENTIFIER.match(_text(name_node))
+    name = match.group(0) if match else _text(name_node)
+    operator = next(
+        (_text(child) for child in node.children if not child.is_named), "="
+    )
+    value_node = node.child_by_field_name("value")
+    return Assignment(
+        name=name,
+        operator=operator,
+        value=word(value_node) if value_node is not None else None,
+        text=_text(node),
+    )
+
+
+def _assignment_word(assignment: Assignment) -> Word:
+    """``NAME=value`` as one argument word of ``export``/``declare``/…"""
+    head = f"{assignment.name}{assignment.operator}"
+    value = assignment.value
+    if value is None:
+        return _literal(head)
+    if value.value is None:
+        return Word(text=assignment.text, value=None, literal=False)
+    return Word(text=assignment.text, value=head + value.value, literal=value.literal)
+
+
+def _heredoc_text(
+    start: tree_sitter.Node | None, body: tree_sitter.Node | None, *, strip_tabs: bool
+) -> str | None:
+    """A here-document's text when it is literal: a quoted delimiter, or a body with no
+    expansion and no backslash. None otherwise."""
+    if body is None:
+        return ""
+    text = _text(body)
+    quoted = start is not None and any(q in _text(start) for q in ("'", '"', "\\"))
+    if not quoted and (
+        "\\" in text or any(c.type != "heredoc_content" for c in body.named_children)
+    ):
+        return None
+    if strip_tabs:
+        text = "".join(line.lstrip("\t") for line in text.splitlines(keepends=True))
+    return text
+
+
+def _stdin_after(own: list[Redirect], stdin: Stdin) -> Stdin:
+    """Where standard input comes from once ``own`` redirections apply."""
+    for redirect in own:
+        if not _is_zero(redirect.acts_on):
+            continue
+        op = redirect.operator
+        if redirect.kind in ("heredoc", "herestring"):
+            stdin = Stdin(redirect.kind, redirect.body)
+        elif op in ("<", "<>"):
+            target = redirect.target
+            stdin = Stdin("file", target.value if target and target.literal else None)
+        elif op == "<&":
+            stdin = Stdin("descriptor")
+        elif op == "<&-":
+            stdin = Stdin("closed")
+    return stdin
+
+
+# -- handlers ------------------------------------------------------------------------------
+
+
+def _leaf(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """A node with nothing below it to class (its parent reads its text)."""
+
+
+def _children(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """A node whose meaning is its children's, in the same context."""
+    w.children(node, ctx)
+
+
+def _pipeline(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """Every stage after a ``|`` or ``|&`` reads the pipe. A here-document's pipeline
+    (``cat <<E | x``) starts with the ``|`` token, so its first stage reads the pipe too
+    (the v2 walker treated it as reading the terminal)."""
+    piped = False
+    for child in node.children:
+        if not child.is_named:
+            if child.type in ("|", "|&"):
+                piped = True
+            continue
+        w.walk(child, ctx.nested(stdin=PIPE) if piped else ctx)
+
+
+def _redirected_statement(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    own: list[Redirect] = []
+    bodies = []
+    for child in node.named_children:
+        if child.type.endswith("_redirect"):
+            own.append(w.walk(child, ctx))  # type: ignore[arg-type]
+        else:
+            bodies.append(child)
+    inner = ctx.nested(
+        stdin=_stdin_after(own, ctx.stdin), redirects=tuple(own) + ctx.redirects
+    )
+    for body in bodies:
+        w.walk(body, inner)
+
+
+def _redirect(w: _Walker, node: tree_sitter.Node, ctx: Context) -> Redirect:
+    """A redirection: record it and check it, then walk what is inside it (a
+    substitution in its target, a here-document's body, and the pipeline or list that
+    continues after a here-document's start, which tree-sitter-bash puts inside it)."""
+    redirect = w.redirect(node)
+    w.check_redirect(redirect)
+    w.children(node, ctx)
+    return redirect
+
+
+def _command(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    name: Word | None = None
+    args: list[Word] = []
+    assignments: list[Assignment] = []
+    own: list[Redirect] = []
+    nested = []
+    for child in node.named_children:
+        if child.type == "variable_assignment" and name is None and not args:
+            assignment = _assignment(child)
+            assignments.append(assignment)
+            w.walk(child, ctx, handler=_prefix_assignment)
+        elif child.type.endswith("_redirect"):
+            own.append(w.walk(child, ctx))  # type: ignore[arg-type]
+        elif child.type == "command_name":
+            name = word(child)
+            nested.append(child)
+        else:
+            args.append(word(child))
+            nested.append(child)
+    words = ((name,) if name is not None else ()) + tuple(args)
+    _check_words(w, words)
+    if name is not None:
+        _check_command_word(w, name)
+    w.result.invocations.append(
+        Invocation(
+            kind="command",
+            text=_text(node),
+            words=words,
+            assignments=tuple(assignments),
+            redirects=tuple(own) + ctx.redirects,
+            stdin=_stdin_after(own, ctx.stdin),
+        )
+    )
+    # Substitutions in the words run before the command's own redirections apply.
+    for child in nested:
+        w.walk(child, ctx)
+
+
+def _check_words(w: _Walker, words: tuple[Word, ...]) -> None:
+    for item in words:
+        if item.value is not None and _NETWORK_PATH.search(item.value):
+            w.findings.raise_to(MUTATING, NETWORK_REASON)
+
+
+def _check_command_word(w: _Walker, name: Word) -> None:
+    """§2: a command word that is not a literal, or a path outside the system
+    directories."""
+    if not name.literal or name.value is None:
+        w.findings.raise_to(MUTATING, f"command word is not a literal: {name.text!r}")
+    elif "/" in name.value and not _system_command_path(name.value):
+        w.findings.raise_to(
+            MUTATING,
+            f"command word is a path outside the system directories: {name.value!r}",
+        )
+
+
+def _keyword_invocation(kind: str) -> Handler:
+    """``declaration_command`` and ``unset_command``: an invocation with the keyword as
+    command word; the command layer gives it meaning (#197)."""
+
+    def handler(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+        keyword = _text(node.children[0]) if node.child_count else ""
+        words = [_literal(keyword)]
+        for child in node.named_children:
+            if child.type == "variable_assignment":
+                words.append(_assignment_word(_assignment(child)))
+            else:
+                words.append(word(child))
+        _check_words(w, tuple(words))
+        w.result.invocations.append(
+            Invocation(
+                kind=kind,
+                text=_text(node),
+                words=tuple(words),
+                assignments=(),
+                redirects=ctx.redirects,
+                stdin=ctx.stdin,
+            )
+        )
+        w.children(node, ctx)
+
+    return handler
+
+
+def _variable_assignment(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """An assignment that sets a shell variable: standalone, in ``export``/``declare``/…,
+    or in an arithmetic ``for`` header. §3 and §5 apply."""
+    w.check_assignment(_assignment(node), prefix=False)
+    w.children(node, ctx)
+
+
+def _prefix_assignment(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """``VAR=x cmd``: §2 (any prefix assignment) and §5 (``SUDO_PROMPT``/``ASKPASS``)."""
+    w.check_assignment(_assignment(node), prefix=True)
+    w.children(node, ctx)
+
+
+def _function_definition(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    name = node.child_by_field_name("name")
+    label = _text(name) if name is not None else _text(node)
+    w.findings.raise_to(SESSION_ALTERING, f"function definition: {label}")
+    # The body runs later, when the function is called, not under these redirections.
+    w.children(node, ctx.nested(stdin=TERMINAL, redirects=()))
+
+
+def _substitution(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """``$(…)``, `` `…` ``, ``<(…)``, ``>(…)``: the inner commands' output is
+    captured, so the redirections around do not apply to them; their standard input is
+    the one the shell has where the substitution is expanded."""
+    if node.type == "process_substitution":
+        w.findings.raise_to(MUTATING, PROCESS_SUBSTITUTION_REASON)
+    w.children(node, ctx.nested(redirects=()))
+
+
+_LEAVES = (
+    "ansi_c_string", "comment", "extglob_pattern", "file_descriptor", "heredoc_content",
+    "heredoc_end", "heredoc_start", "number", "raw_string", "regex",
+    "special_variable_name", "string_content", "test_operator", "variable_name", "word",
+)  # fmt: skip
+_CONTAINERS = (
+    # statements: the same context reaches every child
+    "program", "list", "compound_statement", "subshell", "do_group", "if_statement",
+    "elif_clause", "else_clause", "while_statement", "for_statement",
+    "c_style_for_statement", "case_statement", "case_item", "negated_command",
+    "test_command", "variable_assignments",
+    # words and expressions: only substitutions inside them hold commands
+    "arithmetic_expansion", "array", "binary_expression", "brace_expression",
+    "command_name", "concatenation", "expansion", "heredoc_body",
+    "parenthesized_expression", "postfix_expression", "simple_expansion", "string",
+    "subscript", "ternary_expression", "translated_string", "unary_expression",
+    # what the parser could not read: the tree is unparseable; its parts are still walked
+    "ERROR",
+)  # fmt: skip
+
+HANDLERS: dict[str, Handler] = {
+    **{kind: _leaf for kind in _LEAVES},
+    **{kind: _children for kind in _CONTAINERS},
+    "command": _command,
+    "declaration_command": _keyword_invocation("declaration"),
+    "unset_command": _keyword_invocation("unset"),
+    "variable_assignment": _variable_assignment,
+    "function_definition": _function_definition,
+    "pipeline": _pipeline,
+    "redirected_statement": _redirected_statement,
+    "file_redirect": _redirect,
+    "heredoc_redirect": _redirect,
+    "herestring_redirect": _redirect,
+    "command_substitution": _substitution,
+    "process_substitution": _substitution,
+}
