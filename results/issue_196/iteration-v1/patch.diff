+The pipeline (``nl_shell.gate.classify``, step §1.6) already calls ``check`` for every
+simple command; #190 replaces this module (``targets/<id>/sensitive.toml``, ``realpath``
+of file operands, and the file-type parts of §2 and §4). Until then it adds nothing.
+"""
+
+from __future__ import annotations
+
+from nl_shell.gate.parse import Invocation
+from nl_shell.gate.verdict import Verdict
+
+
+def check(invocation: Invocation) -> Verdict:
+    """§8 for one simple command. The stub raises nothing."""
+    return Verdict()
diff --git a/src/nl_shell/gate/vectors.py b/src/nl_shell/gate/vectors.py
new file mode 100644
index 0000000..5c5750d
--- /dev/null
+++ b/src/nl_shell/gate/vectors.py
@@ -0,0 +1,134 @@
+"""Conformance vectors: loading ``targets/<id>/gate-vectors.toml``.
+
+Spec ``policy-gate/v1`` Conformance: each target has its own vectors, and the tests run
+them through ``nl_shell.gate.classify``. The file is an array of ``[[vector]]`` tables:
+
+- ``command`` (required): the command text;
+- ``class`` (required): the class the gate gives it, one of the five;
+- ``row``: the spec's Conformance row number;
+- ``origin``: ``"proposal"`` (the default) or ``"typed"``;
+- ``label``: the class the model gave its proposal (§1.7);
+- ``rejected``: whether the gate rejects it (default false);
+- ``reason``: text one of the gate's reasons contains;
+- ``note``: free text for the reader.
+
+Anything else is an error that names the entry, as is a missing or mistyped field.
+"""
+
+from __future__ import annotations
+
+import tomllib
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from nl_shell import targets
+from nl_shell.gate.verdict import CLASSES
+
+VECTORS_FILE = "gate-vectors.toml"
+ORIGINS = ("proposal", "typed")
+_KEYS = frozenset(
+    {"row", "command", "class", "origin", "label", "rejected", "reason", "note"}
+)
+
+
+class VectorError(Exception):
+    """The vectors file could not be read; the message names the file and the entry."""
+
+
+@dataclass(frozen=True)
+class Vector:
+    command: str
+    cls: str
+    rejected: bool = False
+    row: int | None = None
+    origin: str = "proposal"
+    label: str | None = None
+    reason: str | None = None
+    note: str | None = None
+
+
+def load(target_id: str, root: Path = targets.TARGETS_ROOT) -> tuple[Vector, ...]:
+    """Load ``root/<target_id>/gate-vectors.toml``."""
+    if not targets.is_plain_id(target_id):
+        raise VectorError(
+            f"invalid target id {target_id!r}: a target id is a plain folder name"
+        )
+    folder = root / target_id
+    if not folder.is_dir() or not folder.resolve().is_relative_to(root.resolve()):
+        raise VectorError(f"no target {target_id!r} in {root}")
+    return read(folder / VECTORS_FILE)
+
+
+def read(path: Path) -> tuple[Vector, ...]:
+    """Read and validate one vectors file."""
+    try:
+        data = path.read_bytes()
+    except FileNotFoundError:
+        raise VectorError(f"{path}: missing") from None
+    except OSError as exc:
+        raise VectorError(f"{path}: cannot read: {exc.strerror or exc}") from None
+    try:
+        doc = tomllib.loads(data.decode("utf-8"))
+    except UnicodeDecodeError:
+        raise VectorError(f"{path}: not valid TOML: not valid UTF-8") from None
+    except tomllib.TOMLDecodeError as exc:
+        raise VectorError(f"{path}: not valid TOML: {exc}") from None
+    extra = sorted(set(doc) - {"vector"})
+    if extra:
+        raise VectorError(f"{path}: unknown top-level key `{extra[0]}`")
+    entries = doc.get("vector", [])
+    if not isinstance(entries, list):
+        raise VectorError(f"{path}: `vector` must be an array of tables ([[vector]])")
+    return tuple(
+        _vector(entry, f"{path}: vector {index}")
+        for index, entry in enumerate(entries, 1)
+    )
+
+
+def _vector(entry: Any, where: str) -> Vector:
+    if not isinstance(entry, dict):
+        raise VectorError(f"{where}: must be a table")
+    if isinstance(entry.get("row"), int):
+        where = f"{where} (row {entry['row']})"
+    unknown = sorted(set(entry) - _KEYS)
+    if unknown:
+        raise VectorError(f"{where}: unknown key `{unknown[0]}`")
+
+    def text(key: str, required: bool = False) -> str | None:
+        if key not in entry:
+            if required:
+                raise VectorError(f"{where}: missing required field `{key}`")
+            return None
+        value = entry[key]
+        if not isinstance(value, str) or (required and not value):
+            raise VectorError(f"{where}: `{key}` must be a non-empty string")
+        return value
+
+    command = text("command", required=True)
+    cls = text("class", required=True)
+    if cls not in CLASSES:
+        raise VectorError(f"{where}: class {cls!r} is not one of {', '.join(CLASSES)}")
+    label = text("label")
+    if label is not None and label not in CLASSES:
+        raise VectorError(f"{where}: label {label!r} is not one of {', '.join(CLASSES)}")
+    origin = text("origin") or "proposal"
+    if origin not in ORIGINS:
+        raise VectorError(f"{where}: origin {origin!r} is not one of {', '.join(ORIGINS)}")
+    rejected = entry.get("rejected", False)
+    if not isinstance(rejected, bool):
+        raise VectorError(f"{where}: `rejected` must be true or false")
+    row = entry.get("row")
+    if row is not None and (isinstance(row, bool) or not isinstance(row, int)):
+        raise VectorError(f"{where}: `row` must be an integer")
+    assert command is not None and cls is not None
+    return Vector(
+        command=command,
+        cls=cls,
+        rejected=rejected,
+        row=row,
+        origin=origin,
+        label=label,
+        reason=text("reason"),
+        note=text("note"),
+    )
diff --git a/src/nl_shell/gate/verdict.py b/src/nl_shell/gate/verdict.py
new file mode 100644
index 0000000..f29be72
--- /dev/null
+++ b/src/nl_shell/gate/verdict.py
@@ -0,0 +1,62 @@
+"""The five classes and the running verdict every step of the gate raises.
+
+Spec ``policy-gate/v1`` Conventions: ``read-only`` < ``mutating`` = ``session-altering`` <
+``destructive`` < ``privileged``; *at least X* is the higher of the current class and X.
+``mutating`` and ``session-altering`` rank the same. When both apply, the verdict names
+``session-altering``: it says more about the command, and it is never lower.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+READ_ONLY = "read-only"
+MUTATING = "mutating"
+SESSION_ALTERING = "session-altering"
+DESTRUCTIVE = "destructive"
+PRIVILEGED = "privileged"
+CLASSES = (READ_ONLY, MUTATING, SESSION_ALTERING, DESTRUCTIVE, PRIVILEGED)
+_RANK = {READ_ONLY: 0, MUTATING: 1, SESSION_ALTERING: 1, DESTRUCTIVE: 2, PRIVILEGED: 3}
+
+
+def rank(cls: str) -> int:
+    """The rank of ``cls``; ``mutating`` and ``session-altering`` share one."""
+    return _RANK[cls]
+
+
+def higher(current: str, other: str) -> str:
+    """The higher of two classes; ``session-altering`` over ``mutating`` at equal rank."""
+    if rank(other) > rank(current):
+        return other
+    if rank(other) == rank(current) and other == SESSION_ALTERING:
+        return other
+    return current
+
+
+@dataclass
+class Verdict:
+    """A class, the reasons that raised it, and whether the command is rejected."""
+
+    cls: str = READ_ONLY
+    reasons: list[str] = field(default_factory=list)
+    rejected: bool = False
+
+    def _reason(self, reason: str) -> None:
+        if reason not in self.reasons:
+            self.reasons.append(reason)
+
+    def raise_to(self, cls: str, reason: str) -> None:
+        """At least ``cls``, because of ``reason``."""
+        self.cls = higher(self.cls, cls)
+        self._reason(reason)
+
+    def reject(self, reason: str) -> None:
+        """The command cannot be confirmed or run at all, because of ``reason``."""
+        self.rejected = True
+        self._reason(reason)
+
+    def merge(self, other: Verdict) -> None:
+        self.cls = higher(self.cls, other.cls)
+        self.rejected = self.rejected or other.rejected
+        for reason in other.reasons:
+            self._reason(reason)
