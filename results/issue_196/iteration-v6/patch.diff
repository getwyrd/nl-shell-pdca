+"""Live-session resolution, spec ``policy-gate/v1`` §7 — a fail-closed stub for now.
+
+The pipeline (``nl_shell.gate.classify``, step §1.5) calls ``resolve`` for every simple
+command still ``read-only`` after §1–§6. Resolving aliases, functions, disabled
+builtins, ``PATH``, traps and the pager and loader variables needs the session snapshot
+(spec ``pty-protocol/v1`` §3); #192 replaces this module. Until then nothing is proved
+read-only: every such command becomes ``mutating``, reason ``STUB_REASON``.
+"""
+
+from __future__ import annotations
+
+from nl_shell.gate.parse import Invocation
+from nl_shell.gate.verdict import MUTATING, READ_ONLY, Verdict
+
+STUB_REASON = "live-session resolution not implemented"
+
+
+def resolve(invocation: Invocation, verdict: Verdict) -> Verdict:
+    """§7 for one simple command and its verdict so far. Returns the new verdict."""
+    result = Verdict(
+        cls=verdict.cls, reasons=list(verdict.reasons), rejected=verdict.rejected
+    )
+    if result.cls == READ_ONLY:
+        result.raise_to(MUTATING, STUB_REASON)
+    return result
diff --git a/src/nl_shell/gate/parse.py b/src/nl_shell/gate/parse.py
new file mode 100644
index 0000000..9652e7a
--- /dev/null
+++ b/src/nl_shell/gate/parse.py
@@ -0,0 +1,1268 @@
+"""The shell layer of the gate: parse with the pinned grammar and walk every node.
+
+Spec ``policy-gate/v1`` §1.2 and §1.4. ``walk`` parses a command with the tree-sitter-bash
+grammar pinned in ``pyproject.toml`` and visits every node of the tree. Each named node
+kind of the grammar has exactly one handler in ``HANDLERS``; a node whose kind has none
+raises ``UnhandledNode``, so syntax the gate does not know fails closed (decision C in
+``nl_shell.gate``). ``grammar_node_kinds`` lists the kinds from the grammar itself, at run
+time, so a test can hold the two together.
+
+One ``Context`` travels the walk: where standard input comes from (``Stdin``), the
+redirections of the statements around the current node, the depth, and the ``Budget``,
+which counts every node visited across the whole classification (a caller that classes
+inner text, such as ``bash -c``, passes the same budget on).
+
+The walker hands each simple command to the command layer (``nl_shell.gate.rules``) as an
+``Invocation``: its words after quote removal, each marked literal or not; its prefix
+assignments; its redirections (its own and those around it); and its standard input.
+``declaration_command`` (``export``, ``declare``, ``typeset``, ``local``, ``readonly``)
+and ``unset_command`` nodes become invocations too, with their keyword as command word.
+
+What the shell layer decides itself (``Walk.findings``), because it holds whatever the
+command is: §2 prefix assignments, output redirections, ``/dev/tcp`` and ``/dev/udp``
+words, a command word that is not a literal or is a path outside the system directories,
+process substitution; §3 function definitions and assignments to the listed variables;
+§5 redirections the gate cannot prove use only descriptors 0-2, and assignments to
+``SUDO_PROMPT`` or ``SUDO_ASKPASS``.
+"""
+
+from __future__ import annotations
+
+import posixpath
+import re
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field, replace
+from functools import cache
+
+import tree_sitter
+import tree_sitter_bash
+
+from nl_shell.gate.verdict import MUTATING, SESSION_ALTERING, Verdict
+
+_ENCODING = ("utf-8", "surrogatepass")
+
+# The total work of one classification: bytes parsed, CPU time spent parsing, nodes
+# visited, and how deep the walk may go. The byte cap is spent before the parse, so the
+# parser never sees more than MAX_INPUT_BYTES. The walk is linear in the text, but the
+# parse is not: tree-sitter-bash 0.25.1 takes quadratic time on some inputs (at this cap,
+# `$[` repeated takes about 10 s, `a=(` about 8 s, `${` about 3 s). So the parse is also
+# stopped once it has used MAX_PARSE_SECONDS of CPU time (``_parse``); ordinary text at
+# the cap parses in a few milliseconds.
+MAX_INPUT_BYTES = 64 * 1024
+MAX_PARSE_SECONDS = 0.5
+MAX_WORK = 20_000
+MAX_DEPTH = 150
+# How far back from a redirection the gate reads for a `{name}` descriptor. A longer
+# name is rejected rather than read in full.
+NAMED_FD_WINDOW = 256
+
+# Spec Conventions: the system directories.
+SYSTEM_DIRECTORIES = frozenset({"/usr/bin", "/usr/sbin", "/bin", "/sbin"})
+
+# §3: variables an assignment to which alters the session.
+SESSION_VARIABLES = frozenset(
+    {
+        "PATH", "BASH_ENV", "ENV", "CDPATH", "PROMPT_COMMAND",
+        "PS0", "PS1", "PS2", "PS3", "PS4",
+        "IFS", "HISTFILE", "PAGER", "MANPAGER", "SYSTEMD_PAGER", "GIT_PAGER",
+        "LESSOPEN", "LESSCLOSE", "EDITOR", "VISUAL", "BROWSER", "NODE_OPTIONS",
+    }
+)  # fmt: skip
+SESSION_VARIABLE_PREFIXES = ("LD_", "SUDO_", "PYTHON", "PERL5", "GIT_")
+# §5: assigning or exporting these is rejected.
+REJECTED_VARIABLES = frozenset({"SUDO_PROMPT", "SUDO_ASKPASS"})
+
+_NETWORK_PATH = re.compile(r"/dev/(?:tcp|udp)/")
+_GLOB = frozenset("*?[")
+_BRACE = re.compile(r"\{[^{}]*(?:,|\.\.)[^{}]*\}")
+# `{name}>file`: bash's named descriptor. tree-sitter-bash does not give it a node of its
+# own (it is an argument word, or an ERROR), so it is read from the bytes just before
+# the redirection (`_named_fd_before`).
+_NAME_BYTES = frozenset(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_")
+# `[n]>&digit-` and `[n]<&digit-`: move descriptor `digit` onto n.
+_MOVE_TARGET = re.compile(r"[0-9]+-")
+# A path that opens one of the shell's own descriptors: `/dev/fd/N`, `/proc/self/fd/N`,
+# `/proc/<pid>/fd/N`, `/proc/thread-self/fd/N`, `/proc/<pid>/task/<tid>/fd/N`.
+_DESCRIPTOR_DIRECTORY = re.compile(r"(?:/dev/fd|/proc/[^/]+(?:/task/[^/]+)?/fd)(?:/(.*))?")
+# `/proc/<pid>/root` and `/proc/<pid>/task/<tid>/root` are links to the process's root
+# directory, so `/proc/self/root/dev/fd/3` is `/dev/fd/3`.
+_PROC_ROOT = re.compile(r"/proc/[^/]+(?:/task/[^/]+)?/root(?=/|$)")
+# `/proc/<pid>/cwd` is a link to the process's working directory, which the gate does not
+# know: `cd /dev/fd; echo x >/proc/self/cwd/3` writes to descriptor 3.
+_PROC_CWD = re.compile(r"/proc/[^/]+(?:/task/[^/]+)?/cwd(?=/|$)")
+# With extglob on (bash-completion turns it on), `@(…)`, `+(…)`, `!(…)`, `?(…)`
+# and `*(…)` are patterns. tree-sitter-bash ends the redirection's target word at the
+# `(`, so the gate reads the byte before and after the word's end.
+_EXTGLOB_LEADS = frozenset(b"?*+@!")
+# The same opener anywhere inside the word (`>/dev/fd/3@(x|)`), read off its shape.
+_EXTGLOB_OPEN = re.compile(r"[?*+@!]\(")
+# bash 5.3 runs `${ cmd; }` and `${| cmd; }` (a command substitution in the current
+# shell); tree-sitter-bash 0.25.1 reads neither. A backslash-newline may sit before the
+# blank, since bash removes it first.
+_FUNSUB = re.compile(rb"\$\{(?:\\\n)*[ \t\n|]")
+# Before a backslash-newline, a `$` or backquote is joined by bash to what follows
+# (`"$\⏎(cmd)"` is `"$(cmd)"`), inside double quotes and here-documents too.
+_EXPANSION_LEADS = frozenset(b"$`")
+# A backslash-newline: bash removes it before it splits words, tree-sitter-bash does not
+# (it splits `r\⏎m` into two words). Where it sits inside one of these tokens the token's
+# own text is read correctly (``_unescape_unquoted``, ``_unescape_double``) or bash keeps
+# it too (single quotes, a comment); a here-document body holding a backslash is not
+# literal (``_heredoc_text``).
+_CONTINUATION = b"\\\n"
+_CONTINUATION_TOKENS = frozenset(
+    {"word", "string_content", "raw_string", "ansi_c_string", "comment",
+     "heredoc_content", "heredoc_body"}
+)  # fmt: skip
+_BLANKS = frozenset(b" \t\n")
+# Bytes before a bare digit run that make the run a redirection's descriptor (`a 0<x`).
+_DESCRIPTOR_LEAD = frozenset(b" \t\n;&|()")
+DESCRIPTOR_WINDOW = 64
+_PARSE_CHUNK = 64 * 1024
+_DIGITS = frozenset(b"0123456789")
+# What a backslash quotes inside double quotes.
+_DOUBLE_ESCAPED = ('"', "\\", "$", "`")
+_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+
+_OUTPUT_OPERATORS = frozenset({">", ">>", ">|", "&>", "&>>", "<>"})
+_DUPLICATE_OPERATORS = frozenset({">&", "<&"})
+_CLOSE_OPERATORS = frozenset({">&-", "<&-"})
+_INPUT_FIRST = ("<",)  # operators that act on descriptor 0 when none is given
+
+
+class GateFailure(Exception):
+    """The walk cannot class the command; ``nl_shell.gate`` fails closed (decision C)."""
+
+
+class UnhandledNode(GateFailure):
+    def __init__(self, kind: str) -> None:
+        super().__init__(f"no handler for node kind {kind!r}")
+        self.kind = kind
+
+
+class BudgetExceeded(GateFailure):
+    pass
+
+
+class SplitContinuation(GateFailure):
+    """A backslash-newline between two characters bash would join into one token."""
+
+    def __init__(self, offset: int) -> None:
+        super().__init__(
+            f"a line continuation at byte {offset} joins two tokens the parser splits"
+        )
+
+
+class UnreadHeredoc(GateFailure):
+    """A here-document whose substitutions the parser did not read."""
+
+    def __init__(self) -> None:
+        super().__init__("a here-document holds a substitution the parser did not read")
+
+
+class HeredocMismatch(GateFailure):
+    """A here-document that bash may end on a different line than the parser does."""
+
+
+class FunctionSubstitution(GateFailure):
+    """bash 5.3's ``${ cmd; }`` or ``${| cmd; }``, which the parser does not read."""
+
+    def __init__(self, offset: int) -> None:
+        super().__init__(f"a bash function substitution at byte {offset}")
+
+
+@dataclass
+class Budget:
+    """Work left for one classification, shared by every walk that is part of it."""
+
+    work: int = MAX_WORK
+    depth: int = MAX_DEPTH
+    used: int = 0
+    input_bytes: int = MAX_INPUT_BYTES
+    read: int = 0
+    parse_seconds: float = MAX_PARSE_SECONDS
+    parsing: float = 0.0
+
+    def spend(self, amount: int = 1) -> None:
+        self.used += amount
+        if self.used > self.work:
+            raise BudgetExceeded(f"work budget exceeded ({self.work} nodes)")
+
+    def spend_input(self, amount: int) -> None:
+        """Charge ``amount`` bytes of text to parse, before it is parsed."""
+        self.read += amount
+        if self.read > self.input_bytes:
+            raise BudgetExceeded(f"input budget exceeded ({self.input_bytes} bytes)")
+
+    def spend_parse(self, seconds: float) -> None:
+        """Charge ``seconds`` of CPU time spent parsing."""
+        self.parsing += seconds
+        if self.parsing > self.parse_seconds:
+            raise BudgetExceeded(f"parse budget exceeded ({self.parse_seconds} s)")
+
+
+@dataclass(frozen=True)
+class Stdin:
+    """Where a simple command's standard input comes from.
+
+    ``source`` is one of ``terminal``, ``pipe``, ``file``, ``heredoc``, ``herestring``,
+    ``descriptor`` (duplicated from another descriptor), ``closed`` or ``unknown``.
+    ``text`` is the literal text a here-document or here-string feeds (None when it is
+    not literal), or the file name for ``file`` when it is literal.
+
+    ``unknown`` is a function body's: the body runs with the standard input of each
+    caller (`f() { sudo tee /x; }; cat <<E | f`), which the walk does not track. A
+    consumer MUST treat ``unknown`` as the worst case for each rule: as a pipe for the
+    pipe-into-sudo rule and decision B, and as the terminal for the terminal-read rule.
+    """
+
+    source: str
+    text: str | None = None
+
+
+TERMINAL = Stdin("terminal")
+PIPE = Stdin("pipe")
+UNKNOWN = Stdin("unknown")
+
+
+@dataclass(frozen=True)
+class Word:
+    """One shell word. ``value`` is the word after quote removal (None when an expansion
+    makes it unknowable); ``literal`` is False when the shell would still expand it
+    (an expansion, a substitution, a glob or brace expansion)."""
+
+    text: str
+    value: str | None
+    literal: bool
+
+
+@dataclass(frozen=True)
+class Assignment:
+    """``NAME=value`` or ``NAME+=value``."""
+
+    name: str
+    operator: str
+    value: Word | None
+    text: str
+
+
+@dataclass(frozen=True)
+class Redirect:
+    """One redirection. ``kind`` is ``file``, ``heredoc`` or ``herestring``; ``operator``
+    the operator token; ``descriptor`` the explicit descriptor text, if any;
+    ``target`` the destination word (None for a here-document); ``named_fd`` True for
+    ``{name}>``; ``body`` the literal text a here-document or here-string feeds;
+    ``pattern`` True when bash would glob or brace-expand the target."""
+
+    kind: str
+    operator: str
+    descriptor: str | None
+    target: Word | None
+    named_fd: bool
+    text: str
+    body: str | None = None
+    pattern: bool = False
+
+    @property
+    def acts_on(self) -> str:
+        """The descriptor it acts on: the explicit one, or bash's default."""
+        if self.descriptor is not None:
+            return self.descriptor
+        if self.kind != "file" or self.operator.startswith(_INPUT_FIRST):
+            return "0"
+        return "1"
+
+
+@dataclass(frozen=True)
+class Invocation:
+    """One simple command, as the command layer sees it.
+
+    ``kind`` is ``command``, ``declaration`` or ``unset``. ``words`` holds the command
+    word first (the keyword for a declaration or ``unset``); it is empty for a command
+    with no command word. ``assignments`` are the prefix assignments (``VAR=x cmd``);
+    ``redirects`` its own redirections, then those of the statements around it."""
+
+    kind: str
+    text: str
+    words: tuple[Word, ...]
+    assignments: tuple[Assignment, ...]
+    redirects: tuple[Redirect, ...]
+    stdin: Stdin
+
+    @property
+    def command_word(self) -> Word | None:
+        return self.words[0] if self.words else None
+
+
+@dataclass(frozen=True)
+class Context:
+    """What travels the walk."""
+
+    stdin: Stdin
+    redirects: tuple[Redirect, ...]
+    depth: int
+    budget: Budget
+
+    def nested(self, **changes: object) -> Context:
+        return replace(self, **changes)  # type: ignore[arg-type]
+
+
+@dataclass
+class Walk:
+    """The result of walking one command."""
+
+    unparseable: bool
+    invocations: list[Invocation] = field(default_factory=list)
+    findings: Verdict = field(default_factory=Verdict)
+
+
+@cache
+def language() -> tree_sitter.Language:
+    return tree_sitter.Language(tree_sitter_bash.language())
+
+
+@cache
+def _parser() -> tree_sitter.Parser:
+    return tree_sitter.Parser(language())
+
+
+def grammar_node_kinds() -> frozenset[str]:
+    """Every named node kind of the pinned grammar, read from the grammar itself."""
+    lang = language()
+    return frozenset(
+        lang.node_kind_for_id(kind)
+        for kind in range(lang.node_kind_count)
+        if lang.node_kind_is_named(kind) and lang.node_kind_is_visible(kind)
+    )
+
+
+def walk(text: str, budget: Budget | None = None, stdin: Stdin = TERMINAL) -> Walk:
+    """Parse ``text`` and walk every node of it.
+
+    Raises ``GateFailure`` (an unhandled node kind, the budget exceeded); the caller
+    fails closed."""
+    budget = budget if budget is not None else Budget()
+    if len(text) > budget.input_bytes - budget.read:
+        # A character is at least one byte: refuse over-long text before encoding it.
+        budget.spend_input(len(text))
+    source = text.encode(*_ENCODING)
+    budget.spend_input(len(source))
+    funsub = _FUNSUB.search(source)
+    if funsub is not None:
+        raise FunctionSubstitution(funsub.start())
+    tree = _parse(source, budget)
+    _check_continuations(source, tree.root_node, budget)
+    walker = _Walker(source, Walk(unparseable=tree.root_node.has_error))
+    if _NETWORK_PATH.search(text):
+        walker.result.findings.raise_to(MUTATING, NETWORK_REASON)
+    walker.walk(tree.root_node, Context(stdin, (), 0, budget))
+    walker.check_heredoc_order()
+    return walker.result
+
+
+def _parse(source: bytes, budget: Budget) -> tree_sitter.Tree:
+    """Parse ``source``, stopping once the parse has used the CPU time left in the
+    budget. tree-sitter calls ``over`` every few milliseconds of parsing (about every
+    15 ms on the slowest input known), and a True return cancels the parse."""
+    parser = _parser()
+    left = budget.parse_seconds - budget.parsing
+    started = time.thread_time()
+
+    def over(_offset: int, _has_error: bool) -> bool:
+        return time.thread_time() - started > left
+
+    def read(offset: int, _point: object) -> bytes:
+        return source[offset : offset + _PARSE_CHUNK]
+
+    tree: tree_sitter.Tree | None = None
+    try:
+        tree = parser.parse(read, progress_callback=over)
+    except ValueError:
+        pass  # tree-sitter's "Parsing failed": ``over`` cancelled it
+    if tree is None:
+        parser.reset()  # a cancelled parse would otherwise resume on the next call
+        budget.parsing = budget.parse_seconds
+        raise BudgetExceeded(f"parse budget exceeded ({budget.parse_seconds} s)")
+    budget.spend_parse(time.thread_time() - started)
+    return tree
+
+
+def _check_continuations(source: bytes, root: tree_sitter.Node, budget: Budget) -> None:
+    """Fail closed on a backslash-newline the parser read as a token break where bash
+    joins the two sides (`>\\⏎&3` is `>&3`, `3\\⏎>y` is `3>y`, `r\\⏎m` is `rm`). A
+    continuation next to a blank on either side joins nothing, so `a |\\⏎  b` passes.
+    One after a `$` or backquote fails closed wherever it is (`"$\\⏎(cmd)"`): bash
+    joins it into an expansion the parser read as plain text."""
+    offset = source.find(_CONTINUATION)
+    while offset != -1:
+        budget.spend()
+        end = offset + 2
+        while source.startswith(_CONTINUATION, end):
+            end += 2
+        node = root.descendant_for_byte_range(offset, offset + 1)
+        inside = node is not None and node.type in _CONTINUATION_TOKENS
+        before = source[offset - 1] if offset else None
+        after = source[end] if end < len(source) else None
+        if before is not None and before in _EXPANSION_LEADS:
+            raise SplitContinuation(offset)
+        if (
+            not inside
+            and before is not None
+            and after is not None
+            and before not in _BLANKS
+            and after not in _BLANKS
+        ):
+            raise SplitContinuation(offset)
+        offset = source.find(_CONTINUATION, end)
+
+
+# -- reasons -------------------------------------------------------------------------------
+
+NETWORK_REASON = "a /dev/tcp or /dev/udp path"
+PROCESS_SUBSTITUTION_REASON = "process substitution"
+DESCRIPTOR_REASON = "a redirection the gate cannot prove uses only descriptors 0-2"
+
+
+# -- words ---------------------------------------------------------------------------------
+
+
+def _text(node: tree_sitter.Node) -> str:
+    """The node's source text. tree-sitter splits bytes it cannot read as UTF-8 (a lone
+    surrogate) into nodes of their own, so a piece that does not decode keeps its bytes
+    as escapes (§1.1 has already flagged such text)."""
+    raw = node.text or b""
+    try:
+        return raw.decode(*_ENCODING)
+    except UnicodeDecodeError:
+        return raw.decode("utf-8", "surrogateescape")
+
+
+def word(node: tree_sitter.Node) -> Word:
+    """The ``Word`` for a word-like node, after quote removal."""
+    value, shape = _evaluate(node)
+    literal = (
+        value is not None
+        and shape is not None
+        and not any(char in _GLOB for char in shape)
+        and not _BRACE.search(shape)
+        and not _tilde(shape)
+    )
+    return Word(text=_text(node), value=value, literal=literal)
+
+
+def _pattern(node: tree_sitter.Node) -> bool:
+    """True when bash would glob or brace-expand the word (unquoted ``*?[`` or braces).
+    tree-sitter-bash gives a sequence (`{3..3}`) a ``brace_expression`` node."""
+    stack = [node]
+    while stack:
+        child = stack.pop()
+        if child.type == "brace_expression":
+            return True
+        stack.extend(child.named_children)
+    _, shape = _evaluate(node)
+    return shape is not None and (
+        any(char in _GLOB for char in shape) or _BRACE.search(shape) is not None
+    )
+
+
+def _extglob_after(source: bytes, end: int) -> bool:
+    """True when the word ending at ``end`` runs on into an extglob pattern bash reads as
+    part of it (`>/dev/@(fd)/3`): its last byte is one of ``?*+@!`` and a ``(`` follows.
+    A quoted lead (`'@'(`) ends in a quote, so it is not one; an escaped one (`\\@(`) is
+    read as one, which fails closed."""
+    return (
+        end > 0
+        and source[end - 1] in _EXTGLOB_LEADS
+        and source[end : end + 1] == b"("
+    )
+
+
+def _extglob_inside(node: tree_sitter.Node) -> bool:
+    """True when the word holds an extglob opener (``?( *( +( @( !(``) anywhere, not only
+    at its end (`>/dev/fd/3@(x|)`), or a part the parser could not read. The shape holds
+    quoted characters as "x", so `'@('` is not one; a word with no shape (an expansion)
+    is checked on its raw text, which fails closed."""
+    stack = [node]
+    while stack:
+        child = stack.pop()
+        if child.type == "ERROR" or child.is_missing:
+            return True
+        stack.extend(child.children)
+    _, shape = _evaluate(node)
+    return _EXTGLOB_OPEN.search(shape if shape is not None else _text(node)) is not None
+
+
+def _tilde(shape: str) -> bool:
+    """True when bash would expand an unquoted ``~`` in the word: at its start, or after
+    ``=`` or ``:`` (bash expands those in any word that looks like an assignment). The
+    shape holds quoted and escaped characters as "x", so `'~'` and `\\~` are not it."""
+    return shape.startswith("~") or "=~" in shape or ":~" in shape
+
+
+def _literal(text: str) -> Word:
+    return Word(text=text, value=text, literal=True)
+
+
+def _unescape_unquoted(raw: str) -> tuple[str, str]:
+    value, shape = [], []
+    chars = iter(raw)
+    for char in chars:
+        if char == "\\":
+            escaped = next(chars, "")
+            if escaped in ("\n", ""):
+                continue
+            value.append(escaped)
+            shape.append("x")
+        else:
+            value.append(char)
+            shape.append(char)
+    return "".join(value), "".join(shape)
+
+
+def _unescape_double(raw: str) -> str:
+    out = []
+    chars = iter(raw)
+    for char in chars:
+        if char == "\\":
+            escaped = next(chars, "")
+            if escaped == "\n":
+                continue
+            out.append(escaped if escaped in ('"', "\\", "$", "`") else char + escaped)
+        else:
+            out.append(char)
+    return "".join(out)
+
+
+def _evaluate(node: tree_sitter.Node) -> tuple[str | None, str | None]:
+    """(the value after quote removal, its shape with quoted characters as "x"), or
+    (None, None) when an expansion makes the value unknowable."""
+    kind = node.type
+    if kind in ("word", "number"):
+        if node.named_child_count:
+            return None, None
+        return _unescape_unquoted(_text(node))
+    if kind == "command_name":
+        if node.named_child_count != 1:
+            return None, None
+        return _evaluate(node.named_children[0])
+    if kind == "raw_string":
+        inner = _text(node)[1:-1]
+        return inner, "x" * len(inner)
+    if kind == "string":
+        parts = []
+        for child in node.named_children:
+            if child.type != "string_content":
+                return None, None
+            parts.append(_unescape_double(_text(child)))
+        inner = "".join(parts)
+        return inner, "x" * len(inner)
+    if kind == "concatenation":
+        values, shapes = [], []
+        for child in node.children:
+            value, shape = _evaluate(child)
+            if value is None or shape is None:
+                return None, None
+            values.append(value)
+            shapes.append(shape)
+        return "".join(values), "".join(shapes)
+    # $'…', $"…", $x, ${x}, $(…), `…`, $((…)), <(…), and anything else.
+    return None, None
+
+
+def _below_three(text: str) -> bool:
+    """True when ``text`` names descriptor 0, 1 or 2 (ASCII digits, leading zeros allowed).
+    Never converts the number, so a 40-digit descriptor costs nothing."""
+    if not text or not text.isascii() or not text.isdigit():
+        return False
+    return (text.lstrip("0") or "0") in ("0", "1", "2")
+
+
+def _descriptor_path(value: str) -> str | None:
+    """The descriptor a path opens when it is one of the shell's own (``/dev/fd/3``,
+    ``/proc/self/fd/3``), after collapsing repeated slashes and ``.``/``..`` as Linux
+    does; ``"?"`` for a path under such a directory that does not name one plainly; None
+    for any other path."""
+    if not value.startswith("/"):
+        return None
+    collapsed = re.sub("/+", "/", value)
+    parts = collapsed.split("/")
+    if ".." in parts and ("dev" in parts or "proc" in parts):
+        # `..` after a link (`/dev/fd/../root/dev/fd/3`) goes where the link points, not
+        # where the text does: the gate cannot read it.
+        return "?"
+    path = posixpath.normpath(collapsed)
+    root = _PROC_ROOT.match(path)
+    while root is not None:
+        path = path[root.end() :] or "/"
+        root = _PROC_ROOT.match(path)
+    if _PROC_CWD.match(path):
+        return "?"
+    match = _DESCRIPTOR_DIRECTORY.fullmatch(path)
+    if match is None:
+        return None
+    number = match.group(1)
+    if number is None:
+        return None  # the directory itself, not a descriptor
+    return number if number.isascii() and number.isdigit() else "?"
+
+
+def _digits_before(source: bytes, end: int) -> str | None:
+    """A bare run of digits just before ``end`` (`a 0<x`: tree-sitter-bash reads the `0`
+    as an argument, bash as the descriptor). Reads at most ``DESCRIPTOR_WINDOW`` bytes
+    back; a longer run is returned as "?", which is not below three (fail closed)."""
+    start = end
+    limit = max(0, end - DESCRIPTOR_WINDOW)
+    while start > limit and source[start - 1] in _DIGITS:
+        start -= 1
+    if start == end:
+        return None
+    if start > 0 and start == limit:
+        return "?"
+    if start > 0 and source[start - 1] not in _DESCRIPTOR_LEAD:
+        return None
+    return source[start:end].decode()
+
+
+def _named_fd_before(source: bytes, end: int) -> bool:
+    """True when the bytes just before ``end`` are ``{name}``, bash's named descriptor.
+    Reads at most ``NAMED_FD_WINDOW`` bytes back; a name that runs past the window counts
+    as a named descriptor (fail closed), so the cost per redirection is bounded. An array
+    element (`{a[0]}>x`) is one too: any `]}` just before the redirection counts."""
+    if end < 2 or source[end - 1] != ord("}"):
+        return False
+    if source[end - 2] == ord("]"):
+        return True
+    start = end - 2
+    limit = max(0, end - 1 - NAMED_FD_WINDOW)
+    while start >= 0 and source[start] in _NAME_BYTES:
+        if start <= limit:
+            return True
+        start -= 1
+    if start < 0 or source[start] != ord("{"):
+        return False
+    name = source[start + 1 : end - 1]
+    return bool(name) and not name[:1].isdigit()
+
+
+def _is_zero(text: str) -> bool:
+    return bool(text) and text.isascii() and text.isdigit() and not text.lstrip("0")
+
+
+def _system_command_path(value: str) -> bool:
+    """True when ``value`` names a file directly in a system directory. Repeated slashes
+    collapse, as Linux resolves them (``//usr/bin/rm``); ``.`` and ``..`` never pass."""
+    collapsed = re.sub("/+", "/", value)
+    directory, _, name = collapsed.rpartition("/")
+    parts = collapsed.split("/")
+    if not name or "." in parts or ".." in parts:
+        return False
+    return directory in SYSTEM_DIRECTORIES
+
+
+def is_session_variable(name: str) -> bool:
+    """§3: an assignment to ``name`` alters the session."""
+    return name in SESSION_VARIABLES or name.startswith(SESSION_VARIABLE_PREFIXES)
+
+
+# -- the walker ----------------------------------------------------------------------------
+
+Handler = Callable[["_Walker", tree_sitter.Node, Context], object]
+
+
+class _Walker:
+    def __init__(self, source: bytes, result: Walk) -> None:
+        self.source = source
+        self.result = result
+        # Redirections of a pipeline or list that apply to one stage only, by node id
+        # (``_redirected_statement``).
+        self.attached: dict[int, tuple[Redirect, ...]] = {}
+        # Here-documents whose redirection node is being walked, and where each one's
+        # delimiter and body start (``redirect``, ``check_heredoc_order``).
+        self.open_heredocs = 0
+        self.heredocs: list[tuple[int, int]] = []
+
+    @property
+    def findings(self) -> Verdict:
+        return self.result.findings
+
+    def walk(
+        self, node: tree_sitter.Node, ctx: Context, handler: Handler | None = None
+    ) -> object:
+        """Visit ``node``: charge the budget, then run its kind's handler (or ``handler``,
+        which a parent uses for a node whose meaning depends on where it sits)."""
+        ctx.budget.spend()
+        depth = ctx.depth + 1
+        if depth > ctx.budget.depth:
+            raise BudgetExceeded(f"nesting deeper than {ctx.budget.depth} nodes")
+        registered = HANDLERS.get(node.type)
+        if registered is None:
+            raise UnhandledNode(node.type)
+        inner = ctx.nested(depth=depth)
+        attached = self.attached.pop(node.id, None)
+        if attached is not None:
+            inner = _apply(inner, attached)
+        return (handler or registered)(self, node, inner)
+
+    def children(self, node: tree_sitter.Node, ctx: Context) -> None:
+        for child in node.named_children:
+            self.walk(child, ctx)
+
+    # -- redirections ----------------------------------------------------------------------
+
+    def redirect(self, node: tree_sitter.Node) -> Redirect:
+        descriptor: str | None = None
+        operator = ""
+        target: Word | None = None
+        pattern = False
+        start: tree_sitter.Node | None = None
+        body: tree_sitter.Node | None = None
+        end: tree_sitter.Node | None = None
+        for index, child in enumerate(node.children):
+            name = node.field_name_for_child(index)
+            if child.type == "file_descriptor" or name == "descriptor":
+                descriptor = _text(child)
+            elif child.type == "heredoc_start":
+                start = child
+            elif child.type == "heredoc_body":
+                body = child
+            elif child.type == "heredoc_end":
+                end = child
+            elif not child.is_named:
+                operator = operator or _text(child)
+            elif target is None and (
+                name == "destination" or node.type == "herestring_redirect"
+            ):
+                target = word(child)
+                pattern = (
+                    _pattern(child)
+                    or _extglob_after(self.source, child.end_byte)
+                    or _extglob_inside(child)
+                )
+        kind = {"heredoc_redirect": "heredoc", "herestring_redirect": "herestring"}.get(
+            node.type, "file"
+        )
+        text: str | None = None
+        if kind == "herestring" and target is not None and target.literal:
+            text = f"{target.value}\n"
+        elif kind == "heredoc":
+            if self.result.unparseable:
+                # tree-sitter-bash may have matched the wrong lines to the body
+                # (`cat <<E;cat <<F` on one line): fail closed rather than trust it.
+                raise HeredocMismatch("a here-document in text the parser could not read")
+            if self.open_heredocs:
+                # `cat <<A | cat <<B`: tree-sitter-bash puts B's redirection inside A's
+                # and gives A's body to B. bash reads the bodies in operator order.
+                raise HeredocMismatch("a here-document inside another one's line")
+            if start is not None and body is not None:
+                self.heredocs.append((start.start_byte, body.start_byte))
+            _check_heredoc_end(
+                self.source, start, body, end, strip_tabs=operator == "<<-"
+            )
+            text = _heredoc_text(start, body, strip_tabs=operator == "<<-")
+        if descriptor is None and kind == "file" and not operator.startswith("&"):
+            descriptor = _digits_before(self.source, node.start_byte)
+        named_fd = descriptor is None and _named_fd_before(self.source, node.start_byte)
+        return Redirect(
+            kind=kind,
+            operator=operator,
+            descriptor=descriptor,
+            target=None if kind == "heredoc" else target,
+            named_fd=named_fd,
+            text=_text(node),
+            body=text,
+            pattern=kind == "file" and pattern,
+        )
+
+    def check_heredoc_order(self) -> None:
+        """bash reads here-document bodies in the order their ``<<`` operators appear.
+        Fail closed when the parser gave them out in another order."""
+        bodies = [body for _, body in sorted(self.heredocs)]
+        if bodies != sorted(bodies):
+            raise HeredocMismatch("here-document bodies out of order")
+
+    def check_redirect(self, redirect: Redirect) -> None:
+        """§2 output redirections and ``/dev/tcp``, §5 descriptors."""
+        findings = self.findings
+        target = redirect.target
+        if redirect.named_fd:
+            findings.reject(f"{DESCRIPTOR_REASON}: a named descriptor in {redirect.text!r}")
+        if redirect.descriptor is not None and not _below_three(redirect.descriptor):
+            findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+        if redirect.pattern:
+            # `>/dev/f?/3`: bash globs a redirection target, so it may name a descriptor.
+            findings.reject(f"{DESCRIPTOR_REASON}: a pattern in {redirect.text!r}")
+        if redirect.kind == "file" and self.result.unparseable:
+            # `>/dev/fd/3@(x|)`: in text the parser could not read, the target node may
+            # hold only part of the word bash opens. Fail closed, as here-documents do.
+            findings.reject(
+                f"{DESCRIPTOR_REASON}: a redirection in text the parser could not read:"
+                f" {redirect.text!r}"
+            )
+        if target is not None and target.value is not None:
+            if _NETWORK_PATH.search(target.value):
+                findings.raise_to(MUTATING, NETWORK_REASON)
+            if redirect.kind == "file":
+                opened = _descriptor_path(target.value)
+                if opened is not None and not _below_three(opened):
+                    findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+        op = redirect.operator
+        if op in _DUPLICATE_OPERATORS:
+            if target is None or not target.literal or target.value is None:
+                findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+            elif target.value.isascii() and target.value.isdigit():
+                if not _below_three(target.value):
+                    findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+            elif _MOVE_TARGET.fullmatch(target.value):
+                # `>&3-` moves descriptor 3 onto 1: it is a descriptor, not a file name.
+                if not _below_three(target.value[:-1]):
+                    findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+            elif target.value == "-":
+                pass
+            elif op == ">&":
+                # `>&file` is `&>file`: both output descriptors go to a file.
+                self._output(redirect, target)
+            else:
+                findings.reject(f"{DESCRIPTOR_REASON}: {redirect.text!r}")
+        elif op in _OUTPUT_OPERATORS:
+            self._output(redirect, target)
+
+    def _output(self, redirect: Redirect, target: Word | None) -> None:
+        if target is not None and target.literal and target.value == "/dev/null":
+            return
+        self.findings.raise_to(MUTATING, f"output redirection: {redirect.text!r}")
+
+    # -- assignments -----------------------------------------------------------------------
+
+    def check_assignment(self, assignment: Assignment, *, prefix: bool) -> None:
+        name = assignment.name
+        if name in REJECTED_VARIABLES:
+            self.findings.reject(f"assignment to {name}")
+        if prefix:
+            self.findings.raise_to(MUTATING, f"prefix assignment: {name}")
+        elif is_session_variable(name):
+            self.findings.raise_to(SESSION_ALTERING, f"assignment to {name}")
+
+
+def _assignment(node: tree_sitter.Node) -> Assignment:
+    name_node = node.child_by_field_name("name")
+    if name_node is None:
+        name_node = node.named_children[0] if node.named_child_count else node
+    if name_node.type == "subscript":
+        inner = name_node.child_by_field_name("name")
+        name_node = inner if inner is not None else name_node
+    match = _IDENTIFIER.match(_text(name_node))
+    name = match.group(0) if match else _text(name_node)
+    operator = next(
+        (_text(child) for child in node.children if not child.is_named), "="
+    )
+    value_node = node.child_by_field_name("value")
+    return Assignment(
+        name=name,
+        operator=operator,
+        value=word(value_node) if value_node is not None else None,
+        text=_text(node),
+    )
+
+
+def _assignment_word(assignment: Assignment) -> Word:
+    """``NAME=value`` as one argument word of ``export``/``declare``/…"""
+    head = f"{assignment.name}{assignment.operator}"
+    value = assignment.value
+    if value is None:
+        return _literal(head)
+    if value.value is None:
+        return Word(text=assignment.text, value=None, literal=False)
+    return Word(text=assignment.text, value=head + value.value, literal=value.literal)
+
+
+def _heredoc_text(
+    start: tree_sitter.Node | None, body: tree_sitter.Node | None, *, strip_tabs: bool
+) -> str | None:
+    """A here-document's text when it is literal: a quoted delimiter, or a body with no
+    ``$``, backquote or backslash. None otherwise. Raises ``UnreadHeredoc`` when an
+    unquoted body holds more substitutions than the parser found (tree-sitter-bash
+    0.25.1 reads none in a ``<<-`` body whose first line starts with a tab)."""
+    if body is None:
+        return ""
+    text = _text(body)
+    quoted = start is not None and any(q in _text(start) for q in ("'", '"', "\\"))
+    if not quoted:
+        if _substitutions_in(text) > _substitution_nodes(body):
+            raise UnreadHeredoc()
+        if any(char in text for char in "$`\\") or any(
+            c.type != "heredoc_content" for c in body.named_children
+        ):
+            return None
+    if strip_tabs:
+        text = "".join(line.lstrip("\t") for line in text.splitlines(keepends=True))
+    return text
+
+
+def _heredoc_delimiter(raw: str) -> str:
+    """The line that ends a here-document, as bash computes it from the word after
+    ``<<``: quote removal, no expansion (`E"F"` is `EF`, `\\E` is `E`). ``$'…'`` and
+    ``$"…"`` fail closed (bash decodes them; the gate does not)."""
+    out: list[str] = []
+    index = 0
+    while index < len(raw):
+        char = raw[index]
+        if char == "$" and raw[index + 1 : index + 2] in ("'", '"'):
+            raise HeredocMismatch(
+                f"a here-document delimiter the gate cannot read: {raw!r}"
+            )
+        if char == "\\":
+            out.append(raw[index + 1 : index + 2])
+            index += 2
+        elif char == "'":
+            close = raw.find("'", index + 1)
+            if close == -1:
+                raise HeredocMismatch(f"an unterminated quote in {raw!r}")
+            out.append(raw[index + 1 : close])
+            index = close + 1
+        elif char == '"':
+            index += 1
+            while index < len(raw) and raw[index] != '"':
+                if raw[index] == "\\" and raw[index + 1 : index + 2] in _DOUBLE_ESCAPED:
+                    index += 1
+                out.append(raw[index])
+                index += 1
+            if index >= len(raw):
+                raise HeredocMismatch(f"an unterminated quote in {raw!r}")
+            index += 1
+        else:
+            out.append(char)
+            index += 1
+    return "".join(out)
+
+
+def _check_heredoc_end(
+    source: bytes,
+    start: tree_sitter.Node | None,
+    body: tree_sitter.Node | None,
+    end: tree_sitter.Node | None,
+    *,
+    strip_tabs: bool,
+) -> None:
+    """Fail closed unless bash and the parser end the here-document on the same line:
+    the whole source line the parser ends on is bash's delimiter, and no body line
+    before it is."""
+    if start is None:
+        raise HeredocMismatch("a here-document with no delimiter")
+    delimiter = _heredoc_delimiter(_text(start))
+    line = b""
+    if end is not None and not end.is_missing:
+        first = source.rfind(b"\n", 0, end.start_byte) + 1
+        last = source.find(b"\n", end.end_byte)
+        line = source[first : last if last != -1 else len(source)]
+    if strip_tabs:
+        line = line.lstrip(b"\t")
+    if end is None or end.is_missing or line != delimiter.encode(*_ENCODING):
+        raise HeredocMismatch(
+            f"bash ends this here-document at {delimiter!r}, the parser does not"
+        )
+    text = _text(body) if body is not None else ""
+    for line in text.split("\n"):
+        if (line.lstrip("\t") if strip_tabs else line) == delimiter:
+            raise HeredocMismatch(
+                f"bash ends this here-document at an earlier {delimiter!r} line"
+            )
+
+
+def _substitutions_in(text: str) -> int:
+    """How many ``$(`` and backquoted substitutions an unquoted here-document body holds
+    (a backslash quotes the next character)."""
+    count = backquotes = 0
+    chars = iter(enumerate(text))
+    for index, char in chars:
+        if char == "\\":
+            next(chars, None)
+        elif char == "`":
+            backquotes += 1
+        elif char == "$" and text.startswith("(", index + 1):
+            count += 1
+    return count + (backquotes + 1) // 2
+
+
+def _substitution_nodes(node: tree_sitter.Node) -> int:
+    """Substitution and arithmetic nodes below ``node`` (``$((`` counts as one ``$(``)."""
+    found = 0
+    stack = list(node.named_children)
+    while stack:
+        child = stack.pop()
+        if child.type in ("command_substitution", "arithmetic_expansion"):
+            found += 1
+        stack.extend(child.named_children)
+    return found
+
+
+def _apply(ctx: Context, own: tuple[Redirect, ...]) -> Context:
+    """``ctx`` once a statement's own redirections apply."""
+    return ctx.nested(stdin=_stdin_after(own, ctx.stdin), redirects=own + ctx.redirects)
+
+
+def _last_stage(node: tree_sitter.Node) -> tree_sitter.Node:
+    """The stage a pipeline's or list's trailing redirections belong to: bash gives
+    `a | b <x` and `a && b >x` to `b` alone. tree-sitter-bash hangs them on the whole
+    pipeline or list."""
+    while node.type in ("pipeline", "list", "negated_command"):
+        stages = [child for child in node.named_children if child.type != "comment"]
+        if not stages:
+            break
+        node = stages[-1]
+    return node
+
+
+def _stdin_after(own: tuple[Redirect, ...] | list[Redirect], stdin: Stdin) -> Stdin:
+    """Where standard input comes from once ``own`` redirections apply."""
+    for redirect in own:
+        if not _is_zero(redirect.acts_on):
+            continue
+        op = redirect.operator
+        if redirect.kind in ("heredoc", "herestring"):
+            stdin = Stdin(redirect.kind, redirect.body)
+        elif op in ("<", "<>"):
+            target = redirect.target
+            stdin = Stdin("file", target.value if target and target.literal else None)
+        elif op == "<&":
+            stdin = Stdin("descriptor")
+        elif op == "<&-":
+            stdin = Stdin("closed")
+    return stdin
+
+
+# -- handlers ------------------------------------------------------------------------------
+
+
+def _leaf(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """A node whose parent reads its text. It has nothing below it to class; should the
+    grammar put a node below it anyway, that node is walked, so no command is dropped."""
+    if node.named_child_count:
+        w.children(node, ctx)
+
+
+def _children(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """A node whose meaning is its children's, in the same context."""
+    w.children(node, ctx)
+
+
+def _error(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """What the parser could not read: the tree is unparseable; its parts are still
+    walked. A here-document operator inside it fails closed (the parser cannot say
+    which lines are its body)."""
+    if any(child.type in ("<<", "<<-") for child in node.children):
+        raise HeredocMismatch("a here-document in text the parser could not read")
+    w.children(node, ctx)
+
+
+def _pipeline(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """Every stage after a ``|`` or ``|&`` reads the pipe. A here-document's pipeline
+    (``cat <<E | x``) starts with the ``|`` token, so its first stage reads the pipe too
+    (the v2 walker treated it as reading the terminal)."""
+    piped = False
+    for child in node.children:
+        if not child.is_named:
+            if child.type in ("|", "|&"):
+                piped = True
+            continue
+        w.walk(child, ctx.nested(stdin=PIPE) if piped else ctx)
+
+
+def _redirected_statement(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    own: list[Redirect] = []
+    bodies = []
+    for child in node.named_children:
+        if child.type.endswith("_redirect"):
+            own.append(w.walk(child, ctx))  # type: ignore[arg-type]
+        else:
+            bodies.append(child)
+    for body in bodies:
+        stage = _last_stage(body)
+        if stage.id == body.id:
+            w.walk(body, _apply(ctx, tuple(own)))
+        else:
+            w.attached[stage.id] = tuple(own)
+            w.walk(body, ctx)
+
+
+def _redirect(w: _Walker, node: tree_sitter.Node, ctx: Context) -> Redirect:
+    """A redirection: record it and check it, then walk what is inside it (a
+    substitution in its target, a here-document's body, and the pipeline or list that
+    continues after a here-document's start, which tree-sitter-bash puts inside it)."""
+    redirect = w.redirect(node)
+    w.check_redirect(redirect)
+    heredoc = redirect.kind == "heredoc"
+    w.open_heredocs += heredoc
+    try:
+        w.children(node, ctx)
+    finally:
+        w.open_heredocs -= heredoc
+    return redirect
+
+
+def _command(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    name: Word | None = None
+    args: list[Word] = []
+    assignments: list[Assignment] = []
+    own: list[Redirect] = []
+    nested = []
+    for child in node.named_children:
+        if _descriptor_word(w.source, child):
+            continue  # `a 0<x`: the redirection reads it as its descriptor
+        if child.type == "variable_assignment" and name is None and not args:
+            assignment = _assignment(child)
+            assignments.append(assignment)
+            w.walk(child, ctx, handler=_prefix_assignment)
+        elif child.type.endswith("_redirect"):
+            own.append(w.walk(child, ctx))  # type: ignore[arg-type]
+        elif child.type == "command_name":
+            name = word(child)
+            nested.append(child)
+        else:
+            args.append(word(child))
+            nested.append(child)
+    words = ((name,) if name is not None else ()) + tuple(args)
+    _check_words(w, words)
+    if name is not None:
+        _check_command_word(w, name)
+    w.result.invocations.append(
+        Invocation(
+            kind="command",
+            text=_text(node),
+            words=words,
+            assignments=tuple(assignments),
+            redirects=tuple(own) + ctx.redirects,
+            stdin=_stdin_after(own, ctx.stdin),
+        )
+    )
+    # Substitutions in the words run before the command's own redirections apply.
+    for child in nested:
+        w.walk(child, ctx)
+
+
+def _descriptor_word(source: bytes, node: tree_sitter.Node) -> bool:
+    """True for a bare digit word directly followed by ``<`` or ``>``: tree-sitter-bash
+    0.25.1 reads the `0` of `a 0<x` as an argument, bash as the redirection's descriptor
+    (``_Walker.redirect`` reads it back from the source)."""
+    return (
+        node.type in ("number", "word")
+        and not node.named_child_count
+        and _digits_before(source, node.end_byte) is not None
+        and source[node.end_byte : node.end_byte + 1] in (b"<", b">")
+        and source[node.end_byte : node.end_byte + 2] != b"<<"
+        and _text(node).isascii()
+        and _text(node).isdigit()
+    )
+
+
+def _check_words(w: _Walker, words: tuple[Word, ...]) -> None:
+    for item in words:
+        if item.value is not None and _NETWORK_PATH.search(item.value):
+            w.findings.raise_to(MUTATING, NETWORK_REASON)
+
+
+def _check_command_word(w: _Walker, name: Word) -> None:
+    """§2: a command word that is not a literal, or a path outside the system
+    directories."""
+    if not name.literal or name.value is None:
+        w.findings.raise_to(MUTATING, f"command word is not a literal: {name.text!r}")
+    elif "/" in name.value and not _system_command_path(name.value):
+        w.findings.raise_to(
+            MUTATING,
+            f"command word is a path outside the system directories: {name.value!r}",
+        )
+
+
+def _keyword_invocation(kind: str) -> Handler:
+    """``declaration_command`` and ``unset_command``: an invocation with the keyword as
+    command word; the command layer gives it meaning (#197)."""
+
+    def handler(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+        keyword = _text(node.children[0]) if node.child_count else ""
+        words = [_literal(keyword)]
+        for child in node.named_children:
+            if child.type == "variable_assignment":
+                words.append(_assignment_word(_assignment(child)))
+            else:
+                words.append(word(child))
+        _check_words(w, tuple(words))
+        w.result.invocations.append(
+            Invocation(
+                kind=kind,
+                text=_text(node),
+                words=tuple(words),
+                assignments=(),
+                redirects=ctx.redirects,
+                stdin=ctx.stdin,
+            )
+        )
+        w.children(node, ctx)
+
+    return handler
+
+
+def _variable_assignment(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """An assignment that sets a shell variable: standalone, in ``export``/``declare``/…,
+    or in an arithmetic ``for`` header. §3 and §5 apply."""
+    w.check_assignment(_assignment(node), prefix=False)
+    w.children(node, ctx)
+
+
+def _prefix_assignment(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """``VAR=x cmd``: §2 (any prefix assignment) and §5 (``SUDO_PROMPT``/``ASKPASS``)."""
+    w.check_assignment(_assignment(node), prefix=True)
+    w.children(node, ctx)
+
+
+def _function_definition(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    name = node.child_by_field_name("name")
+    label = _text(name) if name is not None else _text(node)
+    w.findings.raise_to(SESSION_ALTERING, f"function definition: {label!r}")
+    # The body runs later, when the function is called, not under these redirections,
+    # and with the caller's standard input, which may be a pipe.
+    w.children(node, ctx.nested(stdin=UNKNOWN, redirects=()))
+
+
+def _substitution(w: _Walker, node: tree_sitter.Node, ctx: Context) -> None:
+    """``$(…)``, `` `…` ``, ``<(…)``, ``>(…)``: the inner commands' output is
+    captured, so the redirections around do not apply to them; their standard input is
+    the one the shell has where the substitution is expanded."""
+    if node.type == "process_substitution":
+        w.findings.raise_to(MUTATING, PROCESS_SUBSTITUTION_REASON)
+    w.children(node, ctx.nested(redirects=()))
+
+
+_LEAVES = (
+    "ansi_c_string", "comment", "extglob_pattern", "file_descriptor", "heredoc_content",
+    "heredoc_end", "heredoc_start", "raw_string", "regex",
+    "special_variable_name", "string_content", "test_operator", "variable_name", "word",
+)  # fmt: skip
+_CONTAINERS = (
+    # statements: the same context reaches every child
+    "program", "list", "compound_statement", "subshell", "do_group", "if_statement",
+    "elif_clause", "else_clause", "while_statement", "for_statement",
+    "c_style_for_statement", "case_statement", "case_item", "negated_command",
+    "test_command", "variable_assignments",
+    # words and expressions: only substitutions inside them hold commands
+    "arithmetic_expansion", "array", "binary_expression", "brace_expression",
+    "command_name", "concatenation", "expansion", "heredoc_body", "number",
+    "parenthesized_expression", "postfix_expression", "simple_expansion", "string",
+    "subscript", "ternary_expression", "translated_string", "unary_expression",
+)  # fmt: skip
+
+HANDLERS: dict[str, Handler] = {
+    **{kind: _leaf for kind in _LEAVES},
+    **{kind: _children for kind in _CONTAINERS},
+    "command": _command,
+    "declaration_command": _keyword_invocation("declaration"),
+    "unset_command": _keyword_invocation("unset"),
+    "variable_assignment": _variable_assignment,
+    "function_definition": _function_definition,
+    "pipeline": _pipeline,
+    "ERROR": _error,
+    "redirected_statement": _redirected_statement,
+    "file_redirect": _redirect,
+    "heredoc_redirect": _redirect,
+    "herestring_redirect": _redirect,
+    "command_substitution": _substitution,
+    "process_substitution": _substitution,
+}
