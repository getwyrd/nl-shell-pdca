index 0000000..9ba0052
--- /dev/null
+++ b/targets/ubuntu-26.04/gate-vectors.toml
@@ -0,0 +1,73 @@
+# Policy-gate conformance vectors for the ubuntu-26.04 target
+# (docs/design/specs/policy-gate/v1.md, Conformance). tests/test_policy_gate.py runs every
+# entry through nl_shell.gate.classify; nl_shell.gate.vectors reads this file.
+#
+# This file holds the rows landed so far, not the whole table. The spec requires every
+# row (v1.md:245-249); the set is complete only when #192 (live-session resolution, §7)
+# lands. Rows whose answer depends on a later child (#197 command meaning, #198 the
+# allowlist, #190 sensitive locations) are added with that child.
+#
+# Each [[vector]]: `command` and `class` are required; `row`, `origin` ("proposal" or
+# "typed", default "proposal"), `label`, `rejected` (default false), `reason` (text one of
+# the gate's reasons contains) and `note` are optional. `class` is the gate's exact answer
+# today; a child that raises it updates the entry.
+
+[[vector]]
+row = 7
+command = "PAGER=sh git log"
+class = "mutating"
+reason = "prefix assignment"
+
+[[vector]]
+row = 13
+command = "LD_PRELOAD=./x.so ls"
+class = "mutating"
+reason = "prefix assignment"
+
+[[vector]]
+row = 14
+command = "cat </dev/tcp/example.org/80"
+class = "mutating"
+reason = "/dev/tcp"
+
+[[vector]]
+row = 15
+command = "ls > ~/.bashrc"
+class = "mutating"
+reason = "output redirection"
+
+[[vector]]
+row = 16
+command = "$'\\x72m' -rf ~"
+class = "mutating"
+reason = "command word is not a literal"
+note = "spec: mutating at least; #197 may raise it"
+
+[[vector]]
+row = 23
+command = "SUDO_PROMPT=x sudo true"
+class = "mutating"
+rejected = true
+reason = "SUDO_PROMPT"
+note = "#197 adds privileged for sudo"
+
+[[vector]]
+row = 25
+command = "echo hi >&3"
+class = "mutating"
+rejected = true
+reason = "descriptor"
+
+[[vector]]
+row = 30
+command = "ls ‮txt.exe"
+class = "mutating"
+rejected = true
+reason = "hidden character"
+note = "U+202E RIGHT-TO-LEFT OVERRIDE in a model proposal"
+
+[[vector]]
+row = 31
+command = "if true; then"
+class = "mutating"
+reason = "unparseable"
diff --git a/tests/test_policy_gate.py b/tests/test_policy_gate.py
new file mode 100644
index 0000000..567e6ce
--- /dev/null
+++ b/tests/test_policy_gate.py
@@ -0,0 +1,919 @@
+"""The policy gate's shell layer (#196): spec ``policy-gate/v1`` §1, the shell-level parts
+of §2, §3 and §5, and decision C (the gate fails closed).
+
+The command layer (``nl_shell.gate.rules``) is a stub here: every simple command is
+``mutating``, reason "not allowlisted". Live-session resolution (``nl_shell.gate.live``)
+is a fail-closed stub. So no result in this file is ``read-only``, and ``check`` asserts
+that for every case.
+
+The gate's modules are imported inside the tests, never at module level, so this file
+still loads (and fails) on a tree without them. The conformance rows come from
+``targets/ubuntu-26.04/gate-vectors.toml`` through the gate's own loader.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+COULD_NOT_CLASS = "could not class"
+STUB_REASON = "live-session resolution not implemented"
+LANDED_ROWS = {7, 13, 14, 15, 16, 23, 25, 30, 31}
+
+
+def check(command, cls, reason, *, rejected=False, origin="proposal", label=None):
+    """Classify ``command`` and assert its class, a reason, and the rejection."""
+    from nl_shell.gate import classify
+
+    result = classify(command, origin=origin, label=label)
+    assert result.cls == cls, (command, result)
+    assert any(reason in r for r in result.reasons), (command, reason, result)
+    assert not any(COULD_NOT_CLASS in r for r in result.reasons), (command, result)
+    assert result.rejected is rejected, (command, result)
+    assert result.cls != "read-only", (command, result)
+    log = result.as_log()
+    assert set(log) == {"class", "reasons", "rejected"}
+    assert log["class"] == cls and log["reasons"] == list(result.reasons)
+    return result
+
+
+def check_could_not_class(result):
+    assert result.cls == "privileged", result
+    assert result.rejected is True, result
+    assert any(COULD_NOT_CLASS in r for r in result.reasons), result
+
+
+def read_only_for(monkeypatch, *names):
+    """Make the command layer return ``read-only`` for the given command words."""
+    from nl_shell.gate import rules
+    from nl_shell.gate.verdict import Verdict
+
+    original = rules.classify
+
+    def fake(invocation, budget):
+        word = invocation.command_word
+        if word is not None and word.value in names:
+            return Verdict()
+        return original(invocation, budget)
+
+    monkeypatch.setattr(rules, "classify", fake)
+
+
+def record_invocations(monkeypatch):
+    """Record every invocation the command layer receives."""
+    from nl_shell.gate import rules
+
+    seen = []
+    original = rules.classify
+
+    def recorder(invocation, budget):
+        seen.append(invocation)
+        return original(invocation, budget)
+
+    monkeypatch.setattr(rules, "classify", recorder)
+    return seen
+
+
+def invocation_named(seen, name):
+    matches = [
+        i for i in seen if i.command_word is not None and i.command_word.value == name
+    ]
+    assert matches, (name, [i.text for i in seen])
+    return matches[0]
+
+
+# -- conformance vectors -------------------------------------------------------------------
+
+
+def test_conformance_vectors_from_the_target_file():
+    from nl_shell.gate import vectors
+
+    loaded = vectors.load("ubuntu-26.04")
+    assert {v.row for v in loaded} == LANDED_ROWS
+    for vector in loaded:
+        check(
+            vector.command,
+            vector.cls,
+            vector.reason or "",
+            rejected=vector.rejected,
+            origin=vector.origin,
+            label=vector.label,
+        )
+
+
+@pytest.mark.parametrize(
+    ("body", "message"),
+    [
+        (
+            '[[vector]]\nrow = 3\nclass = "mutating"\n',
+            "vector 1 (row 3): missing required field `command`",
+        ),
+        ('[[vector]]\ncommand = "ls"\n', "vector 1: missing required field `class`"),
+        ('[[vector]]\ncommand = "ls"\nclass = "harmless"\n', "vector 1: class 'harmless'"),
+        (
+            '[[vector]]\ncommand = "ls"\nclass = "mutating"\n'
+            '[[vector]]\ncommand = "ls"\nclass = "mutating"\nexpected = 1\n',
+            "vector 2: unknown key `expected`",
+        ),
+        ('[[vector]\ncommand = "ls"\n', "not valid TOML"),
+    ],
+)
+def test_vector_loader_rejects(tmp_path, body, message):
+    from nl_shell.gate import vectors
+
+    path = tmp_path / "gate-vectors.toml"
+    path.write_text(body, encoding="utf-8")
+    with pytest.raises(vectors.VectorError) as raised:
+        vectors.read(path)
+    assert message in str(raised.value)
+    assert str(path) in str(raised.value)
+
+
+def test_vectors_file_says_it_is_partial_until_192():
+    from nl_shell.gate import vectors
+    from nl_shell.targets import TARGETS_ROOT
+
+    path = TARGETS_ROOT / "ubuntu-26.04" / vectors.VECTORS_FILE
+    header = path.read_text(encoding="utf-8")
+    assert "rows landed so far" in header
+    assert "#192" in header and "v1.md:245-249" in header
+
+
+# -- §1.1 characters, §1.2 parse, §1.7 label -----------------------------------------------
+
+
+def test_hidden_character_typed_is_at_least_mutating():
+    check("ls ‮txt.exe", "mutating", "hidden character", origin="typed")
+
+
+def test_lone_surrogate_in_a_proposal_is_rejected():
+    check("ls \udcff", "mutating", "hidden character", rejected=True)
+
+
+@pytest.mark.parametrize(
+    ("command", "node"), [("if true; then", "MISSING fi"), ("case x in", "ERROR")]
+)
+def test_unparseable(command, node):
+    import tree_sitter
+
+    from nl_shell.gate import parse
+
+    check(command, "mutating", "unparseable")
+    tree = tree_sitter.Parser(parse.language()).parse(command.encode())
+    found = []
+
+    def visit(n):
+        if n.is_missing:
+            found.append(f"MISSING {n.type}")
+        if n.type == "ERROR":
+            found.append("ERROR")
+        for child in n.children:
+            visit(child)
+
+    visit(tree.root_node)
+    assert node in found, found
+
+
+def test_label_raises_never_lowers():
+    check("true", "destructive", "labelled it destructive", label="destructive")
+    result = check("true", "mutating", "not allowlisted", label="read-only")
+    assert not any("labelled" in r for r in result.reasons)
+
+
+def test_label_against_a_read_only_class(monkeypatch):
+    read_only_for(monkeypatch, "true")
+    check("true", "destructive", "labelled it destructive", label="destructive")
+    result = check("true", "mutating", STUB_REASON, label="read-only")
+    assert not any("labelled" in r for r in result.reasons)
+
+
+# -- shell-level §2 ------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("command", "reason"),
+    [
+        ("PAGER=sh git log", "prefix assignment"),
+        ("LD_PRELOAD=./x.so ls", "prefix assignment"),
+        ("LESSOPEN='|sh %s' less f", "prefix assignment"),
+        ("ls > ~/.bashrc", "output redirection"),
+        ("cat </dev/tcp/example.org/80", "/dev/tcp"),
+        ("$'\\x72m' -rf ~", "command word is not a literal"),
+        ("$(echo rm) -rf ~", "command word is not a literal"),
+        ("diff <(ls) <(ls)", "process substitution"),
+        ("/tmp/rm x", "path outside the system directories"),
+        ("./rm x", "path outside the system directories"),
+    ],
+)
+def test_static_rules(command, reason):
+    check(command, "mutating", reason)
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "echo x >/dev/null",
+        "echo x 2>&1",
+        "echo x 1>&2",
+        "echo x >&2",
+        "echo x 2>&1-",
+        "/usr/bin/rm x",
+        "//usr/bin/rm x",
+    ],
+)
+def test_no_shell_level_reason(command):
+    result = check(command, "mutating", "not allowlisted")
+    assert list(result.reasons) == ["not allowlisted"], result
+
+
+# -- shell-level §3 ------------------------------------------------------------------------
+
+
+def test_function_definition_is_session_altering():
+    check("f() { true; }", "session-altering", "function definition")
+
+
+def test_function_definition_reason_quotes_the_name():
+    """The name is attacker text: the reason holds its repr, never a raw control byte."""
+    result = check(
+        "function f\x1bg { :; }", "session-altering", "function definition", origin="typed"
+    )
+    assert not any("\x1b" in r for r in result.reasons), result
+    assert any("'f\\x1bg'" in r for r in result.reasons), result
+
+
+@pytest.mark.parametrize(
+    ("command", "name"),
+    [
+        ("PATH=x", "PATH"),
+        ("IFS=x", "IFS"),
+        ("LD_PRELOAD=x", "LD_PRELOAD"),
+        ("LD_LIBRARY_PATH=x", "LD_LIBRARY_PATH"),
+        ("GIT_DIR=x", "GIT_DIR"),
+        ("GIT_PAGER=x", "GIT_PAGER"),
+        ("PS1=x", "PS1"),
+        ("PYTHONPATH=x", "PYTHONPATH"),
+        ("NODE_OPTIONS=x", "NODE_OPTIONS"),
+        ("export PATH=./bin", "PATH"),
+        # A `mutating` reason first: `session-altering` still names the class.
+        ("A=1 true; PATH=x", "PATH"),
+    ],
+)
+def test_session_variable_assignment(command, name):
+    check(command, "session-altering", name)
+
+
+# -- shell-level §5 ------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "echo hi >&3",
+        "3>x",
+        "{fd}>x",
+        "exec 3>&-",
+        "echo x >&$x",
+        "cat <&$fd",
+        'echo x >&"$X"',
+        "echo x 2>&${FD}",
+        "echo x >&" + "4" * 40,
+        # `[n]>&digit-` moves descriptor `digit` onto n: these write to or read fd 3.
+        "echo hi >&3-",
+        "1>&3-",
+        "echo hi >&'3'-",
+        "cat <&3-",
+        "echo x >&" + "4" * 40 + "-",
+        # A named descriptor longer than the window the gate reads is still rejected.
+        "{" + "a" * 300 + "}>x",
+        "exec {" + "a" * 300 + "}>x",
+        # A path that opens one of the shell's own descriptors is that descriptor.
+        "echo x >/dev/fd/3",
+        "echo x >>/dev/fd/3",
+        "cat </dev/fd/3",
+        "echo x >&/dev/fd/3",
+        "echo x >/proc/self/fd/3",
+        "echo x >/proc/thread-self/fd/3",
+        "echo x >/proc/1234/task/1234/fd/3",
+        "echo x >//dev/fd/3",
+        "echo x >/dev/./fd/3",
+        "echo x >/dev/fd/03",
+        "echo x >'/dev/fd/3'",
+        "echo x >/dev/fd/" + "4" * 40,
+        # bash globs and brace-expands a redirection target, so a pattern may name one.
+        "echo x >/dev/f?/3",
+        "echo x >>/d*/fd/3",
+        "cat </dev/f[d]/3",
+        "echo x >/dev/fd/{3..3}",
+        # With extglob on (Ubuntu turns it on), these are patterns too; tree-sitter-bash
+        # ends the target word at the `(`.
+        "echo x >/dev/@(fd)/3",
+        "echo x >/dev/+(fd)/3",
+        "echo x >/dev/!(x)/3",
+        "echo x >/proc/@(self)/fd/3",
+        "echo x >/@(dev)/fd/3",
+        "echo x >/dev/fd/@(3)",
+        # An extglob in the middle of the target: the parser cannot read the rest of
+        # the line, and the target node holds only part of the word bash opens.
+        "echo hi >/dev/fd/3@(x|)",
+        "echo hi >>/dev/fd/3@(x|)",
+        "cat </dev/fd/3@(x|)",
+        # `/proc/<pid>/root` is a link to `/`; `..` after a link goes where it points.
+        "echo x >/proc/self/root/dev/fd/3",
+        "echo x >/proc/self/root/proc/self/fd/3",
+        "echo x >/proc/self/task/1/root/dev/fd/3",
+        "echo x >/dev/fd/../root/dev/fd/3",
+        # `/proc/<pid>/cwd` is a link to a working directory the gate does not know.
+        "echo x >/proc/self/cwd/3",
+        "echo x >/proc/self/task/1/cwd/3",
+        "echo x >/proc/1234/cwd/fd/3",
+        "echo x >/proc/self/root/proc/self/cwd/3",
+        # A named descriptor may be an array element.
+        "exec {a[0]}>&-",
+        "echo x {a[0]}>x",
+        "{a[0]}>x",
+    ],
+)
+def test_descriptor_not_provably_below_three_is_rejected(command):
+    check(command, "mutating", "descriptor", rejected=True)
+
+
+@pytest.mark.parametrize(
+    ("command", "cls"),
+    [
+        ("SUDO_PROMPT=x sudo true", "mutating"),
+        ("SUDO_ASKPASS=/x sudo true", "mutating"),
+        ("export SUDO_PROMPT=x", "session-altering"),
+        ("SUDO_ASKPASS=/x", "session-altering"),
+    ],
+)
+def test_sudo_prompt_and_askpass_assignments_are_rejected(command, cls):
+    check(command, cls, "SUDO_", rejected=True)
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "echo x >/dev/fd/2",
+        "echo x >/dev/fd/1",
+        "echo x >/dev/stderr",
+        "echo x >/proc/self/root/dev/fd/2",
+        # A quoted `*` is not a pattern.
+        "echo x >'/tmp/a*'",
+        "echo x >/tmp/a\\?",
+        # An extglob lead with no `(` after it is a plain character.
+        "echo x >/tmp/a@b",
+        "echo x >/tmp/a+",
+    ],
+)
+def test_descriptor_path_below_three_is_not_rejected(command):
+    check(command, "mutating", "output redirection")
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        # bash joins a backslash-newline before it splits words; tree-sitter-bash splits
+        # there. Each of these is a different command to bash than to the parser.
+        "echo x >\\\n&3",  # bash: >&3
+        "echo x <\\\n&3",  # bash: <&3
+        "echo x 3\\\n>y",  # bash: 3>y (the parser: argument 3, then >y)
+        "echo x 3\\\n\\\n>y",
+        "{f\\\nd}>x",  # bash: {fd}>x
