+@pytest.mark.parametrize("command", COVERAGE_CORPUS)
+def test_every_command_node_becomes_an_invocation(monkeypatch, command):
+    """A handler that skips its children drops a command (v2: `number` did, so the
+    `rm x` of `$((10#$(rm x)))` was never classed). Count the nodes against the
+    invocations."""
+    import tree_sitter
+
+    from nl_shell.gate import classify, parse
+
+    seen = record_invocations(monkeypatch)
+    result = classify(command)
+    assert not any(COULD_NOT_CLASS in r for r in result.reasons), result
+    tree = tree_sitter.Parser(parse.language()).parse(command.encode())
+    kinds = {"command", "declaration_command", "unset_command"}
+    stack, nodes = [tree.root_node], 0
+    while stack:
+        node = stack.pop()
+        nodes += node.type in kinds
+        stack.extend(node.named_children)
+    assert len(seen) == nodes, (command, [i.text for i in seen])
+    assert "rm" in {i.command_word.value for i in seen if i.command_word is not None}
