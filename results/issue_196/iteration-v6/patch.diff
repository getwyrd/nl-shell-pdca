+# Commands whose every `command`, `declaration_command` and `unset_command` node must
+# reach the command layer, whatever node kind the grammar puts above it.
+COVERAGE_CORPUS = [
+    "echo $((10#$(rm x)))",
+    "echo $((1 + $(rm x)))",
+    "echo ${a:-$(rm x)} ${a[$(rm y)]}",
+    "[[ $(rm x) == y ]]",
+    "x=$(rm a) y=`rm b`",
+    "a=( $(rm x) )",
+    "cat <<E\n$(rm x)\nE",
+    "for i in $(rm x); do :; done",
+    "case $(rm x) in $(rm y)) :;; esac",
+    "echo $\"$(rm x)\"",
+    "export A=$(rm x); unset $(rm y)",
+    "f() { rm x; } >$(rm y)",
+]
