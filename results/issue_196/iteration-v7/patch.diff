+def stdin_of(command: str) -> dict[str, tuple[str, str | None]]:
+    layer = shell().shell_layer(command)
+    out = {}
+    for invocation in layer.invocations:
+        out[invocation.words[0].text] = (invocation.stdin.kind, invocation.stdin.value)
+    return out
+
