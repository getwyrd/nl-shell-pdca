+def test_rule1_names_each_feature():
+    parse = shell()
+    expected = {
+        "U1": "missing token",
+        "U2": "syntax error",
+        "U3": "backslash-newline",
+        "U4": "here-doc delimiter",
+        "U5": "here-doc delimiter",
+        "U6": "here-doc delimiter",
+        "U7": "<<-",
+        "U8": "more than one here-doc",
+        "U9": "extglob",
+        "U10": "extglob",
+        "U11": "extglob",
+        "U12": "extglob",
+        "U13": "extglob",
+        "U14": "${ }",
