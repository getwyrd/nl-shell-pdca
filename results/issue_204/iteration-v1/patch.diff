new file mode 100644
index 0000000..80247ce
--- /dev/null
+++ b/scripts/harvest_inventory.py
@@ -0,0 +1,201 @@
+"""Write ``targets/ubuntu-26.04/inventory.toml`` from this Ubuntu 26.04 host (#204).
+
+Spec ``policy-gate/v1`` §4.1, class 1 (coverage): every binary on the target that
+elevates, or that runs a shell or an interpreter, has a row in the target's
+``commands.toml``, under every name that points at the same file. This script lists those
+names, from the host it runs on:
+
+- regular files with the setuid or setgid bit, or a file capability
+  (``security.capability``), directly in ``/usr/bin``, ``/usr/sbin`` and
+  ``/usr/lib/cargo/bin``;
+- the shells in ``/etc/shells``;
+- the binaries in those folders of every installed dpkg package in section ``shells`` or
+  ``interpreters``;
+- the names there matching ``python3*``, ``perl*``, ``busybox`` or ``gdb``;
+- every name there whose ``realpath`` is the ``realpath`` of a name above or of a row's
+  name in ``commands.toml`` (``sudo-rs`` and ``sudoedit-rs`` are the file ``sudo`` is).
+
+Usage::
+
+    python3 scripts/harvest_inventory.py [--output PATH]
+
+The file records the host's os-release ``VERSION`` line. It is checked in and reviewed
+like an allowlist change; no test runs this script. A reviewer re-runs it on the
+reference host and diffs the result against the checked-in file: any difference is a
+finding (the drift is judged by a human, not by a gate).
+"""
+
+from __future__ import annotations
+
+import argparse
+import fnmatch
+import os
+import stat
+import subprocess
+import sys
+import tomllib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+TARGET = REPO / "targets" / "ubuntu-26.04"
+OUTPUT = TARGET / "inventory.toml"
+COMMANDS = TARGET / "commands.toml"
+DIRS = ("/usr/bin", "/usr/sbin", "/usr/lib/cargo/bin")
+SHELLS = Path("/etc/shells")
+OS_RELEASE = Path("/etc/os-release")
+SECTIONS = ("shells", "interpreters")
+PATTERNS = ("python3*", "perl*", "busybox", "gdb")
+HEADER = """\
+# Binaries on the ubuntu-26.04 target that elevate, or that run a shell or an
+# interpreter (spec policy-gate/v1 §4.1, class 1). Every name here MUST have a row in
+# commands.toml (tests/test_gate_commands.py checks it).
+#
+# GENERATED by scripts/harvest_inventory.py on the reference host; do not edit by hand.
+# Reviewed like an allowlist change. Drift against the host is judged by a human at
+# review (re-run the script there and diff), not by a test.
+"""
+
+
+def entries() -> dict[str, Path]:
+    """Every entry directly in ``DIRS``, keyed by its path."""
+    found: dict[str, Path] = {}
+    for folder in DIRS:
+        try:
+            names = sorted(os.listdir(folder))
+        except OSError:
+            continue
+        for name in names:
+            found[os.path.join(folder, name)] = Path(folder, name)
+    return found
+
+
+def has_capability(path: str) -> bool:
+    try:
+        return bool(os.getxattr(path, "security.capability", follow_symlinks=False))
+    except OSError:
+        return False
+
+
+def package_binaries() -> dict[str, str]:
+    """``path -> package`` for the binaries in ``DIRS`` of packages in ``SECTIONS``."""
+    listing = subprocess.run(
+        ["dpkg-query", "-W", "-f", "${Section}\t${Package}\n"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout
+    out: dict[str, str] = {}
+    for line in listing.splitlines():
+        section, _, package = line.partition("\t")
+        if section.rsplit("/", 1)[-1] not in SECTIONS:
+            continue
+        files = subprocess.run(
+            ["dpkg-query", "-L", package], check=True, capture_output=True, text=True
+        ).stdout
+        for path in files.splitlines():
+            if os.path.dirname(path) in DIRS and os.path.lexists(path):
+                out[path] = package
+    return out
+
+
+def row_names() -> tuple[set[str], tuple[str, ...]]:
+    doc = tomllib.loads(COMMANDS.read_text(encoding="utf-8"))
+    names: set[str] = set()
+    patterns: list[str] = []
+    for row in doc.get("command", []):
+        names.update(row.get("names", []))
+        patterns.extend(row.get("patterns", []))
+    return names, tuple(patterns)
+
+
+def version_line() -> str:
+    for line in OS_RELEASE.read_text(encoding="utf-8").splitlines():
+        if line.startswith("VERSION="):
+            return line.partition("=")[2].strip().strip('"')
+    raise SystemExit(f"{OS_RELEASE}: no VERSION line")
+
+
+def harvest() -> dict[str, dict[str, set[str]]]:
+    """``name -> {"paths": {...}, "why": {...}}``."""
+    listed: dict[str, dict[str, set[str]]] = {}
+
+    def add(path: str, why: str) -> None:
+        entry = listed.setdefault(os.path.basename(path), {"paths": set(), "why": set()})
+        entry["paths"].add(path)
+        entry["why"].add(why)
+
+    all_entries = entries()
+    for path in all_entries:
+        try:
+            info = os.lstat(path)
+        except OSError:
+            continue
+        if not stat.S_ISREG(info.st_mode):
+            continue
+        if info.st_mode & stat.S_ISUID:
+            add(path, "setuid")
+        if info.st_mode & stat.S_ISGID:
+            add(path, "setgid")
+        if has_capability(path):
+            add(path, "file capability")
+    for line in SHELLS.read_text(encoding="utf-8").splitlines():
+        line = line.split("#", 1)[0].strip()
+        if line and os.path.lexists(line):
+            add(line, "/etc/shells")
+    for path, package in package_binaries().items():
+        add(path, f"dpkg package {package}")
+    for path in all_entries:
+        name = os.path.basename(path)
+        if any(fnmatch.fnmatchcase(name, p) for p in PATTERNS):
+            add(path, "name pattern")
+
+    # Every name for the same files: the other names of a listed binary, and every name
+    # of a row's binary (`gnurm` is the file `rm` is, `systemd-run` the file `run0` is).
+    names, patterns = row_names()
+
+    def is_row(name: str) -> bool:
+        return name in names or any(fnmatch.fnmatchcase(name, p) for p in patterns)
+
+    seeds = {os.path.realpath(p) for entry in listed.values() for p in entry["paths"]}
+    seeds |= {os.path.realpath(p) for p in all_entries if is_row(os.path.basename(p))}
+    for path in all_entries:
+        target = os.path.realpath(path)
+        if target in seeds:
+            add(path, f"same file as {target}" if target != path else "a row's binary")
+    for entry in listed.values():
+        for path in list(entry["paths"]):
+            target = os.path.realpath(path)
+            if target != path:
+                entry["why"].add(f"same file as {target}")
+    return listed
+
+
+def render(listed: dict[str, dict[str, set[str]]], version: str) -> str:
+    def quote(text: str) -> str:
+        return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+    lines = [HEADER, f"host_version = {quote(version)}", ""]
+    for name in sorted(listed):
+        entry = listed[name]
+        lines.append("[[binary]]")
+        lines.append(f"name = {quote(name)}")
+        paths = ", ".join(quote(p) for p in sorted(entry["paths"]))
+        why = ", ".join(quote(w) for w in sorted(entry["why"]))
+        lines.append(f"paths = [{paths}]")
+        lines.append(f"why = [{why}]")
+        lines.append("")
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    args = parser.parse_args(argv)
+    text = render(harvest(), version_line())
+    args.output.write_text(text, encoding="utf-8")
+    print(f"wrote {args.output}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
