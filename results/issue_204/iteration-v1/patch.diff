+
+def _ansi_c(source: str, i: int) -> tuple[str, int] | None:
+    """Decode one ``$'…'`` body starting at ``i``; returns the text and the index after
+    the closing quote."""
+    out: list[str] = []
+    cut = False
+    n = len(source)
+    while i < n:
+        c = source[i]
+        if c == "'":
+            return "".join(out), i + 1
+        if c != "\\":
+            char, i = c, i + 1
+        else:
+            if i + 1 >= n:
+                return None
+            e = source[i + 1]
+            i += 2
+            if e in _SIMPLE_ESCAPES:
+                char = _SIMPLE_ESCAPES[e]
+            elif e in "01234567":
