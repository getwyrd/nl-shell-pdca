+def readable(word: Word) -> str | None:
+    """The word as bash passes it, or None when the gate cannot read it.
+
+    A literal word is its quote-removed text. A word whose only non-literal part is
+    ANSI-C quoting (``$'…'``) is decoded as bash does: the escapes below, and the text
+    of one ``$'…'`` cut at its first NUL (bash keeps the rest of the word). Any other
+    expansion, a glob, an undecodable escape or a word the gate made up for unseen
+    input gives None.
+    """
+    if word.literal:
+        return word.text
+    source = word.source
+    if not source:
+        return None
+    _, causes = parse.lex_word(source)
+    if causes != {"expansion"} or "$'" not in source:
+        return None
+    out: list[str] = []
+    i, n = 0, len(source)
+    while i < n:
+        c = source[i]
+        if c == "\\":
+            if i + 1 >= n or source[i + 1] == "\n":
+                return None
+            out.append(source[i + 1])
+            i += 2
+        elif c == "'":
+            end = source.find("'", i + 1)
+            if end < 0:
+                return None
+            out.append(source[i + 1 : end])
+            i = end + 1
+        elif c == '"':
+            j = i + 1
+            while j < n and source[j] != '"':
+                if source[j] in "$`":
+                    return None
+                if source[j] == "\\" and j + 1 < n and source[j + 1] in '$`"\\':
+                    out.append(source[j + 1])
+                    j += 2
+                    continue
+                if source[j] == "\\" and j + 1 < n and source[j + 1] == "\n":
+                    return None
+                out.append(source[j])
+                j += 1
+            if j >= n:
+                return None
+            i = j + 1
+        elif c == "$" and source[i + 1 : i + 2] == "'":
+            decoded = _ansi_c(source, i + 2)
+            if decoded is None:
+                return None
+            text, i = decoded
+            out.append(text)
+        elif c in _UNQUOTED_SPECIAL:
+            return None
+        else:
+            out.append(c)
+            i += 1
+    return "".join(out)
