+    # --- argv parsing ----------------------------------------------------------------
+
+    def _parse(self, grammar: commands.Grammar, args: list[Word]) -> _Parsed:
+        parsed = _Parsed()
+        words = self._old_style(grammar, list(args))
+        current = grammar
+        options_on = True
+        i = 0
+        while i < len(words):
+            word = words[i]
+            text = readable(word)
+            if options_on and text is not None:
+                if text == "--" and "--" not in current.options:
+                    options_on = False
+                    i += 1
+                    continue
+                before = len(parsed.present)
+                step = self._option(current, text, words, i, parsed)
+                if step:
+                    i += step
+                    if any(o.last for o, _, _ in parsed.present[before:]):
+                        options_on = False
+                    continue
+            elif options_on and text is None:
+                # It may be any option, `--`, or an operand.
+                parsed.unreadable_options += 1
+            # An operand.
+            subcommand_next = parsed.sub is None and parsed.undescribed is None
+            if current.subcommands is not None and subcommand_next:
+                if text is None:
+                    parsed.unreadable_sub = True
+                    parsed.tail = words[i + 1 :]
+                    break
+                sub = current.subcommands.get(text)
+                if sub is None:
+                    parsed.undescribed = text
+                    parsed.tail = words[i + 1 :]
+                    break
+                parsed.sub, parsed.sub_name = sub, text
+                current = sub
+                parsed.operands = []
+                options_on = True
+                i += 1
+                continue
+            if current.parse == "posix":
+                options_on = False
+            effect = self._command_at(current, parsed)
+            if effect is not None and len(parsed.operands) == effect.at:
+                parsed.inner = words[i:]
+                parsed.inner_effect = effect
+                break
+            parsed.operands.append(word)
+            i += 1
+        if parsed.inner_effect is None:
+            effect = self._command_at(current, parsed)
+            if effect is not None:
+                parsed.inner_effect = effect
+                parsed.inner = []
+        return parsed
+
+    @staticmethod
+    def _command_at(grammar: commands.Grammar, parsed: _Parsed) -> commands.Effect | None:
+        keys = parsed.keys()
+        for effect in grammar.effects:
+            if effect.effect == "runs-command-at" and _holds(effect, keys):
+                return effect
+        return None
+
+    @staticmethod
+    def _old_style(grammar: commands.Grammar, words: list[Word]) -> list[Word]:
+        """``tar xf a.tar``: a first word with no dash is a bundle of short options, whose
+        values are the next words in order."""
+        if not grammar.old_style or not words:
+            return words
+        first = readable(words[0])
+        if first is None or not first or first.startswith("-"):
+            return words
+        out: list[Word] = []
+        rest = words[1:]
+        for char in first:
+            out.append(Word(text="-" + char, literal=True, source="-" + char))
+            option = grammar.options.get("-" + char)
+            if option is not None and option.value not in ("none", "optional") and rest:
+                count = option.value if isinstance(option.value, int) else 1
+                out.extend(rest[:count])
+                rest = rest[count:]
+        return out + rest
+
+    def _option(
+        self, grammar, text: str, words: list[Word], i: int, parsed: _Parsed
+    ) -> int:
+        """Read the option at ``words[i]``; returns how many words it used (0: an
+        operand)."""
+        options = grammar.options
+
+        def take(option, spelling, attached: str | None) -> int:
+            values: list[Word] = []
+            used = 1
+            if attached is not None:
+                values.append(Word(text=attached, literal=True, source=attached))
+            elif option.value == "required" or isinstance(option.value, int):
+                count = option.value if isinstance(option.value, int) else 1
+                values = list(words[i + 1 : i + 1 + count])
+                used += len(values)
+            parsed.present.append((option, values, spelling))
+            for effect in option.effects:
+                if effect.effect == "runs-command-at":
+                    end, stop = self._until(words, i + used, effect.until)
+                    parsed.option_inners.append((option, effect, words[i + used : end]))
+                    return end - i + (1 if stop else 0)
+            return used
+
+        option = options.get(text)
+        if option is not None:
+            return take(option, text, None)
+        if grammar.flag_patterns and any(p.fullmatch(text) for p in grammar.flag_patterns):
+            parsed.present.append((commands.Option(key=text, spellings=(text,)), [], text))
+            return 1
+        long = text.startswith("--") or (grammar.parse == "long" and text.startswith("-"))
+        if long and len(text) > 1:
+            name, eq, value = text.partition("=")
+            option = options.get(name)
+            if option is not None and eq:
+                if option.value == "none":
+                    parsed.unknown.append(text)
+                    return 1
+                return take(option, name, value)
+            parsed.unknown.append(text)
+            return 1
+        plus = text.startswith("+") and (
+            grammar.plus or any(o.plus for o in options.values())
+        )
+        if (text.startswith("-") or plus) and len(text) > 1:
+            sign = text[0]
+            j = 1
+            while j < len(text):
+                spelling = "-" + text[j]
+                option = options.get(spelling)
+                if option is None or (sign == "+" and not (grammar.plus or option.plus)):
+                    parsed.unknown.append(text)
+                    return 1
+                rest = text[j + 1 :]
+                if option.value == "none":
+                    parsed.present.append((option, [], sign + text[j]))
+                    for effect in option.effects:
+                        if effect.effect == "runs-command-at":
+                            end, stop = self._until(words, i + 1, effect.until)
+                            inner = words[i + 1 : end]
+                            parsed.option_inners.append((option, effect, inner))
+                            return end - i + (1 if stop else 0)
+                    j += 1
+                    continue
+                if option.value == "optional":
+                    return take(option, spelling, rest)
+                if rest:
+                    return take(option, spelling, rest)
+                return take(option, spelling, None)
+            return 1
+        return 0
+
+    @staticmethod
+    def _until(words: list[Word], start: int, until: tuple[str, ...]) -> tuple[int, bool]:
+        """Where an inner command that starts at ``start`` ends: at a word in ``until``
+        (``+`` only right after ``{}``, as ``find`` reads it), or at the end."""
+        for k in range(start, len(words)):
+            text = readable(words[k])
+            if text is None:
+                continue
+            after_braces = k > start and words[k - 1].source == "{}"
+            if text in until and (text != "+" or after_braces):
+                return k, True
+        return len(words), False
