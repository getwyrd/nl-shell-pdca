--- /dev/null
+++ b/src/nl_shell/gate/commands.py
@@ -0,0 +1,661 @@
+"""Loading the command table, ``targets/<id>/commands.toml`` (issue #204).
+
+Spec ``policy-gate/v1`` §4.1. The table is the gate's only source of per-command meaning:
+each row gives a command's argv grammar and its effects from one fixed set, and the one
+engine in ``nl_shell.gate.rules`` reads it. Nothing about a command is in code.
+
+The loader takes no path. It reads ``TARGETS_ROOT / TARGET_ID / COMMANDS_FILE`` and
+refuses a path that resolves outside ``TARGETS_ROOT`` (as ``nl_shell.targets.load``
+does). It reads no environment variable and nothing relative to the cwd or ``HOME``.
+Choosing the target from os-release is a later issue; the id is fixed here.
+
+A missing or invalid table raises ``CommandsError``; the gate turns that into decision C
+for every command, never into a silent ``mutating``.
+
+File format (``format = 1``), one ``[[command]]`` table per row:
+
+- ``names`` (command words) and/or ``patterns`` (``fnmatch`` patterns, ``mkfs*``);
+- ``example``: a minimal invocation; ``prefix``: the words before the inner command,
+  required on a row with ``runs-command-at``;
+- ``class`` (at least ``mutating``, default ``mutating``) and ``reason`` (default
+  "not allowlisted"): what the row gives when no effect says more;
+- ``fixed = true``: the row's effects do not depend on argv, so argv is not parsed (its
+  words still go through decision A); otherwise ``parse`` is ``gnu`` (options anywhere
+  before ``--``), ``posix`` (options end at the first operand) or ``long`` (each word
+  matched whole, one or two dashes, ``find``/``gdb`` style);
+- ``options``: a table from spellings (``"-r|-R|--recursive"``) to an option: ``value``
+  (``none``, ``required``, ``optional`` or a word count), ``effects``, ``rejects`` (a
+  reason: the option is rejected, spec §5), ``gap = "class-7"`` (named options only),
+  ``last`` (options end after it), ``replace`` (its value is a replace string, ``xargs``),
+  ``name`` (its value is a variable name), ``plus`` (``+x`` is accepted too);
+- ``flag_patterns``: regular expressions for flags that are not a fixed list (``-9``);
+- ``plus`` (``+x`` options), ``old_style`` (``tar xf``: a first word with no dash is a
+  bundle of short options);
+- ``effects``: a list of effects, each a name or a table (below);
+- ``subcommands``: a table from subcommand names (``"stop|kill"``) to a table with the
+  same grammar keys; a subcommand not listed gets the row's ``class`` and ``reason``;
+- ``no_command`` (``nothing`` or ``opens-shell``) and ``terminal_stdin`` (``inherits``,
+  ``opens-shell`` or ``runs-code``): required on every grammar with ``runs-command-at``,
+  and ``terminal_stdin`` on every grammar with ``runs-stdin-as-code``.
+
+An effect table has ``effect`` and, as needed: ``grammar`` (required on a text effect),
+``when`` / ``unless`` (option spellings), ``if`` (a condition on the words), ``at`` (the
+operand where an inner command starts, or ``"after"`` the option), ``until`` (words that
+end an inner command), ``appends`` (input adds words to the inner command), ``assignments``
+(``NAME=value`` words come before the inner command), ``name`` (operands are variable
+names), ``scope`` (of ``sets-variable``: ``session`` or ``command``), ``reason``.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import functools
+import re
+import tomllib
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any
+
+from nl_shell import targets
+from nl_shell.gate.parse import CLASSES, RANK
+
+# The fixed load location. Tests point TARGETS_ROOT at a temporary folder (and clear the
+# cache with ``table.cache_clear()``); nothing else changes where the table comes from.
+TARGETS_ROOT = targets.TARGETS_ROOT
+# The one target with a table. Choosing it from os-release is a later issue; until then
+# the id is fixed here, the one place package code names a target (tests/test_targets.py).
+TARGET_ID = "ubuntu-26.04"
+COMMANDS_FILE = "commands.toml"
+FORMAT = 1
+
+EFFECTS = (
+    "runs-command-at",
+    "runs-text",
+    "runs-stdin-as-code",
+    "runs-file-as-code",
+    "stores-code",
+    "sets-variable",
+    "elevates",
+    "destroys",
+    "reads-terminal",
+    "opens-shell",
+    "alters-session",
+)
+TEXT_EFFECTS = ("runs-text", "runs-stdin-as-code", "runs-file-as-code", "stores-code")
+# Every text effect names the language of its text. The text-reading layer (child-2 of
+# #197) parses some of these; until it lands every text effect is decision B.
+GRAMMARS = (
+    "bash",
+    "sh",
+    "zsh",
+    "env-split",
+    "arithmetic",
+    "python",
+    "perl",
+    "tcl",
+    "js",
+    "gdb",
+    "screen",
+    "tmux",
+    "elf",
+    "ssh-config",
+    "remote-sh",
+    "cpp",
+)
+CONDITIONS = (
+    "operand",  # the operand at `at` (default 0) exists
+    "no-operand",
+    "assignment",  # an operand is NAME=value, or a word the gate cannot read
+    "nonliteral-operand",
+    "operand-prefix:+",
+    "operand-prefix::",
+    "word:-1",
+    "joined-special",  # an inner word that sh would not read as one plain word
+)
+PARSE_STYLES = ("gnu", "posix", "long")
+VALUES = ("none", "required", "optional")
+NO_COMMAND = ("nothing", "opens-shell")
+TERMINAL_STDIN = ("inherits", "opens-shell", "runs-code")
+# Spec §4.1, class 7: the code-running options of floor rows 8, 10 and 11 that stay at
+# the row's default. The loader accepts `gap = "class-7"` only on these.
+CLASS7_GAP = frozenset(
+    (
+        ("git", "-c"),
+        ("git", "--config-env"),
+        ("git", "--exec-path"),
+        ("tar", "--to-command"),
+        ("ssh", "-o"),
+    )
+)
+
+_ROW_KEYS = frozenset(
+    (
+        "names",
+        "patterns",
+        "example",
+        "prefix",
+        "class",
+        "reason",
+        "fixed",
+        "parse",
+        "plus",
+        "old_style",
+        "options",
+        "flag_patterns",
+        "effects",
+        "subcommands",
+        "no_command",
+        "terminal_stdin",
+        "note",
+    )
+)
+_GRAMMAR_KEYS = frozenset(
+    (
+        "class",
+        "reason",
+        "parse",
+        "plus",
+        "old_style",
+        "options",
+        "flag_patterns",
+        "effects",
+        "no_command",
+        "terminal_stdin",
+        "note",
+    )
+)
+_FIXED_KEYS = frozenset(
+    ("names", "patterns", "example", "class", "reason", "fixed", "effects", "note")
+)
+_OPTION_KEYS = frozenset(
+    ("value", "effects", "rejects", "gap", "last", "replace", "name", "plus")
+)
+_EFFECT_KEYS = frozenset(
+    (
+        "effect",
+        "grammar",
+        "when",
+        "unless",
+        "if",
+        "at",
+        "until",
+        "appends",
+        "assignments",
+        "name",
+        "scope",
+        "reason",
+    )
+)
+
+
+class CommandsError(Exception):
+    """The command table could not be loaded; the message says why."""
+
+
+@dataclass(frozen=True)
+class Effect:
+    effect: str
+    grammar: str | None = None
+    when: frozenset[str] = frozenset()  # option keys: applies only if one is present
+    unless: frozenset[str] = frozenset()  # option keys: off if one is present
+    cond: str | None = None
+    at: int | str | None = None
+    until: tuple[str, ...] = ()
+    appends: bool = False
+    assignments: bool = False
+    name: bool = False
+    scope: str | None = None
+    reason: str | None = None
+
+    @property
+    def text(self) -> bool:
+        return self.effect in TEXT_EFFECTS
+
+
+@dataclass(frozen=True)
+class Option:
+    key: str  # its first spelling
+    spellings: tuple[str, ...]
+    value: str | int = "none"
+    effects: tuple[Effect, ...] = ()
+    rejects: str | None = None
+    gap: str | None = None
+    last: bool = False
+    replace: str | None = None  # the default replace string, when it takes one
+    name: bool = False
+    plus: bool = False
+
+
+@dataclass(frozen=True)
+class Grammar:
+    label: str  # "rm", "git clean"
+    parse: str
+    options: Mapping[str, Option]  # spelling -> option
+    flag_patterns: tuple[re.Pattern, ...]
+    effects: tuple[Effect, ...]
+    cls: str
+    reason: str
+    plus: bool = False
+    old_style: bool = False
+    subcommands: Mapping[str, Grammar] | None = None
+    no_command: str | None = None
+    terminal_stdin: str | None = None
+
+    def all_effects(self) -> tuple[Effect, ...]:
+        found = list(self.effects)
+        for option in {id(o): o for o in self.options.values()}.values():
+            found.extend(option.effects)
+        return tuple(found)
+
+
+@dataclass(frozen=True)
+class Row:
+    names: tuple[str, ...]
+    patterns: tuple[str, ...]
+    example: str
+    prefix: str | None
+    fixed: bool
+    grammar: Grammar
+    elevates: bool  # some effect of the row elevates (decision A)
+    destroys: bool  # some effect of the row destroys (decision A)
+    runs_code: bool  # it runs a shell or code whatever its options (elevation rule)
+    opens_shell_with_no_command: bool
+    reads_argv: bool = field(default=True)
+
+    @property
+    def name(self) -> str:
+        return self.names[0] if self.names else self.patterns[0]
+
+
+@dataclass(frozen=True)
+class Table:
+    rows: tuple[Row, ...]
+    by_name: Mapping[str, Row]
+
+    def lookup(self, word: str) -> Row | None:
+        """The row for a command word: by name, then by the last path component, then
+        by pattern."""
+        if not word:
+            return None
+        row = self.by_name.get(word)
+        if row is not None:
+            return row
+        base = word.rsplit("/", 1)[-1]
+        if base != word:
+            row = self.by_name.get(base)
+            if row is not None:
+                return row
+        for row in self.rows:
+            if any(fnmatch.fnmatchcase(base, p) for p in row.patterns):
+                return row
+        return None
+
+
+@functools.cache
+def table() -> Table:
+    """The command table, loaded once."""
+    return load()
+
+
+def load() -> Table:
+    """Load and validate ``TARGETS_ROOT / TARGET_ID / COMMANDS_FILE``."""
+    root = TARGETS_ROOT
+    path = root / TARGET_ID / COMMANDS_FILE
+    try:
+        inside = path.resolve().is_relative_to(root.resolve())
+    except OSError as exc:
+        raise CommandsError(f"{path}: cannot resolve: {exc.strerror or exc}") from None
+    if not inside:
+        raise CommandsError(f"{path}: resolves outside {root}")
+    try:
+        data = path.read_bytes()
+    except FileNotFoundError:
+        raise CommandsError(f"{path}: missing") from None
+    except OSError as exc:
+        raise CommandsError(f"{path}: cannot read: {exc.strerror or exc}") from None
+    try:
+        doc = tomllib.loads(data.decode("utf-8"))
+    except UnicodeDecodeError:
+        raise CommandsError(f"{path}: not valid TOML: not valid UTF-8") from None
+    except tomllib.TOMLDecodeError as exc:
+        raise CommandsError(f"{path}: not valid TOML: {exc}") from None
+    return validate(doc, str(path))
+
+
+def validate(doc: Mapping[str, Any], where: str = "commands.toml") -> Table:
+    """Validate a parsed table. Raises ``CommandsError`` naming the row."""
+    extra = sorted(set(doc) - {"format", "command"})
+    if extra:
+        raise CommandsError(f"{where}: unknown top-level key `{extra[0]}`")
+    if doc.get("format") != FORMAT:
+        raise CommandsError(f"{where}: `format` must be {FORMAT}")
+    entries = doc.get("command")
+    if not isinstance(entries, list) or not entries:
+        raise CommandsError(f"{where}: `command` must be a non-empty list of [[command]]")
+    if not all(isinstance(e, dict) for e in entries):
+        raise CommandsError(f"{where}: `command` must be a list of [[command]] tables")
+    rows = []
+    by_name: dict[str, Row] = {}
+    for n, entry in enumerate(entries, 1):
+        row = _row(entry, f"{where}: command {n}")
+        for name in row.names:
+            if name in by_name:
+                raise CommandsError(f"{where}: command {n}: name {name!r} is in two rows")
+            by_name[name] = row
+        rows.append(row)
+    return Table(rows=tuple(rows), by_name=MappingProxyType(by_name))
+
+
+def _fail(where: str, text: str) -> CommandsError:
+    return CommandsError(f"{where}: {text}")
+
+
+def _strings(value: Any, where: str, key: str, empty: bool = False) -> tuple[str, ...]:
+    if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):
+        raise _fail(where, f"`{key}` must be a list of non-empty strings")
+    if not value and not empty:
+        raise _fail(where, f"`{key}` must not be empty")
+    return tuple(value)
+
+
+def _row(entry: dict[str, Any], where: str) -> Row:
+    if "raw" in entry:
+        raise _fail(where, "`raw` is not allowed: every row reads its argv")
+    names = _strings(entry.get("names", []), where, "names", empty=True)
+    patterns = _strings(entry.get("patterns", []), where, "patterns", empty=True)
+    if not names and not patterns:
+        raise _fail(where, "a row needs `names` or `patterns`")
+    where = f"{where} ({(names or patterns)[0]})"
+    fixed = entry.get("fixed", False)
+    if not isinstance(fixed, bool):
+        raise _fail(where, "`fixed` must be a boolean")
+    allowed = _FIXED_KEYS if fixed else _ROW_KEYS
+    unknown = sorted(set(entry) - allowed)
+    if unknown:
+        on = " on a fixed row" if fixed else ""
+        raise _fail(where, f"unknown key `{unknown[0]}`{on}")
+    example = entry.get("example")
+    if not isinstance(example, str) or not example:
+        raise _fail(where, "missing `example` (a minimal invocation)")
+    label = (names or patterns)[0]
+    if fixed:
+        grammar = _grammar(
+            {k: v for k, v in entry.items() if k in ("class", "reason", "effects")},
+            where,
+            label,
+            fixed=True,
+        )
+    else:
+        if "parse" not in entry:
+            raise _fail(where, "missing `parse` (gnu, posix or long), or `fixed = true`")
+        body = {k: v for k, v in entry.items() if k in _GRAMMAR_KEYS}
+        grammar = _grammar(body, where, label)
+        subs = entry.get("subcommands")
+        if subs is not None:
+            if not isinstance(subs, dict) or not subs:
+                raise _fail(where, "`subcommands` must be a non-empty table")
+            table: dict[str, Grammar] = {}
+            for key, sub in subs.items():
+                spellings = _spellings(key, where)
+                if not isinstance(sub, dict):
+                    raise _fail(where, f"subcommand `{key}` must be a table")
+                sub_where = f"{where} subcommand {key}"
+                unknown = sorted(set(sub) - _GRAMMAR_KEYS)
+                if unknown:
+                    raise _fail(sub_where, f"unknown key `{unknown[0]}`")
+                body = dict(sub)
+                body.setdefault("parse", grammar.parse)
+                body.setdefault("class", grammar.cls)
+                if "reason" not in body and "class" not in sub:
+                    body["reason"] = grammar.reason
+                # Under `gnu` the row's options stand anywhere, also after the subcommand.
+                inherited = grammar.options if grammar.parse == "gnu" else {}
+                parsed = _grammar(body, sub_where, f"{label} {spellings[0]}", inherited)
+                for spelling in spellings:
+                    if spelling in table:
+                        raise _fail(where, f"subcommand {spelling!r} listed twice")
+                    table[spelling] = parsed
+            fields = {**grammar.__dict__, "subcommands": MappingProxyType(table)}
+            grammar = Grammar(**fields)
+    for option in {id(o): o for o in grammar.options.values()}.values():
+        if option.gap is not None:
+            if not any((name, s) in CLASS7_GAP for name in names for s in option.spellings):
+                raise _fail(
+                    where,
+                    f"`gap` on {option.key}: only the spec's class-7 options may carry it",
+                )
+    grammars = [grammar, *((grammar.subcommands or {}).values())]
+    effects = [e for g in grammars for e in g.all_effects()]
+    has_command_at = any(e.effect == "runs-command-at" for e in effects)
+    prefix = entry.get("prefix")
+    if has_command_at:
+        if not isinstance(prefix, str) or not prefix:
+            raise _fail(
+                where,
+                "a row with `runs-command-at` needs `prefix` "
+                "(the words before the inner command)",
+            )
+    elif prefix is not None:
+        raise _fail(where, "`prefix` is only for a row with `runs-command-at`")
+    unconditional = [e for g in grammars for e in g.effects if not e.when]
+    runs_code = any(e.text or e.effect == "opens-shell" for e in unconditional) or any(
+        g.no_command == "opens-shell" or g.terminal_stdin == "opens-shell" for g in grammars
+    )
+    return Row(
+        names=names,
+        patterns=patterns,
+        example=example,
+        prefix=prefix,
+        fixed=fixed,
+        grammar=grammar,
+        elevates=any(e.effect == "elevates" for e in effects),
+        destroys=any(e.effect == "destroys" for e in effects),
+        runs_code=runs_code,
+        opens_shell_with_no_command=any(g.no_command == "opens-shell" for g in grammars),
+        reads_argv=not fixed,
+    )
+
+
+def _spellings(key: str, where: str) -> tuple[str, ...]:
+    parts = tuple(key.split("|"))
+    if not all(parts):
+        raise _fail(where, f"bad spelling list `{key}`")
+    return parts
+
+
+def _grammar(
+    body: dict[str, Any],
+    where: str,
+    label: str,
+    inherited: Mapping[str, Option] | None = None,
+    fixed: bool = False,
+) -> Grammar:
+    cls = body.get("class", "mutating")
+    if cls not in CLASSES or RANK[cls] < RANK["mutating"]:
+        raise _fail(where, "`class` must be one of the classes and at least mutating")
+    reason = body.get("reason", "not allowlisted")
+    if not isinstance(reason, str) or not reason:
+        raise _fail(where, "`reason` must be a non-empty string")
+    style = body.get("parse", "posix")
+    if not fixed and style not in PARSE_STYLES:
+        raise _fail(where, f"`parse` must be one of {', '.join(PARSE_STYLES)}")
+    for key in ("plus", "old_style"):
+        if not isinstance(body.get(key, False), bool):
+            raise _fail(where, f"`{key}` must be a boolean")
+    options: dict[str, Option] = dict(inherited or {})
+    raw_options = body.get("options", {})
+    if not isinstance(raw_options, dict):
+        raise _fail(where, "`options` must be a table")
+    own: list[tuple[Option, dict]] = []
+    for key, spec in raw_options.items():
+        spellings = _spellings(key, where)
+        for s in spellings:
+            if not s.startswith(("-", "+")) and s not in ("(", ")", "!", ","):
+                raise _fail(where, f"option {s!r} must start with '-'")
+        if not isinstance(spec, dict):
+            raise _fail(where, f"option `{key}` must be a table (`{{}}` for a plain flag)")
+        unknown = sorted(set(spec) - _OPTION_KEYS)
+        if unknown:
+            raise _fail(where, f"option `{key}`: unknown key `{unknown[0]}`")
+        option = _option(spellings, spec, f"{where} option {key}")
+        own.append((option, spec))
+        for s in spellings:
+            options[s] = option
+    patterns = []
+    for text in _strings(body.get("flag_patterns", []), where, "flag_patterns", empty=True):
+        try:
+            patterns.append(re.compile(text))
+        except re.error as exc:
+            raise _fail(where, f"bad flag pattern {text!r}: {exc}") from None
+    keys = {s: o.key for s, o in options.items()}
+    # Option effects may only name this grammar's options in when/unless.
+    resolved = []
+    for option, spec in own:
+        effects = _effects(
+            spec.get("effects", []), f"{where} option {option.key}", keys, True
+        )
+        resolved.append(Option(**{**option.__dict__, "effects": effects}))
+    for option in resolved:
+        for s in option.spellings:
+            options[s] = option
+    effects = _effects(body.get("effects", []), where, keys, False, fixed=fixed)
+    no_command = body.get("no_command")
+    terminal = body.get("terminal_stdin")
+    if no_command is not None and no_command not in NO_COMMAND:
+        raise _fail(where, f"`no_command` must be one of {', '.join(NO_COMMAND)}")
+    if terminal is not None and terminal not in TERMINAL_STDIN:
+        raise _fail(where, f"`terminal_stdin` must be one of {', '.join(TERMINAL_STDIN)}")
+    everything = list(effects) + [e for o in resolved for e in o.effects]
+    if any(e.effect == "runs-command-at" for e in everything):
+        if no_command is None:
+            raise _fail(where, "a `runs-command-at` row must declare `no_command`")
+        if terminal is None:
+            raise _fail(where, "a `runs-command-at` row must declare `terminal_stdin`")
+    if any(e.effect == "runs-stdin-as-code" for e in everything) and terminal is None:
+        raise _fail(where, "a `runs-stdin-as-code` row must declare `terminal_stdin`")
+    return Grammar(
+        label=label,
+        parse=style if not fixed else "fixed",
+        options=MappingProxyType(options),
+        flag_patterns=tuple(patterns),
+        effects=effects,
+        cls=cls,
+        reason=reason,
+        plus=body.get("plus", False),
+        old_style=body.get("old_style", False),
+        no_command=no_command,
+        terminal_stdin=terminal,
+    )
+
+
+def _option(spellings: tuple[str, ...], spec: dict[str, Any], where: str) -> Option:
+    value = spec.get("value", "none")
+    count = isinstance(value, int) and not isinstance(value, bool) and value >= 1
+    if not (value in VALUES or count):
+        raise _fail(where, "`value` must be none, required, optional or a word count")
+    rejects = spec.get("rejects")
+    if rejects is not None and (not isinstance(rejects, str) or not rejects):
+        raise _fail(where, "`rejects` must be a non-empty reason")
+    gap = spec.get("gap")
+    if gap is not None and gap != "class-7":
+        raise _fail(where, '`gap` must be "class-7"')
+    replace = spec.get("replace")
+    if replace is not None and (not isinstance(replace, str) or value == "none"):
+        raise _fail(where, "`replace` must be a string, on an option that takes a value")
+    for key in ("last", "name", "plus"):
+        if not isinstance(spec.get(key, False), bool):
+            raise _fail(where, f"`{key}` must be a boolean")
+    return Option(
+        key=spellings[0],
+        spellings=spellings,
+        value=value,
+        rejects=rejects,
+        gap=gap,
+        last=spec.get("last", False),
+        replace=replace,
+        name=spec.get("name", False),
+        plus=spec.get("plus", False),
+    )
+
+
+def _effects(
+    raw: Any, where: str, keys: Mapping[str, str], on_option: bool, fixed: bool = False
+) -> tuple[Effect, ...]:
+    if not isinstance(raw, list):
+        raise _fail(where, "`effects` must be a list")
+    out = []
+    for item in raw:
+        spec = {"effect": item} if isinstance(item, str) else item
+        if not isinstance(spec, dict):
+            raise _fail(where, "an effect is a name or a table")
+        unknown = sorted(set(spec) - _EFFECT_KEYS)
+        if unknown:
+            raise _fail(where, f"effect: unknown key `{unknown[0]}`")
+        name = spec.get("effect")
+        if name not in EFFECTS:
+            raise _fail(where, f"unknown effect {name!r}")
+        grammar = spec.get("grammar")
+        if name in TEXT_EFFECTS:
+            if grammar not in GRAMMARS:
+                raise _fail(where, f"{name} must name its grammar ({', '.join(GRAMMARS)})")
+        elif grammar is not None:
+            raise _fail(where, f"`grammar` is only for a text effect, not {name}")
+        if fixed and any(k in spec for k in ("when", "unless", "if", "at", "until")):
+            raise _fail(where, "an effect on a fixed row cannot depend on argv")
+        if fixed and name == "runs-command-at":
+            raise _fail(where, "a fixed row cannot run an inner command")
+
+        def option_keys(key: str) -> frozenset[str]:
+            spellings = _strings(spec.get(key, []), where, key, empty=True)
+            for s in spellings:
+                if s not in keys:
+                    raise _fail(where, f"`{key}` names {s!r}, which is not an option here")
+            return frozenset(keys[s] for s in spellings)
+
+        cond = spec.get("if")
+        if cond is not None and cond not in CONDITIONS:
+            raise _fail(where, f"`if` must be one of {', '.join(CONDITIONS)}")
+        at = spec.get("at")
+        if name == "runs-command-at":
+            if on_option:
+                if at != "after":
+                    raise _fail(where, 'runs-command-at on an option needs `at = "after"`')
+            elif not (isinstance(at, int) and not isinstance(at, bool) and at >= 0):
