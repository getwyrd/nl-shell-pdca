+    "indented-list-item-content": ("1. Item\n\n    [x](gone.md)\n", "gone.md"),
+    "unclosed-backtick": ("A lone ` then [x](gone.md)\n", "gone.md"),
+    "escaped-backticks": ("Use \\` then [x](gone.md) and \\` end.\n", "gone.md"),
