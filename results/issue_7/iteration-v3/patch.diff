+++ b/.github/workflows/docs-checks.yml
@@ -0,0 +1,31 @@
+name: Docs checks
+
+# Enforces ADR-0001 (docs/design/adr/0001-record-architecture-decisions.md:22-23, :30-31):
+# frozen design records (Accepted/Superseded ADRs, non-draft proposals and specs) are never
+# edited, except for a listed status-line change; and relative Markdown links resolve.
+# No path filter, so the job always reports and can be made a required check.
+# `pull_request` only, never `pull_request_target`: this runs PR-supplied code.
+on:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  docs:
+    name: docs
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.14"
+      - name: Frozen design records are unchanged
+        run: >-
+          python scripts/docs_checks.py immutability
+          "${{ github.event.pull_request.base.sha }}"
+          "${{ github.event.pull_request.head.sha }}"
+      - name: Relative Markdown links resolve
+        run: python scripts/docs_checks.py links
