@@ -0,0 +1,339 @@
+#!/usr/bin/env python3
+"""Docs checks for nl-shell's design records. Standard library only.
+
+Run from the root of any git checkout (a worktree is fine; only `git` is used):
+
+    python scripts/docs_checks.py immutability BASE HEAD
+    python scripts/docs_checks.py links
+
+immutability -- a design record that is frozen at the PR's base stays byte-identical at
+    its head, except that its frontmatter `status:` line may move to a listed next state.
+    Sources: ADR-0001 (docs/design/adr/0001-record-architecture-decisions.md:18-23),
+    the class table in docs/design/README.md:18-21, docs/design/proposals/README.md:10-11,
+    and the status vocabularies in docs/design/templates/{adr,proposal,spec}.md:4.
+
+links -- every relative link in a tracked Markdown file points at a tracked file or
+    directory. External (`scheme:`) links, pure `#fragment` links and anything inside
+    code are ignored; fragments are not checked against headings.
+
+Exit status: 0 = clean, 1 = violations found (listed on stdout), 2 = usage or git error.
+"""
+
+from __future__ import annotations
+
+import os
+import posixpath
+import re
+import subprocess
+import sys
+from dataclasses import dataclass
+from urllib.parse import unquote
+
+# --- immutability ---------------------------------------------------------------------
+
+ADR_RE = re.compile(r"^docs/design/adr/\d{4}-[^/]*\.md$")
+PROPOSAL_RE = re.compile(r"^docs/design/proposals/(?:draft|accepted)/\d{4}-[^/]*\.md$")
+SPEC_RE = re.compile(r"^docs/design/specs/(?:.+/)?[^/]+\.md$")
+
+SUPERSEDED_BY_ADR_RE = re.compile(r"^superseded by adr-\d{4}")
+
+
+@dataclass(frozen=True)
+class RecordClass:
+    name: str
+    how_to_change: str
+
+    def frozen(self, status: str) -> bool:
+        raise NotImplementedError
+
+    def allowed_next(self, base: str, head: str) -> bool:
+        raise NotImplementedError
+
+
+class AdrClass(RecordClass):
+    # templates/adr.md:4 -- Proposed | Accepted | Superseded by ADR-NNNN. ADR-0001:22-23:
+    # "An ADR starts as Proposed. Once Accepted it MUST NOT be edited". There is no
+    # implemented state for an ADR.
+    def frozen(self, status: str) -> bool:
+        return not status.startswith("proposed")
+
+    def allowed_next(self, base: str, head: str) -> bool:
+        return base.startswith("accepted") and bool(SUPERSEDED_BY_ADR_RE.match(head))
+
+
+class ProposalClass(RecordClass):
+    # templates/proposal.md:4 -- draft | accepted | implemented | withdrawn.
+    # proposals/README.md:10-11: accepted proposals are never edited; supersession is
+    # recorded in the index, not on the frozen file.
+    def frozen(self, status: str) -> bool:
+        return status != "draft"
+
+    def allowed_next(self, base: str, head: str) -> bool:
+        return base == "accepted" and head in ("implemented", "withdrawn")
+
+
+class SpecClass(RecordClass):
+    # templates/spec.md:4 -- draft | stable | superseded | withdrawn. docs/design/README.md:18:
+    # "a stable version is never edited, only replaced by a new version".
+    def frozen(self, status: str) -> bool:
+        return status != "draft"
+
+    def allowed_next(self, base: str, head: str) -> bool:
+        return base == "stable" and head in ("superseded", "withdrawn")
+
+
+ADR = AdrClass("ADR", "write a new ADR that supersedes it and record that in adr/README.md")
+PROPOSAL = ProposalClass(
+    "proposal", "write a new proposal and record the supersession in proposals/README.md"
+)
+SPEC = SpecClass(
+    "spec", "add a new spec version (e.g. vN+1.md) and record it in specs/README.md"
+)
+
+
+def record_class(path: str) -> RecordClass | None:
+    if ADR_RE.match(path):
+        return ADR
+    if PROPOSAL_RE.match(path):
+        return PROPOSAL
+    if SPEC_RE.match(path) and posixpath.basename(path) != "README.md":
+        return SPEC
+    return None
+
+
+def status_line_index(lines: list[str]) -> int | None:
+    """Index of the `status:` line inside the leading YAML frontmatter, if any."""
+    if not lines or lines[0].rstrip("\r\n") != "---":
+        return None
+    for i in range(1, len(lines)):
+        text = lines[i].rstrip("\r\n")
+        if text in ("---", "..."):
+            return None
+        if re.match(r"^status\s*:", text, re.IGNORECASE):
+            return i
+    return None
+
+
+def status_value(line: str) -> str:
+    value = line.split(":", 1)[1]
+    value = re.sub(r"\s+#.*$", "", value).strip()
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
+        value = value[1:-1].strip()
+    return value.lower()
+
+
+def git(*args: str) -> str:
+    result = subprocess.run(["git", *args], capture_output=True, text=True)
+    if result.returncode != 0:
+        raise GitError(f"git {' '.join(args)}: {result.stderr.strip()}")
+    return result.stdout
+
+
+def git_show(rev: str, path: str) -> str:
+    result = subprocess.run(
+        ["git", "show", f"{rev}:{path}"], capture_output=True, text=True
+    )
+    if result.returncode != 0:
+        raise GitError(f"git show {rev}:{path}: {result.stderr.strip()}")
+    return result.stdout
+
+
+class GitError(Exception):
+    pass
+
+
+def changed_paths(base: str, head: str) -> list[tuple[str, str, str | None]]:
+    """(status letter, old path, new path) for every change from base to head.
+
+    Renames are detected so that a renamed record is checked at its OLD path.
+    """
+    out = git("diff", "--name-status", "-z", "-M", base, head)
+    fields = out.split("\0")
+    changes = []
+    i = 0
+    while i < len(fields) and fields[i]:
+        letter = fields[i][0]
+        if letter in "RC":
+            changes.append((letter, fields[i + 1], fields[i + 2]))
+            i += 3
+        else:
+            changes.append((letter, fields[i + 1], None))
+            i += 2
+    return changes
+
+
+def check_record(
+    rev_base: str, rev_head: str, letter: str, path: str, new: str | None
+) -> str | None:
+    """A violation message for one changed path, or None."""
+    if letter in "AC":  # a new file (or a copy, which leaves the source untouched)
+        return None
+    cls = record_class(path)
+    if cls is None:
+        return None
+    base_lines = git_show(rev_base, path).splitlines(keepends=True)
+    idx = status_line_index(base_lines)
+    if idx is None:
+        return None  # no frontmatter status at the base: not frozen
+    base_status = status_value(base_lines[idx])
+    if not cls.frozen(base_status):
+        return None
+
+    advice = f"Do not edit it; {cls.how_to_change}."
+    where = f"{path} ({cls.name}, status '{base_status}' at the base)"
+    if letter == "D":
+        return f"{where} is frozen and was deleted. {advice}"
+    if letter == "R":
+        return f"{where} is frozen and was renamed to {new}. {advice}"
+
+    head_lines = git_show(rev_head, path).splitlines(keepends=True)
+    differing = [
+        i
+        for i in range(max(len(base_lines), len(head_lines)))
+        if i >= len(base_lines)
+        or i >= len(head_lines)
+        or base_lines[i] != head_lines[i]
+    ]
+    if not differing:
+        return None  # e.g. a mode-only change
+    if differing != [idx] or status_line_index(head_lines) != idx:
+        return f"{where} is frozen and lines other than its status changed. {advice}"
+    head_status = status_value(head_lines[idx])
+    if cls.allowed_next(base_status, head_status):
+        return None
+    return (
+        f"{where} is frozen; its status may not change to '{head_status}'. "
+        f"{advice}"
+    )
+
+
+def cmd_immutability(base: str, head: str) -> int:
+    base_rev = git("merge-base", base, head).strip()
+    head_rev = git("rev-parse", "--verify", f"{head}^{{commit}}").strip()
+    problems = []
+    for letter, path, new in changed_paths(base_rev, head_rev):
+        msg = check_record(base_rev, head_rev, letter, path, new)
+        if msg:
+            problems.append(msg)
+    for msg in problems:
+        print(f"docs-immutability: {msg}")
+    if problems:
+        print(
+            f"docs-immutability: {len(problems)} frozen design record(s) changed. "
+            "Accepted ADRs, non-draft proposals and non-draft specs are append-only: "
+            "supersede them with a new record plus an index entry instead of editing."
+        )
+        return 1
+    print("docs-immutability: OK")
+    return 0
+
+
+# --- links ----------------------------------------------------------------------------
+
+FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+FENCE_CLOSE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})\s*$")
+INLINE_TARGET_RE = re.compile(r"\]\(\s*(<[^>]*>|[^)\s]+)")
+REFDEF_RE = re.compile(r"^ {0,3}\[[^\]]+\]:\s*(<[^>]*>|\S+)")
+SCHEME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
+CODE_SPAN_RE = re.compile(r"(`+)(?:.+?)\1")
+
+
+def strip_code_spans(line: str) -> str:
+    return CODE_SPAN_RE.sub(lambda m: " " * len(m.group(0)), line)
+
+
+def link_targets(text: str):
+    """(line number, target) for every link outside fenced code and code spans."""
+    fence: str | None = None
+    for number, line in enumerate(text.splitlines(), start=1):
+        if fence is not None:
+            close = FENCE_CLOSE_RE.match(line)
+            if close and close.group(1)[0] == fence[0] and len(close.group(1)) >= len(fence):
+                fence = None
+            continue
+        m = FENCE_RE.match(line)
+        if m:
+            fence = m.group(1)
+            continue
+        line = strip_code_spans(line)
+        for m in INLINE_TARGET_RE.finditer(line):
+            yield number, m.group(1)
+        m = REFDEF_RE.match(line)
+        if m:
+            yield number, m.group(1)
+
+
+def resolve(md_path: str, target: str) -> str | None:
+    """The repo-relative path a relative link points at, or None if not relative."""
+    if target.startswith("<") and target.endswith(">"):
+        target = target[1:-1]
+    if not target or target.startswith("#") or target.startswith("//"):
+        return None
+    if SCHEME_RE.match(target):
+        return None
+    target = unquote(re.split(r"[#?]", target, maxsplit=1)[0])
+    if not target:
+        return None
+    if target.startswith("/"):
+        joined = target.lstrip("/")
+    else:
+        joined = posixpath.join(posixpath.dirname(md_path), target)
+    return posixpath.normpath(joined)
+
+
+def cmd_links() -> int:
+    tracked = [p for p in git("ls-files", "-z").split("\0") if p]
+    files = set(tracked)
+    dirs = {"."}
+    for p in tracked:
+        d = posixpath.dirname(p)
+        while d and d not in dirs:
+            dirs.add(d)
+            d = posixpath.dirname(d)
+    problems = []
+    checked = 0
+    for md in sorted(p for p in tracked if p.endswith(".md")):
+        try:
+            with open(md, encoding="utf-8") as fh:
+                text = fh.read()
+        except FileNotFoundError:
+            continue  # tracked but deleted in the working tree
+        for number, target in link_targets(text):
+            resolved = resolve(md, target)
+            if resolved is None:
+                continue
+            checked += 1
+            if resolved.startswith("../") or resolved == "..":
+                problems.append(f"{md}:{number}: link '{target}' points outside the repo")
+            elif resolved not in files and resolved not in dirs:
+                problems.append(
+                    f"{md}:{number}: broken link '{target}' (no tracked file or "
+                    f"directory {resolved})"
+                )
+    for msg in problems:
+        print(f"docs-links: {msg}")
+    if problems:
+        print(f"docs-links: {len(problems)} broken relative link(s) of {checked} checked")
+        return 1
+    print(f"docs-links: OK ({checked} relative links checked)")
+    return 0
+
+
+def main(argv: list[str]) -> int:
+    usage = "usage: docs_checks.py immutability BASE HEAD | docs_checks.py links"
+    try:
+        # Every path below is relative to the repository root, wherever we were started.
+        os.chdir(git("rev-parse", "--show-toplevel").strip())
+        if len(argv) == 3 and argv[0] == "immutability":
+            return cmd_immutability(argv[1], argv[2])
+        if len(argv) == 1 and argv[0] == "links":
+            return cmd_links()
+    except GitError as exc:
+        print(f"docs_checks: {exc}", file=sys.stderr)
+        return 2
+    print(usage, file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
