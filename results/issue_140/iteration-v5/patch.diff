+def _baseline_records(hooks: bytes = b'declare -- __nls_seq="0"\\n') -> bytes:
+    return b"D 0 0 0\nF \nL \nT \nB \nX \nP \nJ 0\nH " + hooks + b"\nV \nE\n"
