+    })
+    repo.git("branch", "pr")
+    for old, new in main_moves:
+        repo.move(old, new)
+    main_tip = repo.commit(main_files)
+    repo.git("checkout", "-q", "pr")
+    for old, new in pr_moves:
+        repo.move(old, new)
+    pr_head = repo.commit(pr_files)
+    return repo, main_tip, pr_head
