+# (3) unit ---------------------------------------------------------------------------------
+
+
+def test_known_unit_is_kept():
+    result, _ = run({"category": "service-failed", "unit": "nginx.service"})
+    assert result.unit == "nginx.service"
+    assert "Unit: nginx.service." in result.message()
