--- /dev/null
+++ b/src/nl_shell/pty_protocol.py
@@ -0,0 +1,295 @@
+"""pty-protocol v1: control-channel records, the session snapshot and the sequencing rules.
+
+Pure logic with no I/O, so it can be tested on its own. ``session.py`` feeds it every byte
+read from the control channel (the pipe that is fd 3 in the bash session) and asks it what
+happened. The normative source is ``docs/design/specs/pty-protocol/v1.md`` (ADR-0014):
+
+- §2  records: one ``\\n``-terminated line, fields split by one space, a one-letter type;
+- §3  the snapshot: ``F`` (only when it changed), ``L``, ``T``, ``B``, ``X``, ``P``, ``J``,
+      ``H`` and ``V``, closed by ``E``; the first snapshot is the session's baseline;
+- §4  ``S n+1`` → ``D n+1 …`` → snapshot → ``E``, and degraded mode on any violation;
+- §5  which commands may be sent at all.
+
+Exit codes and completion come only from here, never from text printed on the PTY.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import enum
+import re
+from typing import Callable
+
+PASTE_START = b"\x1b[200~"
+PASTE_END = b"\x1b[201~"
+
+# A record longer than this is treated as malformed rather than buffered forever.
+MAX_RECORD = 1 << 20
+
+# Snapshot record types every snapshot must carry (§3). `F` is sent only when the function
+# list changed, so it is required in the first snapshot and carried over after that.
+REQUIRED_SNAPSHOT = ("L", "T", "B", "X", "P", "J", "H", "V")
+SNAPSHOT_TYPES = frozenset(("F",) + REQUIRED_SNAPSHOT)
+KNOWN_TYPES = frozenset({"S", "D", "E"}) | SNAPSHOT_TYPES
+
+# The separator `L`, `T` and `B` use for the lines of a multi-line value (§2).
+LINE_SEP = "\x1e"
+
+# Numbers are bounded: a sequence number or exit status has no need for more than 18
+# digits, and Python's int() raises ValueError on a string of more than 4300 (§4.2: a
+# malformed record degrades the session, it never raises out of the tracker).
+_NUM = r"\d{1,18}"
+
+_FIELDS = {
+    "S": re.compile(_NUM),
+    "D": re.compile(rf"{_NUM} {_NUM}( {_NUM})+"),
+    "J": re.compile(_NUM),
+    "H": re.compile(r"\d+ \d+"),  # `cksum` output: CRC and byte count
+    "V": re.compile(r"\d+ \d+"),
+    "X": re.compile(r"shopt -[su] extdebug"),
+}
+
+
+class ProtocolError(Exception):
+    """A control-channel record that does not follow pty-protocol v1 §2."""
+
+
+class CommandRefused(ValueError):
+    """A command that pty-protocol v1 §5.2 forbids sending; nothing was written to the PTY."""
+
+
+@dataclasses.dataclass(frozen=True)
+class Record:
+    type: str
+    fields: str  # everything after "<type> ", "" when there is nothing
+
+
+@dataclasses.dataclass(frozen=True)
+class Done:
+    """A ``D`` record: the command finished (§2)."""
+
+    seq: int
+    status: int
+    pipestatus: tuple[int, ...]
+
+
+@dataclasses.dataclass(frozen=True)
+class Snapshot:
+    """The session state reported before a prompt (§3)."""
+
+    seq: int
+    functions: tuple[str, ...]  # F
+    aliases: tuple[str, ...]  # L, one `alias name='value'` per entry
+    traps: tuple[str, ...]  # T, `trap -p` lines
+    disabled_builtins: tuple[str, ...]  # B, `enable -n` lines
+    extdebug: str  # X, `shopt -p extdebug`
+    path: str  # P, sent with newlines as \x1e and decoded back
+    stopped_jobs: int  # J
+    hooks_sum: str  # H, cksum over PROMPT_COMMAND (every element), PS0 and the hooks
+    vars_sum: str  # V, cksum over the pager and loader variables
+
+
+class Phase(enum.Enum):
+    BASELINE = "waiting for the first snapshot"
+    IDLE = "idle"
+    SENT = "waiting for the start record"
+    RUNNING = "waiting for the done record"
+    SNAPSHOT = "reading the snapshot"
+    DEGRADED = "degraded"
+
+
+def parse_record(line: bytes) -> Record:
+    """Parse one record, without its trailing ``\\n``. Raises :class:`ProtocolError`."""
+    if b"\r" in line:
+        # The reference rcfile wrote `S 1\r\n` (bash turns a prompt's `\n` into CR LF);
+        # a CR is never part of a valid record (§Conventions).
+        raise ProtocolError("record contains a carriage return")
+    if len(line) > MAX_RECORD:
+        raise ProtocolError("record is too long")
+    text = line.decode("utf-8", "surrogateescape")
+    if not text or not text[0].isascii() or not text[0].isalpha():
+        raise ProtocolError(f"record does not start with a one-letter type: {text[:40]!r}")
+    if len(text) > 1 and text[1] != " ":
+        raise ProtocolError(f"record type is longer than one letter: {text[:40]!r}")
+    rtype, fields = text[0], text[2:]
+    if rtype == "E" and len(text) != 1:
+        raise ProtocolError("E record has fields")
+    pattern = _FIELDS.get(rtype)
+    if pattern is not None and not pattern.fullmatch(fields):
+        raise ProtocolError(f"malformed {rtype} record: {text[:80]!r}")
+    return Record(rtype, fields)
+
+
+def check_command(command: str | bytes) -> bytes:
+    """The bytes to paste for ``command``, or :class:`CommandRefused` (§5.2).
+
+    A command may not contain the paste-end sequence, ESC, or any other C0 control
+    character except TAB and LF: any of those could end the bracketed paste early or make
+    readline act on the text instead of inserting it.
+    """
+    data = command.encode("utf-8") if isinstance(command, str) else bytes(command)
+    if PASTE_END in data:
+        raise CommandRefused("command contains the paste-end sequence ESC [201~")
+    for byte in data:
+        if byte < 0x20 and byte not in (0x09, 0x0A):
+            raise CommandRefused(f"command contains the control character 0x{byte:02x}")
+    if not data.strip(b" \t\n"):
+        # bash runs neither PS0 nor a command for a blank line, so no S record would come.
+        raise CommandRefused("command is empty")
+    return data
+
+
+def _lines(fields: str) -> tuple[str, ...]:
+    return tuple(part for part in fields.split(LINE_SEP) if part)
+
+
+class ProtocolTracker:
+    """The §4 state machine over the control channel.
+
+    ``feed`` takes raw bytes as read from the pipe and returns the events they completed:
+    ``("S", n)``, ``("D", Done)`` and ``("E", Snapshot)``. Any violation puts the tracker
+    in degraded mode, which is sticky: later bytes are ignored and ``degraded_reason``
+    keeps the first reason. Unknown record types are ignored (spec §Versioning).
+    """
+
+    def __init__(self, on_record: Callable[[bytes], None] | None = None):
+        self.phase = Phase.BASELINE
+        self.seq = 0  # sequence number of the last finished command
+        self.baseline: Snapshot | None = None
+        self.snapshot: Snapshot | None = None
+        self.done: Done | None = None
+        self.degraded_reason: str | None = None
+        self._on_record = on_record
+        self._buf = bytearray()
+        self._fields: dict[str, str] = {}
+        self._functions: tuple[str, ...] | None = None
+
+    @property
+    def degraded(self) -> bool:
+        return self.phase is Phase.DEGRADED
+
+    def degrade(self, reason: str) -> None:
+        if self.phase is not Phase.DEGRADED:
+            self.phase = Phase.DEGRADED
+            self.degraded_reason = reason
+
+    def command_sent(self) -> None:
+        if self.phase is not Phase.IDLE:
+            raise RuntimeError(f"cannot send a command while {self.phase.value}")
+        self.done = None
+        self.phase = Phase.SENT
+
+    def eof(self) -> None:
+        self.degrade("the control channel closed")
+
+    def feed(self, data: bytes) -> list[tuple[str, object]]:
+        events: list[tuple[str, object]] = []
+        if self.degraded:
+            return events
+        self._buf += data
+        while not self.degraded:
+            end = self._buf.find(b"\n")
+            if end < 0:
+                if len(self._buf) > MAX_RECORD:
+                    self.degrade("malformed control record: record is too long")
+                break
+            line = bytes(self._buf[: end + 1])
+            del self._buf[: end + 1]
+            if self._on_record is not None:
+                self._on_record(line)
+            event = self._handle(line[:-1])
+            if event is not None:
+                events.append(event)
+        return events
+
+    def _handle(self, line: bytes) -> tuple[str, object] | None:
+        try:
+            record = parse_record(line)
+            return self._sequence(record)
+        except (ProtocolError, ValueError) as exc:
+            self.degrade(f"malformed control record: {exc}")
+            return None
+
+    def _sequence(self, record: Record) -> tuple[str, object] | None:
+        rtype = record.type
+        if rtype not in KNOWN_TYPES:
+            return None
+        phase = self.phase
+        if phase is Phase.BASELINE:
+            if rtype == "D" and self._done(record).seq == 0:
+                self.phase = Phase.SNAPSHOT
+                return None
+            return self._out_of_order(rtype, "before the first snapshot")
+        if phase is Phase.IDLE:
+            return self._out_of_order(rtype, "while no command was running")
+        if phase is Phase.SENT:
+            if rtype == "S" and int(record.fields) == self.seq + 1:
+                self.phase = Phase.RUNNING
+                return ("S", self.seq + 1)
+            if rtype == "D":
+                return self._out_of_order(rtype, "without a start record")
+            return self._out_of_order(rtype, f"while waiting for 'S {self.seq + 1}'")
+        if phase is Phase.RUNNING:
+            if rtype == "D":
+                done = self._done(record)
+                if done.seq == self.seq + 1:
+                    self.done = done
+                    self.phase = Phase.SNAPSHOT
+                    return ("D", done)
+            return self._out_of_order(rtype, f"while waiting for 'D {self.seq + 1}'")
+        # Phase.SNAPSHOT
+        if rtype in SNAPSHOT_TYPES:
+            if rtype in self._fields:
+                return self._out_of_order(rtype, "twice in one snapshot")
+            self._fields[rtype] = record.fields
+            return None
+        if rtype == "E":
+            return self._end_snapshot()
+        return self._out_of_order(rtype, "inside a snapshot")
+
+    def _out_of_order(self, rtype: str, where: str) -> None:
+        self.degrade(f"control record '{rtype}' arrived out of order ({where})")
+        return None
+
+    @staticmethod
+    def _done(record: Record) -> Done:
+        numbers = [int(n) for n in record.fields.split(" ")]
+        return Done(numbers[0], numbers[1], tuple(numbers[2:]))
+
+    def _end_snapshot(self) -> tuple[str, object] | None:
+        fields, self._fields = self._fields, {}
+        if "F" in fields:
+            self._functions = tuple(fields["F"].split())
+        missing = [t for t in REQUIRED_SNAPSHOT if t not in fields]
+        if self._functions is None:
+            missing.insert(0, "F")
+        if missing:
+            self.degrade(f"snapshot is missing record(s) {', '.join(missing)}")
+            return None
+        seq = self.done.seq if self.done is not None else 0
+        snapshot = Snapshot(
+            seq=seq,
+            functions=self._functions or (),
+            aliases=_lines(fields["L"]),
+            traps=_lines(fields["T"]),
+            disabled_builtins=_lines(fields["B"]),
+            extdebug=fields["X"],
+            # `$PATH` with its newlines sent as \x1e (one record per line, §2), decoded back.
+            # `<<<` adds one final newline, which arrives as a trailing \x1e.
+            path=fields["P"].removesuffix(LINE_SEP).replace(LINE_SEP, "\n"),
+            stopped_jobs=int(fields["J"]),
+            hooks_sum=fields["H"],
+            vars_sum=fields["V"],
+        )
+        self.snapshot = snapshot
+        if self.baseline is None:
+            self.baseline = snapshot
+        elif snapshot.hooks_sum != self.baseline.hooks_sum:
+            self.degrade(
+                "nl-shell's hooks changed (PROMPT_COMMAND, PS0 or the hook functions):"
+                " the snapshot's H differs from the baseline"
+            )
+            return None
+        self.seq = seq
+        self.phase = Phase.IDLE
+        return ("E", snapshot)
