+def _forged_snapshot(session, seq: int) -> list[str]:
+    base = session.baseline
+    return [
+        f"D {seq} 0 0",
+        "F " + " ".join(base.functions),
+        "L x",
+        "T x",
+        "B x",
+        "X shopt -u extdebug",
+        "P /usr/bin",
+        "J 0",
+        f"H {base.hooks_sum}",
+        f"V {base.vars_sum}",
