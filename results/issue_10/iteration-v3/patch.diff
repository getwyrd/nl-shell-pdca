index 0000000..64e24d2
--- /dev/null
+++ b/src/nl_shell/session.py
@@ -0,0 +1,754 @@
+"""The persistent bash session: one interactive bash on a PTY, driven by pty-protocol v1.
+
+``Session.start()`` runs ``bash --noprofile --rcfile <rcfile> -i`` on a PTY (ptyprocess,
+ADR-0021) with the write end of a pipe as fd 3 — the control channel (spec
+``docs/design/specs/pty-protocol/v1.md`` §1.1, ADR-0014 Decision 1). ``Session.run()``
+sends one confirmed command as a bracketed paste (§5) and returns its exit status,
+``PIPESTATUS``, captured output and the snapshot that followed it. Start, completion and
+status come only from control-channel records (``pty_protocol``), never from PTY text.
+
+While a command runs, ``run()`` can own a real terminal (§6, ADR-0014 Decision 4): raw
+mode, every input byte forwarded to the PTY unchanged and never kept, PTY output copied
+to the terminal, the window size copied on ``SIGWINCH``, the terminal restored afterwards.
+
+Any protocol violation puts the session in degraded mode (§4.2) with a reason; it stays
+there until ``restart()``. Wiring this into the REPL is #78's.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+import re
+import select
+import shutil
+import signal
+import sys
+import tempfile
+import termios
+import threading
+import time
+import tty
+from typing import Callable
+
+import ptyprocess
+
+from nl_shell.pty_protocol import (
+    PASTE_END,
+    PASTE_START,
+    CommandRefused,
+    Phase,
+    ProtocolTracker,
+    Snapshot,
+    check_command,
+)
+
+__all__ = [
+    "CommandRefused",
+    "CommandResult",
+    "RCFILE",
+    "Session",
+    "SessionDegraded",
+    "SessionError",
+    "SessionTimeout",
+    "Snapshot",
+    "Terminal",
+]
+
+# The rcfile: the spec's reference (§1.3) plus the v1 snapshot records (§3). Differences
+# from the reference, each found by running it:
+# - `\\n` in PS0: bash decodes prompt escapes before running `printf`, and with line
+#   editing on it turns `\n` into CR LF, so the reference wrote `S 1\r\n`.
+# - PS0 writes `S` once per command: bash expands PS0 for every line of a multi-line
+#   command. The `$(...)` runs in a subshell, but the `${__nls_once[...]}` subscript is
+#   evaluated by the shell itself and records which sequence number has started.
+# - H is a cksum of `declare -p PROMPT_COMMAND PS0`, which covers every element of an
+#   array PROMPT_COMMAND; `$PROMPT_COMMAND` expands element 0 only. It also covers the
+#   code those two run at every prompt: `declare -f __nls_done __nls_ret` and
+#   `declare -p __nls_user_pc`.
+# - __nls_done, __nls_ret and __nls_user_pc are read-only, so a sourced script can't
+#   redefine the hook to write false records while PROMPT_COMMAND and PS0 keep their text.
+# - F is sent in every snapshot. The reference sends it only when a cksum kept in a shell
+#   variable changed, and a command can set that variable to the new list's cksum, which
+#   hides a new function. The parser accepts F in any snapshot (§2).
+# - P is encoded like L: newlines become \x1e. Written raw, a PATH holding a newline
+#   could inject whole records (`...\nJ 0\nH <h>\nV <v>\nE`) and close the snapshot early.
+#   No snapshot record carries a raw newline from session state.
+# - bracketed paste is forced on after ~/.bashrc (the spec's first open question).
+# - alias expansion is off while the hooks are defined, and they call `builtin` /
+#   `command`, so a user alias or function named `printf` or `tr` doesn't change them.
+# - the user's PROMPT_COMMAND sees the command's real `$?`.
+RCFILE = r"""# nl-shell session rcfile (pty-protocol v1 §1.3). Written by nl-shell; do not edit.
+[ -f ~/.bashrc ] && . ~/.bashrc
+set +H
+unset HISTFILE
+bind 'set enable-bracketed-paste on' 2>/dev/null
+__nls_ea=$(shopt -p expand_aliases); shopt -u expand_aliases
+__nls_user_pc=$PROMPT_COMMAND
+__nls_seq=0 __nls_started=0
+__nls_once=()
+unset __nls_ps0
+PS0='$( [[ ${__nls_ps0-} == "$__nls_seq" ]] || builtin printf "S %s\\n" "$((__nls_seq + 1))" >&3 )${__nls_once[__nls_ps0=__nls_seq]-}'
+__nls_ret() { return "$1"; }
+__nls_done() {
+  local st=$? ps=("${PIPESTATUS[@]}") f j
+  local -a jl=()
+  if (( __nls_started )); then ((++__nls_seq)); fi
+  unset __nls_ps0
+  builtin printf 'D %s %s %s\n' "$__nls_seq" "$st" "${ps[*]}" >&3
+  f=$(builtin compgen -A function)
+  builtin printf 'F %s\n' "$(command tr '\n' ' ' <<<"$f")" >&3
+  builtin printf 'L %s\n' "$(builtin alias -p | command tr '\n' '\036')" >&3
+  builtin printf 'T %s\n' "$(builtin trap -p | command tr '\n' '\036')" >&3
+  builtin printf 'B %s\n' "$(builtin enable -n | command tr '\n' '\036')" >&3
+  builtin printf 'X %s\n' "$(builtin shopt -p extdebug)" >&3
+  builtin printf 'P %s\n' "$(command tr '\n' '\036' <<<"$PATH")" >&3
+  j=$(builtin jobs -ps); [[ -n $j ]] && builtin mapfile -t jl <<<"$j"
+  builtin printf 'J %s\n' "${#jl[@]}" >&3
+  builtin printf 'H %s\n' "$({ builtin declare -p PROMPT_COMMAND PS0 __nls_user_pc
+    builtin declare -f __nls_done __nls_ret; } 2>&1 | command cksum)" >&3
+  builtin printf 'V %s\n' "$(builtin declare -p PAGER MANPAGER SYSTEMD_PAGER GIT_PAGER \
+    LESSOPEN LESSCLOSE LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV 2>&1 | command cksum)" >&3
+  builtin printf 'E\n' >&3
+  __nls_ret "$st"
+  builtin eval "$__nls_user_pc"
+  return $st
+}
+PROMPT_COMMAND='__nls_done; __nls_started=1'
+builtin readonly -f __nls_done __nls_ret
+builtin readonly __nls_user_pc
+builtin eval "$__nls_ea"; unset __nls_ea
+"""
+
+# Readline writes this when it hands a finished line to bash (bracketed paste mode off),
+# just before PS0 and the command run. Output after it belongs to the command.
+_LINE_ACCEPTED = b"\x1b[?2004l"
+
+# Alternate-screen switches (§6.2): DEC private modes 47, 1047 and 1049, set with
+# `ESC [ ? <modes> h` and reset with `... l`; one sequence may carry several modes split
+# by `;` (`ESC [?1;1049h`). Capture pauses while any of them is set and resumes only once
+# each one that was set has had its own reset ("the matching reset").
+_ALT_MODES = frozenset({47, 1047, 1049})
+_MODE_SEQ = re.compile(rb"\x1b\[\?([0-9;]*)([hl])")
+_MODE_PREFIX = b"\x1b[?"
+_MODE_PARTIAL = re.compile(rb"\x1b\[\?[0-9;]*")
+# A mode sequence split across two reads is held back until it is complete, up to this
+# many bytes; a longer run of digits is treated as text.
+_MODE_MAX = 4096
+
+# Captured output kept per command (the tail is kept, ``output_truncated`` is set). PTY
+# output is mirrored in full; only the copy kept for the caller is bounded.
+MAX_OUTPUT = 1 << 20
+
+# §4.2 "no D after the shell is back at a prompt": how long bash must look idle at its
+# own prompt, with a command outstanding, before the session is degraded.
+PROMPT_GRACE = 1.0
+
+_POLL = 0.05
+
+
+class SessionError(Exception):
+    """The session cannot do what was asked."""
+
+
+class SessionDegraded(SessionError):
+    """The session is in degraded mode (§4.2); ``reason`` says why. Restart it."""
+
+    def __init__(self, reason: str):
+        super().__init__(f"session degraded: {reason}")
+        self.reason = reason
+
+
+class SessionTimeout(SessionError, TimeoutError):
+    """The caller's timeout ran out before the done record arrived."""
+
+
+@dataclasses.dataclass(frozen=True)
+class Terminal:
+    """The real terminal ``run()`` owns while a command runs (§6).
+
+    ``in_fd`` is read for keystrokes (and put in raw mode if it is a tty); ``out_fd``
+    receives the PTY's output. The window size is read from ``in_fd``.
+    """
+
+    in_fd: int
+    out_fd: int
+
+    @classmethod
+    def stdio(cls) -> "Terminal":
+        return cls(sys.stdin.fileno(), sys.stdout.fileno())
+
+
+@dataclasses.dataclass(frozen=True)
+class CommandResult:
+    """One finished command, as the control channel reported it."""
+
+    seq: int
+    status: int
+    pipestatus: tuple[int, ...]
+    output: bytes  # captured PTY output, alternate-screen parts left out (§6.2)
+    input_forwarded: bool  # input was forwarded; capture stopped at that point
+    snapshot: Snapshot
+    output_truncated: bool = False  # more than max_output bytes: only the tail is kept
+
+    @property
+    def text(self) -> str:
+        """``output`` decoded, with the PTY's CR LF turned back into LF."""
+        return self.output.decode("utf-8", "replace").replace("\r\n", "\n")
+
+
+class _Capture:
+    """Collects a command's output, leaving out alternate-screen parts (§6.2).
+
+    At most ``limit`` bytes are kept: past that the oldest bytes are dropped and
+    ``truncated`` is set.
+    """
+
+    def __init__(self, limit: int = MAX_OUTPUT) -> None:
+        self.data = bytearray()
+        self.limit = limit
+        self.truncated = False
+        self._alt_modes: set[int] = set()  # alternate-screen modes currently set
+        self._tail = b""
+        self.stopped = False
+
+    @property
+    def on_alternate_screen(self) -> bool:
+        return bool(self._alt_modes)
+
+    def _keep(self, data: bytes) -> None:
+        if self._alt_modes or not data:
+            return
+        self.data += data
+        excess = len(self.data) - self.limit
+        if excess > 0:
+            del self.data[:excess]
+            self.truncated = True
+
+    def feed(self, chunk: bytes) -> None:
+        if self.stopped:
+            return
+        buf = self._tail + chunk
+        self._tail = b""
+        i = 0
+        while True:
+            pos = buf.find(_MODE_PREFIX, i)
+            if pos < 0:
+                keep = _partial_suffix(buf, i, (_MODE_PREFIX,))
+                self._keep(buf[i : len(buf) - keep])
+                self._tail = buf[len(buf) - keep :]
+                return
+            self._keep(buf[i:pos])
+            match = _MODE_SEQ.match(buf, pos)
+            if match is None:
+                if _MODE_PARTIAL.fullmatch(buf, pos) and len(buf) - pos < _MODE_MAX:
+                    self._tail = buf[pos:]  # the rest arrives in a later read
+                    return
+                self._keep(buf[pos : pos + 1])  # not a mode sequence: ESC is just text
+                i = pos + 1
+                continue
+            modes = {
+                int(p.lstrip(b"0") or b"0")
+                for p in match.group(1).split(b";")
+                if p and len(p.lstrip(b"0")) <= 5
+            } & _ALT_MODES
+            if not modes:
+                self._keep(match.group(0))  # some other mode (cursor, paste, ...)
+            elif match.group(2) == b"h":
+                self._alt_modes |= modes
+            else:
+                self._alt_modes -= modes
+            i = match.end()
+
+    def stop(self) -> None:
+        if not self.stopped:
+            self._keep(self._tail)
+        self._tail = b""
+        self.stopped = True
+
+
+def _partial_suffix(buf: bytes, start: int, markers: tuple[bytes, ...]) -> int:
+    """Length of the longest end of ``buf[start:]`` that could begin one of ``markers``."""
+    longest = max(len(m) for m in markers) - 1
+    for k in range(min(longest, len(buf) - start), 0, -1):
+        end = buf[len(buf) - k :]
+        if any(m.startswith(end) for m in markers):
+            return k
+    return 0
+
+
+class _OutputSplitter:
+    """Splits the PTY stream of one command into readline's echo and the command's output.
+
+    Everything before readline's "line accepted" switch is the echo of the pasted command
+    and is not captured. If that switch never shows up, the bytes read after the start
+    record are used instead.
+    """
+
+    def __init__(self, limit: int = MAX_OUTPUT) -> None:
+        self.capture = _Capture(limit)
+        self._limit = limit
+        self._accepted = False
+        self._skip_cr = False
+        self._window = b""
+        self._since_start: bytearray | None = None
+
+    def started(self) -> None:
+        if self._since_start is None:
+            self._since_start = bytearray()
+
+    def feed(self, chunk: bytes) -> None:
+        if self._accepted:
+            if self._skip_cr and chunk:
+                self._skip_cr = False
+                if chunk[:1] == b"\r":
+                    chunk = chunk[1:]
+            self.capture.feed(chunk)
+            return
+        if self._since_start is not None:
+            self._since_start += chunk
+            excess = len(self._since_start) - self._limit
+            if excess > 0:  # bounded like the capture itself: keep the tail
+                del self._since_start[:excess]
+                self.capture.truncated = True
+        buf = self._window + chunk
+        pos = buf.find(_LINE_ACCEPTED)
+        if pos < 0:
+            self._window = buf[-(len(_LINE_ACCEPTED) - 1) :]
+            return
+        self._accepted = True
+        self._since_start = None
+        self._skip_cr = True
+        self.feed(buf[pos + len(_LINE_ACCEPTED) :])
+
+    def finish(self) -> bytes:
+        if not self._accepted and self._since_start is not None:
+            self.capture.feed(bytes(self._since_start))
+        self.capture.stop()
+        return bytes(self.capture.data)
+
+
+class Session:
+    """One long-lived interactive bash on a PTY with nl-shell's control channel on fd 3."""
+
+    def __init__(
+        self,
+        *,
+        env: dict[str, str] | None = None,
+        cwd: str | None = None,
+        term: str | None = None,
+        dimensions: tuple[int, int] = (24, 80),
+        on_record: Callable[[bytes], None] | None = None,
+        max_output: int = MAX_OUTPUT,
+    ):
+        """Prefer :meth:`start`. ``on_record`` sees every control record, ``\\n`` included.
+
+        ``max_output`` bounds the output kept per command (the tail is kept).
+        """
+        if max_output < 1:
+            raise ValueError("max_output must be at least 1")
+        self.max_output = max_output
+        self._env = dict(os.environ if env is None else env)
+        if term is None:
+            term = self._env.get("TERM", "")
+            if not term or term == "dumb":
+                # Readline turns bracketed paste off on a dumb terminal (§5.1 needs it).
+                term = "xterm-256color"
+        self._env["TERM"] = term
+        self._cwd = cwd
+        self._dimensions = dimensions
+        self._on_record = on_record
+        self._proc: ptyprocess.PtyProcess | None = None
+        self._ctl: int | None = None
+        self._ctl_open = False
+        self._rcdir: str | None = None
+        self._tracker = ProtocolTracker(on_record)
+
+    # ----- lifecycle -------------------------------------------------------------
+
+    @classmethod
+    def start(cls, *, timeout: float = 10.0, **kwargs) -> "Session":
+        """Start bash and wait for the baseline snapshot (§1, §3)."""
+        session = cls(**kwargs)
+        try:
+            session._spawn(timeout)
+        except BaseException:
+            session.close()
+            raise
+        return session
+
+    def restart(self, timeout: float = 10.0) -> None:
+        """Replace the bash process with a fresh one; clears degraded mode."""
+        self.close()
+        self._tracker = ProtocolTracker(self._on_record)
+        try:
+            self._spawn(timeout)
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self) -> None:
+        """End bash (and its jobs, via SIGHUP) and release every descriptor."""
+        proc, self._proc = self._proc, None
+        if proc is not None:
+            try:
+                proc.close(force=True)
+            except Exception:
+                pass
+        if self._ctl is not None:
+            os.close(self._ctl)
+            self._ctl = None
+            self._ctl_open = False
+        self._remove_rcfile()
+
+    def __enter__(self) -> "Session":
+        return self
+
+    def __exit__(self, *exc) -> None:
+        self.close()
+
+    def _spawn(self, timeout: float) -> None:
+        self._rcdir = tempfile.mkdtemp(prefix="nl-shell-session-")
+        rcfile = os.path.join(self._rcdir, "rc.bash")
+        with open(rcfile, "w", encoding="utf-8") as fh:
+            fh.write(RCFILE)
+        read_end, write_end = os.pipe()
+
+        def control_channel_on_fd3() -> None:  # runs in the child, after fork
+            if write_end != 3:
+                os.dup2(write_end, 3)  # the copy on fd 3 is inheritable
+                os.close(write_end)
+            else:
+                os.set_inheritable(3, True)
+
+        try:
+            self._proc = ptyprocess.PtyProcess.spawn(
+                ["bash", "--noprofile", "--rcfile", rcfile, "-i"],
+                cwd=self._cwd,
+                env=self._env,
+                dimensions=self._dimensions,
+                pass_fds=(write_end,),
+                preexec_fn=control_channel_on_fd3,
+            )
+        except BaseException:
+            os.close(read_end)
+            raise
+        finally:
+            os.close(write_end)  # only bash (and what it starts) holds the write end
+        self._ctl, self._ctl_open = read_end, True
+
+        deadline = time.monotonic() + timeout
+        while self._tracker.phase is Phase.BASELINE or self._tracker.phase is Phase.SNAPSHOT:
+            if time.monotonic() > deadline:
+                raise SessionTimeout("bash did not report its first snapshot in time")
+            ready = self._select([self._proc.fd, self._ctl], _POLL)
+            if self._proc.fd in ready:
+                self._read_pty()  # bash's start-up output and first prompt: discarded
+            if self._ctl in ready:
+                self._read_control()
+            if self._tracker.degraded:
+                raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+        self._remove_rcfile()  # bash has read it
+
+    def _remove_rcfile(self) -> None:
+        if self._rcdir is not None:
+            shutil.rmtree(self._rcdir, ignore_errors=True)
+            self._rcdir = None
+
+    # ----- state -----------------------------------------------------------------
+
+    @property
+    def pid(self) -> int | None:
+        return self._proc.pid if self._proc is not None else None
+
+    @property
+    def degraded(self) -> bool:
+        return self._tracker.degraded
+
+    @property
+    def degraded_reason(self) -> str | None:
+        return self._tracker.degraded_reason
+
+    @property
+    def baseline(self) -> Snapshot | None:
+        return self._tracker.baseline
+
+    @property
+    def snapshot(self) -> Snapshot | None:
+        return self._tracker.snapshot
+
+    # ----- running a command -------------------------------------------------------
+
+    def run(
+        self,
+        command: str | bytes,
+        *,
+        terminal: Terminal | None = None,
+        timeout: float | None = None,
+    ) -> CommandResult:
+        """Send one confirmed command (§5) and wait for its done record and snapshot.
+
+        Raises :class:`CommandRefused` (nothing is written), :class:`SessionDegraded`, or
+        :class:`SessionTimeout` (which also degrades the session: the command may still
+        be running).
+        """
+        data = check_command(command)
+        if self._proc is None:
+            raise SessionError("the session is closed")
+        if self._tracker.degraded:
+            raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+
+        fd = self._proc.fd
+        self._drain_pty()  # the last prompt and any job notices: not this command's
+        # Every record must be read before the command goes out: one that arrived after
+        # the last E (e.g. the rest of a snapshot something forged an early E into) is out
+        # of order, and the session must degrade before bash gets the next command (§4.2).
+        self._drain_control()
+        if self._tracker.degraded:
+            raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+        self._tracker.command_sent()
+
+        saved_attrs = None
+        wake_r = wake_w = None
+        old_handler = None
+        try:
+            if terminal is not None:
+                try:
+                    saved_attrs = termios.tcgetattr(terminal.in_fd)
+                    tty.setraw(terminal.in_fd, termios.TCSANOW)
+                except termios.error:
+                    saved_attrs = None  # not a tty: nothing to switch or restore
+                wake_r, wake_w = os.pipe()
+                os.set_blocking(wake_w, False)
+                if threading.current_thread() is threading.main_thread():
+                    old_handler = signal.signal(
+                        signal.SIGWINCH, lambda _s, _f: _poke(wake_w)
+                    )
+                self._copy_window_size(terminal)
+            _write_all(fd, PASTE_START + data + PASTE_END + b"\r")
+            return self._wait_for_result(terminal, wake_r, timeout)
+        finally:
+            if old_handler is not None:
+                signal.signal(signal.SIGWINCH, old_handler)
+            if saved_attrs is not None:
+                termios.tcsetattr(terminal.in_fd, termios.TCSADRAIN, saved_attrs)
+            for wfd in (wake_r, wake_w):
+                if wfd is not None:
+                    os.close(wfd)
+
+    def _wait_for_result(
+        self, terminal: Terminal | None, wake_r: int | None, timeout: float | None
+    ) -> CommandResult:
+        assert self._proc is not None and self._ctl is not None
+        fd = self._proc.fd
+        deadline = None if timeout is None else time.monotonic() + timeout
+        splitter = _OutputSplitter(self.max_output)
+        mirror_out = terminal.out_fd if terminal is not None else None
+        forward_in = terminal.in_fd if terminal is not None else None
+        input_forwarded = False
+        output: bytes | None = None  # set when the D record arrives
+        finished: Snapshot | None = None  # set when the E record arrives
+        prompt_since: float | None = None
+
+        while True:
+            watch = [fd]
+            if self._ctl_open:
+                watch.append(self._ctl)
+            if forward_in is not None and output is None:
+                watch.append(forward_in)
+            if wake_r is not None:
+                watch.append(wake_r)
+            ready = self._select(watch, _POLL)
+
+            # PTY output first, so whatever was printed before a D record read in the same
+            # round is already counted as this command's.
+            if fd in ready:
+                chunk = self._read_pty()
+                if output is None and chunk:
+                    if mirror_out is not None:
+                        _write_all(mirror_out, chunk)
+                    splitter.feed(chunk)
+            if self._ctl_open and self._ctl in ready:
+                for kind, value in self._read_control():
+                    if kind == "S":
+                        splitter.started()
+                    elif kind == "D" and output is None:
+                        for chunk in self._drain_pty():
+                            if mirror_out is not None:
+                                _write_all(mirror_out, chunk)
+                            splitter.feed(chunk)
+                        output = splitter.finish()
+                    elif kind == "E":
+                        finished = value  # type: ignore[assignment]
+                if finished is not None:
+                    # Records after this E (already read, or waiting in the pipe) are out
+                    # of order; the tracker degrades on them, checked below.
+                    self._drain_control()
+            if forward_in is not None and forward_in in ready and output is None:
+                # Forwarded bytes are written straight to the PTY and never kept (§6.1).
+                # Capture stops here: the PTY may echo them back as output.
+                if _forward(forward_in, fd):
+                    input_forwarded = True
+                    splitter.capture.stop()
+                else:
+                    forward_in = None  # EOF on the terminal
+            if wake_r is not None and wake_r in ready:
+                _drain_fd(wake_r)
+                if terminal is not None:
+                    self._copy_window_size(terminal)
+
+            if self._tracker.degraded:
+                raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+            if finished is not None:
+                done = self._tracker.done
+                assert done is not None and output is not None
+                return CommandResult(
+                    seq=done.seq,
+                    status=done.status,
+                    pipestatus=done.pipestatus,
+                    output=output,
+                    input_forwarded=input_forwarded,
+                    snapshot=finished,
+                    output_truncated=splitter.capture.truncated,
+                )
+
+            now = time.monotonic()
+            if self._tracker.phase in (Phase.SENT, Phase.RUNNING) and self._back_at_prompt():
+                if prompt_since is None:
+                    prompt_since = now
+                elif now - prompt_since >= PROMPT_GRACE:
+                    self._tracker.degrade(
+                        "no done record after the shell returned to a prompt"
+                    )
+                    raise SessionDegraded(self._tracker.degraded_reason or "unknown")
+            else:
+                prompt_since = None
+            if deadline is not None and now > deadline:
+                self._tracker.degrade("no done record within the caller's timeout")
+                raise SessionTimeout(f"command did not finish within {timeout} s")
+
+    # ----- helpers -----------------------------------------------------------------
+
+    @staticmethod
+    def _select(fds: list[int], timeout: float) -> list[int]:
+        ready, _, _ = select.select(fds, [], [], timeout)
+        return ready
+
+    def _read_pty(self) -> bytes:
+        assert self._proc is not None
+        try:
+            chunk = os.read(self._proc.fd, 65536)
+        except OSError:
+            chunk = b""  # EIO: bash has exited and the slave side is gone
+        if not chunk:
+            self._tracker.degrade("the shell exited")
+        return chunk
+
+    def _drain_pty(self) -> list[bytes]:
+        """Read what the PTY has buffered right now, without waiting for more."""
+        assert self._proc is not None
+        chunks = []
+        while not self._tracker.degraded and self._select([self._proc.fd], 0):
+            chunk = self._read_pty()
+            if not chunk:
+                break
+            chunks.append(chunk)
+        return chunks
+
+    def _drain_control(self) -> None:
+        """Feed the tracker whatever the control channel holds right now, without waiting."""
+        while self._ctl_open and not self._tracker.degraded and self._select([self._ctl], 0):
+            self._read_control()
+
+    def _read_control(self) -> list[tuple[str, object]]:
+        assert self._ctl is not None
+        data = os.read(self._ctl, 65536)
+        if not data:
+            self._ctl_open = False
+            self._tracker.eof()
+            return []
+        return self._tracker.feed(data)
+
+    def _copy_window_size(self, terminal: Terminal) -> None:
+        assert self._proc is not None
+        try:
+            size = os.get_terminal_size(terminal.in_fd)
+        except OSError:
+            return
+        if size.lines and size.columns:
+            self._proc.setwinsize(size.lines, size.columns)
+
+    def _back_at_prompt(self) -> bool:
+        """bash owns the terminal and is waiting for input, with nothing running.
+
+        The PTY's foreground process group is bash's own while bash runs a builtin or sits
+        at its prompt, and the command's group while an external command runs. Where
+        /proc allows, two cases that also leave bash in the foreground are excluded: bash
+        busy on the CPU, and bash waiting for a `$(...)` child (which stays in its group).
+        """
+        assert self._proc is not None
+        try:
+            if os.tcgetpgrp(self._proc.fd) != self._proc.pid:
+                return False
+        except OSError:
+            return False
+        return not _shell_busy(self._proc.pid)
+
+
+def _shell_busy(pid: int) -> bool:
+    try:
+        with open(f"/proc/{pid}/stat", encoding="ascii", errors="replace") as fh:
+            state = fh.read().rsplit(")", 1)[1].split()[0]
+        if state == "R":
+            return True
+        with open(f"/proc/{pid}/task/{pid}/children", encoding="ascii") as fh:
+            children = fh.read().split()
+        for child in children:
+            try:
+                with open(f"/proc/{child}/stat", encoding="ascii", errors="replace") as fh:
+                    pgrp = int(fh.read().rsplit(")", 1)[1].split()[2])
+            except (OSError, ValueError, IndexError):
+                continue
+            if pgrp == pid:
+                return True
+    except (OSError, ValueError, IndexError):
+        return False  # no /proc: fall back to the foreground-group rule alone
+    return False
+
+
+def _forward(src: int, dst: int) -> bool:
+    """Copy one read of ``src`` to ``dst``; False on EOF. The bytes are not kept."""
+    try:
+        chunk = os.read(src, 4096)
+    except OSError:
+        return False
+    if not chunk:
+        return False
+    _write_all(dst, chunk)
+    return True
+
+
+def _write_all(fd: int, data: bytes) -> None:
+    view = memoryview(data)
+    while view:
+        try:
+            written = os.write(fd, view)
+        except BlockingIOError:
+            select.select([], [fd], [], _POLL)
+            continue
+        view = view[written:]
+
+
+def _poke(fd: int) -> None:
+    try:
+        os.write(fd, b"w")
+    except OSError:
+        pass
+
+
+def _drain_fd(fd: int) -> None:
+    try:
+        while select.select([fd], [], [], 0)[0] and os.read(fd, 1024):
+            pass
+    except OSError:
+        pass
