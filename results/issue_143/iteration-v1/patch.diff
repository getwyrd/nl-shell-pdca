+    _, out = session("show disk usage", responses=[raw])
+    assert out == (
+        "Proposed command (risk: read-only, 1 line):\n"
+        "  | printf 'a\tb'\n"
+        f"{NOTHING_RUNS_YET}\n"
+    )
+
