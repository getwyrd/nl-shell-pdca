+"""The UTS #39 character-safety policy for proposals and printed text (#144).
+
+Every vector is fed as a stub response (or typed as a request) through the real ``Repl``
+with the recording stub backend, so the tests drive the production parser and escape
+path. ``nl_shell`` modules other than ``nl_shell.repl`` are imported inside the tests, so
+the file still loads (and fails) on a tree without this issue's change. Expected escapes
+and reply texts are pinned as literals; the tests never read the UCD files.
+"""
+
+import io
+import json
+import unicodedata
+
+import pytest
+
+from nl_shell.repl import Repl
+
+NO_USABLE = "No usable proposal came back from the model."
+NOTHING_RUNS_YET = (
+    "Nothing runs yet: running a proposal arrives with the policy gate (#12, #78)."
+)
+DF = '{"kind": "command", "command": "df -h", "risk": "read-only"}'
+DF_SHOWN = (
+    "Proposed command (risk: read-only, 1 line):\n"
+    "  | df -h\n"
+    f"{NOTHING_RUNS_YET}"
+)
+
+
+def scripted(*lines):
+    it = iter(lines)
+
+    def read(_prompt):
+        try:
+            return next(it)
+        except StopIteration:
+            raise EOFError from None
+
+    return read
+
+
+@pytest.fixture(autouse=True)
+def no_commands_on_path(tmp_path, monkeypatch):
+    """An empty ``$PATH``, so `show ...` routes as natural language on any host."""
+    empty = tmp_path / "empty-bin"
+    empty.mkdir()
+    monkeypatch.setenv("PATH", str(empty))
+
+
+def session(*lines, responses=()):
+    """Run a Repl with the recording stub; returns (stub, printed text)."""
+    from nl_shell import prompts, targets
+    from nl_shell.backend import RecordingStub
+
+    target = targets.load("ubuntu-26.04")
+    loaded = prompts.load(target.folder, prompts.user_path())
+    stub = RecordingStub(responses)
+    out = io.StringIO()
+    repl = Repl(scripted(*lines), out, backend=stub, prompts=loaded)
+    assert repl.run() == 0
+    return stub, out.getvalue()
+
+
+def command_response(command, *, ensure_ascii=True):
+    return json.dumps(
+        {"kind": "command", "command": command, "risk": "read-only"},
+        ensure_ascii=ensure_ascii,
+    )
+
+
+def shown(command):
+    return (
+        "Proposed command (risk: read-only, 1 line):\n"
+        f"  | {command}\n"
+        f"{NOTHING_RUNS_YET}\n"
+    )
+
+
+def assert_rejected(command):
+    for ensure_ascii in (True, False):
+        stub, out = session(
+            "show disk usage", "@list files",
+            responses=[command_response(command, ensure_ascii=ensure_ascii), DF],
+        )
+        assert out == NO_USABLE + "\n" + DF_SHOWN + "\n", (command, ensure_ascii)
+        assert len(stub.inputs) == 2
+
+
+def assert_accepted(command):
+    for ensure_ascii in (True, False):
+        _, out = session(
+            "show disk usage",
+            responses=[command_response(command, ensure_ascii=ensure_ascii)],
+        )
+        assert out == shown(command), (command, ensure_ascii)
+
+
+# (1) characters that render as nothing or as blank ------------------------------------
+
+HIDDEN = {
+    "hangul-filler-u3164": ("ㅤ", "\\u3164"),
+    "hangul-choseong-filler-u115f": ("ᅟ", "\\u115f"),
+    "hangul-jungseong-filler-u1160": ("ᅠ", "\\u1160"),
+    "halfwidth-hangul-filler-uffa0": ("ﾠ", "\\uffa0"),
+    "combining-grapheme-joiner-u034f": ("͏", "\\u034f"),
+    "variation-selector-1-ufe00": ("︀", "\\ufe00"),
+    "variation-selector-16-ufe0f": ("️", "\\ufe0f"),
+    "variation-selector-17-ue0100": ("\U000e0100", "\\U000e0100"),
+    "khmer-inherent-aq-u17b4": ("឴", "\\u17b4"),
+    "mongolian-fvs1-u180b": ("᠋", "\\u180b"),
+    "braille-blank-u2800": ("⠀", "\\u2800"),
+    "musical-null-notehead-u1d159": ("\U0001d159", "\\U0001d159"),
+    "khitan-filler-u16fe4": ("\U00016fe4", "\\U00016fe4"),
+    "no-break-space-u00a0": (" ", "\\xa0"),
+    "ideographic-space-u3000": ("　", "\\u3000"),
+    "private-use-ue000": ("", "\\ue000"),
+    "unassigned-u0378": ("͸", "\\u0378"),
+}
+
+
+@pytest.mark.parametrize(("char", "escaped"), HIDDEN.values(), ids=HIDDEN.keys())
+def test_command_with_a_hidden_character_is_rejected(char, escaped):
+    assert_rejected(f"ls{char} -la")
+    assert_rejected(f"echo '{char}'")  # quoted too
+
+
+@pytest.mark.parametrize(("char", "escaped"), HIDDEN.values(), ids=HIDDEN.keys())
+def test_hidden_character_in_a_request_is_escaped_in_context(char, escaped):
+    typed = f"show{char}disk usage"
+    stub, out = session(typed, ":context", responses=[DF])
+    assert stub.inputs[0][-1][1].endswith(typed)  # sent raw
+    assert out.splitlines()[-1].endswith(f"show{escaped}disk usage")
+    assert char not in out
+
+
+# (2) combining marks: at most two in a row ---------------------------------------------
+
+
+def test_three_combining_marks_in_a_command_are_rejected():
+    assert_rejected("echo é́́")
+
+
+def test_two_combining_marks_in_a_command_are_accepted():
+    assert_accepted("echo é́")
+
+
+def test_third_combining_mark_is_escaped_in_context():
+    typed = "show é́́ disk"
+    stub, out = session(typed, ":context", responses=[DF])
+    assert stub.inputs[0][-1][1].endswith(typed)
+    last = out.splitlines()[-1]
+    assert last.endswith("show é́\\u0301 disk")
+    assert "́́́" not in out
+
+
+# (3) mixed-script words ----------------------------------------------------------------
+
+MIXED = {
+    "cyrillic-es-in-curl": "сurl example.com",
+    "cyrillic-es-in-a-path": "ls /tmp/сurl",
+    "latin-d-in-cyrillic-word": "cat Dокумент.txt",
+    # A Common character inside a word (not ASCII punctuation) does not hide the mix.
+    "cyrillic-es-hyphen-latin": "echo с\u2010url",
+    "cyrillic-es-middle-dot-latin": "echo с\u00b7url",
+}
+
+
+@pytest.mark.parametrize("command", MIXED.values(), ids=MIXED.keys())
+def test_command_with_a_mixed_script_word_is_rejected(command):
+    assert_rejected(command)
+
+
+# (4) single-script words and precomposed or lightly combined letters are shown as is --
+
+ACCEPTED = {
+    "cyrillic-word": "ls Документы",
+    "greek-word": "cat αρχείο.txt",
+    "han-and-katakana": "cat 日本語ファイル.txt",
+    "precomposed-e-acute": "echo café",
+    "e-and-one-combining-acute": "echo café",
+}
+
+
+@pytest.mark.parametrize("command", ACCEPTED.values(), ids=ACCEPTED.keys())
+def test_single_script_command_is_accepted_and_shown_unchanged(command):
+    assert_accepted(command)
+
+
+# (5) the vendored tables, not the interpreter's unicodedata ---------------------------
+
+
+def test_tables_record_unicode_16():
+    from nl_shell import _unicode_tables
+
+    assert _unicode_tables.UNICODE_VERSION == "16.0.0"
+
+
+def test_policy_reads_the_vendored_tables_not_unicodedata(monkeypatch):
+    # Make the interpreter's database disagree with Unicode 16.0 on every property the
+    # policy uses: U+0378 assigned and U+1C89 (CYRILLIC CAPITAL LETTER TJE, new in 16.0)
+    # unassigned (Cn); U+0301 COMBINING ACUTE ACCENT a letter, not a mark (Mn); U+FE0F
+    # VARIATION SELECTOR-16 (Default_Ignorable, Mn) and U+00A0 NO-BREAK SPACE
+    # (White_Space, Zs) visible letters; U+E000 a letter, not private use (Co); U+200B
+    # ZERO WIDTH SPACE a letter, not a format character (Cf). The policy must not notice,
+    # since it takes every property from the vendored tables.
+    real_category = unicodedata.category
+    faked = {
+        "\u0378": "Lu",
+        "\u1c89": "Cn",
+        "\u0301": "Lo",
+        "\ufe0f": "Lo",
+        "\xa0": "Lo",
+        "\ue000": "Lo",
+        "\u200b": "Lo",
+    }
+
+    def category(char):
+        return faked.get(char, real_category(char))
+
+    monkeypatch.setattr(unicodedata, "category", category)
+    monkeypatch.setattr(unicodedata, "combining", lambda char: 0)
+    monkeypatch.setattr(unicodedata, "unidata_version", "15.0.0")
+    assert_accepted("ls \u1c89")
+    assert_rejected("ls \u0378")
+    assert_rejected("echo e\u0301\u0301\u0301")
+    assert_rejected("ls\ufe0f -la")
+    assert_rejected("ls\xa0-la")
+    assert_rejected("ls\ue000 -la")
+    assert_rejected("ls\u200b -la")
