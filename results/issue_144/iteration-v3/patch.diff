new file mode 100644
index 0000000..e6fdc23
--- /dev/null
+++ b/scripts/gen_unicode_tables.py
@@ -0,0 +1,191 @@
+"""Generate ``src/nl_shell/_unicode_tables.py`` from the Unicode Character Database (#144).
+
+The character-safety policy (``nl_shell.render``, ``nl_shell.proposal``) reads every
+Unicode property it uses from that generated module, never from the interpreter's
+``unicodedata``, so the policy is the same on every supported Python. This script reads
+the UCD text files (Ubuntu package ``unicode-data``, installed in ``/usr/share/unicode/``)
+and writes only the ranges the policy needs:
+
+- general categories Cf, Co, Cn (``UnicodeData.txt``; a code point not listed there is
+  Cn) and Mn, Me (the combining marks);
+- Default_Ignorable_Code_Point (``DerivedCoreProperties.txt``);
+- White_Space (``PropList.txt``);
+- Script_Extensions (``ScriptExtensions.txt``, else the ``Scripts.txt`` value), as
+  four-letter codes, with Common (Zyyy) and Inherited (Zinh) removed; a code point whose
+  set is then empty is left out.
+
+Usage::
+
+    python3 scripts/gen_unicode_tables.py [--ucd /usr/share/unicode] [--expect 16.0.0]
+
+The run fails if the UCD version is not ``--expect``, so a regenerated module never
+silently changes the pinned version. The module is committed; tests never run this.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+OUTPUT = REPO / "src" / "nl_shell" / "_unicode_tables.py"
+MAX_CODE = 0x10FFFF
+IGNORED_SCRIPTS = frozenset(("Zyyy", "Zinh"))
+HEADER = '''"""Unicode property tables for the character-safety policy (#144).
+
+GENERATED by scripts/gen_unicode_tables.py from the Unicode Character Database {version};
+do not edit by hand. Each table is a tuple of inclusive ``(first, last)`` code point
+ranges, sorted and merged; ``SCRIPT_EXTENSIONS`` adds the four-letter script codes of
+each range (Common and Inherited removed; a code point not listed has none).
+"""
+'''
+
+
+def data_lines(path: Path):
+    """``(first, last, value)`` per data line of a UCD ``range ; value`` file."""
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.split("#", 1)[0].strip()
+        if not line:
+            continue
+        codes, value = (part.strip() for part in line.split(";", 1))
+        first, _, last = codes.partition("..")
+        yield int(first, 16), int(last or first, 16), value
+
+
+def file_version(path: Path) -> str:
+    """The version in the first line of a UCD file (``# Scripts-16.0.0.txt``)."""
+    first = path.read_text(encoding="utf-8").splitlines()[0]
+    match = re.search(r"-(\d+\.\d+\.\d+)\.txt", first)
+    if match is None:
+        raise SystemExit(f"{path}: no version in its first line: {first!r}")
+    return match.group(1)
+
+
+def general_categories(path: Path) -> list[str]:
+    """The general category of every code point; ``Cn`` where UnicodeData has none."""
+    cats = ["Cn"] * (MAX_CODE + 1)
+    range_start: tuple[int, str] | None = None
+    for line in path.read_text(encoding="utf-8").splitlines():
+        fields = line.split(";")
+        code, name, cat = int(fields[0], 16), fields[1], fields[2]
+        if name.endswith(", First>"):
+            range_start = (code, cat)
+            continue
+        if name.endswith(", Last>"):
+            assert range_start is not None and range_start[1] == cat
+            for c in range(range_start[0], code + 1):
+                cats[c] = cat
+            range_start = None
+            continue
+        cats[code] = cat
+    return cats
+
+
+def ranges(codes) -> list[tuple[int, int]]:
+    """Sorted, merged ``(first, last)`` ranges covering ``codes``."""
+    out: list[list[int]] = []
+    for code in sorted(set(codes)):
+        if out and out[-1][1] == code - 1:
+            out[-1][1] = code
+        else:
+            out.append([code, code])
+    return [(a, b) for a, b in out]
+
+
+def property_codes(path: Path, name: str) -> set[int]:
+    codes: set[int] = set()
+    for first, last, value in data_lines(path):
+        if value == name:
+            codes.update(range(first, last + 1))
+    return codes
+
+
+def script_extensions(ucd: Path) -> list[tuple[int, int, tuple[str, ...]]]:
+    """Merged ``(first, last, scripts)`` ranges; Common and Inherited removed."""
+    short = {}
+    aliases = (ucd / "PropertyValueAliases.txt").read_text(encoding="utf-8")
+    for line in aliases.splitlines():
+        fields = [f.strip() for f in line.split("#", 1)[0].split(";")]
+        if len(fields) >= 3 and fields[0] == "sc":
+            short[fields[2]] = fields[1]
+    scx: dict[int, frozenset[str]] = {}
+    for first, last, value in data_lines(ucd / "Scripts.txt"):
+        for code in range(first, last + 1):
+            scx[code] = frozenset((short[value],))
+    for first, last, value in data_lines(ucd / "ScriptExtensions.txt"):
+        for code in range(first, last + 1):
+            scx[code] = frozenset(value.split())
+    out: list[list] = []
+    for code in sorted(scx):
+        scripts = tuple(sorted(scx[code] - IGNORED_SCRIPTS))
+        if not scripts:
+            continue
+        if out and out[-1][1] == code - 1 and out[-1][2] == scripts:
+            out[-1][1] = code
+        else:
+            out.append([code, code, scripts])
+    return [(a, b, s) for a, b, s in out]
+
+
+def format_ranges(name: str, comment: str, rs) -> str:
+    body = "".join(f"    (0x{a:04X}, 0x{b:04X}),\n" for a, b in rs)
+    return f"# {comment}\n{name} = (\n{body})\n"
+
+
+def generate(ucd: Path, expect: str) -> str:
+    versions = {
+        file_version(ucd / name)
+        for name in (
+            "DerivedCoreProperties.txt", "PropList.txt", "Scripts.txt",
+            "ScriptExtensions.txt", "PropertyValueAliases.txt",
+        )
+    }
+    if versions != {expect}:
+        raise SystemExit(f"UCD in {ucd} is version {sorted(versions)}, expected {expect}")
+    cats = general_categories(ucd / "UnicodeData.txt")
+    by_cat = {
+        name: ranges(c for c in range(MAX_CODE + 1) if cats[c] in members)
+        for name, members in (
+            ("CF", {"Cf"}), ("CO", {"Co"}), ("CN", {"Cn"}), ("MARK", {"Mn", "Me"}),
+        )
+    }
+    ignorable = ranges(
+        property_codes(ucd / "DerivedCoreProperties.txt", "Default_Ignorable_Code_Point")
+    )
+    white = ranges(property_codes(ucd / "PropList.txt", "White_Space"))
+    scripts = script_extensions(ucd)
+    scx_body = "".join(f"    (0x{a:04X}, 0x{b:04X}, {s!r}),\n" for a, b, s in scripts)
+    cn_comment = "General_Category = Cn (unassigned, noncharacters)."
+    mark_comment = "General_Category = Mn or Me (combining marks)."
+    parts = [
+        HEADER.format(version=expect),
+        f'UNICODE_VERSION = "{expect}"\n',
+        format_ranges("CF", "General_Category = Cf (format).", by_cat["CF"]),
+        format_ranges("CO", "General_Category = Co (private use).", by_cat["CO"]),
+        format_ranges("CN", cn_comment, by_cat["CN"]),
+        format_ranges("MARK", mark_comment, by_cat["MARK"]),
+        format_ranges(
+            "DEFAULT_IGNORABLE", "Default_Ignorable_Code_Point = Yes.", ignorable
+        ),
+        format_ranges("WHITE_SPACE", "White_Space = Yes.", white),
+        "# Script_Extensions without Zyyy/Zinh: (first, last, scripts).\n"
+        f"SCRIPT_EXTENSIONS = (\n{scx_body})\n",
+    ]
+    return "\n\n".join(parts)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--ucd", type=Path, default=Path("/usr/share/unicode"))
+    parser.add_argument("--expect", default="16.0.0")
+    parser.add_argument("--output", type=Path, default=OUTPUT)
+    args = parser.parse_args(argv)
+    args.output.write_text(generate(args.ucd, args.expect), encoding="utf-8")
+    print(f"wrote {args.output}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
